+void test_button_prompts() {
+    // A western game (cross confirms) with the default Confirm button: cross
+    // on the bottom button, circle on the right.
+    ButtonPrompts p = button_prompts(PromptSetting::Automatic, PadKind::Xbox, true, true);
+    check(p.style == PromptStyle::Xbox && p.cross == FaceButton::South && p.circle == FaceButton::East,
+          "an Xbox pad shows its own buttons, cross on the bottom one");
+    check(p.square == FaceButton::West && p.triangle == FaceButton::North && !p.numbered_shoulders,
+          "square and triangle stay left and top");
+    p = button_prompts(PromptSetting::Automatic, PadKind::Xbox, false, true);
+    check(p.cross == FaceButton::East && p.circle == FaceButton::South,
+          "Confirm on the right button moves cross there");
+    p = button_prompts(PromptSetting::Automatic, PadKind::Xbox, false, false);
+    check(p.cross == FaceButton::South && p.circle == FaceButton::East,
+          "a Japanese game confirming on the right keeps cross on the bottom button");
+    check(button_prompts(PromptSetting::Automatic, PadKind::None, true, true).style == PromptStyle::Psp,
+          "with no gamepad the game's own symbols stay");
+    check(button_prompts(PromptSetting::Automatic, PadKind::PlayStation, true, true).style == PromptStyle::PlayStation,
+          "a PlayStation pad shows PlayStation buttons");
+    check(button_prompts(PromptSetting::Automatic, PadKind::Nintendo, true, true).style == PromptStyle::Nintendo,
+          "a Nintendo pad shows Nintendo buttons");
+    p = button_prompts(PromptSetting::Automatic, PadKind::SteamDeck, true, true);
+    check(p.style == PromptStyle::Xbox && p.numbered_shoulders, "a Steam Deck shows A B X Y and L1 R1");
+    check(!button_prompts(PromptSetting::Xbox, PadKind::SteamDeck, true, true).numbered_shoulders,
+          "Xbox chosen by name keeps LB and RB");
+    check(button_prompts(PromptSetting::Psp, PadKind::Xbox, true, true).style == PromptStyle::Psp,
+          "PSP chosen keeps the game's symbols with any pad");
+    check(button_prompts(PromptSetting::Nintendo, PadKind::None, true, true).style == PromptStyle::Nintendo,
+          "a chosen style needs no pad");
+    check(std::string(prompt_setting_label(PromptSetting::PlayStation)) == "PlayStation" &&
+              std::string(prompt_style_name(PromptStyle::Nintendo)) == "nintendo",
+          "the menu and the log name each one");
