index 0000000..e556f17
--- /dev/null
+++ b/host/input/button_prompts.cpp
@@ -0,0 +1,55 @@
+#include "input/button_prompts.hpp"
+
+namespace portablekit::input {
+
+ButtonPrompts button_prompts(PromptSetting setting, PadKind pad, bool confirm_south, bool cross_confirms) {
+    ButtonPrompts prompts;
+    // South sends the confirm button when confirm_south is set, the back
+    // button otherwise (the renderer's read_gamepad), so it sends cross
+    // exactly when those two agree.
+    const bool south_sends_cross = confirm_south == cross_confirms;
+    prompts.cross = south_sends_cross ? FaceButton::South : FaceButton::East;
+    prompts.circle = south_sends_cross ? FaceButton::East : FaceButton::South;
+    switch (setting) {
+    case PromptSetting::Automatic:
+        switch (pad) {
+        case PadKind::None: prompts.style = PromptStyle::Psp; break;
+        case PadKind::Xbox: prompts.style = PromptStyle::Xbox; break;
+        case PadKind::PlayStation: prompts.style = PromptStyle::PlayStation; break;
+        case PadKind::Nintendo: prompts.style = PromptStyle::Nintendo; break;
+        case PadKind::SteamDeck:
+            prompts.style = PromptStyle::Xbox;
+            prompts.numbered_shoulders = true;
+            break;
+        }
+        break;
+    case PromptSetting::Psp: prompts.style = PromptStyle::Psp; break;
+    case PromptSetting::Xbox: prompts.style = PromptStyle::Xbox; break;
+    case PromptSetting::PlayStation: prompts.style = PromptStyle::PlayStation; break;
+    case PromptSetting::Nintendo: prompts.style = PromptStyle::Nintendo; break;
+    }
+    return prompts;
+}
+
+const char *prompt_setting_label(PromptSetting setting) {
+    switch (setting) {
+    case PromptSetting::Automatic: return "Automatic";
+    case PromptSetting::Psp: return "PSP";
+    case PromptSetting::Xbox: return "Xbox";
+    case PromptSetting::PlayStation: return "PlayStation";
+    case PromptSetting::Nintendo: return "Nintendo";
+    }
+    return "Automatic";
+}
+
+const char *prompt_style_name(PromptStyle style) {
+    switch (style) {
+    case PromptStyle::Psp: return "psp";
+    case PromptStyle::Xbox: return "xbox";
+    case PromptStyle::PlayStation: return "playstation";
+    case PromptStyle::Nintendo: return "nintendo";
+    }
+    return "psp";
+}
+
+} // namespace portablekit::input
diff --git a/host/input/button_prompts.hpp b/host/input/button_prompts.hpp
new file mode 100644
index 0000000..1fc20b3
--- /dev/null
+++ b/host/input/button_prompts.hpp
@@ -0,0 +1,51 @@
+#pragma once
+
+// What the game's button symbols are drawn as: the PSP's own, or the buttons
+// of the gamepad in use (Controls > Button prompts, input.button_prompts). A
+// profile that draws the game's symbol textures again
+// (GameProfile::edit_texture) reads it from the TextureEditContext it is
+// given. No SDL here: the renderer says what kind of pad is in use.
+
+#include <cstdint>
+
+namespace portablekit::input {
+
+// The player's choice. Automatic follows the gamepad in use.
+enum class PromptSetting : std::uint8_t { Automatic, Psp, Xbox, PlayStation, Nintendo };
+inline constexpr int kPromptSettings = 5;
+
+// What the symbols are drawn as.
+enum class PromptStyle : std::uint8_t { Psp, Xbox, PlayStation, Nintendo };
+
+// A face button by where it sits on the pad.
+enum class FaceButton : std::uint8_t { South, East, West, North };
+
+// The kind of pad in use, as far as the names on its buttons go.
+enum class PadKind : std::uint8_t { None, Xbox, PlayStation, Nintendo, SteamDeck };
+
+struct ButtonPrompts {
+    PromptStyle style{PromptStyle::Psp};
+    // The pad's face button that sends each of the PSP's. The Confirm button
+    // setting moves cross and circle between south and east.
+    FaceButton cross{FaceButton::South};
+    FaceButton circle{FaceButton::East};
+    FaceButton square{FaceButton::West};
+    FaceButton triangle{FaceButton::North};
+    // Shoulders named L1 and R1 in the Xbox style, as a Steam Deck prints them.
+    bool numbered_shoulders{};
+
+    bool operator==(const ButtonPrompts &) const = default;
+};
+
+// The prompts for `setting` with `pad` in use. `confirm_south` is the Confirm
+// button setting; `cross_confirms` says the game confirms with cross
+// (GameProfile::confirm_button == 1) rather than circle.
+[[nodiscard]] ButtonPrompts button_prompts(PromptSetting setting, PadKind pad, bool confirm_south, bool cross_confirms);
+
+// The menu's name for a setting: "Automatic", "PSP", "Xbox", ...
+[[nodiscard]] const char *prompt_setting_label(PromptSetting setting);
+
+// A style's name for logs: "psp", "xbox", "playstation", "nintendo".
+[[nodiscard]] const char *prompt_style_name(PromptStyle style);
+
+} // namespace portablekit::input
