+// Which of the profile's textures drawn again this is
+// (GameProfile::edited_textures), by its key as a dump names it, or none.
+// Only a texture of a listed size is hashed.
+std::optional<std::size_t> listed_edit(const GuestMemory &memory, const TextureState &texture,
+                                       std::uint16_t max_seen_v, const TexturePackOptions &options) {
+    const std::span<const EditedTexture> listed = portablekit::game().edited_textures;
+    const auto sized = [&](const EditedTexture &entry) {
+        return entry.width == texture.width && entry.height == texture.height;
+    };
+    if (std::none_of(listed.begin(), listed.end(), sized)) return std::nullopt;
+    TexturePackKey key;
+    std::uint32_t covered_width = 0u, covered_height = 0u;
+    if (!compute_texture_pack_key(memory, texture, max_seen_v, options, key, covered_width, covered_height))
+        return std::nullopt;
+    const std::string name = format_texture_pack_key(key);
+    for (std::size_t i = 0; i < listed.size(); ++i)
+        if (sized(listed[i]) && name == listed[i].key) return i;
+    return std::nullopt;
+}
+
+// What kind of pad `pad` is, as far as the names on its buttons go. A Steam
+// Deck's own controls, or Steam's virtual pad on a Deck, print A B X Y and
+// L1 R1.
+input::PadKind pad_kind(SDL_Gamepad *pad) {
+    if (pad == nullptr) return input::PadKind::None;
+    const char *name = SDL_GetGamepadName(pad);
+    const std::string_view text = name != nullptr ? name : "";
+    switch (SDL_GetGamepadType(pad)) {
+    case SDL_GAMEPAD_TYPE_PS3:
+    case SDL_GAMEPAD_TYPE_PS4:
+    case SDL_GAMEPAD_TYPE_PS5: return input::PadKind::PlayStation;
+    case SDL_GAMEPAD_TYPE_NINTENDO_SWITCH_PRO:
+    case SDL_GAMEPAD_TYPE_NINTENDO_SWITCH_JOYCON_LEFT:
+    case SDL_GAMEPAD_TYPE_NINTENDO_SWITCH_JOYCON_RIGHT:
+    case SDL_GAMEPAD_TYPE_NINTENDO_SWITCH_JOYCON_PAIR: return input::PadKind::Nintendo;
+    default: break;
+    }
+    const char *deck = std::getenv("SteamDeck");  // Steam sets it on a Steam Deck
+    const bool on_deck = deck != nullptr && std::strcmp(deck, "1") == 0;
+    if (text.find("Steam Deck") != std::string_view::npos ||
+        (on_deck && text.find("Steam Virtual") != std::string_view::npos))
+        return input::PadKind::SteamDeck;
+    return input::PadKind::Xbox;
+}
+
 } // namespace
 
+void VulkanRenderer::Impl::apply_texture_edits() {
+    static const bool off = portablekit::env_set("NO_TEXTURE_EDITS");
+    const GameProfile &profile = portablekit::game();
+    if (off || profile.edit_texture == nullptr || profile.edited_textures.empty()) return;
+    const settings::Settings &s = settings::current();
+    TextureEditContext context;
+    context.prompts =
+        input::button_prompts(s.button_prompts, pad_kind(gamepad), s.confirm_south, profile.confirm_button == 1u);
+    context.sharp_textures = sharp_textures;
+    if (edit_context && *edit_context == context) return;
+    const bool first = !edit_context;
+    edit_context = context;
+    if (profile.button_prompts)
+        std::cout << "[render] button prompts: " << input::prompt_style_name(context.prompts.style) << "\n";
+    if (first) return;
+    // Drawn again as they are next used.
+    device_wait_idle();
+    drop_cached_textures();
+}
