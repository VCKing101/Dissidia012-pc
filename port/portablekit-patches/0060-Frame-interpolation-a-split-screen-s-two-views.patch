+// A split screen draws the same scene twice, once from each player's camera.
+void split_views() {
+    const CutThresholds thresholds{};
+    // View 0's camera turns 2 degrees, view 1's 10 degrees and slides 30
+    // units: each view's draws go with its own camera.
+    const auto frame = [](float first, float second, float slide) {
+        std::vector<DrawSummary> both = scene(50u, first);
+        std::vector<DrawSummary> right = scene(50u, second, slide);
+        for (DrawSummary &d : right) d.split_view = 1u;
+        both.insert(both.end(), right.begin(), right.end());
+        return both;
+    };
+    Matcher matcher;
+    const Matching &split = matcher.match(frame(0.0f, 0.0f, 0.0f), frame(2.0f, 10.0f, 30.0f), thresholds);
+    bool own_view = true;
+    for (std::size_t i = 0; i < 100u; ++i)
+        own_view = own_view && split.newer_of[i] >= 0 && (split.newer_of[i] < 50) == (i < 50u);
+    check(split.matched == 100u && own_view && split.cut == nullptr,
+          "a split frame's draws pair within their own view and blend");
+    check(split.views[0].found && near(split.views[0].angle_degrees, 2.0f, 0.01f) && split.views[1].found &&
+              near(split.views[1].angle_degrees, 10.0f, 0.01f),
+          "each view has its own camera motion");
+    check(split.rejected == 0u, "and the scenery of neither view counts as moving on its own");
+    check(near(split.camera_angle_degrees, 10.0f, 0.01f), "the larger turn is the frame's for the cut limits");
+
+    // The second view jumping 40 degrees is a cut, though the first view
+    // hardly moves.
+    Matcher fresh;
+    const Matching &jump = fresh.match(frame(0.0f, 0.0f, 0.0f), frame(1.0f, 40.0f, 0.0f), thresholds);
+    check(jump.cut != nullptr && std::strcmp(jump.cut, "camera turned") == 0, "a cut in one view is a cut");
+
+    // A frame split against one that is not (a full-screen moment): only
+    // the first view's draws pair; the renderer treats the change as a cut.
+    const Matching &change = fresh.match(frame(0.0f, 0.0f, 0.0f), scene(100u), thresholds);
+    bool first_only = true;
+    for (std::size_t i = 50u; i < 100u; ++i) first_only = first_only && change.newer_of[i] == Matching::kNoPartner;
+    check(change.matched == 50u && first_only, "a whole-screen frame pairs only with the first view");
+}
