new file mode 100644
index 0000000..e315b06
--- /dev/null
+++ b/host/gpu/vulkan_report.hpp
@@ -0,0 +1,18 @@
+#pragma once
+
+// What this machine offers for Vulkan, printed when the renderer cannot start
+// so that a player's log says why: the graphics adapters Windows has, the
+// loader's instance extensions, the loader's own account of its driver search,
+// the devices of an instance made without a window, and any of the loader's
+// environment variables that are set.
+//
+// The account of the driver search is what VK_LOADER_DEBUG would print. The
+// loader reads that variable once, when it is loaded at start-up, so it cannot
+// be turned on now; a debug messenger chained into vkCreateInstance is given
+// the same messages. Lines go to standard output, each starting "[vulkan]".
+
+namespace portablekit::gpu {
+
+void log_vulkan_report();
+
+} // namespace portablekit::gpu
