diff --git a/host/hle/hle_io.cpp b/host/hle/hle_io.cpp
index bbd0c35..6e6d195 100644
--- a/host/hle/hle_io.cpp
+++ b/host/hle/hle_io.cpp
@@ -219,7 +219,46 @@ std::optional<std::pair<std::uint64_t, std::uint64_t>> parse_lbn_path(const std:
     return std::make_pair(*lba, *length);
 }
 
-std::filesystem::path host_path(const std::string &path) { return io().memory_stick / path; }
+// The memory stick's file for `path`. A PSP's memory stick (FAT) and Windows
+// match names in any case, and games rely on it: Dissidia 012 asks whether
+// "ms0:/PSP/GAME/ULUS10566/2f356e6c.edat" exists, then opens
+// "MS0:/PSP/GAME/ULUS10566/2F356E6C.EDAT". Elsewhere each part of the path is
+// looked up as it is, then in any ASCII case among that folder's entries; a
+// part that is not there (a file about to be made) is kept as the game wrote it.
+std::filesystem::path host_path(const std::string &path) {
+#if defined(_WIN32)
+    return io().memory_stick / path;
+#else
+    std::filesystem::path result = io().memory_stick;
+    bool found = true;  // every part so far is an existing entry
+    std::size_t start = 0;
+    while (start <= path.size()) {
+        std::size_t end = path.find('/', start);
+        if (end == std::string::npos) end = path.size();
+        const std::string part = path.substr(start, end - start);
+        start = end + 1;
+        if (part.empty() || part == ".") continue;
+        std::error_code ec;
+        if (found && !std::filesystem::exists(result / part, ec)) {
+            found = false;
+            for (const auto &entry : std::filesystem::directory_iterator(result, ec)) {
+                const std::string name = entry.path().filename().string();
+                if (name.size() == part.size() &&
+                    std::equal(name.begin(), name.end(), part.begin(), [](unsigned char a, unsigned char b) {
+                        return std::tolower(a) == std::tolower(b);
+                    })) {
+                    result /= name;
+                    found = true;
+                    break;
+                }
+            }
+            if (found) continue;
+        }
+        result /= part;
+    }
+    return result;
+#endif
+}
 
 bool trace_io() {
     static const bool enabled = portablekit::env("TRACE_IO") != nullptr;
