--- a/host/gpu/texture_pack_match.cpp
+++ b/host/gpu/texture_pack_match.cpp
@@ -337,7 +337,7 @@ TexturePackMatcher::Known TexturePackMatcher::known(std::uint64_t cache_key, std
         return Known::Matched;
