+    // of a second, a visible stall at every overlay swap. A key parked again
+    // replaces what it held.
+    void park_functions(std::uint64_t key, std::uint32_t start, std::uint32_t end);
+    // True when `key` was parked: its registrations are back as they were.
+    bool restore_functions(std::uint64_t key);
+    // Room for `count` more registrations, so that registering a large
+    // corpus rehashes the table once rather than every time it doubles.
+    void reserve_functions(std::size_t count);
