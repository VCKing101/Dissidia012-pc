+    std::size_t unaligned_functions_{};
+    // park_functions(): the registrations taken out, by key.
+    std::unordered_map<std::uint64_t, std::vector<decltype(functions_)::node_type>> parked_functions_;
+    // Takes the registrations in [start, end) out of the table and the direct
