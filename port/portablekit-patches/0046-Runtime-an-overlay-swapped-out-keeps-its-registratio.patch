+// An overlay swapped out keeps its registrations (Runtime::park_functions),
+// and comes back with them when it is loaded again, instead of dropping and
+// registering a few hundred thousand entries at every swap.
+// <prefix>_NO_OVERLAY_PARKING drops and registers them, as before.
+bool overlay_parking() {
+    static const bool on = portablekit::env("NO_OVERLAY_PARKING") == nullptr;
+    return on;
+}
+
 bool install_overlay_for(Runtime &runtime, std::uint32_t pc) {
     const auto [slot_start, slot_end] = code_range_of(pc);
     if (slot_start == 0u) return false;
@@ -303,12 +313,19 @@ bool install_overlay_for(Runtime &runtime, std::uint32_t pc) {
         if (identity_hash(runtime.memory(), corpus) != corpus.hash) continue;
         auto &installed = installed_overlays();
         if (installed[slot_start] == corpus.hash) return false;  // already installed: a real miss
+        const auto started = std::chrono::steady_clock::now();
         runtime.unregister_functions(slot_start, slot_start + corpus.size);
-        corpus.install(runtime);
+        const bool restored = overlay_parking() && runtime.restore_functions(corpus.hash);
+        if (!restored) {
+            runtime.reserve_functions(corpus.size / 4u);
+            corpus.install(runtime);
+        }
         installed[slot_start] = corpus.hash;
         installed_headers()[slot_start] = header_hash(runtime.memory(), slot_start);
         std::cout << "[overlay] installed " << corpus.name << " (" << corpus.size / 1024u << " KiB) at "
-                  << psprecomp::hex32(slot_start) << "\n";
+                  << psprecomp::hex32(slot_start) << (restored ? ", its parked registrations," : "") << " in "
+                  << std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - started).count()
+                  << " ms\n";
         return true;
     }
 
@@ -369,8 +386,13 @@ void revalidate_overlays(Runtime &runtime) {
         }
         // A different overlay now occupies the slot: drop the stale code so the
         // next dispatch there goes through the miss hook.
-        runtime.unregister_functions(corpus->base, corpus->base + corpus->size);
-        std::cout << "[overlay] " << corpus->name << " was replaced in " << psprecomp::hex32(slot_start) << "\n";
+        const auto started = std::chrono::steady_clock::now();
+        if (overlay_parking()) runtime.park_functions(corpus->hash, corpus->base, corpus->base + corpus->size);
+        else runtime.unregister_functions(corpus->base, corpus->base + corpus->size);
+        std::cout << "[overlay] " << corpus->name << " was replaced in " << psprecomp::hex32(slot_start) << " ("
+                  << (overlay_parking() ? "parked" : "dropped") << " in "
+                  << std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - started).count()
+                  << " ms)\n";
         installed_headers().erase(slot_start);
         it = installed_overlays().erase(it);
     }
