-        }
-        const std::uint32_t c = memory_.canonical(it->first);
+void Runtime::unregister_functions(std::uint32_t start, std::uint32_t end) { take_functions(start, end, nullptr); }
+
+void Runtime::take_functions(std::uint32_t start, std::uint32_t end,
+                             std::vector<decltype(functions_)::node_type> *keep) {
+    const auto clear_direct = [this](std::uint32_t address) {
+        const std::uint32_t c = memory_.canonical(address);
         if (c >= direct_base_) {
             const std::size_t index = static_cast<std::size_t>(c - direct_base_) / 4u;
             if (index < direct_functions_.size()) {
@@ -1229,10 +1233,62 @@ void Runtime::unregister_functions(std::uint32_t start, std::uint32_t end) {
                 direct_chainable_[index] = nullptr;
             }
         }
-        it = functions_.erase(it);
+    };
+    const auto take = [&](decltype(functions_)::const_iterator it) {
+        clear_direct(it->first);
+        if ((it->first & 3u) != 0u) --unaligned_functions_;
+        if (keep != nullptr) keep->push_back(functions_.extract(it));
+        else functions_.erase(it);
+    };
+    if (end <= start) return;
+    const std::uint64_t words = (static_cast<std::uint64_t>(end) - start + 3u) / 4u;
+    if (unaligned_functions_ == 0u && words < functions_.size()) {
+        // Every registration is at a multiple of four: look up each such
+        // address of the range rather than walk the whole table.
+        for (std::uint64_t address = (start + 3ull) & ~3ull; address < end; address += 4u) {
+            const auto found = functions_.find(static_cast<std::uint32_t>(address));
+            if (found != functions_.end()) take(found);
+        }
+        return;
+    }
+    for (auto it = functions_.begin(); it != functions_.end();) {
+        if (it->first < start || it->first >= end) {
+            ++it;
+            continue;
+        }
+        const auto next = std::next(it);
+        take(it);
+        it = next;
     }
 }
 
+void Runtime::park_functions(std::uint64_t key, std::uint32_t start, std::uint32_t end) {
+    std::vector<decltype(functions_)::node_type> kept;
+    take_functions(start, end, &kept);
+    parked_functions_[key] = std::move(kept);
+}
+
+void Runtime::reserve_functions(std::size_t count) { functions_.reserve(functions_.size() + count); }
+
+bool Runtime::restore_functions(std::uint64_t key) {
+    const auto parked = parked_functions_.find(key);
+    if (parked == parked_functions_.end()) return false;
+    std::vector<decltype(functions_)::node_type> nodes = std::move(parked->second);
+    parked_functions_.erase(parked);
+    for (auto &node : nodes) {
+        const std::uint32_t address = node.key();
+        const RecompiledFunction function = node.mapped().function;
+        const bool chainable = node.mapped().name.starts_with("recomp_unit_");
+        // Anything registered at the address since takes the parked entry's
+        // place, as a later registration always does.
+        if (functions_.contains(address)) continue;
+        functions_.insert(std::move(node));
+        if ((address & 3u) != 0u) ++unaligned_functions_;
+        index_function(address, function, chainable);
+    }
+    return true;
+}
