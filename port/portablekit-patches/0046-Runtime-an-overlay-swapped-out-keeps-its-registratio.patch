     if (!function) {
diff --git a/tests/test_main.cpp b/tests/test_main.cpp
index d4305f6..abfa302 100644
--- a/tests/test_main.cpp
+++ b/tests/test_main.cpp
@@ -136,6 +136,33 @@ static void test_chained_call_context_guard() {
 }
 
 
+// Overlay swaps: registrations parked under a key come back as they were, and
+// a range cleared by unregister_functions no longer dispatches.
+static void test_parked_functions() {
+    psprecomp::Runtime runtime;
+    runtime.register_function(0x08804100u, &chained_same_context, "recomp_unit_main");
+    for (std::uint32_t address = 0x089DD4C0u; address < 0x089DD4C0u + 0x400u; address += 4u)
+        runtime.register_function(address, &chained_same_context, "recomp_unit_overlay_a");
+    runtime.register_function(0x089DD4C2u, &chained_switch_context, "odd_entry");
+    const std::size_t all = runtime.function_count();
+    runtime.park_functions(0xA, 0x089DD4C0u, 0x089DD4C0u + 0x400u);
+    require(runtime.function_count() == 1u && !runtime.has_function(0x089DD4C0u) &&
+                !runtime.has_function(0x089DD4C2u) && runtime.has_function(0x08804100u),
+            "Parking an overlay's range left its registrations in place or took others");
+    runtime.register_function(0x089DD4C0u, &chained_switch_context, "recomp_unit_overlay_b");
+    runtime.park_functions(0xB, 0x089DD4C0u, 0x089DD4C0u + 0x400u);
+    require(runtime.restore_functions(0xA) && runtime.function_count() == all,
+            "Restoring a parked overlay did not bring back every registration");
+    require(runtime.has_function(0x089DD4C0u + 0x3FCu) && runtime.has_function(0x089DD4C2u),
+            "Restored registrations are not found");
+    require(!runtime.restore_functions(0xA), "A key restored twice");
+    runtime.unregister_functions(0x089DD4C0u, 0x089DD4C0u + 0x400u);
+    require(runtime.function_count() == 1u && !runtime.has_function(0x089DD4C4u),
+            "unregister_functions left registrations in its range");
+    require(runtime.restore_functions(0xB) && runtime.function_count() == 2u && runtime.has_function(0x089DD4C0u),
+            "The second overlay's parked registration did not come back");
+}
