+std::uint32_t data_hash(const std::uint8_t *data, std::size_t size, const TexturePackOptions &options) {
+    // xxh64 keys keep the low 32 bits of the 64-bit hash. A quick pack matched
+    // by picture keys its textures with xxh64 too.
+    if (options.hash == TexturePackHash::Quick && !options.quick_by_picture) return texture_pack_quick_hash(data, size);
+    return options.hash == TexturePackHash::Xxh32 ? XXH32(data, size, kDataSeed)
+                                                  : static_cast<std::uint32_t>(XXH64(data, size, kDataSeed));
+}
+
+std::uint32_t load_u32(const std::uint8_t *at) {
+    return static_cast<std::uint32_t>(at[0]) | static_cast<std::uint32_t>(at[1]) << 8u |
+           static_cast<std::uint32_t>(at[2]) << 16u | static_cast<std::uint32_t>(at[3]) << 24u;
+}
+
+// Adds two words as two separate 16-bit halves, each wrapping on its own.
+std::uint32_t add_halves(std::uint32_t a, std::uint32_t b) {
+    return ((a & 0xFFFF0000u) + (b & 0xFFFF0000u)) | ((a + b) & 0xFFFFu);
+}
+
+// Multiplies two words as two separate 16-bit halves, keeping the low 16
+// bits of each product.
+std::uint32_t multiply_halves(std::uint32_t a, std::uint32_t b) {
+    const std::uint32_t low = ((a & 0xFFFFu) * (b & 0xFFFFu)) & 0xFFFFu;
+    const std::uint32_t high = ((a >> 16u) * (b >> 16u)) & 0xFFFFu;
+    return high << 16u | low;
 }
 
 bool is_hex_name(const std::string &stem) {
@@ -160,6 +180,42 @@ std::vector<std::uint8_t> read_file(const std::filesystem::path &path) {
 
 } // namespace
 
+std::uint32_t texture_pack_quick_hash(const std::uint8_t *data, std::size_t size) {
+    if (size % 64u != 0u) {
+        // Pairs of words: the first added, the second XORed in. Bytes past
+        // the last whole pair are not read.
+        std::uint32_t sum = 0u;
+        for (std::size_t at = 0; at + 8u <= size; at += 8u) {
+            sum += load_u32(data + at);
+            sum ^= load_u32(data + at + 4u);
+        }
+        return sum;
+    }
+    // Whole 64-byte steps: four rows of 16 bytes, each row four words or
+    // eight 16-bit halves, folded into a 16-byte state with a row of eight
+    // 16-bit factors that grows by the same step after each.
+    std::array<std::uint32_t, 4> state{};
+    std::array<std::uint32_t, 4> factors{0x9BD9C00Bu, 0xB6514B73u, 0x43094D9Bu, 0x00010083u};
+    for (std::size_t at = 0; at < size; at += 64u) {
+        const std::uint8_t *step = data + at;
+        for (std::size_t i = 0; i < 4u; ++i) {
+            const std::uint32_t first = load_u32(step + 4u * i);
+            const std::uint32_t second = load_u32(step + 16u + 4u * i);
+            const std::uint32_t third = load_u32(step + 32u + 4u * i);
+            const std::uint32_t fourth = load_u32(step + 48u + 4u * i);
+            std::uint32_t word = add_halves(state[i], multiply_halves(first, factors[i]));
+            word ^= second;
+            word += third;
+            word ^= multiply_halves(fourth, factors[i]);
+            state[i] = word;
+            factors[i] = add_halves(factors[i], 0x24552455u);
+        }
+    }
+    std::uint32_t hash = 0u;
+    for (std::size_t i = 0; i < 4u; ++i) hash += state[i] + factors[i];
+    return hash;
+}
