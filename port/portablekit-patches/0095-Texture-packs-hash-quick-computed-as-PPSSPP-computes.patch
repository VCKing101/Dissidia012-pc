+// The quick hash of a few lengths: whole 64-byte steps (the lane form, and
+// none at all), and others (pairs of words). The expected values come from a
+// separate model that keeps the state as bytes seen as 16- and 32-bit lanes.
+void test_quick_hash() {
+    const auto pattern = [](std::size_t size, std::uint32_t seed) {
+        std::vector<std::uint8_t> bytes(size);
+        for (std::uint8_t &byte : bytes) {
+            seed = (seed * 1103515245u + 12345u) & 0x7FFFFFFFu;
+            byte = static_cast<std::uint8_t>(seed >> 16u);
+        }
+        return bytes;
+    };
+    const struct {
+        std::size_t size;
+        std::uint32_t seed;
+        std::uint32_t hash;
+    } cases[] = {{0u, 1u, 0x9535599Cu},  {8u, 1u, 0x9063858Du},    {24u, 7u, 0x6D40A78Bu},  {64u, 1u, 0x4CDE3B85u},
+                 {128u, 3u, 0x170E79B6u}, {4096u, 5u, 0x8E2ABC1Au}, {4100u, 5u, 0xFA46E446u}};
+    for (const auto &c : cases) {
+        const std::vector<std::uint8_t> bytes = pattern(c.size, c.seed);
+        check(texture_pack_quick_hash(bytes.data(), bytes.size()) == c.hash,
+              "the quick hash of " + std::to_string(c.size) + " bytes");
+    }
+}
