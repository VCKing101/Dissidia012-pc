@@ -327,6 +327,9 @@ struct State {
     int baseline{kBaseline};  // row of the cell the baselines are on
     std::unordered_map<std::uint32_t, Layout> layouts;
     std::unordered_map<std::uint64_t, GlyphBitmap> bitmaps;
+    // render_scaled()'s glyphs, by code, factor and subpixel shift; `x` and `y`
+    // relative to the whole pixel of the origin.
+    std::unordered_map<std::uint64_t, GlyphBitmap> scaled;
     std::atomic<std::uint64_t> generation{};
 };
 
@@ -604,12 +607,56 @@ GlyphBitmap render(std::uint32_t code, float shift_x, float shift_y) {
     return s.bitmaps.emplace(key, std::move(bitmap)).first->second;
 }
 
+GlyphBitmap render_scaled(std::uint32_t code, std::int32_t x64, std::int32_t y64, int factor) {
+    State &s = loaded_state();
+    const Layout &layout = layout_for(s, code);
+    if (layout.face == nullptr || layout.metrics.width == 0 || factor < 1 || factor > 16) return {};
+    // The game places the 1x bitmap's natural box (unshifted) at (x64, y64),
+    // so the glyph's origin is that far from it; scaled, the outline keeps
+    // its place on the origin.
+    const std::int64_t origin_x = (static_cast<std::int64_t>(x64) - layout.natural_x0 * 64) * factor;
+    const std::int64_t origin_y = (static_cast<std::int64_t>(y64) - layout.natural_y0 * 64) * factor;
+    const auto whole = [](std::int64_t v) { return v >= 0 ? v / 64 : -((-v + 63) / 64); };
+    const std::int64_t whole_x = whole(origin_x), whole_y = whole(origin_y);
+    const int sx = static_cast<int>(origin_x - whole_x * 64);  // 0..63, exact: positions are in 1/64 pixels
+    const int sy = static_cast<int>(origin_y - whole_y * 64);
+    const std::uint64_t key = (static_cast<std::uint64_t>(code) << 20u) | (static_cast<std::uint64_t>(factor) << 12u) |
+                              (static_cast<std::uint64_t>(sx) << 6u) | static_cast<std::uint64_t>(sy);
+    auto found = s.scaled.find(key);
+    if (found == s.scaled.end()) {
+        // A few thousand large glyphs at most; text redrawn after a clear draws them again.
+        if (s.scaled.size() >= 2048u) s.scaled.clear();
+        const float fx = static_cast<float>(sx) / 64.0f;
+        const float fy = static_cast<float>(sy) / 64.0f;
+        const float scale_x = layout.scale_x * static_cast<float>(factor);
+        const float scale_y = layout.scale_y * static_cast<float>(factor);
+        GlyphBitmap bitmap;
+        int x0 = 0, y0 = 0, x1 = 0, y1 = 0;
+        stbtt_GetGlyphBitmapBoxSubpixel(&layout.face->info, layout.glyph, scale_x, scale_y, fx, fy, &x0, &y0, &x1, &y1);
+        bitmap.width = std::max(x1 - x0, 0);
+        bitmap.height = std::max(y1 - y0, 0);
+        bitmap.x = x0;
+        bitmap.y = y0;
+        bitmap.pixels.assign(static_cast<std::size_t>(bitmap.width) * static_cast<std::size_t>(bitmap.height), 0u);
+        if (!bitmap.pixels.empty())
+            stbtt_MakeGlyphBitmapSubpixel(&layout.face->info, bitmap.pixels.data(), bitmap.width, bitmap.height,
+                                          bitmap.width, scale_x, scale_y, fx, fy, layout.glyph);
+        if (layout.bold > 0 && !bitmap.pixels.empty()) embolden(bitmap, layout.bold * factor);
+        found = s.scaled.emplace(key, std::move(bitmap)).first;
+    }
+    GlyphBitmap placed = found->second;
+    placed.x += static_cast<int>(whole_x);
+    placed.y += static_cast<int>(whole_y);
+    return placed;
+}
+
 static void (*reload_hook)() = nullptr;
 
 void reload() {
     State &s = state();
     s.layouts.clear();
     s.bitmaps.clear();
+    s.scaled.clear();
     load(s);
     ++s.generation;
     if (reload_hook != nullptr) reload_hook();
