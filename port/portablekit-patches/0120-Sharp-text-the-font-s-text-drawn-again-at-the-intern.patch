+#pragma once
+
+#include <cstdint>
+#include <vector>
+
+namespace psprecomp {
+class GuestMemory;
+}
+
+// Sharp text: the game's text drawn again at the renderer's resolution.
+//
+// sceFontGetCharGlyphImage hands the host a buffer in guest memory and a
+// position, and the host draws one glyph into it at the PSP's size. A game may
+// then draw that buffer as a texture, as Dissidia 012 does with each block of
+// text: at a higher internal resolution the small glyphs are only enlarged.
+// So the host keeps every glyph it draws into a buffer (character and
+// position), and a copy of the buffer as its glyphs left it. When the renderer
+// loads a texture lying in such a buffer, and the buffer holds exactly what
+// the host drew, the same glyphs are drawn again at the renderer's scale; if
+// anything else wrote to the buffer, or the font changed since, the game's
+// own texture is drawn.
+//
+// Glyph buffers are recognised by use alone: a game that copies its glyphs on
+// into an atlas never draws the buffer, and is drawn as before.
+namespace portablekit::fonts {
+
+// The buffer of a SceFontGlyphImage.
+struct GlyphTarget {
+    std::uint32_t address{};
+    std::uint32_t width{};           // pixels
+    std::uint32_t height{};
+    std::uint32_t bytes_per_line{};
+    std::uint32_t pixel_format{};    // SceFontGlyphImage's: 0 4-bit, 2 8-bit; others are not kept
+};
+
+// A rectangle of the buffer the glyph may be drawn into (the _Clip call).
+struct GlyphClip {
+    std::int32_t x{};
+    std::int32_t y{};
+    std::int32_t width{0x7FFFFFFF};
+    std::int32_t height{0x7FFFFFFF};
+};
+
+// <prefix>_NO_SHARP_TEXT=1 turns it off whatever the setting says.
+[[nodiscard]] bool sharp_text_available();
+
+// Around each glyph the host draws: before, so a buffer the game cleared or
+// wrote itself is noticed, and after, with the glyph drawn.
+void before_glyph(const psprecomp::GuestMemory &memory, const GlyphTarget &target);
+void after_glyph(const psprecomp::GuestMemory &memory, const GlyphTarget &target, std::uint32_t code,
+                 std::int32_t x64, std::int32_t y64, const GlyphClip &clip);
+
+// A texture as the renderer samples it: where its texels start, its row
+// stride in texels, its size and bits per texel (4 or 8, CLUT indices).
+struct SharpTextQuery {
+    std::uint32_t address{};
+    std::uint32_t stride{};
+    std::uint32_t width{};
+    std::uint32_t height{};
+    std::uint32_t bits{};
+    int factor{};  // how many times larger to draw it, 2 to 16
+};
+
+// The part of the texture inside a glyph buffer, drawn `factor` times as
+// large: coverage 0..255 per pixel (for a 4-bit buffer the 1x texel is
+// coverage >> 4), covered_width * factor pixels per row. The texture's texels
+// outside that part (right of the buffer, below it) are not glyphs.
+struct SharpText {
+    std::vector<std::uint8_t> coverage;
+    std::uint32_t covered_width{};
+    std::uint32_t covered_height{};
+};
+
+// True and fills `out` when the texture lies in a glyph buffer that holds
+// only the glyphs the host drew into it.
+bool sharp_text(const psprecomp::GuestMemory &memory, const SharpTextQuery &query, SharpText &out);
+
+} // namespace portablekit::fonts
