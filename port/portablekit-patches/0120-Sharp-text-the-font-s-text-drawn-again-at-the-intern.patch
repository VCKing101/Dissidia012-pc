 [[nodiscard]] GlyphMetrics metrics(std::uint32_t code);
 // Renders `code` shifted right by shift_x and down by shift_y, both in [0, 1).
 [[nodiscard]] GlyphBitmap render(std::uint32_t code, float shift_x, float shift_y);
+// The glyph the game asked to be drawn at (x64, y64) in its buffer (26.6
+// fixed point, as sceFontGetCharGlyphImage gives the position), drawn
+// `factor` times as large for a buffer `factor` times the size: the same
+// outline, position and emboldening as the 1x glyph, so each pixel of that one
+// covers factor x factor pixels of this one. `x` and `y` are where its
+// top-left pixel goes in the larger buffer.
+[[nodiscard]] GlyphBitmap render_scaled(std::uint32_t code, std::int32_t x64, std::int32_t y64, int factor);
 
 // Rereads the font settings and clears every cached glyph, so the next glyph
 // the game asks for comes from the new font, then runs the hook.
diff --git a/host/fonts/sharp_text.cpp b/host/fonts/sharp_text.cpp
new file mode 100644
index 0000000..4e99dcd
--- /dev/null
+++ b/host/fonts/sharp_text.cpp
@@ -0,0 +1,255 @@
+#include "fonts/sharp_text.hpp"
+
+#include "fonts/game_font.hpp"
+#include "profile.hpp"
+
+#include "psprecomp/guest_memory.hpp"
+
+#include <algorithm>
+#include <cstdarg>
+#include <cstdio>
+#include <cstring>
+#include <iostream>
+#include <map>
+#include <mutex>
+#include <string>
+
+namespace portablekit::fonts {
+namespace {
+
+constexpr std::uint32_t kFormat4 = 0u;  // SceFontGlyphImage pixel formats kept: 4-bit, low nibble first
+constexpr std::uint32_t kFormat8 = 2u;  // and 8-bit
+constexpr std::size_t kMaxBufferBytes = 1u << 20u;
+constexpr std::size_t kMaxBuffers = 512u;
+
+// <prefix>_TRACE_SHARP_TEXT=1: each texture looked up, and why one is not drawn sharp.
+bool tracing() {
+    static const bool enabled = portablekit::env("TRACE_SHARP_TEXT") != nullptr;
+    return enabled;
+}
+
+#if defined(__GNUC__)
+__attribute__((format(printf, 1, 2)))
+#endif
+void trace(const char *format, ...) {
+    if (!tracing()) return;
+    char line[256];
+    va_list args;
+    va_start(args, format);
+    std::vsnprintf(line, sizeof(line), format, args);
+    va_end(args);
+    std::cerr << "[sharp-text] " << line << "\n";
+}
+
+struct Stamp {
+    std::uint32_t code{};
+    std::int32_t x64{};
+    std::int32_t y64{};
+    GlyphClip clip;
+};
+
+// One glyph buffer: what the host drew into it and what it held afterwards.
+struct Buffer {
+    GlyphTarget target;
+    std::vector<std::uint8_t> expected;  // the buffer as the last glyph left it
+    std::vector<Stamp> stamps;           // the glyphs drawn since it was last clear
+    bool foreign{};                      // it held something else when glyphs were drawn: never sharp
+    std::uint64_t generation{};          // the font's, when its first glyph was drawn
+    std::uint64_t last_used{};
+};
+
+struct Registry {
+    std::mutex mutex;
+    std::map<std::uint32_t, Buffer> buffers;  // by address
+    std::uint64_t clock{};
+};
+
+Registry &registry() {
+    static Registry value;
+    return value;
+}
+
+std::size_t buffer_bytes(const GlyphTarget &t) {
+    return static_cast<std::size_t>(t.bytes_per_line) * t.height;
+}
+
+bool kept(const GlyphTarget &t) {
+    if (t.address == 0u || t.width == 0u || t.height == 0u) return false;
+    if (t.pixel_format == kFormat4) {
+        if (t.bytes_per_line * 2u < t.width) return false;
+    } else if (t.pixel_format == kFormat8) {
+        if (t.bytes_per_line < t.width) return false;
+    } else {
+        return false;
+    }
+    return buffer_bytes(t) <= kMaxBufferBytes;
+}
+
+bool same_shape(const GlyphTarget &a, const GlyphTarget &b) {
+    return a.width == b.width && a.height == b.height && a.bytes_per_line == b.bytes_per_line &&
+           a.pixel_format == b.pixel_format;
+}
+
+bool all_zero(const std::uint8_t *bytes, std::size_t size) {
+    for (std::size_t i = 0; i < size; ++i)
+        if (bytes[i] != 0u) return false;
+    return true;
+}
+
+// Forgets buffers that overlap [address, address + size) other than the one at `address`.
+void drop_overlapping(Registry &r, std::uint32_t address, std::size_t size) {
+    const std::uint64_t end = static_cast<std::uint64_t>(address) + size;
+    auto it = r.buffers.lower_bound(address);
+    if (it != r.buffers.begin()) {
+        auto before = std::prev(it);
+        if (static_cast<std::uint64_t>(before->first) + buffer_bytes(before->second.target) > address)
+            r.buffers.erase(before);
+    }
+    while (it != r.buffers.end() && it->first < end) {
+        if (it->first == address) {
+            ++it;
+            continue;
+        }
+        it = r.buffers.erase(it);
+    }
+}
+
+void evict(Registry &r) {
+    while (r.buffers.size() > kMaxBuffers) {
+        auto oldest = r.buffers.begin();
+        for (auto it = r.buffers.begin(); it != r.buffers.end(); ++it)
+            if (it->second.last_used < oldest->second.last_used) oldest = it;
+        r.buffers.erase(oldest);
+    }
+}
+
+} // namespace
+
+bool sharp_text_available() {
+    static const bool off = portablekit::env("NO_SHARP_TEXT") != nullptr;
+    return !off;
+}
+
+void before_glyph(const psprecomp::GuestMemory &memory, const GlyphTarget &target) {
+    if (!sharp_text_available() || !kept(target)) return;
+    const std::size_t size = buffer_bytes(target);
+    const std::uint8_t *bytes = memory.raw_pointer(target.address, size);
+    if (bytes == nullptr) return;
+    Registry &r = registry();
+    const std::lock_guard lock(r.mutex);
+    drop_overlapping(r, target.address, size);
+    auto [it, fresh] = r.buffers.try_emplace(target.address);
+    Buffer &b = it->second;
+    const std::uint64_t now = generation();
+    const bool unchanged = !fresh && same_shape(b.target, target) && b.generation == now && b.expected.size() == size &&
+                           std::memcmp(b.expected.data(), bytes, size) == 0;
+    if (!unchanged) {
+        // A clear buffer starts a new text. Anything else was written by the
+        // game itself (or drawn with another font), so the glyphs alone are not
+        // the whole picture: that text keeps the game's own texture.
+        b.target = target;
+        b.stamps.clear();
+        b.expected.clear();
+        b.foreign = !all_zero(bytes, size);
+        b.generation = now;
+    }
+    b.last_used = ++r.clock;
+    evict(r);
+}
+
+void after_glyph(const psprecomp::GuestMemory &memory, const GlyphTarget &target, std::uint32_t code,
+                 std::int32_t x64, std::int32_t y64, const GlyphClip &clip) {
+    if (!sharp_text_available() || !kept(target)) return;
+    const std::size_t size = buffer_bytes(target);
+    const std::uint8_t *bytes = memory.raw_pointer(target.address, size);
+    if (bytes == nullptr) return;
+    Registry &r = registry();
+    const std::lock_guard lock(r.mutex);
+    const auto it = r.buffers.find(target.address);
+    if (it == r.buffers.end() || !same_shape(it->second.target, target)) return;
+    Buffer &b = it->second;
+    if (!b.foreign) b.stamps.push_back({code, x64, y64, clip});
+    b.expected.assign(bytes, bytes + size);
+}
+
+bool sharp_text(const psprecomp::GuestMemory &memory, const SharpTextQuery &query, SharpText &out) {
+    if (!sharp_text_available() || query.factor < 2 || query.factor > 16) return false;
+    if (query.bits != 4u && query.bits != 8u) return false;
+    if (query.width == 0u || query.height == 0u) return false;
+    Registry &r = registry();
+    const std::lock_guard lock(r.mutex);
+    auto it = r.buffers.upper_bound(query.address);
+    if (it == r.buffers.begin()) return false;
+    --it;
+    const std::uint32_t base = it->first;
+    Buffer &b = it->second;
+    const GlyphTarget &t = b.target;
+    const std::size_t size = buffer_bytes(t);
+    if (static_cast<std::uint64_t>(query.address) >= static_cast<std::uint64_t>(base) + size) return false;
+    const std::uint32_t bits = t.pixel_format == kFormat4 ? 4u : 8u;
+    if (bits != query.bits || static_cast<std::uint64_t>(query.stride) * bits / 8u != t.bytes_per_line) {
+        trace("%08X: texture %ux%u stride %u at %u bits is not laid out like glyph buffer %08X (%u bytes a line)",
+              query.address, query.width, query.height, query.stride, query.bits, base, t.bytes_per_line);
+        return false;
+    }
+    if (b.foreign || b.stamps.empty()) {
+        trace("%08X: buffer %08X %s", query.address, base, b.foreign ? "holds more than glyphs" : "has no glyphs");
+        return false;
+    }
+    if (b.generation != generation()) {
+        trace("%08X: buffer %08X was drawn with another font", query.address, base);
+        return false;
+    }
+    const std::uint8_t *bytes = memory.raw_pointer(base, size);
+    if (bytes == nullptr || b.expected.size() != size || std::memcmp(bytes, b.expected.data(), size) != 0) {
+        trace("%08X: buffer %08X was changed after its glyphs were drawn", query.address, base);
+        return false;
+    }
+    const std::uint32_t offset = query.address - base;
+    const std::uint32_t row0 = offset / t.bytes_per_line;
+    const std::uint32_t column0 = (offset % t.bytes_per_line) * 8u / bits;
+    if (column0 >= t.width || row0 >= t.height) return false;
+    const std::uint32_t covered_width = std::min(query.width, t.width - column0);
+    const std::uint32_t covered_height = std::min(query.height, t.height - row0);
+    const auto f = static_cast<std::int64_t>(query.factor);
+    const std::int64_t out_width = covered_width * f;
+    const std::int64_t out_height = covered_height * f;
+    out.covered_width = covered_width;
+    out.covered_height = covered_height;
+    out.coverage.assign(static_cast<std::size_t>(out_width * out_height), 0u);
+    // The covered part, in pixels of the larger buffer.
+    const std::int64_t left = column0 * f;
+    const std::int64_t top = row0 * f;
+    std::size_t drawn = 0;
+    for (const Stamp &stamp : b.stamps) {
+        const GlyphBitmap glyph = render_scaled(stamp.code, stamp.x64, stamp.y64, query.factor);
+        if (glyph.pixels.empty()) continue;
+        // Inside the buffer, the clip rectangle and the covered part.
+        const std::int64_t clip_x0 = std::max<std::int64_t>({0, static_cast<std::int64_t>(stamp.clip.x) * f, left});
+        const std::int64_t clip_y0 = std::max<std::int64_t>({0, static_cast<std::int64_t>(stamp.clip.y) * f, top});
+        const std::int64_t clip_x1 = std::min<std::int64_t>(
+            {static_cast<std::int64_t>(t.width) * f,
+             (static_cast<std::int64_t>(stamp.clip.x) + stamp.clip.width) * f, left + out_width});
+        const std::int64_t clip_y1 = std::min<std::int64_t>(
+            {static_cast<std::int64_t>(t.height) * f,
+             (static_cast<std::int64_t>(stamp.clip.y) + stamp.clip.height) * f, top + out_height});
+        const std::int64_t x_begin = std::max<std::int64_t>(glyph.x, clip_x0);
+        const std::int64_t x_end = std::min<std::int64_t>(static_cast<std::int64_t>(glyph.x) + glyph.width, clip_x1);
+        const std::int64_t y_begin = std::max<std::int64_t>(glyph.y, clip_y0);
+        const std::int64_t y_end = std::min<std::int64_t>(static_cast<std::int64_t>(glyph.y) + glyph.height, clip_y1);
+        if (x_begin >= x_end || y_begin >= y_end) continue;
+        ++drawn;
+        const std::int64_t count = x_end - x_begin;
+        for (std::int64_t y = y_begin; y < y_end; ++y) {
+            const std::uint8_t *in = glyph.pixels.data() + (y - glyph.y) * glyph.width + (x_begin - glyph.x);
+            std::uint8_t *row = out.coverage.data() + (y - top) * out_width + (x_begin - left);
+            for (std::int64_t i = 0; i < count; ++i) row[i] = std::max(row[i], in[i]);
+        }
+    }
