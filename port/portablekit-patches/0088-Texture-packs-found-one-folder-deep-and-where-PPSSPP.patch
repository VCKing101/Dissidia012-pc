diff --git a/tests/texture_pack_tests.cpp b/tests/texture_pack_tests.cpp
index bff62c0..b140bca 100644
--- a/tests/texture_pack_tests.cpp
+++ b/tests/texture_pack_tests.cpp
@@ -273,6 +273,34 @@ void test_location(const fs::path &root) {
     l = texture_pack_location(textures, kGame, "/somewhere/pack");
     check(l.source == TexturePackLocation::Source::InPlace && l.folder == fs::path("/somewhere/pack"),
           "a pack used in place is read from its folder");
+
+    // Packs put in by hand where the player expected them.
+    const fs::path places = root / "places";
+    const fs::path ms0 = places / "ms0";
+    const fs::path ppsspp = ms0 / "PSP" / "TEXTURES" / kGame;
