+// A band of the port's own over the last game frame while the game cannot go
+// on, such as a network game waiting for the other player. The game stands
+// still meanwhile, as behind the paused menu: no input reaches it, its sound
+// stops and the stall watchdog is not told.
+struct WaitView {
+    std::string text;      // UTF-8; '\n' breaks lines
+    bool can_leave{true};  // holding back for a second leaves; a hint says so
+    bool ok{};             // an OK under the text; confirm ends the screen
+};
+
+enum class WaitEnd { Done, Left, Confirmed, WindowClosed };
+
+// Called on the game's thread. `step` runs once an interface frame (about 60
+// times a second; it should return quickly), fills `view` and keeps the
+// screen while it returns true. Without an interface `step` still runs, with
+// nothing drawn and no way to leave, and a view with an OK ends at once.
+WaitEnd wait_over_game(const std::function<bool(WaitView &)> &step);
+
 } // namespace portablekit::ui
