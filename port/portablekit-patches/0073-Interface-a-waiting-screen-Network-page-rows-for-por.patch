+// A frame of wait_over_game()'s band: the text, an OK when asked for, and the
+// hint. `held` is how long back has been held, 0 to 1.
+void wait_frame(const WaitView &view, float held, bool &confirmed) {
+    const ImGuiIO &io = ImGui::GetIO();
+    ImGui::GetBackgroundDrawList()->AddRectFilled({0, 0}, io.DisplaySize, band::kDim);
+    ImGui::SetNextWindowPos({0, 0}, ImGuiCond_Always);
+    ImGui::SetNextWindowSize(io.DisplaySize, ImGuiCond_Always);
+    ImGui::Begin("##wait", nullptr,
+                 ImGuiWindowFlags_NoDecoration | ImGuiWindowFlags_NoMove | ImGuiWindowFlags_NoSavedSettings |
+                     ImGuiWindowFlags_NoNav | ImGuiWindowFlags_NoScrollWithMouse | ImGuiWindowFlags_NoBackground);
+    ImDrawList *draw = ImGui::GetWindowDrawList();
+
+    ImGui::PushFont(nullptr, ImGui::GetStyle().FontSizeBase * 1.1f);
+    const float width = std::min(io.DisplaySize.x * 0.8f, font() * 36.0f);
+    const std::vector<std::string> lines = wrap(view.text, width);
+    const float line_height = ImGui::GetTextLineHeightWithSpacing();
+    const float text_height = line_height * static_cast<float>(lines.size());
+    ImGui::PopFont();
+    const ImVec2 choice_size{std::round(font() * 5.5f), std::round(font() * 1.7f)};
+    const float gap = std::round(font() * 1.1f);
+    const float hint_height = std::round(font() * 1.3f);
+    const float margin = std::round(font() * 1.2f);
+    const float block = text_height + (view.ok ? gap + choice_size.y : 0.0f) + gap * 0.6f + hint_height;
+    const float top = std::round((io.DisplaySize.y - block) * 0.5f);
+    const float band_top = top - margin;
+    const float band_bottom = top + block + margin * 0.6f;
+    draw_band(ImGui::GetBackgroundDrawList(), band_top, band_bottom);
+
+    ImGui::PushFont(nullptr, ImGui::GetStyle().FontSizeBase * 1.1f);
+    float y = top;
+    for (const std::string &line : lines) {
+        const ImVec2 size = ImGui::CalcTextSize(line.c_str());
+        draw->AddText({std::round((io.DisplaySize.x - size.x) * 0.5f), y}, band::kText, line.c_str());
+        y += line_height;
+    }
+    ImGui::PopFont();
+
+    if (view.ok) {
+        bool hovered = false;
+        const float left = std::round((io.DisplaySize.x - choice_size.x) * 0.5f);
+        if (choice("OK", {left, top + text_height + gap}, choice_size, true, hovered)) confirmed = true;
+    }
+
+    const float hints_y = band_bottom - margin * 0.6f - hint_height + std::round((hint_height - font()) * 0.5f);
+    const float right = std::min(io.DisplaySize.x - margin, (io.DisplaySize.x + width) * 0.5f + font() * 4.0f);
+    if (view.ok) {
+        ImGui::SetCursorScreenPos({right - hints_width({{Control::Confirm, "OK"}}), hints_y});
+        hints({{Control::Confirm, "OK"}}, kBandHints);
+    } else if (view.can_leave) {
+        ImGui::SetCursorScreenPos({right - hints_width({{Control::Back, "Hold to leave"}}), hints_y});
+        hints({{Control::Back, "Hold to leave"}}, kBandHints);
+        // How far the hold has come: a rule growing under the band.
+        if (held > 0.0f) {
+            const float full = width;
+            const float left = std::round((io.DisplaySize.x - full) * 0.5f);
+            draw->AddRectFilled({left, band_bottom - px(3.0f)}, {left + full * held, band_bottom}, band::kRule);
+        }
+    }
+    ImGui::End();
+}
