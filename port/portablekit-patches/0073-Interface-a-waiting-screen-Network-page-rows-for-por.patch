+bool shared_address(const std::string &address) {
+    in_addr parsed{};
+    if (inet_pton(AF_INET, address.c_str(), &parsed) != 1) return true;
+    const std::uint32_t a = ntohl(parsed.s_addr);
+    const auto in = [a](std::uint32_t base, int bits) { return (a >> (32 - bits)) == (base >> (32 - bits)); };
+    return a == 0u || in(0x0A000000u, 8) || in(0xAC100000u, 12) || in(0xC0A80000u, 16) || in(0x64400000u, 10) ||
+           in(0xA9FE0000u, 16);
+}
