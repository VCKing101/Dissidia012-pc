+WaitEnd wait_over_game(const std::function<bool(WaitView &)> &step) {
+    WaitView view;
+    Layer &layer = Layer::get();
+    if (!layer.attached()) {
+        while (step(view) && !view.ok) std::this_thread::sleep_for(std::chrono::milliseconds(16));
+        return WaitEnd::Done;
+    }
+    stall_watchdog::note_menu(true);
+    audio::AudioSink::instance().set_paused(true);
+    layer.renderer().set_game_input(false);
+    layer.set_interactive(true);
+    WaitEnd end = WaitEnd::Done;
+    using Clock = std::chrono::steady_clock;
+    std::optional<Clock::time_point> held_since;
+    const bool window_open = layer.run(
+        [&] {
+            if (!step(view)) {
+                end = WaitEnd::Done;
+                return false;
+            }
+            (void)layer.take_menu_toggle();
+            (void)layer.take_back();
+            const bool south = layer.confirm_south();
+            const ImGuiKey confirm = south ? ImGuiKey_GamepadFaceDown : ImGuiKey_GamepadFaceRight;
+            const ImGuiKey back = south ? ImGuiKey_GamepadFaceRight : ImGuiKey_GamepadFaceDown;
+            bool confirmed = false;
+            float held = 0.0f;
+            if (view.ok) {
+                held_since.reset();
+                confirmed = ImGui::IsKeyPressed(ImGuiKey_Enter, false) ||
+                            ImGui::IsKeyPressed(ImGuiKey_KeypadEnter, false) ||
+                            (layer.gamepad_armed() && ImGui::IsKeyPressed(confirm, false));
+            } else if (view.can_leave &&
+                       (layer.escape_held() || (layer.gamepad_armed() && ImGui::IsKeyDown(back)))) {
+                if (!held_since) held_since = Clock::now();
+                held = std::min(1.0f, std::chrono::duration<float>(Clock::now() - *held_since).count());
+            } else {
+                held_since.reset();
+            }
+            wait_frame(view, held, confirmed);
+            if (confirmed) {
+                end = WaitEnd::Confirmed;
+                return false;
+            }
+            if (held >= 1.0f) {
+                end = WaitEnd::Left;
+                return false;
+            }
+            return true;
+        },
+        true);
+    layer.set_interactive(false);
+    layer.renderer().set_game_input(true);
+    audio::AudioSink::instance().set_paused(false);
+    stall_watchdog::note_menu(false);
+    // Go on at normal speed rather than racing to make up the wait.
+    kernel().resync_real_time();
+    perf::restart_measurement();
+    return window_open ? end : WaitEnd::WindowClosed;
+}
