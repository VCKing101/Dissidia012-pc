+}
+
+bool usable(const SaveSlot &slot, SaveAction action) { return action == SaveAction::Save || slot.exists; }
+
+const char *action_title(SaveAction action) {
+    switch (action) {
+    case SaveAction::Load: return "Load";
+    case SaveAction::Save: return "Save";
+    case SaveAction::Delete: return "Delete";
+    }
+    return "";
+}
+
+// The question about a slot, and whether it opens on No.
+std::pair<std::string, bool> question(const SaveSlot &slot, SaveAction action) {
+    std::string what = slot.exists ? (slot.title.empty() ? slot.name : slot.title) : "New data";
+    if (slot.exists && !slot.modified.empty()) what += "\n" + slot.modified;
+    switch (action) {
+    case SaveAction::Load: return {"Load this data?\n\n" + what, false};
+    case SaveAction::Save:
+        if (slot.exists) return {"Overwrite this data?\n\n" + what, true};
+        return {"Save the data?\n\n" + what, false};
+    case SaveAction::Delete: return {"Delete this data?\n\n" + what, true};
+    }
+    return {what, true};
+}
+
+void ask(std::size_t index) {
+    Dialog &d = dialog();
+    d.selected = index;
+    d.asking = true;
+    const auto [text, default_no] = question(d.request.slots[index], d.request.action);
+    MessageRequest request;
+    request.text = text;
+    request.question = true;
+    request.default_no = default_no;
+    open_game_message(std::move(request), [index](MessageAnswer answer) {
+        Dialog &state = dialog();
+        if (!state.open) return;
+        state.asking = false;
+        if (answer == MessageAnswer::Yes) {
+            finish(index);
+            return;
+        }
+        // No or back: a single request ends there, a list goes back to it.
+        if (state.request.single) {
+            finish(std::nullopt);
+            return;
+        }
+        take_game();
+        state.focus_pending = true;
+    });
+}
+
+} // namespace
+
+bool open_game_save_list(SaveListRequest request, SaveListDone on_done) {
+    Layer &layer = Layer::get();
+    if (!layer.attached()) return false;
+    if (dialog().open) close_game_save_list();
+    Dialog &d = dialog();
+    d = Dialog{};
+    d.open = true;
+    d.request = std::move(request);
+    d.on_done = std::move(on_done);
+    d.selected = d.request.focus < d.request.slots.size() ? d.request.focus : 0u;
+    // Start on a slot the action can use.
+    if (!d.request.slots.empty() && !usable(d.request.slots[d.selected], d.request.action)) {
+        for (std::size_t i = 0; i < d.request.slots.size(); ++i)
+            if (usable(d.request.slots[i], d.request.action)) {
+                d.selected = i;
+                break;
+            }
+    }
+    d.focus_pending = true;
+    take_game();
+    if (d.request.single && !d.request.slots.empty()) ask(0u);
+    return true;
+}
+
+bool game_save_list_open() { return dialog().open; }
+
+void close_game_save_list() {
+    Dialog &d = dialog();
+    if (!d.open) return;
+    d.open = false;
+    d.on_done = nullptr;
+    if (d.asking && game_message_open()) close_game_message();
+    d.asking = false;
+    release_game();
+}
+
+void game_save_list_frame() {
+    Dialog &d = dialog();
+    if (!d.open || d.asking) return;
+    Layer &layer = Layer::get();
+    (void)layer.take_menu_toggle();
+
+    bool any = false;
+    for (const SaveSlot &slot : d.request.slots) any = any || usable(slot, d.request.action);
+    if (!any) {
+        // Nothing to load or delete: say so, then back out.
+        d.asking = true;
+        MessageRequest request;
+        request.text = "There is no saved data.";
+        open_game_message(std::move(request), [](MessageAnswer) { finish(std::nullopt); });
+        return;
+    }
+
+    const bool back = layer.take_back();
+    const ImGuiKey cancel = layer.confirm_south() ? ImGuiKey_GamepadFaceRight : ImGuiKey_GamepadFaceDown;
+    if (back || (layer.gamepad_armed() && ImGui::IsKeyPressed(cancel, false))) {
+        finish(std::nullopt);
+        return;
+    }
+
+    begin_panel("##savelist", action_title(d.request.action), "Save data", true);
+    begin_content();
+    std::optional<std::size_t> chosen;
+    for (std::size_t i = 0; i < d.request.slots.size(); ++i) {
+        const SaveSlot &slot = d.request.slots[i];
+        if (!usable(slot, d.request.action)) continue;
+        if (d.focus_pending && i == d.selected) {
+            focus_next_row();
+            d.focus_pending = false;
+        }
+        const std::string id = "##slot" + std::to_string(i);
+        const std::string name = slot.exists ? (slot.title.empty() ? slot.name : slot.title) : "New data";
+        const std::string detail = slot.exists ? slot.modified : slot.name;
+        if (list_row(id.c_str(), name, detail, ListIcon::File, slot.exists)) chosen = i;
+        if (ImGui::IsItemFocused()) {
+            d.selected = i;
+            if (slot.exists && !slot.detail.empty()) layer.set_description(slot.detail);
+        }
+    }
+    begin_footer();
+    hints({{Control::Confirm, "Choose"}, {Control::Back, "Back"}});
+    end_panel();
+    if (chosen) ask(*chosen);
+}
+
+} // namespace portablekit::ui
