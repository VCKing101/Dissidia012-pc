+#pragma once
+
+#include <cstddef>
+#include <functional>
+#include <optional>
+#include <string>
+#include <vector>
+
+// The save-data dialog (sceUtilitySavedata list and confirmation modes),
+// drawn by the interface layer over the running game.
+//
+// A list request shows the game's save slots, each with the title and detail
+// of the save in it or "New data"; the player picks one, confirms it in a
+// Yes/No question (an overwrite or a delete opens on No), or backs out. A
+// single request (one named save) asks only the question. Loading and
+// deleting list only the slots that hold a save.
+//
+// The game keeps running behind it, as it does behind the PSP's dialog, but
+// reads a neutral pad until the dialog closes.
+namespace portablekit::ui {
+
+struct SaveSlot {
+    std::string name;      // the save name, e.g. "DATA01"
+    bool exists{};
+    std::string title;     // the save's own title and detail, when it exists
+    std::string detail;
+    std::string modified;  // when it was last written, already formatted
+};
+
+enum class SaveAction { Load, Save, Delete };
+
+struct SaveListRequest {
+    SaveAction action{SaveAction::Load};
+    std::vector<SaveSlot> slots;
+    std::size_t focus{};  // the slot selected first
+    bool single{};        // one slot: ask the question only
+};
+
+// Called once: the index of the slot the player confirmed, or nullopt after
+// backing out.
+using SaveListDone = std::function<void(std::optional<std::size_t>)>;
+
+// Opens the dialog over the running game. False when there is no interface
+// to draw it in.
+bool open_game_save_list(SaveListRequest request, SaveListDone on_done);
+[[nodiscard]] bool game_save_list_open();
+// Closes an open dialog without an answer.
+void close_game_save_list();
+// Builds this frame of the list and handles its input. Called inside an
+// interface frame by draw_over_game(); its questions are message dialogs.
+void game_save_list_frame();
+
+} // namespace portablekit::ui
