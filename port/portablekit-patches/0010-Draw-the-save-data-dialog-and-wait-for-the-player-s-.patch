+// The modes that ask the player on a PSP: the three list modes, where the
+// player picks a slot, and saving and deleting one named save, which ask
+// first. They are drawn by the interface (host/ui/save_list_dialog.hpp) and
+// stay VISIBLE until the player has answered; the work is done then.
+//
+//   <prefix>_SAVEDATA_ANSWERS=new,cancel,DATA01,first
+//       answers the next asking requests in order, without drawing them: a
+//       save name, "new" (the first listed slot with no save), "first" (the
+//       first listed slot with one) or "cancel". For tests and runs without a
+//       window.
+//   <prefix>_SAVEDATA_INSTANT=1
+//       no dialog, as before, but nothing is overwritten or deleted without a
+//       person: a list load takes the first save there is, a list save the
+//       first empty slot, a save goes ahead only if there is no save to
+//       replace, and the rest cancel.
+//
+// With no window and no scripted answer the request waits and says so once.
+// LOAD and the automatic and data modes never ask.
+enum class Asking { No, List, Single };
+
+Asking asking_mode(std::uint32_t mode) {
+    switch (mode) {
+    case kListLoad:
+    case kListSave:
+    case kListDelete: return Asking::List;
+    case kSave:
+    case kDelete: return Asking::Single;
+    default: return Asking::No;
+    }
+}
+
+#if defined(PORTABLEKIT_HAS_RENDERER)
+ui::SaveAction save_action(std::uint32_t mode) {
+    switch (mode) {
+    case kListSave:
+    case kSave: return ui::SaveAction::Save;
+    case kListDelete:
+    case kDelete: return ui::SaveAction::Delete;
+    default: return ui::SaveAction::Load;
+    }
+}
+#endif
+
+bool action_saves(std::uint32_t mode) { return mode == kListSave || mode == kSave; }
+
+bool savedata_instant() {
+    static const bool instant = [] {
+        const char *text = portablekit::env("SAVEDATA_INSTANT");
+        return text != nullptr && *text != '\0' && *text != '0';
+    }();
+    return instant;
+}
+
+std::vector<std::string> &savedata_answers() {
+    static std::vector<std::string> answers = [] {
+        std::vector<std::string> list;
+        const char *text = portablekit::env("SAVEDATA_ANSWERS");
+        if (text == nullptr) return list;
+        std::string item;
+        for (const char c : std::string(text) + ",") {
+            if (c != ',' && c != ';' && c != ' ') {
+                item.push_back(c);
+                continue;
+            }
+            if (!item.empty()) list.push_back(item);
+            item.clear();
+        }
+        std::reverse(list.begin(), list.end());
+        return list;
+    }();
+    return answers;
+}
+
+struct Slot {
+    std::string name;
+    bool exists{};
+    std::string title;
+    std::string detail;
+    std::string modified;
+};
+
+std::string format_time(std::filesystem::file_time_type written) {
+    const auto system_time = std::chrono::system_clock::now() +
+                             std::chrono::duration_cast<std::chrono::system_clock::duration>(
+                                 written - std::filesystem::file_time_type::clock::now());
+    const std::time_t time = std::chrono::system_clock::to_time_t(system_time);
+    std::tm tm{};
+#if defined(_WIN32)
+    localtime_s(&tm, &time);
+#else
+    localtime_r(&time, &tm);
+#endif
+    char text[32];
+    std::strftime(text, sizeof(text), "%Y-%m-%d %H:%M", &tm);
+    return text;
+}
+
+// The slots the request offers: the listed names for a list mode, else the
+// one save name; each with what its PARAM.SFO says when it holds a save.
+std::vector<Slot> request_slots(const psprecomp::GuestMemory &memory, std::uint32_t params, Asking asking) {
+    std::vector<std::string> names;
+    if (asking == Asking::List) names = save_name_list(memory, memory.load32(params + param::kSaveNameList));
+    if (names.empty()) names.push_back(save_name_at(memory, params + param::kSaveName));
+    std::vector<Slot> slots;
+    for (const std::string &name : names) {
+        Slot slot;
+        slot.name = name;
+        const auto files = files_for(memory, params, name);
+        slot.exists = savedata::save_exists(state().memory_stick, files);
+        if (slot.exists) {
+            const auto folder = savedata::save_folder(state().memory_stick, files);
+            std::error_code error;
+            slot.modified = format_time(std::filesystem::last_write_time(folder, error));
+            std::ifstream in(folder / "PARAM.SFO", std::ios::binary);
+            const std::vector<std::uint8_t> bytes((std::istreambuf_iterator<char>(in)), std::istreambuf_iterator<char>());
+            if (const auto sfo = savedata::ParamSfo::parse(bytes)) {
+                slot.title = sfo->string("SAVEDATA_TITLE").value_or("");
+                slot.detail = sfo->string("SAVEDATA_DETAIL").value_or("");
+            }
+        }
+        slots.push_back(std::move(slot));
+    }
+    return slots;
+}
+
+// The slot the request focuses first (the focus field), in list order.
+std::size_t focused_slot(const std::vector<Slot> &slots, std::uint32_t focus) {
+    // 1 first, 2 last, 3 latest, 4 oldest; anything else the first.
+    if (focus == 2u && !slots.empty()) return slots.size() - 1u;
+    if (focus == 3u || focus == 4u) {
+        std::optional<std::size_t> best;
+        for (std::size_t i = 0; i < slots.size(); ++i) {
+            if (!slots[i].exists) continue;
+            if (!best || (focus == 3u ? slots[i].modified >= slots[*best].modified
+                                      : slots[i].modified < slots[*best].modified))
+                best = i;
+        }
+        if (best) return *best;
+    }
+    return 0u;
+}
+
+std::optional<std::string> scripted_choice(const std::vector<Slot> &slots, const std::string &answer,
+                                           std::uint32_t mode) {
+    if (answer == "cancel") return std::nullopt;
+    for (const Slot &slot : slots) {
+        if (answer == "new" && !slot.exists) return slot.name;
+        if (answer == "first" && slot.exists) return slot.name;
+        if (answer == slot.name && (slot.exists || action_saves(mode))) return slot.name;
+    }
+    std::cerr << "[savedata] SAVEDATA_ANSWERS: \"" << answer << "\" names no slot this request can use; cancelling\n";
+    return std::nullopt;
+}
+
+std::optional<std::string> instant_choice(const std::vector<Slot> &slots, std::uint32_t mode) {
+    for (const Slot &slot : slots) {
+        if (mode == kListLoad && slot.exists) return slot.name;
+        if ((mode == kListSave || mode == kSave) && !slot.exists) return slot.name;
+    }
+    return std::nullopt;
+}
+
+struct AskingState {
+    bool active{};
+    std::uint32_t params{};
+    std::uint32_t mode{};
+    std::uint32_t status{dialog_status::kNone};
+    // Set once answered: the save name chosen, or nullopt for a cancel.
+    std::optional<std::optional<std::string>> choice;
+    unsigned serial{};
+};
+
+AskingState &asking_state() {
+    static AskingState value;
+    return value;
+}
+
+void set_choice(std::optional<std::string> choice, const char *by) {
+    AskingState &a = asking_state();
+    std::cerr << "[savedata] " << mode_name(a.mode) << " -> " << (choice ? "\"" + *choice + "\"" : "cancel") << " ("
+              << by << ")" << std::endl;
+    a.choice = std::move(choice);
+}
+
+// Starts an asking request: where the answer comes from.
+void start_asking(psprecomp::GuestMemory &memory, std::uint32_t params, std::uint32_t mode, Asking asking) {
+    AskingState &a = asking_state();
+    a = AskingState{true, params, mode, dialog_status::kInit, std::nullopt, a.serial + 1u};
+    const std::vector<Slot> slots = request_slots(memory, params, asking);
+    if (savedata_instant()) {
+        set_choice(instant_choice(slots, mode), "SAVEDATA_INSTANT");
+        return;
+    }
+    if (auto &script = savedata_answers(); !script.empty()) {
+        const std::string answer = script.back();
+        script.pop_back();
+        set_choice(scripted_choice(slots, answer, mode), "SAVEDATA_ANSWERS");
+        return;
+    }
+#if defined(PORTABLEKIT_HAS_RENDERER)
+    ui::SaveListRequest request;
+    request.action = save_action(mode);
+    request.single = asking == Asking::Single;
+    request.focus = focused_slot(slots, memory.load32(params + param::kFocus));
+    for (const Slot &slot : slots)
+        request.slots.push_back(ui::SaveSlot{slot.name, slot.exists, slot.title, slot.detail, slot.modified});
+    const unsigned serial = a.serial;
+    std::vector<std::string> names;
+    for (const Slot &slot : slots) names.push_back(slot.name);
+    if (ui::open_game_save_list(std::move(request), [serial, names](std::optional<std::size_t> index) {
+            if (asking_state().serial != serial || !asking_state().active) return;
+            set_choice(index ? std::optional<std::string>(names[*index]) : std::nullopt, "player");
+        }))
+        return;
+#endif
+    log_once("savedata-waiting",
+             "[savedata] no window to draw the save-data dialog in and no answer scripted; the game waits "
+             "(<prefix>_SAVEDATA_ANSWERS answers save-data dialogs in order)");
+}
+
+// The player's choice carried out, as the PSP does once the dialog closes.
+std::uint32_t finish_asking(psprecomp::GuestMemory &memory) {
+    const AskingState &a = asking_state();
+    const std::optional<std::string> &choice = *a.choice;
+    if (!choice) return result::kCancelled;
+    write_cstring(memory, a.params + param::kSaveName, *choice, 20u);
+    switch (a.mode) {
+    case kListLoad: return do_load(memory, a.params, *choice);
+    case kListSave:
+    case kSave: return do_save(memory, a.params, *choice);
+    default: return do_delete(memory, a.params, *choice);
+    }
+}
+
+std::uint32_t asking_poll(psprecomp::GuestMemory &memory) {
+    AskingState &a = asking_state();
+    const std::uint32_t reported = a.status;
+    switch (a.status) {
+    case dialog_status::kInit: a.status = dialog_status::kVisible; break;
+    case dialog_status::kVisible:
+        if (a.choice) {
+            const std::uint32_t outcome = finish_asking(memory);
+            memory.store32(a.params + dialog_common::kResultOffset, outcome);
+            if (outcome != result::kOk || trace_savedata())
+                std::cerr << "[savedata] result " << psprecomp::hex32(outcome) << "\n";
+            a.status = dialog_status::kQuit;
+        }
+        break;
+    case dialog_status::kFinished:
+        a.status = dialog_status::kNone;
+        a.active = false;
+        break;
+    default: break;
+    }
+    return reported;
+}
+
+void close_asking_ui() {
+#if defined(PORTABLEKIT_HAS_RENDERER)
+    if (ui::game_save_list_open()) ui::close_game_save_list();
+#endif
+}
