+void WheelPresses::add(float notches) {
+    if (notches == 0.0f) return;
+    // A turn the other way drops what is still waiting from the last one.
+    const int sign = notches > 0.0f ? 1 : -1;
+    if ((waiting_ != 0 && (waiting_ > 0) != (sign > 0)) || (partial_ != 0.0f && (partial_ > 0.0f) != (sign > 0))) {
+        waiting_ = 0;
+        partial_ = 0.0f;
+    }
+    partial_ += notches;
+    while (partial_ >= 1.0f) {
+        waiting_ = std::min(waiting_ + 1, limit_);
+        partial_ -= 1.0f;
+    }
+    while (partial_ <= -1.0f) {
+        waiting_ = std::max(waiting_ - 1, -limit_);
+        partial_ += 1.0f;
+    }
+}
+
+void WheelPresses::advance() {
+    if (phase_ > 0) {
+        if (--phase_ == 0) phase_ = -std::max(1, gap_);
+        return;
+    }
+    if (phase_ < 0 && ++phase_ != 0) return;
+    if (waiting_ == 0) return;
+    direction_ = waiting_ > 0 ? 1 : -1;
+    waiting_ -= direction_;
+    phase_ = std::max(1, hold_);
+}
+
+void WheelPresses::clear() {
+    partial_ = 0.0f;
+    waiting_ = 0;
+    direction_ = 0;
+    phase_ = 0;
+}
