+// One key for two buttons together, and the mouse wheel as presses.
+void test_combos_and_wheel() {
+    check(combo_index(Action::Combo1) == 0 && combo_index(Action::Combo8) == 7 && combo_index(Action::R3) == -1 &&
+              combo_action(2) == Action::Combo3,
+          "combo actions are numbered from Combo1");
+    check(default_bindings()[static_cast<std::size_t>(Action::Combo1)][0] == kNone,
+          "the framework binds no combo: the game names them");
+    Bindings b = default_bindings();
+    b[static_cast<std::size_t>(Action::Combo2)] = {from_name("C"), kNone};
+    PadInput pad = read(b, [&](Binding x) { return x == from_name("C"); });
+    check(pad.combos == 2u && pad.buttons == 0u, "a combo key is reported as its combo, its buttons are the game's");
+    assign(b, Action::Combo1, from_name("C"));
+    check(slots_of(b, Action::Combo1)[0] == from_name("C") && slots_of(b, Action::Combo2)[0] == kNone,
+          "a key moves from one combo to another like any control");
+
+    check(name(kWheelUp) == "Wheel Up" && from_name("wheel down") == kWheelDown && wheel_of(kWheelUp) == 1 &&
+              wheel_of(kWheelDown) == -1 && mouse_button_of(kWheelUp) == 0 && key_position(kWheelDown) == -1,
+          "the wheel's two ways are bindings of their own");
+    Slots slots{};
+    check(parse("Up / Wheel Up", slots) && slots[1] == kWheelUp && format(slots) == "Up / Wheel Up",
+          "the wheel round-trips through settings.ini");
+    b = default_bindings();
+    b[static_cast<std::size_t>(Action::Down)] = {from_name("Down"), kWheelDown};
+    pad = read(b, [&](Binding x) { return x == kWheelDown; });
+    check(pad.buttons == 0x0040u, "Wheel Down presses what it is bound to");
+
+    // Two notches at once: pressed two reads, released two, pressed again.
+    WheelPresses wheel;
+    wheel.add(2.0f);
+    std::vector<int> seen;
+    for (int i = 0; i < 9; ++i) {
+        wheel.advance();
+        seen.push_back(wheel.held());
+    }
+    check(seen == std::vector<int>({1, 1, 0, 0, 1, 1, 0, 0, 0}), "each notch is its own press, with a release between");
+    wheel.clear();
+    wheel.add(0.4f);
+    wheel.add(0.4f);
+    wheel.advance();
+    check(wheel.held() == 0, "less than a notch presses nothing");
+    wheel.add(0.4f);
+    wheel.advance();
+    check(wheel.held() == 1, "fractions add up to a notch");
+    wheel.clear();
+    wheel.add(10.0f);
+    check(wheel.waiting() == 4, "a fast spin waits for at most four presses");
+    wheel.advance();
+    wheel.add(-1.0f);
+    check(wheel.waiting() == -1 && wheel.held() == 1, "turning back drops what waits; the press under way finishes");
+    wheel.advance();
+    wheel.advance();
+    wheel.advance();
+    wheel.advance();
+    check(wheel.held() == -1, "then the other way is pressed");
+    Bindings defaults = default_bindings();
+    defaults[static_cast<std::size_t>(Action::Up)][1] = kWheelUp;
+    defaults[static_cast<std::size_t>(Action::Down)][1] = kWheelDown;
+    Bindings saved = default_bindings();
+    saved[static_cast<std::size_t>(Action::Down)] = {from_name("Down"), from_name("PageDown")};
+    add_default_wheel(saved, defaults);
+    check(slots_of(saved, Action::Up)[1] == kWheelUp && slots_of(saved, Action::Down)[1] == from_name("PageDown"),
+          "an older file gains the wheel where its control has room");
+    saved = default_bindings();
+    saved[static_cast<std::size_t>(Action::CameraUp)] = {from_name("I"), kWheelUp};
+    add_default_wheel(saved, defaults);
+    check(slots_of(saved, Action::Up)[1] == kNone && slots_of(saved, Action::Down)[1] == kWheelDown,
+          "a wheel already bound elsewhere stays there");
+    WheelPresses longer(3, 1);
+    longer.add(1.0f);
+    seen.clear();
+    for (int i = 0; i < 5; ++i) {
+        longer.advance();
+        seen.push_back(longer.held());
+    }
+    check(seen == std::vector<int>({1, 1, 1, 0, 0}), "hold and gap are counted in reads");
+}
