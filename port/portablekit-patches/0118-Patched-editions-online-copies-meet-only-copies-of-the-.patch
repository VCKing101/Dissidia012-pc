+Result prepare_image(const std::filesystem::path &image, const std::filesystem::path &base,
+                     const std::filesystem::path &out, Progress &progress) {
+    Result result;
+    try {
+        std::ifstream in(image, std::ios::binary);
+        if (!in) throw Failure{"the disc image cannot be read"};
+        const std::uint64_t size = std::filesystem::file_size(image);
+        progress.total = size;
+        Source source(base);
+        Sectors sectors(source);
+        std::vector<std::uint8_t> chunk(4u << 20u);
+        std::uint64_t made = 0u;
+        while (made < size) {
+            if (progress.cancel) throw Failure{"Cancelled"};
+            const std::size_t n = static_cast<std::size_t>(std::min<std::uint64_t>(chunk.size(), size - made));
+            in.read(reinterpret_cast<char *>(chunk.data()), static_cast<std::streamsize>(n));
+            if (static_cast<std::size_t>(in.gcount()) != n) throw Failure{"the disc image cannot be read"};
+            sectors.add(chunk.data(), n);
+            made += n;
+            progress.done = made;
         }
+        sectors.finish();
+        result.changed_sectors = sectors.sectors.size();
+        result.zero_sectors = sectors.zeros;
+        if (sectors.sectors.empty()) throw Failure{"it is the game's own disc: nothing on it differs"};
+        write_layer(out, base, install::path_to_utf8(image.filename()), size, source.size(), sectors);
         result.ok = true;
     } catch (const Failure &failure) {
         result.message = failure.what;
@@ -804,6 +848,32 @@ std::unique_ptr<Layer> Layer::open(const std::filesystem::path &path) {
 
 Layer::~Layer() = default;
 
+std::string Layer::identity() {
+    if (!identity_.empty()) return identity_;
+    psprecomp::Sha256 hash;
+    std::vector<std::uint8_t> bytes;
+    put64(bytes, size_);
+    hash.update(bytes);
+    std::vector<std::uint8_t> sector(kSector);
+    for (std::size_t i = 0; i < sectors_.size(); ++i) {
+        bytes.clear();
+        put32(bytes, sectors_[i]);
+        if (slots_[i] == kZero) {
+            std::fill(sector.begin(), sector.end(), std::uint8_t{0});
+        } else {
+            file_.clear();
+            file_.seekg(static_cast<std::streamoff>(data_offset_ + std::uint64_t{slots_[i]} * kSector));
+            file_.read(reinterpret_cast<char *>(sector.data()), kSector);
+            if (file_.gcount() != static_cast<std::streamsize>(kSector))
+                throw psprecomp::Error("A damaged prepared disc: its changes cannot be read");
+        }
+        hash.update(bytes);
+        hash.update(sector);
+    }
+    identity_ = hash.finish();
+    return identity_;
+}
+
 std::size_t Layer::read(std::ifstream &base, std::uint64_t offset, std::span<std::uint8_t> output) {
     if (offset >= size_) return 0u;
     const std::size_t count = static_cast<std::size_t>(std::min<std::uint64_t>(output.size(), size_ - offset));
