+// The tag of a copy playing a patched edition of the game (a mod's disc,
+// patched_edition.hpp): the port's own tag, "-m" and the first 12 digits of
+// the edition's identity, the port's tag shortened to leave room. A copy of
+// the release (no identity) keeps the port's tag as it is; a port without a
+// tag gets "m" and the digits.
+[[nodiscard]] inline std::string version_tag_with_edition(std::string_view tag, std::string_view identity) {
+    if (identity.empty()) return std::string(tag);
+    const std::string mark = "m" + std::string(identity.substr(0, 12));
+    if (tag.empty()) return mark;
+    return std::string(tag.substr(0, kVersionTagLength - mark.size() - 1u)) + "-" + mark;
+}
