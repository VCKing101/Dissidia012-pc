+// SHA-256 of data given a piece at a time; finish() gives the lower-case hex
+// digest, as sha256_bytes() does for the pieces joined.
+class Sha256 {
+public:
+    void update(std::span<const std::uint8_t> bytes);
+    [[nodiscard]] std::string finish();
+
+private:
+    std::array<std::uint32_t, 8> h_{0x6a09e667u, 0xbb67ae85u, 0x3c6ef372u, 0xa54ff53au,
+                                    0x510e527fu, 0x9b05688cu, 0x1f83d9abu, 0x5be0cd19u};
+    std::array<std::uint8_t, 64> block_{};
+    std::size_t used_ = 0u;
+    std::uint64_t length_ = 0u;
+};
+
 } // namespace psprecomp
diff --git a/src/sha256.cpp b/src/sha256.cpp
index 74fad87..afe2a99 100644
--- a/src/sha256.cpp
+++ b/src/sha256.cpp
@@ -1,6 +1,7 @@
 #include "psprecomp/sha256.hpp"
 #include "psprecomp/common.hpp"
 
+#include <algorithm>
 #include <array>
 #include <cstdint>
 #include <fstream>
@@ -37,6 +38,31 @@ std::string sha256_bytes(std::span<const std::uint8_t> bytes) {
     for(std::size_t i=0;i<data.size();i+=64u) transform(h,data.data()+i);
     std::ostringstream out; out<<std::hex<<std::setfill('0'); for(auto v:h) out<<std::setw(8)<<v; return out.str();
 }
+void Sha256::update(std::span<const std::uint8_t> bytes) {
+    length_ += bytes.size();
+    std::size_t at = 0u;
+    if (used_ != 0u) {
+        const std::size_t n = std::min(bytes.size(), block_.size() - used_);
+        std::copy_n(bytes.data(), n, block_.data() + used_);
+        used_ += n;
+        at = n;
+        if (used_ < block_.size()) return;
+        transform(h_, block_.data());
+        used_ = 0u;
+    }
+    for (; at + 64u <= bytes.size(); at += 64u) transform(h_, bytes.data() + at);
+    std::copy(bytes.begin() + static_cast<std::ptrdiff_t>(at), bytes.end(), block_.begin());
+    used_ = bytes.size() - at;
+}
+std::string Sha256::finish() {
+    const std::uint64_t bits = length_ * 8u;
+    std::array<std::uint8_t, 72> tail{};
+    tail[0] = 0x80u;
+    const std::size_t pad = (used_ < 56u ? 56u : 120u) - used_;
+    for (int i = 0; i < 8; ++i) tail[pad + static_cast<std::size_t>(i)] = static_cast<std::uint8_t>(bits >> ((7 - i) * 8));
+    update(std::span<const std::uint8_t>(tail.data(), pad + 8u));
+    std::ostringstream out; out<<std::hex<<std::setfill('0'); for(auto v:h_) out<<std::setw(8)<<v; return out.str();
+}
 std::string sha256_file(const std::filesystem::path &path) {
     std::ifstream in(path, std::ios::binary); if(!in) throw Error("Cannot open file for SHA-256: "+path.string());
     const std::vector<std::uint8_t> data((std::istreambuf_iterator<char>(in)), {});
diff --git a/tests/disc_patch_tests.cpp b/tests/disc_patch_tests.cpp
new file mode 100644
index 0000000..9e25f03
--- /dev/null
+++ b/tests/disc_patch_tests.cpp
@@ -0,0 +1,226 @@
+// Disc patches (host/disc_patch.hpp) on a made-up disc of a few sectors: a
+// VCDIFF patch and an already patched image prepared into layers, the layer
+// read back as the patched image, and the identity online play keeps modded
+// copies apart by. Also the streaming SHA-256 and the version tag of a modded
+// copy. No game data.
+
+#include "adhoc/protocol.hpp"
+#include "disc_patch.hpp"
+
+#include "psprecomp/sha256.hpp"
+
+#include <cstdio>
+#include <filesystem>
+#include <fstream>
+#include <random>
+#include <string>
+#include <vector>
+
+namespace {
+
+int g_failures = 0;
+
+void check(bool condition, const char *what) {
+    std::printf("%s %s\n", condition ? "ok  " : "FAIL", what);
+    if (!condition) ++g_failures;
+}
+
+constexpr std::size_t kSector = 2048u;
+
+using Bytes = std::vector<std::uint8_t>;
+
+void write_file(const std::filesystem::path &path, const Bytes &bytes) {
+    std::ofstream out(path, std::ios::binary | std::ios::trunc);
+    out.write(reinterpret_cast<const char *>(bytes.data()), static_cast<std::streamsize>(bytes.size()));
+}
+
+void fill_sector(Bytes &image, std::size_t sector, std::uint8_t value) {
+    std::fill(image.begin() + static_cast<std::ptrdiff_t>(sector * kSector),
+              image.begin() + static_cast<std::ptrdiff_t>((sector + 1u) * kSector), value);
+}
+
+// VCDIFF's variable-length integer: base 128, most significant group first.
+void vint(Bytes &out, std::uint64_t value) {
+    std::uint8_t groups[10];
+    int n = 0;
+    do {
+        groups[n++] = static_cast<std::uint8_t>(value & 0x7Fu);
+        value >>= 7u;
+    } while (value != 0u);
+    while (n-- > 0) out.push_back(static_cast<std::uint8_t>(groups[n] | (n != 0 ? 0x80u : 0u)));
+}
+
+std::uint32_t adler32(const Bytes &data) {
+    std::uint32_t a = 1u, b = 0u;
+    for (const std::uint8_t byte : data) {
+        a = (a + byte) % 65521u;
+        b = (b + a) % 65521u;
+    }
+    return (b << 16u) | a;
+}
+
+Bytes read_layer(const std::filesystem::path &layer_path, const std::filesystem::path &release) {
+    auto layer = portablekit::disc_patch::Layer::open(layer_path);
+    if (!layer) return {};
+    std::ifstream base(release, std::ios::binary);
+    Bytes image(static_cast<std::size_t>(layer->size()));
+    image.resize(layer->read(base, 0u, image));
+    return image;
+}
+
+} // namespace
+
+int main() {
+    namespace disc_patch = portablekit::disc_patch;
+
+    // The streaming SHA-256 gives what the one-call form gives.
+    {
+        const std::string abc = "abc";
+        psprecomp::Sha256 hash;
+        hash.update(std::span(reinterpret_cast<const std::uint8_t *>(abc.data()), abc.size()));
+        check(hash.finish() == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad",
+              "SHA-256 of \"abc\" is the standard's");
+        Bytes data(10'000u);
+        std::mt19937 random(7u);
+        for (std::uint8_t &byte : data) byte = static_cast<std::uint8_t>(random());
+        bool same = true;
+        for (const std::size_t piece : {1u, 55u, 56u, 63u, 64u, 65u, 1000u}) {
+            psprecomp::Sha256 pieces;
+            for (std::size_t at = 0; at < data.size(); at += piece)
+                pieces.update(std::span(data.data() + at, std::min(piece, data.size() - at)));
+            same = same && pieces.finish() == psprecomp::sha256_bytes(data);
+        }
+        check(same, "SHA-256 in pieces of 1 to 1000 bytes is SHA-256 of the whole");
+    }
+
+    const std::filesystem::path dir =
+        std::filesystem::temp_directory_path() / ("portablekit_disc_patch_tests_" + std::to_string(std::random_device{}()));
+    std::filesystem::create_directories(dir);
+
+    // A release of 16 sectors, and a mod's disc: sector 3 changed, sector 9
+    // emptied, a 17th sector added.
+    Bytes release(16u * kSector);
+    for (std::size_t i = 0; i < release.size(); ++i) release[i] = static_cast<std::uint8_t>(i * 7u / kSector + i + 1u);
+    Bytes modded = release;
+    modded.resize(17u * kSector);
+    fill_sector(modded, 3u, 0xABu);
+    fill_sector(modded, 9u, 0x00u);
+    fill_sector(modded, 16u, 0xCDu);
+    write_file(dir / "release.iso", release);
+    write_file(dir / "modded.iso", modded);
+
+    // The same disc as a patch: one window over the whole release, with a
+    // checksum, in the default code table (19: COPY with its size, mode 0;
+    // 0: RUN with its size; 1: ADD with its size).
+    {
+        Bytes data{0xABu, 0x00u}, inst, addr;
+        data.insert(data.end(), kSector, 0xCDu);
+        const auto copy = [&](std::uint64_t from, std::uint64_t size) {
+            inst.push_back(19u);
+            vint(inst, size);
+            vint(addr, from);
+        };
+        const auto run = [&](std::uint64_t size) {
+            inst.push_back(0u);
+            vint(inst, size);
+        };
+        copy(0u, 3u * kSector);
+        run(kSector);
+        copy(4u * kSector, 5u * kSector);
+        run(kSector);
+        copy(10u * kSector, 6u * kSector);
+        inst.push_back(1u);
+        vint(inst, kSector);
+
+        Bytes delta;
+        vint(delta, modded.size());
+        delta.push_back(0u);  // no section compressed
+        vint(delta, data.size());
+        vint(delta, inst.size());
+        vint(delta, addr.size());
+        const std::uint32_t sum = adler32(modded);
+        for (int shift = 24; shift >= 0; shift -= 8) delta.push_back(static_cast<std::uint8_t>(sum >> shift));
+        delta.insert(delta.end(), data.begin(), data.end());
+        delta.insert(delta.end(), inst.begin(), inst.end());
+        delta.insert(delta.end(), addr.begin(), addr.end());
+
+        Bytes patch{0xD6u, 0xC3u, 0xC4u, 0x00u, 0x00u};
+        patch.push_back(0x05u);  // a source segment, and a checksum
+        vint(patch, release.size());
+        vint(patch, 0u);
+        vint(patch, delta.size());
+        patch.insert(patch.end(), delta.begin(), delta.end());
+        write_file(dir / "mod.xdelta", patch);
+    }
+    check(disc_patch::is_patch_file(dir / "mod.xdelta") && !disc_patch::is_patch_file(dir / "modded.iso"),
+          "a patch is told from a disc image");
+
+    disc_patch::Progress progress;
+    const disc_patch::Result from_patch =
+        disc_patch::prepare(dir / "mod.xdelta", dir / "release.iso", dir / "from-patch.pkdisc", progress);
+    check(from_patch.ok && from_patch.windows == 1u && from_patch.mismatched == 0u && from_patch.changed_sectors == 3u &&
+              from_patch.zero_sectors == 1u,
+          "the patch prepares into a layer of its 3 changed sectors, 1 of them emptied");
+    disc_patch::Progress image_progress;
+    const disc_patch::Result from_image =
+        disc_patch::prepare_image(dir / "modded.iso", dir / "release.iso", dir / "from-image.pkdisc", image_progress);
+    check(from_image.ok && from_image.changed_sectors == 3u && from_image.zero_sectors == 1u &&
+              image_progress.done == modded.size(),
+          "the patched image prepares into a layer of the same sectors");
+
+    check(read_layer(dir / "from-patch.pkdisc", dir / "release.iso") == modded,
+          "the patch's layer reads as the patched image");
+    check(read_layer(dir / "from-image.pkdisc", dir / "release.iso") == modded,
+          "the image's layer reads as the patched image");
+
+    std::string patch_identity, image_identity;
+    if (auto layer = disc_patch::Layer::open(dir / "from-patch.pkdisc")) patch_identity = layer->identity();
+    if (auto layer = disc_patch::Layer::open(dir / "from-image.pkdisc")) image_identity = layer->identity();
+    check(patch_identity.size() == 64u && patch_identity == image_identity,
+          "both layers have the same identity, though their notes name different files");
+
+    std::filesystem::copy_file(dir / "from-patch.pkdisc", dir / "renamed.pkdisc");
+    if (auto layer = disc_patch::Layer::open(dir / "renamed.pkdisc"))
+        check(layer->identity() == patch_identity, "a renamed layer keeps its identity");
+
+    Bytes other = modded;
+    other[3u * kSector + 100u] = 0xACu;
+    write_file(dir / "other.iso", other);
+    disc_patch::Progress other_progress;
+    (void)disc_patch::prepare_image(dir / "other.iso", dir / "release.iso", dir / "other.pkdisc", other_progress);
+    std::string other_identity;
+    if (auto layer = disc_patch::Layer::open(dir / "other.pkdisc")) other_identity = layer->identity();
+    check(other_identity.size() == 64u && other_identity != patch_identity,
+          "a mod that differs by one byte has another identity");
+
+    disc_patch::Progress same_progress;
+    const disc_patch::Result same =
+        disc_patch::prepare_image(dir / "release.iso", dir / "release.iso", dir / "same.pkdisc", same_progress);
+    check(!same.ok && !std::filesystem::exists(dir / "same.pkdisc"), "the release itself prepares nothing");
+
+    disc_patch::Progress cancelled;
+    cancelled.cancel = true;
+    const disc_patch::Result stopped =
+        disc_patch::prepare_image(dir / "modded.iso", dir / "release.iso", dir / "stopped.pkdisc", cancelled);
+    check(!stopped.ok && stopped.message == "Cancelled" && !std::filesystem::exists(dir / "stopped.pkdisc"),
+          "a cancelled preparation keeps nothing");
+
+    // The version tag of a modded copy.
+    namespace ctl = portablekit::adhoc::ctl;
+    const std::string identity(64, 'a');
+    check(ctl::version_tag_with_edition("0123456789abcdef-std", "") == "0123456789abcdef-std",
+          "the release keeps the port's tag");
+    check(ctl::version_tag_with_edition("0123456789abcdef-std", identity) == "0123456789abcdef-std-maaaaaaaaaaaa",
+          "a mod's identity follows the port's tag");
+    check(ctl::version_tag_with_edition("", identity) == "maaaaaaaaaaaa", "a port without a tag gets the mod's");
+    const std::string longest(ctl::kVersionTagLength, 'x');
+    const std::string joined = ctl::version_tag_with_edition(longest, identity);
+    check(joined.size() == ctl::kVersionTagLength && ctl::version_tag_ok(joined) &&
+              joined.ends_with("-maaaaaaaaaaaa"),
+          "a long tag is shortened to leave the mod's room");
+
+    std::error_code ec;
+    std::filesystem::remove_all(dir, ec);
+    std::printf("%s\n", g_failures == 0 ? "all passed" : "FAILED");
+    return g_failures == 0 ? 0 : 1;
+}
