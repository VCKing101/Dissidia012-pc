+void draw_band(ImDrawList *draw, float top, float bottom) {
+    const float width = ImGui::GetIO().DisplaySize.x;
+    draw->AddRectFilledMultiColor({0.0f, top}, {width, bottom}, band::kTop, band::kTop, band::kBottom,
+                                  band::kBottom);
+    // A thin rule at each edge, with a fainter one just inside it.
+    const float line = std::max(1.0f, px(1.0f));
+    draw->AddRectFilled({0.0f, top}, {width, top + line}, band::kRule);
+    draw->AddRectFilled({0.0f, top + line}, {width, top + 3.0f * line}, band::kRuleGlow);
+    draw->AddRectFilled({0.0f, bottom - line}, {width, bottom}, band::kRule);
+    draw->AddRectFilled({0.0f, bottom - 3.0f * line}, {width, bottom - line}, band::kRuleGlow);
+}
+
+void draw_choice(ImDrawList *draw, ImVec2 min, ImVec2 max, bool selected) {
+    if (!selected) return;
+    const float rounding = (max.y - min.y) * 0.5f;
+    draw->AddRectFilled(min, max, band::kSelect, rounding);
+    draw->AddRect(min, max, band::kSelectEdge, rounding, 0, std::max(1.0f, px(1.0f)));
 }
 
