diff --git a/tests/input_tests.cpp b/tests/input_tests.cpp
index 7875ea0..f68357b 100644
--- a/tests/input_tests.cpp
+++ b/tests/input_tests.cpp
@@ -1,7 +1,12 @@
-// Keyboard and mouse bindings, without SDL or game data.
+// Keyboard and mouse bindings, and the stick's mapping to the PSP nub,
+// without SDL or game data.
 #include "input/bindings.hpp"
+#include "input/stick.hpp"
 
+#include <algorithm>
 #include <cmath>
+#include <cstdlib>
+#include <limits>
 #include <cstdint>
 #include <iostream>
 #include <array>
@@ -139,6 +144,84 @@ void test_mouse_turn() {
     check(std::fabs(t.yaw + 0.5f) < 1e-5f && std::fabs(t.pitch - 1.0f) < 1e-5f, "inversion and the aim's share apply");
 }
 
+// The stick at `degrees` (counterclockwise from right, up being negative Y as
+// on a gamepad) and `length`, as the nub's bytes.
+stick::Nub nub_at(float degrees, float length, bool square = true) {
+    const float r = degrees * 3.14159265f / 180.0f;
+    return stick::to_nub(length * std::cos(r), -length * std::sin(r), {0.15f, stick::kFullDeflection, square});
+}
+
+bool is(stick::Nub n, int x, int y) { return n.x == x && n.y == y; }
+
+void test_stick() {
+    check(stick::nub_offset(-1.0f) == -128 && stick::nub_offset(1.0f) == 127 && stick::nub_offset(0.0f) == 0,
+          "each end of an axis reaches the end of the byte: 0 and 255 about 0x80");
+    check(stick::nub_offset(-3.0f) == -128 && stick::nub_offset(3.0f) == 127 && stick::nub_offset(std::numeric_limits<float>::quiet_NaN()) == 0,
+          "out of range is clamped, NaN is the centre");
+    check(stick::nub_offset(0.5f) == 64 && stick::nub_offset(-0.5f) == -64, "rounded to the nearest step");
+
+    // Full tilt: every direction reaches the edge of the square, a diagonal
+    // its corner; the direction is kept.
+    check(is(nub_at(0.0f, 1.0f), 255, 128), "full right is 255");
+    check(is(nub_at(90.0f, 1.0f), 128, 0), "full up is 0");
+    check(is(nub_at(180.0f, 1.0f), 0, 128), "full left is 0, not 1");
+    check(is(nub_at(270.0f, 1.0f), 128, 255), "full down is 255");
+    check(is(nub_at(45.0f, 1.0f), 255, 0) && is(nub_at(135.0f, 1.0f), 0, 0) && is(nub_at(225.0f, 1.0f), 0, 255) &&
+              is(nub_at(315.0f, 1.0f), 255, 255),
+          "a full diagonal is the nub's corner");
+    // tan 22.5 = 0.4142: 53 steps from the centre on the short axis.
+    check(is(nub_at(22.5f, 1.0f), 255, 75), "22.5 degrees: the long axis full, the short one at tan 22.5");
+    check(is(nub_at(67.5f, 1.0f), 181, 0), "67.5 degrees: the same, the other way round");
+
+    // Without the square, the circle is passed on as it is (cos 45 = 0.7071).
+    check(is(nub_at(45.0f, 1.0f, false), 218, 37), "the switch off: a full diagonal is about 0.71 on each axis");
+    check(is(nub_at(0.0f, 1.0f, false), 255, 128), "and a straight push is unchanged");
+
+    // The dead zone is on the length, so a diagonal is never cut where a
+    // straight push of the same length is not.
+    check(is(nub_at(45.0f, 0.14f), 128, 128) && is(nub_at(0.0f, 0.14f), 128, 128), "inside the dead zone: the centre");
+    const stick::Nub small = nub_at(45.0f, 0.2f);
+    check(small.x > 128 && small.y < 128 && small.x - 128 == 128 - small.y,
+          "just past the dead zone a diagonal moves both axes equally (a per-axis dead zone would cut both)");
+    // Half tilt: (0.5 - 0.15) / (0.95 - 0.15) = 0.4375 of the way, on each axis
+    // at a diagonal once squared.
+    check(is(nub_at(45.0f, 0.5f), 184, 72) && is(nub_at(0.0f, 0.5f), 184, 128), "half tilt: the same reach any way");
+    check(is(nub_at(0.0f, 0.96f), 255, 128) && is(nub_at(45.0f, 0.96f), 255, 0),
+          "a stick stopping a little short of its edge still reaches full");
+    check(is(nub_at(45.0f, 1.3f), 255, 0), "beyond the circle (a squarish gate) stays at the corner");
+
+    // Over every angle and length: the square keeps the direction, makes the
+    // longer axis the length, and never moves backwards as the push grows.
+    bool direction = true;
+    bool longer_is_length = true;
+    bool monotonic = true;
+    for (int degrees = 0; degrees < 360; degrees += 3) {
+        const float r = static_cast<float>(degrees) * 3.14159265f / 180.0f;
+        int last_reach = 0;
+        for (int step = 0; step <= 20; ++step) {
+            const float length = static_cast<float>(step) / 20.0f;
+            const stick::Vector v = stick::deflection(length * std::cos(r), length * std::sin(r), 0.15f);
+            const stick::Vector q = stick::to_square(v);
+            const float v_length = std::hypot(v.x, v.y);
+            if (v_length > 1e-3f) {
+                direction = direction && std::fabs(std::atan2(q.y, q.x) - std::atan2(v.y, v.x)) < 1e-4f;
+                longer_is_length =
+                    longer_is_length && std::fabs(std::max(std::fabs(q.x), std::fabs(q.y)) - v_length) < 1e-4f;
+            }
+            const stick::Nub n = nub_at(static_cast<float>(degrees), length);
+            const int reach = std::max(std::abs(n.x - 128), std::abs(n.y - 128));
+            monotonic = monotonic && reach >= last_reach;
+            last_reach = reach;
+        }
+    }
+    check(direction, "the square keeps the stick's direction");
+    check(longer_is_length, "the square's longer axis is the stick's length");
+    check(monotonic, "a bigger push never reaches less far");
+
+    const stick::Vector at_once = stick::deflection(0.96f, 0.0f, 0.95f, 0.95f);
+    check(at_once.x == 1.0f && at_once.y == 0.0f, "a dead zone at the full point: full at once past it");
+}
+
 } // namespace
 
 void test_keep_saved() {
@@ -174,6 +257,7 @@ int main() {
     test_assign();
     test_read();
     test_mouse_turn();
+    test_stick();
     std::cout << (failures ? "FAIL" : "PASS") << ": input bindings (" << failures << " failures)\n";
     return failures ? 1 : 0;
 }
