diff --git a/host/input/stick.cpp b/host/input/stick.cpp
new file mode 100644
index 0000000..5fb55cf
--- /dev/null
+++ b/host/input/stick.cpp
@@ -0,0 +1,41 @@
+#include "input/stick.hpp"
+
+#include <algorithm>
+#include <cmath>
+
+namespace portablekit::input::stick {
+
+Vector deflection(float x, float y, float dead_zone, float full) {
+    const float length = std::sqrt(x * x + y * y);
+    if (!(length > dead_zone) || !(length > 0.0f)) return {};
+    // A full point at or inside the dead zone would divide by nothing; past
+    // the dead zone is then full at once.
+    const float span = full - dead_zone;
+    const float amount = span > 1e-4f ? std::min((length - dead_zone) / span, 1.0f) : 1.0f;
+    return {x / length * amount, y / length * amount};
+}
+
+Vector to_square(Vector v) {
+    const float longer = std::max(std::fabs(v.x), std::fabs(v.y));
+    if (!(longer > 0.0f)) return {};
+    // Scaling by length / longer axis makes the longer axis the length: the
+    // circle of radius r goes to the square of half-side r.
+    const float scale = std::sqrt(v.x * v.x + v.y * v.y) / longer;
+    return {std::clamp(v.x * scale, -1.0f, 1.0f), std::clamp(v.y * scale, -1.0f, 1.0f)};
+}
+
+int nub_offset(float value) {
+    if (!(value == value)) return 0;  // NaN
+    value = std::clamp(value, -1.0f, 1.0f);
+    // The centre is 0x80, so there are 128 steps below it and 127 above:
+    // each side is scaled to its own end, and both ends are reached.
+    return static_cast<int>(std::lround(value * (value < 0.0f ? 128.0f : 127.0f)));
+}
+
+Nub to_nub(float x, float y, const Tuning &tuning) {
+    Vector v = deflection(x, y, tuning.dead_zone, tuning.full);
+    if (tuning.square) v = to_square(v);
+    return {static_cast<std::uint8_t>(0x80 + nub_offset(v.x)), static_cast<std::uint8_t>(0x80 + nub_offset(v.y))};
+}
+
+} // namespace portablekit::input::stick
diff --git a/host/input/stick.hpp b/host/input/stick.hpp
new file mode 100644
index 0000000..3213e16
--- /dev/null
+++ b/host/input/stick.hpp
@@ -0,0 +1,64 @@
+#pragma once
+
+#include <cstdint>
+
+// A gamepad's analog stick as the PSP's analog nub. Pure arithmetic: no SDL.
+//
+// A PSP game reads the nub as two bytes, X and Y, each 0..255 with the centre
+// at 0x80, and the nub's range reaches its corners: pushed fully to a corner
+// it reads near 0 or 255 on both axes. Many games treat each axis on its own,
+// with a dead zone or a speed per axis. A modern stick's gate is a circle, so
+// at a full diagonal each axis is only cos 45 degrees, about 0.71 of its
+// travel. Passed on as it is, a full diagonal reaches a game as about 0.71 on
+// each axis: a game with a large per-axis dead zone sees a smaller push, or
+// nothing at all.
+//
+// So the stick is taken as a vector:
+//   1. dead zones on its length, not per axis (radial), so a diagonal is not
+//      cut or shortened more than a straight push: nothing within
+//      `dead_zone` of the centre, and full deflection from `full` outwards,
+//      with the length rescaled linearly in between;
+//   2. circle to square (`square`): the vector is stretched along its own
+//      direction until its longer axis equals its length, so a full push in
+//      any direction reaches the edge of the nub's square range, a full
+//      diagonal its corner. The direction is unchanged, and so is a straight
+//      push;
+//   3. each axis, -1..1, to a byte: -1 is 0, 0 is 0x80 and 1 is 255, rounded
+//      to the nearest step.
+namespace portablekit::input::stick {
+
+// The length from which a push counts as full: sticks that stop a little
+// short of the edge, worn or badly calibrated ones, still reach it.
+inline constexpr float kFullDeflection = 0.95f;
+
+struct Vector {
+    float x{};
+    float y{};
+};
+
+struct Tuning {
+    float dead_zone{0.15f};            // fraction of the radius that does nothing
+    float full{kFullDeflection};       // fraction of the radius that is a full push
+    bool square{true};                 // circle to square, step 2 above
+};
+
+// Step 1: the stick at x, y (each -1..1, right and down positive) after the
+// radial dead zones, same direction, length 0..1.
+[[nodiscard]] Vector deflection(float x, float y, float dead_zone, float full = kFullDeflection);
+
+// Step 2: a vector in the unit circle stretched onto the unit square.
+[[nodiscard]] Vector to_square(Vector v);
+
+// Step 3: one axis, -1..1, as an offset from the nub's centre 0x80:
+// -128..127, so 0x80 plus it is 0..255.
+[[nodiscard]] int nub_offset(float value);
+
+struct Nub {
+    std::uint8_t x{0x80u};
+    std::uint8_t y{0x80u};
+};
+
+// All three steps: the stick at x, y as the nub's two bytes.
+[[nodiscard]] Nub to_nub(float x, float y, const Tuning &tuning);
+
+} // namespace portablekit::input::stick
