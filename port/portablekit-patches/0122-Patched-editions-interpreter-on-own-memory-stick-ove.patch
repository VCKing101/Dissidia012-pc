@@ -64,6 +65,20 @@ void begin(psprecomp::Runtime &runtime, const Edition &edition, std::uint32_t lo
 void code_flushed(psprecomp::Runtime &runtime);
 void data_flushed(psprecomp::Runtime &runtime, std::uint32_t address, std::uint32_t size);
 
+// <prefix>_TRACE_PATCHED=2: logs a changed word of code, and the nearest
+// function at or below it that a port registered in place of the game's own
+// and that stays where the unit around it went to the interpreter: a port's
