 #include "psprecomp/sha256.hpp"
 
 #include <algorithm>
+#include <cstdlib>
 #include <cstring>
 #include <iostream>
 #include <map>
@@ -104,6 +108,48 @@ std::optional<std::string> sfo_string(const std::vector<std::uint8_t> &sfo, std:
     return std::string(text, strnlen(text, value->length));
 }
 
+// What found the words being compared, for the trace.
+const char *g_found_by = "a cache flush";
+
+} // namespace
+
+// <prefix>_PATCHED_INTERPRET_ALL: 1 both, "main" the executable only,
+// "overlays" the patched overlays only.
+bool interpret_all_of(std::string_view part) {
+    const char *value = portablekit::env("PATCHED_INTERPRET_ALL");
+    if (value == nullptr) return false;
+    const std::string_view v(value);
+    return v != "main" && v != "overlays" ? true : v == part;
+}
+
+bool trace_every_word() {
+    static const bool every = [] {
+        const char *trace = portablekit::env("TRACE_PATCHED");
+        return trace != nullptr && std::string_view(trace) == "2";
+    }();
+    return every;
+}
+
+void trace_word(psprecomp::Runtime &runtime, std::uint32_t address, std::uint32_t was, std::uint32_t now) {
+    // Inside a unit taken for the interpreter only a port's own functions are
+    // still registered; each has a function of its own, unlike the unit's
+    // addresses around it (registered_function() answers for those too).
+    std::uint32_t host = 0u;
+    for (std::uint32_t at = address & ~3u, n = 0u; n < 4096u && at >= 4u; at -= 4u, ++n) {
+        if (!runtime.has_function(at)) continue;
+        const auto function = runtime.registered_function(at);
+        if (function != runtime.registered_function(at - 4u) && function != runtime.registered_function(at + 4u))
+            host = at;
+        break;
+    }
+    std::cout << "[patched] word " << psprecomp::hex32(address) << ": " << psprecomp::hex32(was) << " -> "
+              << psprecomp::hex32(now);
+    if (host != 0u) std::cout << "; a port's function at " << psprecomp::hex32(host) << ", " << (address - host) << " bytes before";
+    std::cout << " (found at " << g_found_by << ")" << std::endl;
+}
+
+namespace {
+
 void compare_code(psprecomp::Runtime &runtime, std::uint32_t from, std::uint32_t to) {
     State &s = state();
     const std::uint32_t end = s.code_start + static_cast<std::uint32_t>(s.code.size());
@@ -125,6 +171,7 @@ void compare_code(psprecomp::Runtime &runtime, std::uint32_t from, std::uint32_t
                 ++words;
                 const std::uint32_t taken = runtime.retire_recompiled_unit(address);
                 if (taken != 0u) ++units;
+                if (trace_every_word()) trace_word(runtime, address, le32(release + at), le32(memory + at));
                 // <prefix>_TRACE_PATCHED=1: each word that took a unit with it.
                 static const bool trace = portablekit::env("TRACE_PATCHED") != nullptr;
                 if (trace && taken != 0u)
@@ -256,7 +303,41 @@ void begin(psprecomp::Runtime &runtime, const Edition &edition, std::uint32_t lo
     s.identity = edition.identity;
     std::cout << "[patched] playing " << edition.disc.filename().string() << ", " << (edition.ram_bytes >> 20u)
               << " MiB of memory, identity " << edition.identity << std::endl;
+    // The units the patch changes leave the recompiled code and run under the
+    // interpreter (compare_code), so it is on for this start, also where the
+    // build or its layout turns it off (PSPRECOMP_NO_INTERPRETER: a release, a
+    // packaged copy). Off, the first call into a changed unit stops the game.
+    if (!psprecomp::interpreter_fallback_enabled()) {
+        psprecomp::set_interpreter_fallback_enabled(true);
+        std::cout << "[patched] the interpreter is on for this start: it runs the code the patch changes" << std::endl;
+    }
     compare_code(runtime, load_base, code_end);
+    // <prefix>_PATCHED_COMPARE_VBLANK=1, a diagnosis: the code is compared at
+    // every vblank too, so a patch that writes code with no cache flush shows.
+    if (portablekit::env("PATCHED_COMPARE_VBLANK") != nullptr) {
+        kernel().add_vblank_hook([&runtime] {
+            State &st = state();
+            g_found_by = "a vblank, with no flush";
+            compare_code(runtime, st.code_start, st.code_start + static_cast<std::uint32_t>(st.code.size()));
+            recompare_patched_overlays(runtime, 0u, 0xFFFFFFFFu);
+            g_found_by = "a cache flush";
+        });
+        std::cout << "[patched] the code is compared at every vblank too" << std::endl;
+    }
+    if (interpret_all_of("main")) {
+        // <prefix>_PATCHED_INTERPRET_RANGE=lo-hi (hex) narrows it to a range.
+        std::uint32_t lo = load_base, hi = code_end;
+        if (const char *range = portablekit::env("PATCHED_INTERPRET_RANGE"); range != nullptr && *range != '\0') {
+            char *end = nullptr;
+            lo = static_cast<std::uint32_t>(std::strtoul(range, &end, 16));
+            if (end != nullptr && *end == '-') hi = static_cast<std::uint32_t>(std::strtoul(end + 1, nullptr, 16));
+        }
+        std::uint32_t taken = 0u;
+        for (std::uint32_t at = std::max(lo, load_base) & ~3u; at < std::min(hi, code_end); at += 4u)
+            taken += runtime.retire_recompiled_unit(at);
+        std::cout << "[patched] the executable from " << psprecomp::hex32(lo) << " to " << psprecomp::hex32(hi)
+                  << " runs under the interpreter (" << taken << " addresses)" << std::endl;
+    }
 }
 
 bool active() noexcept { return state().active; }
@@ -265,13 +346,16 @@ std::string identity() { return state().identity; }
 
 void code_flushed(psprecomp::Runtime &runtime) {
     State &s = state();
-    if (s.active) compare_code(runtime, s.code_start, s.code_start + static_cast<std::uint32_t>(s.code.size()));
+    if (!s.active) return;
+    compare_code(runtime, s.code_start, s.code_start + static_cast<std::uint32_t>(s.code.size()));
+    recompare_patched_overlays(runtime, 0u, 0xFFFFFFFFu);
 }
 
 void data_flushed(psprecomp::Runtime &runtime, std::uint32_t address, std::uint32_t size) {
     if (!state().active) return;
     const std::uint32_t canonical = address & 0x1FFFFFFFu;
     compare_code(runtime, canonical, canonical + size);
+    recompare_patched_overlays(runtime, canonical, canonical + size);
 }
 
