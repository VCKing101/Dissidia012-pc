@@ -473,6 +486,51 @@ void revalidate_overlays(Runtime &runtime) {
 
 void forget_unmatched_overlays() { unmatched_slots().clear(); }
 
+void recompare_patched_overlays(Runtime &runtime, std::uint32_t from, std::uint32_t to) {
+    constexpr std::uint32_t kChunk = 256u;
+    for (auto &[slot_start, slot] : patched_slots()) {
+        // Swapped out: compared whole when it is installed again.
+        if (slot.header != header_hash(runtime.memory(), slot_start)) continue;
+        const OverlayCorpus *corpus = nullptr;
+        for (const OverlayCorpus &candidate : overlay_corpora())
+            if (candidate.base == slot_start && candidate.hash == slot.corpus) corpus = &candidate;
+        if (corpus == nullptr) continue;
+        const std::vector<std::uint8_t> *image = patched::overlay_baseline(corpus->base, corpus->code_size, corpus->hash);
+        if (image == nullptr) continue;
+        const std::uint32_t size = static_cast<std::uint32_t>(std::min<std::size_t>(image->size(), corpus->size)) & ~3u;
+        const std::uint32_t begin = std::max(from, slot_start) - slot_start;
+        const std::uint32_t end =
+            static_cast<std::uint32_t>(std::min<std::uint64_t>(to, std::uint64_t{slot_start} + size) - slot_start);
+        if (std::uint64_t{from} >= std::uint64_t{slot_start} + size || to <= slot_start || begin >= end) continue;
+        const std::uint8_t *loaded = runtime.memory().raw_pointer(slot_start, size);
+        if (loaded == nullptr) continue;
+        std::size_t words = 0u, units = 0u;
+        for (std::uint32_t offset = begin & ~3u; offset < end;) {
+            const std::uint32_t length = std::min(kChunk, end - offset);
+            if (std::memcmp(loaded + offset, image->data() + offset, length) != 0) {
+                for (std::uint32_t at = offset; at + 4u <= offset + length; at += 4u) {
+                    if (std::memcmp(loaded + at, image->data() + at, 4u) == 0) continue;
+                    const std::uint32_t address = slot_start + at;
+                    if (!slot.changed.insert(address).second) continue;
+                    ++words;
+                    if (runtime.retire_recompiled_unit(address) != 0u) ++units;
+                    if (patched::trace_every_word()) {
+                        std::uint32_t was = 0u, now = 0u;
+                        std::memcpy(&was, image->data() + at, 4u);
+                        std::memcpy(&now, loaded + at, 4u);
+                        patched::trace_word(runtime, address, was, now);
+                    }
+                }
+            }
+            offset += length;
+        }
+        // Words of its data change as the game runs: only code is news.
+        if (units != 0u)
+            std::cout << "[patched] overlay " << corpus->name << ": " << words << " more changed words, " << units
+                      << " more recompiled units interpreted" << std::endl;
+    }
+}
+
 std::uint64_t patched_overlay_hash(const psprecomp::GuestMemory &memory, std::uint32_t base) {
     const auto slot = patched_slots().find(base);
     return slot != patched_slots().end() && slot->second.header == header_hash(memory, base) ? slot->second.corpus : 0u;
diff --git a/host/overlays.hpp b/host/overlays.hpp
index 5bfb3a3..e949841 100644
--- a/host/overlays.hpp
+++ b/host/overlays.hpp
@@ -22,6 +22,13 @@ void revalidate_overlays(psprecomp::Runtime &runtime);
 // again at the next call into it.
 void forget_unmatched_overlays();
 
+// A patched edition's overlay running on the release's corpus is compared with
+// the release's image again over [from, to) when the game flushes a cache: a
+// patch may write more of its code once the overlay runs (hooks into code of
+// its own), and a unit holding a newly changed word goes to the interpreter,
+// as when the overlay was installed (patched_edition.hpp).
+void recompare_patched_overlays(psprecomp::Runtime &runtime, std::uint32_t from, std::uint32_t to);
+
 // The hash of the corpus a patched overlay in the slot at `base` runs on
 // (patched_edition.hpp), 0 when the slot holds no such image. A port that tells
 // its overlays apart by their corpus's hash asks this for a patched one.
