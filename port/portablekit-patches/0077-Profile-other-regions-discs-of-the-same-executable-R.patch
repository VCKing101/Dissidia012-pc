diff --git a/host/profile.cpp b/host/profile.cpp
index 5a603c6..a081528 100644
--- a/host/profile.cpp
+++ b/host/profile.cpp
@@ -66,4 +66,52 @@ std::span<const std::uint32_t> active_overlay_slots() {
