+// Another region's disc of the same game that holds the same executable, byte
+// for byte, in its own encrypted EBOOT.BIN (Dissidia 012's European disc
+// against its North American one). The installer takes it like the profile's
+// own release and the same corpus runs it. A game that reads its own disc id
+// from its data names its saves and downloads by this disc id, so they follow
+// it; textures and the ad hoc product code stay the profile's.
+struct RegionRelease {
+    const char *disc_id;                     // DISC_ID in its PARAM.SFO, e.g. "ULES01505"
+    const char *disc_id_display;             // the same, as it is printed
+    const char *release_name;                // "the European release"
+    const char *encrypted_executable_sha256; // its EBOOT.BIN, which decrypts to executable_sha256
+    const char *save_game_name;              // its saves' main folder, e.g. "ULES01505"
+    std::span<const SaveFolder> save_folders;
+};
+
