 }
 
+namespace {
+const RegionRelease *g_active_region_release = nullptr;
+}
+
+const RegionRelease *find_region_release(std::string_view disc_id) {
+    for (const RegionRelease &release : game().region_releases)
+        if (release.disc_id != nullptr && disc_id == release.disc_id) return &release;
+    return nullptr;
+}
+
+const RegionRelease *find_region_release_by_encrypted(std::string_view eboot_sha256) {
+    for (const RegionRelease &release : game().region_releases)
+        if (release.encrypted_executable_sha256 != nullptr && eboot_sha256 == release.encrypted_executable_sha256)
+            return &release;
+    return nullptr;
+}
+
+bool is_supported_disc_id(std::string_view disc_id) {
+    return disc_id == game().disc_id || find_region_release(disc_id) != nullptr;
+}
+
+std::string supported_discs_display() {
+    std::string text = game().disc_id_display;
+    const auto releases = game().region_releases;
+    for (std::size_t i = 0; i < releases.size(); ++i)
+        text += std::string(i + 1u == releases.size() ? " or " : ", ") + releases[i].disc_id_display;
+    return text;
+}
+
+void set_active_region_release(const RegionRelease *release) { g_active_region_release = release; }
+const RegionRelease *active_region_release() { return g_active_region_release; }
+
+const char *active_disc_id() {
+    return g_active_region_release != nullptr ? g_active_region_release->disc_id : game().disc_id;
+}
+
+const char *active_disc_id_display() {
+    return g_active_region_release != nullptr ? g_active_region_release->disc_id_display : game().disc_id_display;
+}
+
+const char *active_save_game_name() {
+    return g_active_region_release != nullptr ? g_active_region_release->save_game_name : game().save_game_name;
+}
+
+std::span<const SaveFolder> active_save_folders() {
+    return g_active_region_release != nullptr ? g_active_region_release->save_folders : game().save_folders;
+}
+
 } // namespace portablekit
