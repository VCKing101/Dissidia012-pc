diff --git a/host/main.cpp b/host/main.cpp
index 1cc86c7..94aaa48 100644
--- a/host/main.cpp
+++ b/host/main.cpp
@@ -439,7 +439,9 @@ int main(int argc, char **argv) {
         std::cout << portablekit::kernel().describe_threads() << "\n";
