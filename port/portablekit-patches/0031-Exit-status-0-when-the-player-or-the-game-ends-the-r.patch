diff --git a/host/system.hpp b/host/system.hpp
index fdacabd..b48d104 100644
--- a/host/system.hpp
+++ b/host/system.hpp
@@ -6,6 +6,7 @@
 #include <cstdint>
 #include <filesystem>
 #include <iterator>
+#include <string_view>
 
 namespace portablekit {
 
@@ -25,4 +26,16 @@ void install_system(psprecomp::Runtime &runtime, const psprecomp::Elf32Image &el
 // this function.
 [[nodiscard]] std::filesystem::path memory_stick_directory(const std::filesystem::path &game_dir);
 
+// The runtime's stop reasons for an ending the player or the game asked for:
+// the window closed (its close button, the input script's quit, SIGTERM), Quit
+// in the menu, or the game's own sceKernelExitGame. The process exits with 0
+// after one of these and with 4 after any other stop, which is an error.
+inline constexpr std::string_view kStopWindowClosed = "window closed";
+inline constexpr std::string_view kStopQuitFromMenu = "quit from the menu";
+inline constexpr std::string_view kStopGameExited = "guest called sceKernelExitGame";
+
+[[nodiscard]] inline bool is_requested_stop(std::string_view reason) {
+    return reason.empty() || reason == kStopWindowClosed || reason == kStopQuitFromMenu || reason == kStopGameExited;
+}
+
 } // namespace portablekit
