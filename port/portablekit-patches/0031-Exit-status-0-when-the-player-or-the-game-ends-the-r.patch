     } else if (!ui::menu_over_game() && ui::menu_requested()) {
         if (ui::menu_pauses()) {
             // The menu pauses the game: guest code and emulated time stand
@@ -369,7 +370,7 @@ void present_frame(Runtime &rt) {
             // and keep the pause out of the frame statistics.
