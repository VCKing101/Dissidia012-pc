+    {"clut.change_missed_by_key", "texture", "high", "A CLUT's contents changed but not its first word, with <prefix>_CLUT_FIRST_WORD_KEY: the cache key hashes only the first word, the old colours are drawn"},
+    {"clut.variant", "texture", "info", "One texture and CLUT drawn with different CLUT shift/mask/start (keyed apart since the whole-palette key)"},
+    {"clut.contents_changed", "texture", "info", "A CLUT's contents changed but not its first word (keyed apart since the whole-palette key)"},
     // Render to texture.
     {"fbtex.sampled", "render-to-texture", "info", "A texture read from a render target (done on the GPU)"},
     {"fbtex.self_sample", "render-to-texture", "info", "A draw sampling its own target: read from a copy made before the draw"},
