     {"clut.shift_mask_offset", "texture", "info", "CLUT index shift, mask or start (0xC5) other than the defaults: decoded right"},
-    {"clut.variant_cache_collision", "texture", "high", "One texture and CLUT drawn with different CLUT shift/mask/start: the texture cache key ignores them, the first decode is reused"},
-    {"clut.change_missed_by_key", "texture", "high", "A CLUT's contents changed but not its first word: the cache key hashes only the first word, the old colours are drawn"},
