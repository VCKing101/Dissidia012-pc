     s.scene_order.push_back(s.scene);
-    s.scenes[s.scene];
+    s.current = &s.scenes[s.scene];
     std::cout << "[census] GE census to " << s.path << ", scene " << s.scene << std::endl;
     return true;
 }
@@ -242,12 +245,9 @@ void hit(State &s, const std::string &name, const std::string &variant, const st
     }
     ++feature.count;
     if (!variant.empty()) ++feature.variants[variant];
-    ++s.scenes[s.scene].features[name];
+    ++s.current->features[name];
 }
 
-void hit_draw(State &s, const std::string &name, const std::string &variant, const std::string &detail) {
-    hit(s, name, variant, detail, kDrawWords, std::size(kDrawWords));
-}
 
 std::uint32_t bytes_per_pixel(std::uint32_t format) { return format == 3u ? 4u : 2u; }
 
@@ -349,6 +349,25 @@ std::string target_detail(const DrawCall &call) {
     return out.str();
 }
 
+// A draw's description, made only when a feature is first seen: most hits
+// are of features seen before, and formatting one per draw cost more than
+// the draw.
+struct LazyDetail {
+    const DrawCall *call{};
+    std::string text;
+    const std::string &get() {
+        if (text.empty()) text = target_detail(*call);
+        return text;
+    }
+};
+
+void hit_draw(State &s, const std::string &name, const std::string &variant, LazyDetail &detail) {
+    static const std::string none;
+    const auto found = s.features.find(name);
+    const bool first = found == s.features.end() || found->second.count == 0u;
+    hit(s, name, variant, first ? detail.get() : none, kDrawWords, std::size(kDrawWords));
+}
+
 void write_locked(State &s) {
     std::ostringstream out;
     out << "{\n  \"frames\": " << s.frame << ",\n  \"draws\": " << s.draws << ",\n  \"scenes\": [\n";
@@ -443,6 +462,7 @@ void set_scene(const std::string &name) {
         s.scene_order.push_back(name);
         s.scenes[name].first_frame = s.frame;
     }
+    s.current = &s.scenes[name];
     std::cout << "[census] scene " << name << " from frame " << s.frame << std::endl;
     write_locked(s);
 }
@@ -457,7 +477,7 @@ void note_frame(std::uint32_t display_address) {
     if (scene.frames == 0u) scene.first_frame = s.frame;
     ++scene.frames;
     scene.last_frame = s.frame;
-    if (s.frame - s.last_write_frame >= 1800u) write_locked(s);
+    if (s.frame - s.last_write_frame >= 600u) write_locked(s);
 }
 
