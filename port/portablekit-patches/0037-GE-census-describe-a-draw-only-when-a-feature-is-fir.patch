     s.draw_texture = call.texture.enabled ? call.texture.address : 0u;
@@ -572,6 +592,7 @@ void note_draw(const GuestMemory &memory, const DrawCall &call, const std::array
                     const float cw = m[3] * x + m[7] * y + m[11] * z + m[15];
                     if (cz > cw) far = true;
                     if (cz < -cw) near = true;
+                    if (far && near) break;
                 }
                 if (far) hit_draw(s, "clip.depth_clamp_far", near ? "also near" : "", detail);
                 else if (near) hit_draw(s, "clip.depth_clamp_near", "", detail);
@@ -717,8 +738,9 @@ void note_draw(const GuestMemory &memory, const DrawCall &call, const std::array
                                          texture.clut_format);
         const std::uint32_t variant = texture.clut_shift | texture.clut_mask << 8u | texture.clut_offset << 16u;
         const auto [entry, inserted] = s.clut_variants.try_emplace(key, variant);
+        static const bool first_word_key = portablekit::env("CLUT_FIRST_WORD_KEY") != nullptr;
         if (!inserted && entry->second != variant)
-            hit_draw(s, "clut.variant_cache_collision", hex(entry->second, 6) + " then " + hex(variant, 6), detail);
+            hit_draw(s, first_word_key ? "clut.variant_cache_collision" : "clut.variant", hex(entry->second, 6) + " then " + hex(variant, 6), detail);
         const std::uint32_t clut_bytes = std::max<std::uint32_t>(texture.clut_load_bytes, 4u);
         if (const std::uint8_t *clut = memory.raw_pointer(texture.clut_address, clut_bytes)) {
             std::uint32_t first_word{};
@@ -726,7 +748,8 @@ void note_draw(const GuestMemory &memory, const DrawCall &call, const std::array
             const std::uint64_t hash = hash_bytes(clut, clut_bytes);
             auto &seen = s.cluts[GuestMemory::canonical(texture.clut_address)];
             if (seen.hash != 0u && seen.hash != hash && seen.first_word == first_word)
-                hit_draw(s, "clut.change_missed_by_key", hex(texture.clut_address), detail);
+                hit_draw(s, first_word_key ? "clut.change_missed_by_key" : "clut.contents_changed",
+                         hex(texture.clut_address), detail);
