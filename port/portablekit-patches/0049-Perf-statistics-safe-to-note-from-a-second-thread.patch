@@ -521,11 +587,13 @@ void note_pipeline_created(double milliseconds) noexcept {
 }
 
 void note_pipeline_prewarmed() noexcept {
+    const Guard guard(stats_mutex());
     Csv &c = csv();
     if (c.file != nullptr) ++c.prewarmed;
 }
 
 void note_texture_decoded(double milliseconds) noexcept {
+    const Guard guard(stats_mutex());
     Csv &c = csv();
     if (c.file == nullptr) return;
     ++c.textures;
@@ -533,11 +601,13 @@ void note_texture_decoded(double milliseconds) noexcept {
 }
 
 void note_texture_key(double milliseconds) noexcept {
+    const Guard guard(stats_mutex());
     Csv &c = csv();
     if (c.file != nullptr) c.key_ms += milliseconds;
 }
 
 void note_snapshot(std::uint64_t bytes) noexcept {
+    const Guard guard(stats_mutex());
     Csv &c = csv();
     if (c.file == nullptr) return;
     ++c.snapshots;
@@ -545,6 +615,7 @@ void note_snapshot(std::uint64_t bytes) noexcept {
 }
 
 void note_pairing(const char *cut, std::uint32_t matched, std::uint32_t eligible) noexcept {
+    const Guard guard(stats_mutex());
     Csv &c = csv();
     if (c.file == nullptr) return;
     c.cut = cut;
@@ -554,13 +625,16 @@ void note_pairing(const char *cut, std::uint32_t matched, std::uint32_t eligible
 }
 
 void set_scene(const std::string &name) {
+    const Guard guard(stats_mutex());
     Csv &c = csv();
     if (c.file == nullptr) return;
     c.scene.clear();
     for (const char ch : name) c.scene += ch == ',' || ch == '\n' ? '_' : ch;
 }
 
-void count_present() {
+namespace {
+
+void count_present_locked() {
     State &s = state();
     const Clock::time_point now = Clock::now();
     const double present_ms = to_ms(now - s.last_present);
@@ -580,7 +654,31 @@ void count_present() {
     s.present_max_ms = std::max(s.present_max_ms, present_ms);
 }
 
+} // namespace
+
+void count_present() {
+    const Guard guard(stats_mutex());
+    count_present_locked();
+}
+
+void count_noted_present(PresentKind kind, float t, std::uint32_t skipped, double late_ms) {
+    const Guard guard(stats_mutex());
+    if (Csv &c = csv(); c.file != nullptr) {
+        c.kind = kind;
+        c.t = t;
+        c.skipped = skipped;
+        c.late_ms = late_ms;
+        c.noted = true;
+    }
+    count_present_locked();
+}
+
+void set_present_thread() noexcept { tl_present_thread = true; }
+bool on_present_thread() noexcept { return tl_present_thread; }
+std::unique_lock<std::mutex> lock_stats() { return std::unique_lock<std::mutex>(stats_mutex()); }
+
 void set_frame_rate_info(double rate, double requested) {
+    const Guard guard(stats_mutex());
     State &s = state();
     s.frame_rate = rate;
     s.requested_rate = requested;
@@ -783,11 +881,18 @@ void note_present_due(std::int64_t steady_us) noexcept {
 
 void end_frame(std::uint64_t virtual_us, bool presented) {
 #if defined(_WIN32)
-    if (StallSampler *sampler = StallSampler::get())
-        sampler->flip(std::chrono::duration<double, std::milli>(Clock::now() - state().frame_start).count());
+    if (StallSampler *sampler = StallSampler::get()) {
+        Clock::time_point frame_start{};
+        {
+            const Guard guard(stats_mutex());
+            frame_start = state().frame_start;
+        }
+        sampler->flip(std::chrono::duration<double, std::milli>(Clock::now() - frame_start).count());
+    }
 #endif
+    const Guard guard(stats_mutex());
     State &s = state();
-    if (presented) count_present();
+    if (presented) count_present_locked();
     const Clock::time_point now = Clock::now();
     const double frame_ms = to_ms(now - s.frame_start);
     s.frame_start_previous = s.frame_start;
