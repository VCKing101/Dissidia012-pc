+    const Guard guard(stats_mutex());
     Csv &c = csv();
     if (c.file == nullptr) return;
     c.kind = kind;
@@ -507,12 +571,14 @@ void note_present(PresentKind kind, float t, std::uint32_t skipped, double late_
 }
 
