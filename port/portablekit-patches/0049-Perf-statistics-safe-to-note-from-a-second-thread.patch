@@ -364,42 +386,83 @@ std::uint64_t split_ticks() noexcept {
 #endif
 }
 
-void add_split(Split kind, std::uint64_t ticks) noexcept { render_split().ticks[static_cast<std::size_t>(kind)] += ticks; }
