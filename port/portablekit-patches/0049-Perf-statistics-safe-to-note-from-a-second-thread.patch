--- a/host/perf/frame_stats.hpp
+++ b/host/perf/frame_stats.hpp
@@ -3,6 +3,7 @@
 #include <array>
 #include <chrono>
 #include <cstdint>
+#include <mutex>
 #include <string>
 
 namespace portablekit::perf {
@@ -96,6 +97,20 @@ void end_frame(std::uint64_t virtual_us, bool presented = true);
 
 // A present between the game's flips (frame interpolation).
 void count_present();
+// note_present() and count_present() as one step, for a present made on the
+// present thread while the emulation thread may note its own.
+enum class PresentKind : std::uint8_t;
+void count_noted_present(PresentKind kind, float t, std::uint32_t skipped, double late_ms);
+
+// The calling thread is the renderer's present thread (presents on a thread
+// of their own). Its waits, render time and split are not the game's frame
+// time and are left out of them; its presents, passes, copies and GPU time
+// still count. Every function here may be called from either thread.
+void set_present_thread() noexcept;
+[[nodiscard]] bool on_present_thread() noexcept;
+// Held while reading last_second() or frame_history() on another thread than
+// the one that ends frames (the overlay, drawn by the present thread).
+[[nodiscard]] std::unique_lock<std::mutex> lock_stats();
 // The rate frame interpolation presents at now and the one the setting asks
 // for, shown on the perf line; 0 when it is off.
 void set_frame_rate_info(double rate, double requested);
diff --git a/host/perf/perf_overlay.cpp b/host/perf/perf_overlay.cpp
