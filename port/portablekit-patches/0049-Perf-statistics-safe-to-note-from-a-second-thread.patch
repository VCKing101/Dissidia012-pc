From 3b47ed8213e73f3b0492828d98fbe406fff6ecd8 Mon Sep 17 00:00:00 2001
From: VCKing101 <59761021+VCKing101@users.noreply.github.com>
Date: Thu, 22 Oct 2026 19:00:51 +1030
Subject: [PATCH 49/62] Perf: statistics safe to note from a second thread

The frame statistics, the CSV and the overlay's readings are kept behind one
lock, so a thread other than the emulation thread (the renderer's present
thread) can count its presents and the overlay can read them while it draws.
A thread that marks itself as the present thread (set_present_thread) keeps
its waits, render time and split out of the game's frame time; its presents,
passes, copies and GPU time still count. count_noted_present notes and counts
a present in one step.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 host/perf/frame_stats.cpp  | 135 ++++++++++++++++++++++++++++++++-----
 host/perf/frame_stats.hpp  |  15 +++++
 host/perf/perf_overlay.cpp |   3 +
 3 files changed, 138 insertions(+), 15 deletions(-)

diff --git a/host/perf/frame_stats.cpp b/host/perf/frame_stats.cpp
index 3d7b814..fa53a59 100644
--- a/host/perf/frame_stats.cpp
+++ b/host/perf/frame_stats.cpp
@@ -13,6 +13,7 @@
 #include <cstdlib>
 #include <cstring>
 #include <iostream>
+#include <mutex>
 
 #if defined(_WIN32)
 #ifndef NOMINMAX
@@ -166,6 +167,22 @@ State &state() {
     return value;
 }
 
+// The statistics are written by the emulation thread and, when presents have
+// a thread of their own (the renderer's present thread), by that thread too;
+// the overlay reads them while it presents. One lock for all of it, never
+// held while calling out of this file. Never destroyed: the process may still
+// count a present while it exits.
+std::mutex &stats_mutex() {
+    static std::mutex *value = new std::mutex;
+    return *value;
+}
+using Guard = std::lock_guard<std::mutex>;
+
+// The present thread's waits and CPU time are its own, not the game's frame
+// time: they are left out of render, wait and the split (the renderer reports
+// them on its [present-thread] line). Its presents still count.
+thread_local bool tl_present_thread = false;
+
 void print(const Summary &s) {
     char line[512];
     int length = std::snprintf(line, sizeof(line),
@@ -266,6 +283,7 @@ Options options() {
 }
 
 void restart_measurement() {
+    const Guard guard(stats_mutex());
     State &s = state();
     const Clock::time_point now = Clock::now();
     s.frame_start = now;
@@ -293,7 +311,11 @@ void restart_measurement() {
     s.gpu_frames = 0u;
 }
 
-void add_render_time(Clock::duration duration) { state().render += duration; }
+void add_render_time(Clock::duration duration) {
+    if (tl_present_thread) return;
