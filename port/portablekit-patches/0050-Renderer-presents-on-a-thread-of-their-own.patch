 namespace portablekit::gpu {
 
+namespace {
+// How many renderer calls the calling thread is inside (VulkanRenderer::Impl::
+// lock_state): the emulation thread lets a waiting present thread in only
+// between calls, never in the middle of one.
+thread_local int tl_state_depth = 0;
+// The renderer whose present thread runs, for the exit handler.
+std::atomic<VulkanRenderer *> g_presenting{};
+} // namespace
+
 std::string default_window_title() {
     std::string title = portablekit::game().app_name;
     if (*kBuildLabel != '\0') title += std::string(" (") + kBuildLabel + ")";
@@ -1961,6 +1972,154 @@ struct VulkanRenderer::Impl {
     // for submit_and_present to present.
     std::optional<std::uint32_t> acquired_image;
     float display_hz{};
+
+    // Presents on a thread of their own (<prefix>_NO_PRESENT_THREAD keeps
+    // them on the emulation thread, paced as by patch 0048). The emulation
+    // thread records each game frame as before and submits it at its flip;
+    // the present thread makes every present -- frame interpolation's, a
+    // frame at its flip without interpolation, the interface's while the
+    // game is paused -- at its due time while the game's code runs: it
+    // acquires a swapchain image, records the present (the replay, the copy
+    // to the window, the overlay and the interface), submits it and presents.
+    // Everything in Impl is the renderer's state, behind `state`: the
+    // emulation thread holds it for each call into the renderer (Guard), the
+    // present thread while it records and submits a present. The swapchain
+    // is the present thread's alone; it acquires and presents without
+    // `state`, so a display that keeps its images never holds the game. Every
+    // use of the queue (submits, presents, idle waits, ImGui's texture
+    // uploads) is behind `queue`, always taken after `state`, never before.
+    struct Presenter {
+        std::recursive_mutex state;
+        std::mutex queue;
+        // The present thread waits for `state`: the emulation thread lets it
+        // in before its next call instead of taking the lock again at once.
+        std::atomic<bool> wants{};
+        std::thread thread;
+        present::Mailbox mailbox;
+        // The emulation thread's time spent waiting for `state`, in
+        // nanoseconds since the start: what presents cost the game now.
+        std::atomic<std::uint64_t> emu_wait_ns{};
+        std::uint64_t governor_emu_wait_ns{};  // at the governor's last second
+        std::uint64_t reported_emu_wait_ns{};  // at the present thread's last line
+    };
+    std::unique_ptr<Presenter> presenter = std::make_unique<Presenter>();
+    bool threaded{};
+    void lock_state();
+    void unlock_state() {
+        --tl_state_depth;
+        presenter->state.unlock();
+    }
+    // The emulation thread's hold on the renderer for one call; nothing
+    // without the present thread.
+    class Guard {
+    public:
+        explicit Guard(Impl &impl) : impl_(impl.threaded ? &impl : nullptr) {
+            if (impl_ != nullptr) impl_->lock_state();
+        }
+        ~Guard() {
+            if (impl_ != nullptr) impl_->unlock_state();
+        }
+        Guard(const Guard &) = delete;
+        Guard &operator=(const Guard &) = delete;
+
+    private:
+        Impl *impl_;
+    };
+    // The present thread's hold.
+    void present_lock();
