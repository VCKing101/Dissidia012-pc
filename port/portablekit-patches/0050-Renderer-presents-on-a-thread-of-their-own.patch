+// ---------------------------------------------------------------------------
+// The present thread (Impl::Presenter).
+
+void VulkanRenderer::Impl::lock_state() {
+    Presenter &p = *presenter;
+    if (tl_state_depth++ != 0) {
+        p.state.lock();
+        return;
+    }
+    if (!p.wants.load(std::memory_order_acquire) && p.state.try_lock()) return;
+    const auto start = std::chrono::steady_clock::now();
+    // The present thread asked first: it goes before this call, which then
+    // waits for its present to be recorded and submitted.
+    while (p.wants.load(std::memory_order_acquire)) std::this_thread::yield();
+    p.state.lock();
+    p.emu_wait_ns.fetch_add(static_cast<std::uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                                                           std::chrono::steady_clock::now() - start)
+                                                           .count()),
+                            std::memory_order_relaxed);
+}
+
+void VulkanRenderer::Impl::present_lock() {
+    using Clock = std::chrono::steady_clock;
+    const Clock::time_point start = Clock::now();
+    presenter->wants.store(true, std::memory_order_release);
+    presenter->state.lock();
+    presenter->wants.store(false, std::memory_order_release);
+    const double waited = std::chrono::duration<double, std::milli>(Clock::now() - start).count();
+    thread_second.lock_wait_ms += waited;
+    thread_second.lock_wait_max_ms = std::max(thread_second.lock_wait_max_ms, waited);
+}
