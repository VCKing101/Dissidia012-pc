diff --git a/host/gpu/present_queue.cpp b/host/gpu/present_queue.cpp
new file mode 100644
index 0000000..b2c1a05
--- /dev/null
+++ b/host/gpu/present_queue.cpp
@@ -0,0 +1,195 @@
+#include "present_queue.hpp"
+
+#include <algorithm>
+#include <thread>
+
+#if defined(_WIN32)
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+#elif defined(__unix__) || defined(__APPLE__)
+#include <time.h>
+#endif
+
+namespace portablekit::gpu::present {
+
+namespace {
+#if defined(_WIN32)
+HANDLE make_timer() {
+    HANDLE made = CreateWaitableTimerExW(nullptr, nullptr, CREATE_WAITABLE_TIMER_HIGH_RESOLUTION, TIMER_ALL_ACCESS);
+    // Before Windows 10 1803 there is no high-resolution timer.
+    if (made == nullptr) made = CreateWaitableTimerExW(nullptr, nullptr, 0, TIMER_ALL_ACCESS);
+    return made;
+}
+// Arms `timer` to fire `duration` from now; false when it cannot.
+bool arm(HANDLE timer, Clock::duration duration) {
+    LARGE_INTEGER relative{};
+    // Negative: relative, in 100 ns units; at least one.
+    relative.QuadPart = -std::max<LONGLONG>(
+        1, static_cast<LONGLONG>(std::chrono::duration_cast<std::chrono::nanoseconds>(duration).count() / 100));
+    return SetWaitableTimerEx(timer, &relative, 0, nullptr, nullptr, nullptr, 0) != 0;
+}
+#endif
+} // namespace
+
+Mailbox::Mailbox() {
+#if defined(_WIN32)
+    event_ = CreateEventW(nullptr, FALSE, FALSE, nullptr);
+    timer_ = make_timer();
+    if (event_ == nullptr || timer_ == nullptr) {
+        if (event_ != nullptr) CloseHandle(static_cast<HANDLE>(event_));
+        if (timer_ != nullptr) CloseHandle(static_cast<HANDLE>(timer_));
+        event_ = timer_ = nullptr;
+    }
+#endif
+}
+
+Mailbox::~Mailbox() {
+#if defined(_WIN32)
+    if (event_ != nullptr) CloseHandle(static_cast<HANDLE>(event_));
+    if (timer_ != nullptr) CloseHandle(static_cast<HANDLE>(timer_));
+#endif
+}
+
+void Mailbox::signal() {
+    wake_.notify_all();
+#if defined(_WIN32)
+    if (event_ != nullptr) SetEvent(static_cast<HANDLE>(event_));
+#endif
+}
+
+void Mailbox::post() {
+    {
+        const std::lock_guard<std::mutex> guard(lock_);
+        ++posted_;
+    }
+    signal();
+}
+
+std::uint64_t Mailbox::post_ui() {
+    std::uint64_t ticket = 0;
+    {
+        const std::lock_guard<std::mutex> guard(lock_);
+        ticket = ++ui_posted_;
+        ++posted_;
+    }
+    signal();
+    return ticket;
+}
+
+bool Mailbox::wait_ui(std::uint64_t ticket, Clock::duration limit) {
+    std::unique_lock<std::mutex> guard(lock_);
+    done_.wait_for(guard, limit, [&] { return stop_ || ui_done_ >= ticket; });
+    return ui_done_ >= ticket;
+}
+
+void Mailbox::stop() {
+    {
+        const std::lock_guard<std::mutex> guard(lock_);
+        stop_ = true;
+    }
+    signal();
+    done_.notify_all();
+}
+
+Mailbox::Wake Mailbox::wait_until(Clock::time_point deadline) {
+#if defined(_WIN32)
+    if (event_ != nullptr) {
+        for (;;) {
+            {
+                const std::lock_guard<std::mutex> guard(lock_);
+                if (stop_) return Wake::Stop;
+                if (posted_ != seen_) {
+                    seen_ = posted_;
+                    return Wake::Posted;
+                }
+            }
+            const Clock::time_point now = Clock::now();
+            if (now >= deadline) return Wake::Deadline;
+            // A post sets the event (auto-reset): one made after the check
+            // above ends this wait at once.
+            const HANDLE handles[2] = {static_cast<HANDLE>(event_), static_cast<HANDLE>(timer_)};
+            if (!arm(handles[1], deadline - now)) break;
+            WaitForMultipleObjects(2u, handles, FALSE, INFINITE);
+        }
+    }
+#endif
+    std::unique_lock<std::mutex> guard(lock_);
+    wake_.wait_until(guard, deadline, [&] { return stop_ || posted_ != seen_; });
+    if (stop_) return Wake::Stop;
+    if (posted_ != seen_) {
+        seen_ = posted_;
+        return Wake::Posted;
+    }
+    return Wake::Deadline;
+}
+
+std::uint64_t Mailbox::ui_wanted() const {
+    const std::lock_guard<std::mutex> guard(lock_);
+    return ui_posted_ > ui_done_ ? ui_posted_ : 0u;
+}
+
+void Mailbox::ui_done(std::uint64_t ticket) {
+    {
+        const std::lock_guard<std::mutex> guard(lock_);
+        ui_done_ = std::max(ui_done_, ticket);
+    }
+    done_.notify_all();
+}
+
+bool Mailbox::stopping() const {
+    const std::lock_guard<std::mutex> guard(lock_);
+    return stop_;
+}
+
+WaitPlan plan_wait(Clock::time_point now, Clock::time_point due, Clock::duration slack) noexcept {
+    WaitPlan plan{};
+    if (due <= now) {
+        plan.coarse_until = now;
+        return plan;
+    }
+    // Far enough off: wait on the mailbox until `slack` before, then sleep
+    // the rest. Closer than that: sleep it all.
+    plan.precise = true;
+    plan.coarse_until = due - slack > now ? due - slack : now;
+    return plan;
+}
+
+void precise_sleep_until(Clock::time_point when) {
+    // The last stretch is spun: a sleep's wake-up comes up to a few hundred
+    // microseconds late even with the finest timer.
+    constexpr auto kSpin = std::chrono::microseconds(250);
+#if defined(_WIN32)
+    static thread_local HANDLE timer = make_timer();
+    const Clock::time_point sleep_to = when - kSpin;
+    const Clock::time_point now = Clock::now();
+    if (sleep_to > now && timer != nullptr && arm(timer, sleep_to - now)) WaitForSingleObject(timer, INFINITE);
+#else
+    const Clock::time_point sleep_to = when - kSpin;
+    if (sleep_to > Clock::now()) std::this_thread::sleep_until(sleep_to);
+#endif
+    while (Clock::now() < when) std::this_thread::yield();
+}
+
+double thread_cpu_ms() {
+#if defined(_WIN32)
+    FILETIME created{}, exited{}, kernel{}, user{};
+    if (!GetThreadTimes(GetCurrentThread(), &created, &exited, &kernel, &user)) return 0.0;
+    const auto ticks = [](const FILETIME &time) {
+        return static_cast<double>(static_cast<std::uint64_t>(time.dwHighDateTime) << 32u | time.dwLowDateTime);
+    };
+    return (ticks(kernel) + ticks(user)) / 10'000.0;
+#elif defined(__unix__) || defined(__APPLE__)
+    timespec now{};
+    if (clock_gettime(CLOCK_THREAD_CPUTIME_ID, &now) != 0) return 0.0;
+    return static_cast<double>(now.tv_sec) * 1000.0 + static_cast<double>(now.tv_nsec) / 1.0e6;
+#else
+    return 0.0;
+#endif
+}
+
+} // namespace portablekit::gpu::present
diff --git a/host/gpu/present_queue.hpp b/host/gpu/present_queue.hpp
new file mode 100644
index 0000000..070d205
--- /dev/null
+++ b/host/gpu/present_queue.hpp
@@ -0,0 +1,109 @@
+#pragma once
+
+#include <chrono>
+#include <condition_variable>
+#include <cstdint>
+#include <mutex>
+
+// The hand-off between the emulation thread, which records the game's frames,
+// and the renderer's present thread, which shows them (frame interpolation's
+// presents between flips, a frame at its flip without interpolation, and the
+// interface's presents while the game is paused). What is to be shown lives in
+// the renderer behind its own lock; this only wakes the present thread and
+// lets the emulation thread wait for an interface present it needs done.
+// Independent of the renderer and of Vulkan, so it can be checked on its own.
+namespace portablekit::gpu::present {
+
+using Clock = std::chrono::steady_clock;
+
+class Mailbox {
+public:
+    Mailbox();
+    ~Mailbox();
+    Mailbox(const Mailbox &) = delete;
+    Mailbox &operator=(const Mailbox &) = delete;
+
+    // Emulation thread.
+    // Something new to present (a flipped frame, a picture to show): wakes
+    // the present thread if it waits. Several posts before it wakes are one.
+    void post();
+    // An interface present, which the caller waits for with wait_ui(): the
+    // paused game's menu is paced by its presents, as before. Returns its
+    // ticket; a later ticket covers the earlier ones.
+    [[nodiscard]] std::uint64_t post_ui();
+    // True once the present thread has made the present of `ticket` (or a
+    // later one); false when `limit` passes first or the mailbox stops.
+    bool wait_ui(std::uint64_t ticket, Clock::duration limit);
+    // Ends the present thread's waits for good.
+    void stop();
+
+    // Present thread.
+    enum class Wake : std::uint8_t {
+        Deadline,  // `deadline` passed with nothing posted
+        Posted,    // something was posted since the last wake
+        Stop,      // stop() was called
+    };
+    // Waits until `deadline` or a post or stop(), whichever comes first. A
+    // post made before the call and not yet seen returns at once.
+    Wake wait_until(Clock::time_point deadline);
+    // The newest interface present waiting, or 0.
+    [[nodiscard]] std::uint64_t ui_wanted() const;
+    // The present of `ticket` was made (or given up): wakes its waiter.
+    void ui_done(std::uint64_t ticket);
+    [[nodiscard]] bool stopping() const;
+
+private:
+    mutable std::mutex lock_;
+    std::condition_variable wake_;
+    std::condition_variable done_;
+    std::uint64_t posted_{};
+    std::uint64_t seen_{};
+    std::uint64_t ui_posted_{};
+    std::uint64_t ui_done_{};
+    bool stop_{};
+    // Windows: a condition variable's timed wait follows the system timer,
+    // which can be 15.6 ms coarse; the waits there are on an event the posts
+    // set and a high-resolution waitable timer instead (null: the condition
+    // variable).
+    void *event_{};
+    void *timer_{};
+    void signal();
+};
+
+// How the present thread waits for a present due at `due`: on the mailbox,
+// which a new frame interrupts, until `coarse_until`; then, when `precise`,
+// a sleep without interruption to `due` itself. A condition variable's timed
+// wait wakes a millisecond or more late on some systems; the last stretch is
+// slept with the finest timer the system has (precise_sleep_until).
+struct WaitPlan {
+    Clock::time_point coarse_until{};
+    bool precise{};
+};
+inline constexpr Clock::duration kPreciseSlack = std::chrono::microseconds(2000);
+[[nodiscard]] WaitPlan plan_wait(Clock::time_point now, Clock::time_point due,
+                                 Clock::duration slack = kPreciseSlack) noexcept;
+
+// Sleeps until `when` as closely as the system allows: a high-resolution
+// waitable timer on Windows, the steady clock's sleep elsewhere, and a short
+// spin for the last fraction of a millisecond.
+void precise_sleep_until(Clock::time_point when);
+
+// CPU time the calling thread has used, in milliseconds (0 when unknown).
+[[nodiscard]] double thread_cpu_ms();
+
+// The present thread's own figures, one second at a time: what it made, what
+// it waited for, and how late its presents were against the moments they
+// were due at.
+struct ThreadSecond {
+    std::uint32_t presents{};
+    std::uint32_t blocked{};       // no image within the acquire's time limit
+    double cpu_ms{};               // the thread's CPU time in the second
+    double lock_wait_ms{};         // waiting for the renderer's lock (the emulation thread in a render call)
+    double lock_wait_max_ms{};
+    double acquire_ms{};           // waiting for a swapchain image
+    double acquire_max_ms{};
+    double late_max_ms{};          // the latest present after its due time
+    double emu_wait_ms{};          // the emulation thread waiting for the lock the present thread held
+};
+
+} // namespace portablekit::gpu::present
