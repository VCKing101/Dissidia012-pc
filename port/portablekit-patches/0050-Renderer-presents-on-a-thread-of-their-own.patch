+    present_clock.set_busy_after_flip(false);
+    thread_second_start = std::chrono::steady_clock::now();
+    presenter->thread = std::thread([this] { present_loop(); });
+}
+
+void VulkanRenderer::Impl::stop_present_thread() {
+    if (!threaded) return;
+    presenter->mailbox.stop();
+    if (presenter->thread.joinable()) presenter->thread.join();
+    threaded = false;
+    plain_pending = false;
+    plain_ui = ui_request = nullptr;
+}
+
+void VulkanRenderer::Impl::present_loop() {
+    using Clock = std::chrono::steady_clock;
+    perf::set_present_thread();
+    // Woken on time while the emulation thread and the decoders run.
+    SDL_SetCurrentThreadPriority(SDL_THREAD_PRIORITY_HIGH);
+    thread_cpu_start = present::thread_cpu_ms();
+    thread_second_start = Clock::now();
+    present::Mailbox &mailbox = presenter->mailbox;
+    for (;;) {
+        if (mailbox.stopping()) break;
+        report_present_thread();
+        const std::uint64_t ticket = mailbox.ui_wanted();
+        PresentJob job = PresentJob::None;
+        std::optional<std::int64_t> due;
+        present_lock();
+        if (ticket != 0u) job = PresentJob::Interface;
+        else if (plain_pending) job = PresentJob::Flip;
+        else if (cycle_active) due = present_clock.next_due();
+        present_unlock();
+        if (job == PresentJob::None) {
+            const Clock::time_point now = Clock::now();
+            if (!due) {
+                // Nothing scheduled: a flip or the interface wakes the thread.
+                if (mailbox.wait_until(now + std::chrono::milliseconds(100)) == present::Mailbox::Wake::Stop) break;
+                continue;
+            }
+            const Clock::time_point at{std::chrono::microseconds(*due)};
+            if (at > now) {
+                // A flip in the meantime may move the grid: it wakes the wait.
+                const present::WaitPlan plan = present::plan_wait(now, at);
+                const present::Mailbox::Wake woke = mailbox.wait_until(plan.coarse_until);
+                if (woke == present::Mailbox::Wake::Stop) break;
+                if (woke == present::Mailbox::Wake::Posted) continue;
+                if (Clock::now() < at) present::precise_sleep_until(at);
+            }
+            job = PresentJob::Between;
+        }
+        make_present(job, ticket);
+    }
+}
+
+void VulkanRenderer::Impl::make_present(PresentJob job, std::uint64_t ticket) {
+    using Clock = std::chrono::steady_clock;
+    const auto ms = [](Clock::duration duration) { return std::chrono::duration<double, std::milli>(duration).count(); };
+    present::Mailbox &mailbox = presenter->mailbox;
+    const std::uint32_t slot = present_slot;
+    VkCommandBuffer commands = present_commands[slot];
+    VkFence fence = present_fences[slot];
+    VkSemaphore acquire = image_available[2u + slot];
+    // The slot's last present has finished: its command buffer, scratch area
+    // and overlay staging are free again.
+    wait_fence(fence, "the wait for a present slot");
+
+    // The swapchain, rebuilt here when the window or a setting changed it.
+    present_lock();
+    check_swapchain();
+    if (swapchain_dirty || swapchain == VK_NULL_HANDLE) recreate_swapchain();
+    const VkSwapchainKHR chain = swapchain;
+    present_unlock();
+    // Nothing could be shown: the job is given up.
+    const auto give_up = [&] {
+        present_lock();
+        if (job == PresentJob::Flip) plain_pending = false;
+        if (job == PresentJob::Between) {
+            ++interpolation_stats.blocked;
+            perf::note_missed_present(true);
+            (void)present_clock.take(to_us(Clock::now()));
+        }
+        present_unlock();
+        if (job == PresentJob::Interface) mailbox.ui_done(ticket);
+    };
+    if (chain == VK_NULL_HANDLE) {
+        // No swapchain could be made: nowhere to present to for now.
+        give_up();
+        (void)mailbox.wait_until(Clock::now() + std::chrono::milliseconds(50));
+        return;
+    }
+    // An image, waiting for the display as long as it takes, up to a limit:
+    // this thread holds nothing the game needs meanwhile.
+    std::uint32_t image_index = 0u;
+    const Clock::time_point acquire_start = Clock::now();
+    const VkResult acquired = vkAcquireNextImageKHR(device, chain, 100'000'000u, acquire, VK_NULL_HANDLE, &image_index);
+    const double acquire_ms = ms(Clock::now() - acquire_start);
+    thread_second.acquire_ms += acquire_ms;
+    thread_second.acquire_max_ms = std::max(thread_second.acquire_max_ms, acquire_ms);
+    if (acquired != VK_SUCCESS && acquired != VK_SUBOPTIMAL_KHR) {
+        if (acquired == VK_TIMEOUT || acquired == VK_NOT_READY) {
+            ++thread_second.blocked;
+            display_stalled += Clock::now() - acquire_start;
+            if (!display_stall_told && display_stalled >= std::chrono::seconds(1)) {
+                display_stall_told = true;
+                std::printf("[present] the display has taken no image for %.1f s (vsync with the monitor asleep?); "
+                            "the game runs on without presents\n",
+                            ms(display_stalled) / 1000.0);
+                std::fflush(stdout);
+            }
+        } else {
+            present_lock();
+            note_present_result(acquired);
+            present_unlock();
+        }
+        give_up();
+        return;
+    }
+    if (display_stall_told) {
+        std::printf("[present] the display takes images again after %.1f s\n", ms(display_stalled) / 1000.0);
+        std::fflush(stdout);
+    }
+    display_stalled = {};
+    display_stall_told = false;
+
+    // Recorded and submitted holding the renderer.
+    present_lock();
+    const Clock::time_point start = Clock::now();
+    if (acquired == VK_SUBOPTIMAL_KHR) swapchain_check = true;
+    vkResetFences(device, 1u, &fence);
+    present_regions[slot] = 0u;
+    collect_present_timer(slot);
+    vkResetCommandBuffer(commands, 0u);
+    VkCommandBufferBeginInfo begin{VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO};
+    begin.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+    vkBeginCommandBuffer(commands, &begin);
+    // The newest picture, or the target shown when there is none (after a
+    // resize, before the first flip).
+    const auto newest = [&]() -> VkImage {
+        if (newer_picture_valid) return pictures[newer_picture].color;
+        if (holding) return held.color;
+        const auto shown = targets.find(presented_target);
+        return shown != targets.end() ? shown->second.color : VK_NULL_HANDLE;
+    };
+    VkImage image = VK_NULL_HANDLE;
+    bool game_frame = true;
+    ImDrawData *ui = nullptr;
+    perf::PresentKind kind = perf::PresentKind::Flip;
+    float t = 1.0f;
+    std::uint32_t skipped = 0u;
+    double late_ms = 0.0;
+    std::optional<pacing::PresentClock::Present> between;
+    BetweenImage shown{};
+    switch (job) {
+    case PresentJob::Interface: {
+        game_frame = false;
+        if (ui_show_game) {
+            const auto found = targets.find(presented_target);
+            if (found != targets.end()) image = found->second.color;
+        }
+        ui = ui_request;
+        ui_request = nullptr;
+        break;
+    }
+    case PresentJob::Flip:
+        plain_pending = false;
+        image = plain_picture ? newest() : VK_NULL_HANDLE;
+        ui = plain_ui;
+        plain_ui = nullptr;
+        late_ms = ms(start - plain_flipped);
+        break;
+    case PresentJob::Between:
+    case PresentJob::None: {
+        if (cycle_active) between = present_clock.take(to_us(start));
+        if (between) {
+            InterpolationStats &stats = interpolation_stats;
+            stats.skipped += between->skipped;
+            late_ms = static_cast<double>(to_us(start) - between->time_us - present_clock.delay_us()) / 1000.0;
+            stats.max_late = std::max(stats.max_late, Clock::duration(std::chrono::microseconds(
+                                                          static_cast<std::int64_t>(std::max(0.0, late_ms) * 1000.0))));
+            shown = record_between(*between, slot, commands);
+            image = shown.image;
+            kind = shown.kind;
+            t = between->t;
+            skipped = between->skipped;
+        } else {
+            // The frames were dropped since it was due (a pause, a resize, a
+            // change to 30): the newest picture as it is.
+            image = newest();
+            kind = perf::PresentKind::Newest;
+        }
+        ui = frame_ui;
+        break;
+    }
+    }
+    if (!ui_ready) ui = nullptr;
+    presenting_blended = shown.blended;
+    breadcrumb(commands, "a present's copy to the window");
+    const bool capture = record_window(commands, &image_index, image, game_frame, ui);
+    presenting_blended = false;
+    submit_window(commands, fence, &image_index, acquire);
+    if (between) finish_between(*between, shown, start, false, false);
+    thread_second.late_max_ms = std::max(thread_second.late_max_ms, late_ms);
+    present_unlock();
+
+    const VkResult presented = present_window(image_index);
+    if (presented != VK_SUCCESS) {
+        present_lock();
+        note_present_result(presented);
+        present_unlock();
+    }
+    // The interface's own presents are not the game's (as before).
+    if (job != PresentJob::Interface) {
+        perf::count_noted_present(kind, t, skipped, late_ms);
+        ++thread_second.presents;
+    }
+    if (capture) {
+        present_lock();
+        write_capture(fence);
+        present_unlock();
+    }
+    if (job == PresentJob::Interface) mailbox.ui_done(ticket);
+    present_slot ^= 1u;
+}
+
+// Once a second, with <prefix>_PERF=log or <prefix>_TRACE_INTERPOLATION: the
+// present thread's [present-thread] line.
+void VulkanRenderer::Impl::report_present_thread() {
+    using Clock = std::chrono::steady_clock;
+    const Clock::time_point now = Clock::now();
+    if (now - thread_second_start < std::chrono::seconds(1)) return;
+    const double seconds = std::chrono::duration<double>(now - thread_second_start).count();
+    const double cpu = present::thread_cpu_ms();
+    present::ThreadSecond second = thread_second;
+    second.cpu_ms = cpu - thread_cpu_start;
+    const std::uint64_t waited = presenter->emu_wait_ns.load(std::memory_order_relaxed);
+    second.emu_wait_ms = static_cast<double>(waited - presenter->reported_emu_wait_ns) / 1.0e6;
+    presenter->reported_emu_wait_ns = waited;
+    thread_cpu_start = cpu;
+    thread_second = {};
+    thread_second_start = now;
+    bool show = false;
+    present_lock();
+    show = trace_interpolation || perf::options().log;
+    present_unlock();
+    if (!show) return;
+    char line[400];
+    std::snprintf(line, sizeof(line),
+                  "[present-thread] %.1f s: %u presents, cpu %.1f ms (%.1f%% of a core); waited for the renderer "
+                  "%.2f ms (longest %.2f), for an image %.2f ms (longest %.2f), %u not made; latest %.2f ms late; "
+                  "the emulation thread waited %.2f ms for it\n",
+                  seconds, second.presents, second.cpu_ms, second.cpu_ms / (seconds * 10.0), second.lock_wait_ms,
+                  second.lock_wait_max_ms, second.acquire_ms, second.acquire_max_ms, second.blocked,
+                  second.late_max_ms, second.emu_wait_ms);
+    std::fputs(line, stdout);
+    std::fflush(stdout);
+}
