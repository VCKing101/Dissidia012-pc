+void VulkanRenderer::Impl::destroy_snapshot(Target::Snapshot &snapshot) {
+    const bool counted = snapshot.image != VK_NULL_HANDLE;
+    for (VkDescriptorSet &descriptor : snapshot.descriptors)
+        if (descriptor != VK_NULL_HANDLE) vkFreeDescriptorSets(device, descriptor_pool, 1u, &descriptor);
+    vkDestroyImageView(device, snapshot.opaque_view, nullptr);
+    vkDestroyImageView(device, snapshot.view, nullptr);
+    vkDestroyImage(device, snapshot.image, nullptr);
+    vkFreeMemory(device, snapshot.memory, nullptr);
+    snapshot = Target::Snapshot{};
+    if (counted && snapshot_count != 0u) --snapshot_count;
+}
+
 void VulkanRenderer::Impl::destroy_target(Target &target) {
+    for (Target::Snapshot &snapshot : target.snapshots) destroy_snapshot(snapshot);
+    target.snapshots.clear();
     for (VkDescriptorSet &descriptor : target.copy_descriptors)
         if (descriptor != VK_NULL_HANDLE) vkFreeDescriptorSets(device, descriptor_pool, 1u, &descriptor);
     vkDestroyImageView(device, target.copy_opaque_view, nullptr);
@@ -5022,6 +5072,137 @@ VkDescriptorSet VulkanRenderer::Impl::framebuffer_descriptor(Target &target, boo
     return target.copy_descriptors[opaque ? 1u : 0u];
