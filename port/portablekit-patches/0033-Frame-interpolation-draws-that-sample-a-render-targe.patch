+VkDescriptorSet VulkanRenderer::Impl::framebuffer_snapshot(Target &target, bool opaque, std::uint32_t x,
+                                                           std::uint32_t y, std::uint32_t width, std::uint32_t height,
+                                                           std::array<float, 4> &mapping) {
+    const perf::SplitScope split(perf::Split::Texture);
+    if (x >= kPspWidth || y >= kPspHeight || width == 0u || height == 0u) return VK_NULL_HANDLE;
+    // The guest rectangle with a pixel of margin for filtering, in the
+    // target's pixels.
+    const float scale_x = static_cast<float>(target_extent.width) / static_cast<float>(kPspWidth);
+    const float scale_y = static_cast<float>(target_extent.height) / static_cast<float>(kPspHeight);
+    const auto clamp_to = [](float value, std::uint32_t limit) {
+        return static_cast<std::int32_t>(std::clamp(value, 0.0f, static_cast<float>(limit)));
+    };
+    const std::int32_t left = clamp_to(std::floor((static_cast<float>(x) - 1.0f) * scale_x), target_extent.width);
+    const std::int32_t top = clamp_to(std::floor((static_cast<float>(y) - 1.0f) * scale_y), target_extent.height);
+    const std::int32_t right =
+        clamp_to(std::ceil(static_cast<float>(std::min(x + width, kPspWidth) + 1u) * scale_x), target_extent.width);
+    const std::int32_t bottom =
+        clamp_to(std::ceil(static_cast<float>(std::min(y + height, kPspHeight) + 1u) * scale_y), target_extent.height);
+    if (right <= left || bottom <= top) return VK_NULL_HANDLE;
+    const VkOffset2D origin{left, top};
+    const VkExtent2D taken{static_cast<std::uint32_t>(right - left), static_cast<std::uint32_t>(bottom - top)};
+    const auto map = [&](const Target::Snapshot &snapshot) {
+        mapping = {scale_x / static_cast<float>(snapshot.extent.width),
+                   scale_y / static_cast<float>(snapshot.extent.height),
+                   -static_cast<float>(snapshot.origin.x) / static_cast<float>(snapshot.extent.width),
+                   -static_cast<float>(snapshot.origin.y) / static_cast<float>(snapshot.extent.height)};
+        return snapshot.descriptors[opaque ? 1u : 0u];
+    };
+    // The same pixels taken already, by this frame or one still recorded.
+    for (Target::Snapshot &snapshot : target.snapshots) {
+        if (snapshot.valid && snapshot.serial == target.draw_serial && snapshot.origin.x == origin.x &&
+            snapshot.origin.y == origin.y && snapshot.taken.width == taken.width &&
+            snapshot.taken.height == taken.height) {
+            snapshot.used_frame = frames;
+            return map(snapshot);
+        }
+    }
+    // A snapshot no recorded frame names any more: the frame drawing now,
+    // the newer and the older of the pair being blended keep theirs.
+    Target::Snapshot *slot = nullptr;
+    for (Target::Snapshot &snapshot : target.snapshots) {
+        const bool free = !snapshot.valid || snapshot.used_frame + 3u <= frames;
+        if (free && snapshot.extent.width >= taken.width && snapshot.extent.height >= taken.height &&
+            (slot == nullptr ||
+             snapshot.extent.width * snapshot.extent.height < slot->extent.width * slot->extent.height))
+            slot = &snapshot;
+    }
+    if (slot == nullptr) {
+        if (snapshot_count >= kMaxFramebufferSnapshots) {
+            static bool told = false;
+            if (!told) {
+                told = true;
+                std::cout << "[render] frame interpolation: no room for more snapshots of render targets; "
+                             "in-between frames may show a later pass's picture\n";
+            }
+            return VK_NULL_HANDLE;
+        }
+        Target::Snapshot added{};
+        // Some room to spare, so that strips and tiles of a few sizes share
+        // images.
+        added.extent = {std::max(taken.width, std::min(target_extent.width, taken.width * 2u)),
+                        std::max(taken.height, std::min(target_extent.height, taken.height * 2u))};
+        std::string error;
+        if (!create_image(added.extent.width, added.extent.height, VK_FORMAT_R8G8B8A8_UNORM,
+                          VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT, added.image, added.memory,
+                          added.view, VK_IMAGE_ASPECT_COLOR_BIT, error)) {
+            std::cout << "[render] cannot snapshot a render target: " << error << "\n";
+            destroy_snapshot(added);
+            return VK_NULL_HANDLE;
+        }
+        ++snapshot_count;
+        VkImageViewCreateInfo view_info{VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO};
+        view_info.image = added.image;
+        view_info.viewType = VK_IMAGE_VIEW_TYPE_2D;
+        view_info.format = VK_FORMAT_R8G8B8A8_UNORM;
+        view_info.components.a = VK_COMPONENT_SWIZZLE_ONE;
+        view_info.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0u, 1u, 0u, 1u};
+        bool made = vkCreateImageView(device, &view_info, nullptr, &added.opaque_view) == VK_SUCCESS;
+        for (std::size_t i = 0; made && i < added.descriptors.size(); ++i) {
+            VkDescriptorSetAllocateInfo descriptor_info{VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO};
+            descriptor_info.descriptorPool = descriptor_pool;
+            descriptor_info.descriptorSetCount = 1u;
+            descriptor_info.pSetLayouts = &descriptor_layout;
+            if (vkAllocateDescriptorSets(device, &descriptor_info, &added.descriptors[i]) != VK_SUCCESS) {
+                added.descriptors[i] = VK_NULL_HANDLE;
+                made = false;
+                break;
+            }
+            VkDescriptorImageInfo image_info{framebuffer_sampler(), i == 0u ? added.view : added.opaque_view,
+                                             VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL};
+            VkWriteDescriptorSet write{VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET};
+            write.dstSet = added.descriptors[i];
+            write.descriptorCount = 1u;
+            write.descriptorType = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER;
+            write.pImageInfo = &image_info;
+            vkUpdateDescriptorSets(device, 1u, &write, 0u, nullptr);
+        }
+        if (!made) {
+            destroy_snapshot(added);
+            return VK_NULL_HANDLE;
+        }
+        target.snapshots.push_back(added);
+        slot = &target.snapshots.back();
+    }
+    bring_alpha_up_to_date(target);
+    end_pass();
+    transition(command_buffer, target.color, VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL,
+               VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+    transition(command_buffer, slot->image,
+               slot->valid ? VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL : VK_IMAGE_LAYOUT_UNDEFINED,
+               VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+    VkImageCopy region{};
+    region.srcSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0u, 0u, 1u};
+    region.dstSubresource = region.srcSubresource;
+    region.srcOffset = {origin.x, origin.y, 0};
+    region.extent = {taken.width, taken.height, 1u};
+    vkCmdCopyImage(command_buffer, target.color, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, slot->image,
+                   VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1u, &region);
+    perf::count_target_copy();
+    transition(command_buffer, slot->image, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+               VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+    transition(command_buffer, target.color, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+               VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL);
+    slot->origin = origin;
+    slot->taken = taken;
+    slot->serial = target.draw_serial;
+    slot->used_frame = frames;
+    slot->valid = true;
+    return map(*slot);
+}
