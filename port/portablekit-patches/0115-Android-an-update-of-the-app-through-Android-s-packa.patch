From a99144ccab2ea1b885ea766173da358ab19aff13 Mon Sep 17 00:00:00 2001
From: VCKing101 <59761021+VCKing101@users.noreply.github.com>
Date: Thu, 19 Nov 2026 20:25:48 +1030
Subject: [PATCH] Android: an update of the app through Android's package
 installer

GameActivity.installPackage hands an APK in the app's own storage to
Android's PackageInstaller as an update of this app (setAppPackageName,
so no other package). Android asks the player to confirm, the first time
to let the app install apps, then stops the app and installs it over
itself. Its answers come back to the activity through a PendingIntent
(onNewIntent): the question to the player is shown, and a cancel or a
refusal is kept for installState(), installStatus() and installMessage().

- host/platform/android_jni: install_package() and install_answer().
- build_apk.sh: EXTRA_PERMISSIONS adds permissions to the manifest, such
  as REQUEST_INSTALL_PACKAGES, which only a game whose app installs its
  own updates asks for.

Tested with Dissidia 012's player app on a Galaxy S25 Ultra (Android 17):
an update from 0.7.98 to 0.7.99 installed over the app with its data kept;
going to Settings to allow installs came back as a cancel. Not tested:
other phones and Android versions, a refusal (another key, no space).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 host/platform/android_jni.cpp                 |  36 +++++
 host/platform/android_jni.hpp                 |  26 +++-
 packaging/android/README.md                   |   4 +-
 packaging/android/build_apk.sh                |  13 +-
 .../teamgdb/portablekit/GameActivity.java     | 133 +++++++++++++++++-
 5 files changed, 203 insertions(+), 9 deletions(-)

diff --git a/host/platform/android_jni.cpp b/host/platform/android_jni.cpp
index 5073494..b5fabbf 100644
--- a/host/platform/android_jni.cpp
+++ b/host/platform/android_jni.cpp
@@ -162,4 +162,40 @@ int open_document(const std::string &uri, const char *mode) {
     return fd;
 }
 
+bool install_package(const std::string &path) {
+    Call call;
+    if (!call.ok()) return false;
+    jmethodID id = call.method("installPackage", "(Ljava/lang/String;)Z");
+    if (id == nullptr) return false;
+    jstring file = call.string(path);
+    const jboolean handed = call.env->CallStaticBooleanMethod(call.type, id, file);
+    call.env->DeleteLocalRef(file);
+    if (call.failed()) return false;
+    return handed == JNI_TRUE;
+}
+
+InstallAnswer install_answer() {
+    InstallAnswer answer;
+    Call call;
+    if (!call.ok()) return answer;
+    jmethodID state = call.method("installState", "()I");
+    jmethodID status = call.method("installStatus", "()I");
+    jmethodID message = call.method("installMessage", "()Ljava/lang/String;");
+    if (state == nullptr || status == nullptr || message == nullptr) return answer;
+    const jint value = call.env->CallStaticIntMethod(call.type, state);
+    if (call.failed()) return answer;
+    switch (value) {
+    case 1: answer.state = InstallAnswer::State::Waiting; break;
+    case 2: answer.state = InstallAnswer::State::Cancelled; break;
+    case 3: answer.state = InstallAnswer::State::Failed; break;
+    default: break;
+    }
+    if (answer.state != InstallAnswer::State::Failed) return answer;
+    answer.status = call.env->CallStaticIntMethod(call.type, status);
+    if (call.failed()) answer.status = 1;  // STATUS_FAILURE
+    jobject text = call.env->CallStaticObjectMethod(call.type, message);
+    if (!call.failed()) answer.message = call.text(text).value_or(std::string());
+    return answer;
+}
+
 } // namespace portablekit::android
