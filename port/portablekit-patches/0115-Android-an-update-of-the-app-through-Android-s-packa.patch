  */
 public class GameActivity extends SDLActivity {
     private static final int kPickTree = 0x59414b01;
@@ -32,6 +39,17 @@ public class GameActivity extends SDLActivity {
     private static boolean sPickDone;
     private static String sPickResult;
 
+    // What Android answered about the latest installPackage(): installState().
+    private static final String kInstallStatus = "io.github.teamgdb.portablekit.INSTALL_STATUS";
+    private static final int kInstallNone = 0;
+    private static final int kInstallWaiting = 1;
+    private static final int kInstallCancelled = 2;
+    private static final int kInstallFailed = 3;
+    private static final Object sInstallLock = new Object();
+    private static int sInstallState = kInstallNone;
+    private static int sInstallStatus;
+    private static String sInstallMessage = "";
+
     /**
      * Keeps the game in landscape, either way up, as the manifest asks. SDL
      * calls this when it makes the window and would otherwise ask for every
@@ -129,6 +147,115 @@ public class GameActivity extends SDLActivity {
         super.onActivityResult(requestCode, resultCode, data);
     }
 
+    /**
+     * Hands an APK in the app's own storage to Android's package installer, as
+     * an update of this app: Android asks the player to confirm, then stops the
+     * app and installs it. The app needs android.permission.REQUEST_INSTALL_PACKAGES
+     * (build_apk.sh, EXTRA_PERMISSIONS); the first time, Android also asks the
+     * player to let it install apps. Blocks while the package is copied to the
+     * installer; false when that failed. installState() follows Android's answer.
+     */
+    public static boolean installPackage(String path) {
+        if (mSingleton == null) return false;
+        setInstall(kInstallWaiting, 0, "");
+        PackageInstaller installer = mSingleton.getPackageManager().getPackageInstaller();
+        PackageInstaller.SessionParams params =
+            new PackageInstaller.SessionParams(PackageInstaller.SessionParams.MODE_FULL_INSTALL);
+        // Only this app: a package with another name is refused.
+        params.setAppPackageName(mSingleton.getPackageName());
+        File file = new File(path);
+        params.setSize(file.length());
+        int id = -1;
+        try {
+            id = installer.createSession(params);
+            try (PackageInstaller.Session session = installer.openSession(id)) {
+                try (InputStream in = new FileInputStream(file);
+                     OutputStream out = session.openWrite("base.apk", 0, file.length())) {
+                    byte[] buffer = new byte[1 << 16];
+                    for (int n; (n = in.read(buffer)) > 0;) out.write(buffer, 0, n);
+                    session.fsync(out);
+                }
+                // Android's answers come back to this activity (onNewIntent).
+                // It fills in the intent's extras, so from Android 12 the
+                // intent must be mutable, and then explicit.
+                Intent answer = new Intent(mSingleton, GameActivity.class).setAction(kInstallStatus);
+                int flags = PendingIntent.FLAG_UPDATE_CURRENT;
+                if (Build.VERSION.SDK_INT >= 31) flags |= PendingIntent.FLAG_MUTABLE;
+                PendingIntent pending = PendingIntent.getActivity(mSingleton, id, answer, flags);
+                session.commit(pending.getIntentSender());
+            }
+            return true;
+        } catch (Exception e) {
+            if (id != -1) {
+                try {
+                    installer.abandonSession(id);
+                } catch (Exception ignored) {
+                }
+            }
+            setInstall(kInstallFailed, PackageInstaller.STATUS_FAILURE, e.toString());
+            return false;
+        }
+    }
+
+    /** 0 nothing asked, 1 waiting for Android or the player, 2 the player said no, 3 Android refused. */
+    public static int installState() {
+        synchronized (sInstallLock) {
+            return sInstallState;
+        }
+    }
+
+    /** With installState() 3: PackageInstaller's STATUS_FAILURE_* code. */
+    public static int installStatus() {
+        synchronized (sInstallLock) {
+            return sInstallStatus;
+        }
+    }
+
+    /** With installState() 3: Android's own words, for a log. */
+    public static String installMessage() {
+        synchronized (sInstallLock) {
+            return sInstallMessage;
+        }
+    }
+
+    private static void setInstall(int state, int status, String message) {
+        synchronized (sInstallLock) {
+            sInstallState = state;
+            sInstallStatus = status;
+            sInstallMessage = message != null ? message : "";
+        }
+    }
+
+    @Override
+    protected void onNewIntent(Intent intent) {
+        if (intent == null || !kInstallStatus.equals(intent.getAction())) {
+            super.onNewIntent(intent);
+            return;
+        }
+        int status = intent.getIntExtra(PackageInstaller.EXTRA_STATUS, PackageInstaller.STATUS_FAILURE);
+        String message = intent.getStringExtra(PackageInstaller.EXTRA_STATUS_MESSAGE);
+        if (status == PackageInstaller.STATUS_PENDING_USER_ACTION) {
+            // Android's question to the player: shown over the game.
+            Intent confirm = intent.getParcelableExtra(Intent.EXTRA_INTENT);
+            if (confirm != null) {
+                try {
+                    startActivity(confirm);
+                    return;
+                } catch (Exception e) {
+                    message = e.toString();
+                }
+            }
+            setInstall(kInstallFailed, PackageInstaller.STATUS_FAILURE, message);
+        } else if (status == PackageInstaller.STATUS_SUCCESS) {
+            // Usually never seen: Android stops the app to update it.
+            setInstall(kInstallNone, status, "");
+        } else if (status == PackageInstaller.STATUS_FAILURE_ABORTED) {
+            setInstall(kInstallCancelled, status, message);
+        } else {
+            setInstall(kInstallFailed, status, message);
+        }
+    }
+
     /** Starts the app afresh: this process ends and a new one opens the activity. */
     public static void relaunch() {
         if (mSingleton == null) return;
