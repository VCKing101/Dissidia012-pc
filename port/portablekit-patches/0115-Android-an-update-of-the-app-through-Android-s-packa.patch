 // What the Android app asks of its Java activity (GameActivity, packaging/android/java) through JNI:
-// the display cutout, and folders the player picks through the system's
-// document picker, read and written as content:// documents. Only in the
+// the display cutout, folders the player picks through the system's
+// document picker, read and written as content:// documents, and an update
+// of the app through Android's package installer. Only in the
 // Android app (PORTABLEKIT_ANDROID_APP); every call runs on the calling thread and
 // the picker blocks it until the player has chosen.
 
@@ -45,4 +46,25 @@ struct Entry {
 // truncating); -1 on failure.
 [[nodiscard]] int open_document(const std::string &uri, const char *mode);
 
+// Hands an APK in the app's own storage (`path`) to Android's package
+// installer as an update of this app. Android asks the player to confirm,
+// then stops the app and installs it. The app must ask for
+// android.permission.REQUEST_INSTALL_PACKAGES (build_apk.sh EXTRA_PERMISSIONS).
+// Blocks while the package is copied to the installer; false when that failed,
+// with install_answer() saying why.
+[[nodiscard]] bool install_package(const std::string &path);
+
+struct InstallAnswer {
+    enum class State {
+        None,       // nothing asked yet
+        Waiting,    // for Android or the player
+        Cancelled,  // the player said no
+        Failed,     // Android refused it
+    } state = State::None;
+    int status = 0;       // Failed: PackageInstaller's STATUS_FAILURE_* code
+    std::string message;  // Failed: Android's own words, for a log
+};
+// What Android has answered about the latest install_package().
+[[nodiscard]] InstallAnswer install_answer();
+
 } // namespace portablekit::android
