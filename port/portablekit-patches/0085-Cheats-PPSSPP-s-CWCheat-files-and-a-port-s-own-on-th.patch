+// CWCheat files and codes (host/cheats/cwcheat.hpp) against a stand-in memory:
+// what PPSSPP reads from a file, and what each kind of code writes.
+
+#include "cheats/cwcheat.hpp"
+
+#include <cstdio>
+#include <string>
+#include <vector>
+
+namespace {
+
+using namespace portablekit::cheats;
+
+int g_failures = 0;
+
+void check(bool condition, const char *what) {
+    std::printf("%s %s\n", condition ? "ok  " : "FAIL", what);
+    if (!condition) ++g_failures;
+}
+
+// 1 MiB of memory from 0x08800000; [0x08804000, 0x08804100) is code.
+class TestMemory final : public Memory {
+public:
+    static constexpr std::uint32_t kBase = 0x08800000u;
+    std::vector<std::uint8_t> bytes = std::vector<std::uint8_t>(0x100000u, 0u);
+
+    bool valid(std::uint32_t address, std::uint32_t size) const override {
+        return address >= kBase && size != 0u && address - kBase + size <= bytes.size();
+    }
+    std::uint8_t read8(std::uint32_t address) const override { return bytes[address - kBase]; }
+    void write8(std::uint32_t address, std::uint8_t value) override { bytes[address - kBase] = value; }
+    bool code(std::uint32_t address, std::uint32_t size) const override {
+        return address < 0x08804100u && 0x08804000u < address + size;
+    }
+
+    std::uint32_t get(std::uint32_t address, std::uint32_t size = 4u) const {
+        std::uint32_t v = 0u;
+        for (std::uint32_t i = 0; i < size; ++i) v |= static_cast<std::uint32_t>(read8(address + i)) << (8u * i);
+        return v;
+    }
+    void set(std::uint32_t address, std::uint32_t value, std::uint32_t size = 4u) {
+        for (std::uint32_t i = 0; i < size; ++i) write8(address + i, static_cast<std::uint8_t>(value >> (8u * i)));
+    }
+};
+
+Cheat cheat(std::vector<CodeLine> lines) {
+    Cheat c;
+    c.enabled = true;
+    c.lines = std::move(lines);
+    return c;
+}
+
+void file_tests() {
+    const std::string text = "\xEF\xBB\xBF_S ULUS-10566\r\n_G Dissidia 012\r\n_C0 Gil\r\n_L 0x203BFA00 0x05F5E0FF\r\n"
+                             "# a comment\r\n_C1 KP // note\r\n_L 203EE31C 000F423F # max\r\n_C2 Other\r\n"
+                             "_M 0x00000000 0x00000000\r\nnot a line\r\n";
+    CheatFile file = parse(text, "ULUS10566");
+    check(file.byte_order_mark && file.crlf, "a byte order mark and CRLF are noticed");
+    check(file.cheats.size() == 3u, "three cheats");
+    check(file.cheats[0].name == "Gil" && !file.cheats[0].enabled && file.cheats[0].lines.size() == 1u &&
+              file.cheats[0].lines[0].a == 0x203BFA00u && file.cheats[0].lines[0].b == 0x05F5E0FFu,
+          "_C0 is off, and its _L line is read");
+    check(file.cheats[1].enabled && file.cheats[1].lines.size() == 1u && file.cheats[1].lines[0].b == 0x000F423Fu,
+          "_C1 is on; 0x is optional and a comment may follow a line");
+    check(file.cheats[2].enabled && file.cheats[2].action_replay, "_C2 is on; _M marks Action Replay codes");
+    check(file.problems == 1u, "a line that is not a code is counted and skipped");
+    set_enabled(file, 0u, true);
+    set_enabled(file, 1u, false);
+    const std::string again = text_of(file);
+    check(again.find("_C1 Gil\r\n") != std::string::npos && again.find("_C0 KP // note\r\n") != std::string::npos &&
+              again.rfind("\xEF\xBB\xBF", 0) == 0u,
+          "turning cheats on and off rewrites their _C lines, keeping the BOM and line endings");
+    check(parse(again, "ULUS10566").cheats[0].enabled, "and reads back so");
+
+    const std::string sections = "_S ULES-01505\n_C1 Europe\n_L 0x20000000 1\n_S ULUS-10566\n_C1 USA\n_L 0x20000000 2\n";
+    const CheatFile usa = parse(sections, "ULUS10566");
+    check(usa.cheats.size() == 1u && usa.cheats[0].name == "USA", "with several _S, only this game's section");
+    const CheatFile other = parse("_S ULJM-05800\n_C1 One\n_L 0x20000000 1\n", "ULUS10566");
+    check(other.cheats.size() == 1u, "with one _S, its cheats count whatever it names, as in PPSSPP");
+}
+
+void write_tests() {
+    TestMemory m;
+    run(cheat({{0x00010000u, 0x000000ABu}, {0x00010010u, 0x0000ABCDu}, {0x00010020u, 0x12345678u}}), m, 0u);
+    check(m.get(0x08810000u) == 0xABu && m.get(0x08810010u) == 0xABCDu && m.get(0x08810020u) == 0x12345678u,
+          "0x0 writes as wide as its value: 8, 16 or 32 bits");
+    m.set(0x08810030u, 0xFFFFFFFFu);
+    run(cheat({{0x10010030u, 0x00001234u}, {0x20010040u, 0xDEADBEEFu}}), m, 0u);
+    check(m.get(0x08810030u) == 0xFFFF1234u && m.get(0x08810040u) == 0xDEADBEEFu, "0x1 writes 16 bits, 0x2 32");
+
+    m.set(0x08810050u, 10u, 1u);
+    m.set(0x08810054u, 1000u, 2u);
+    m.set(0x08810058u, 5u);
+    run(cheat({{0x30100005u, 0x00010050u}, {0x30400064u, 0x00010054u}, {0x30600000u, 0x00010058u}, {3u, 0u}}), m,
+        0u);
+    check(m.get(0x08810050u, 1u) == 15u && m.get(0x08810054u, 2u) == 900u && m.get(0x08810058u) == 2u,
+          "0x3 adds and subtracts 8, 16 and 32 bits (the 32-bit amount on the next line)");
+
+    run(cheat({{0x40010100u, 0x00030002u}, {100u, 10u}}), m, 0u);
+    check(m.get(0x08810100u) == 100u && m.get(0x08810108u) == 110u && m.get(0x08810110u) == 120u &&
+              m.get(0x08810104u) == 0u,
+          "0x4 writes a run of 32-bit values, stepping in words and growing by the increment");
+    run(cheat({{0x80010200u, 0x00030001u}, {0x00000007u, 1u}, {0x80010300u, 0x00020002u}, {0x10001234u, 0x10u}}), m,
+        0u);
+    check(m.get(0x08810200u, 1u) == 7u && m.get(0x08810201u, 1u) == 8u && m.get(0x08810202u, 1u) == 9u &&
+              m.get(0x08810300u, 2u) == 0x1234u && m.get(0x08810304u, 2u) == 0x1244u,
+          "0x8 writes runs of 8-bit or 16-bit values");
+
+    m.set(0x08810400u, 0x11223344u);
+    run(cheat({{0x50010400u, 4u}, {0x00010410u, 0u}}), m, 0u);
+    check(m.get(0x08810410u) == 0x11223344u, "0x5 copies bytes");
+
+    m.set(0x08810500u, 0x0Fu, 1u);
+    m.set(0x08810502u, 0xFF00u, 2u);
+    run(cheat({{0x70010500u, 0x000000F0u}, {0x70010502u, 0x00030F0Fu}}), m, 0u);
+    check(m.get(0x08810500u, 1u) == 0xFFu && m.get(0x08810502u, 2u) == 0x0F00u, "0x7 ORs 8 bits and ANDs 16");
+}
+
+void pointer_tests() {
+    TestMemory m;
+    // A pointer at 0x08810000 to a structure at 0x08820000.
+    m.set(0x08810000u, 0x08820000u);
+    run(cheat({{0x60010000u, 0x0000270Fu}, {0x00010001u, 0x00000E4Cu}}), m, 0u);
+    check(m.get(0x08820E4Cu, 2u) == 9999u, "0x6 writes 16 bits through a pointer at an offset");
+    // Two pointers: 0x08810004 -> 0x08830000, and +0x10 there -> 0x08840000.
+    m.set(0x08810004u, 0x08830000u);
+    m.set(0x08830010u, 0x08840000u);
+    run(cheat({{0x60010004u, 0x12345678u}, {0x00020002u, 0x00000020u}, {0x20000010u, 0u}}), m, 0u);
+    check(m.get(0x08840020u) == 0x12345678u, "0x6 follows a further pointer from an extra line");
+    m.set(0x08810008u, 0u);  // not a valid pointer
+    run(cheat({{0x60010008u, 1u}, {0x00000001u, 0u}}), m, 0u);
+    check(m.get(0x08810008u) == 0u, "a pointer that leads nowhere writes nothing");
+}
+
+void condition_tests() {
+    TestMemory m;
+    m.set(0x08810000u, 2u, 2u);
+    run(cheat({{0xD0010000u, 0x00000002u}, {0x20010010u, 1u}, {0xD0010000u, 0x00000003u}, {0x20010014u, 1u},
+               {0x20010018u, 1u}}),
+        m, 0u);
+    check(m.get(0x08810010u) == 1u && m.get(0x08810014u) == 0u && m.get(0x08810018u) == 1u,
+          "0xD 16-bit tests run or skip the next line");
+    run(cheat({{0xE1020002u, 0x00010000u}, {0x20010020u, 1u}, {0x20010024u, 1u}, {0xE1020005u, 0x00010000u},
+               {0x20010028u, 1u}, {0x2001002Cu, 1u}, {0x20010030u, 1u}}),
+        m, 0u);
+    check(m.get(0x08810020u) == 1u && m.get(0x08810024u) == 1u && m.get(0x08810028u) == 0u &&
+              m.get(0x0881002Cu) == 0u && m.get(0x08810030u) == 1u,
+          "0xE runs or skips the given number of lines");
+    run(cheat({{0xE0020002u, 0x10010000u}, {0x20010040u, 1u}, {0x20010044u, 1u}}), m, 0u);
+    check(m.get(0x08810040u) == 0u && m.get(0x08810044u) == 0u, "0xE with a 16-bit not-equal test");
+    // Buttons: L + R (0x300).
+    const Cheat joker = cheat({{0xD0000000u, 0x10000300u}, {0x20010050u, 7u}});
+    run(joker, m, 0x100u);
+    check(m.get(0x08810050u) == 0u, "a button code does nothing while not all its buttons are held");
+    run(joker, m, 0x300u | 0x4000u);
+    check(m.get(0x08810050u) == 7u, "and runs while they are");
+    m.set(0x08810060u, 5u);
+    run(cheat({{0xC0010060u, 6u}, {0x20010064u, 1u}}), m, 0u);
+    check(m.get(0x08810064u) == 0u, "0xC ends the cheat while memory does not hold the value");
+    m.set(0x08810070u, 9u);
+    m.set(0x08810074u, 9u);
+    run(cheat({{0xD0010070u, 0x40010074u}, {1u, 2u}, {0x20010078u, 1u}, {0x2001007Cu, 1u}}), m, 0u);
+    check(m.get(0x08810078u) == 1u, "0xD compares two addresses");
+}
+
+void code_tests() {
+    TestMemory m;
+    m.set(0x08804010u, 0x03E00008u);
+    const RunResult r = run(cheat({{0x20004010u, 0x00000000u}, {0x20010000u, 5u}}), m, 0u);
+    check(r.wrote_code && m.get(0x08804010u) == 0x03E00008u && m.get(0x08810000u) == 5u,
+          "a write into code is left out and reported; the cheat's other writes are made");
+    const RunResult bad = run(cheat({{0xF0000000u, 0u}, {0x20010004u, 1u}}), m, 0u);
+    check(bad.invalid && m.get(0x08810004u) == 0u, "a line it cannot run ends the pass");
+    Cheat off = cheat({{0x20010008u, 1u}});
+    off.enabled = false;
+    run(off, m, 0u);
+    check(m.get(0x08810008u) == 0u, "a cheat that is off does nothing");
+}
+
+} // namespace
+
+int main() {
+    file_tests();
+    write_tests();
+    pointer_tests();
+    condition_tests();
+    code_tests();
+    if (g_failures != 0) std::printf("%d failed\n", g_failures);
+    return g_failures == 0 ? 0 : 1;
+}
