+bool overlay_code_overlaps(const psprecomp::GuestMemory &memory, std::uint32_t address, std::uint32_t size) {
+    const std::uint64_t start = address, end = static_cast<std::uint64_t>(address) + size;
+    const auto overlaps = [&](std::uint64_t from, std::uint64_t to) { return start < to && from < end; };
+    const std::span<const std::uint32_t> slots = active_overlay_slots();
+    for (std::size_t i = 0; i + 1u < slots.size(); ++i) {
+        const std::uint32_t slot = slots[i];
+        // An image no corpus matched runs interpreted: writes change it, as
+        // on a PSP.
+        if (const auto unmatched = unmatched_slots().find(slot);
+            unmatched != unmatched_slots().end() && unmatched->second == header_hash(memory, slot))
+            continue;
+        // The image's own header gives its code's size (a big image runs past
+        // the next slot's base); without one, the largest corpus there.
+        std::uint64_t code_end = 0u;
+        if (memory.raw_pointer(slot, kOverlayHeaderBytes) != nullptr && memory.load8(slot) == 'M' &&
+            memory.load8(slot + 1u) == 'W' && memory.load8(slot + 2u) == 'o' && memory.load8(slot + 3u) == '3' &&
+            memory.load32(slot + 8u) == slot) {
+            code_end = slot + kOverlayHeaderBytes + std::min<std::uint64_t>(memory.load32(slot + 12u), 0x2000000u);
+        } else {
+            for (const OverlayCorpus &corpus : overlay_corpora())
+                if (corpus.base == slot)
+                    code_end = std::max<std::uint64_t>(code_end, slot + kOverlayHeaderBytes + corpus.code_size);
+        }
+        if (overlaps(slot, code_end)) return true;
+    }
+    for (const OverlayCorpus &corpus : overlay_corpora())
+        if (slot_of(corpus.base).first == 0u && overlaps(corpus.base, corpus.base + kOverlayHeaderBytes + corpus.code_size))
+            return true;
+    return false;
+}
