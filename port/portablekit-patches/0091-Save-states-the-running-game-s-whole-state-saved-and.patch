+    snapshot::add(
+        "threadman",
+        [] { return std::any(ThreadmanSaved{vpls(), fpls(), msg_pipes(), lwmutex::by_work_area()}); },
+        [](const std::any &any) {
+            const ThreadmanSaved &saved = std::any_cast<const ThreadmanSaved &>(any);
+            vpls() = saved.vpls;
