+// A context as a save state keeps it (host/snapshot.hpp): everything but the
+// decoder, which stays where it is. A restored context takes the frames the
+// decoder already made from `recent` until it is back at its next frame, so
+// the music comes out as it did. A context made since the save gets a fresh
+// decoder, and its first frame is decoded as after a seek.
+struct ContextSaved {
+    bool loaded{};
+    TrackInfo track;
+    std::uint32_t buffer{};
+    std::uint32_t buffer_size{};
+    std::int32_t loop_num{};
+    std::int32_t position{};
+    std::shared_ptr<const audio::HostPcm> host;
+    std::int64_t cached_frame{};
+    std::vector<std::int16_t> cached;
+    bool streaming{};
+    std::uint32_t written{};
+    std::uint32_t cursor{};
+    std::uint32_t wraps{};
+    std::uint32_t loops_done{};
+    std::uint32_t stored_from{};
+    std::vector<std::uint8_t> stored;
+    std::uint32_t codec_type{};
+    bool low_level{};
+    std::uint32_t low_level_frame_bytes{};
+    std::uint32_t low_level_out_channels{};
+    std::uint64_t made{};  // frames the decoder had made
+};
+
+void add_atrac_to_snapshots() {
+    using Saved = std::array<std::optional<ContextSaved>, kMaxAtracIds>;
+    snapshot::add(
+        "atrac",
+        [] {
+            Saved saved;
+            for (std::size_t id = 0; id < kMaxAtracIds; ++id) {
+                const AtracContext *c = contexts()[id].get();
+                if (c == nullptr) continue;
+                saved[id] = ContextSaved{c->loaded, c->track, c->buffer, c->buffer_size, c->loop_num, c->position,
+                                         c->host, c->cached_frame, c->cached, c->streaming, c->written, c->cursor,
+                                         c->wraps, c->loops_done, c->stored_from, c->stored, c->codec_type,
+                                         c->low_level, c->low_level_frame_bytes, c->low_level_out_channels,
+                                         c->made};
+            }
+            return std::any(saved);
+        },
+        [](const std::any &any) {
+            const Saved &saved = std::any_cast<const Saved &>(any);
+            for (std::size_t id = 0; id < kMaxAtracIds; ++id) {
+                std::unique_ptr<AtracContext> &slot = contexts()[id];
+                if (!saved[id]) {
+                    slot.reset();
+                    continue;
+                }
+                const ContextSaved &c = *saved[id];
+                // A context made since the save, or one whose track changed,
+                // needs its decoder opened for the saved track.
+                const bool reopen = !slot || slot->track.codec != c.track.codec ||
+                                    slot->track.channels != c.track.channels ||
+                                    slot->track.block_align != c.track.block_align ||
+                                    slot->track.extradata != c.track.extradata;
+                if (!slot) slot = std::make_unique<AtracContext>();
+                AtracContext &live = *slot;
+                if (reopen && c.loaded && !c.host)
+                    live.decoder.open(c.track.codec, c.track.channels, c.track.block_align, c.track.extradata);
+                live.loaded = c.loaded;
+                live.track = c.track;
+                live.buffer = c.buffer;
+                live.buffer_size = c.buffer_size;
+                live.loop_num = c.loop_num;
+                live.position = c.position;
+                live.host = c.host;
+                live.replay.clear();
+                if (reopen) {
+                    live.next_frame = -1;
+                    live.recent.clear();
+                } else {
+                    for (const AtracContext::Made &m : live.recent)
+                        if (m.serial >= c.made) live.replay.push_back(m);
+                    // Older than the frames kept: nothing to hand out, so a seek.
+                    if (live.made > c.made && (live.recent.empty() || live.recent.front().serial > c.made)) {
+                        live.replay.clear();
+                        live.next_frame = -1;
+                    }
+                }
+                live.cached_frame = c.cached_frame;
+                live.cached = c.cached;
+                live.streaming = c.streaming;
+                live.written = c.written;
+                live.cursor = c.cursor;
+                live.wraps = c.wraps;
+                live.loops_done = c.loops_done;
+                live.stored_from = c.stored_from;
+                live.stored = c.stored;
+                live.codec_type = c.codec_type;
+                live.low_level = c.low_level;
+                live.low_level_frame_bytes = c.low_level_frame_bytes;
+                live.low_level_out_channels = c.low_level_out_channels;
+            }
+        });
+}
+
 } // namespace
 
