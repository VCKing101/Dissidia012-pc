+#pragma once
+
+// Save states of the running game, for rollback netplay: everything a run
+// depends on, taken between two dispatches (the runtime's post-dispatch hook),
+// when no recompiled frame is live and every guest thread's registers are in
+// its context. A state holds guest RAM and VRAM, the running thread's
+// context, the runtime's starvation phase, the kernel's objects and clock, and
+// what each participant adds: the HLE modules' own state (display, controller
+// latch, audio channels, SAS voices, threadman pools, open files) and anything
+// a port keeps that the game's run reads back.
+//
+// Not in a state, on purpose: the host's renderer and the frames it holds,
+// what the sound device has already played, the network, real-time pacing,
+// and logs. Restoring a state does not undo them.
+
+#include "psprecomp/runtime.hpp"
+
+#include <any>
+#include <cstdint>
+#include <functional>
+#include <memory>
+#include <string>
+#include <vector>
+
+namespace portablekit::snapshot {
+
+// Something outside guest memory and the kernel that a game's run depends on:
+// `save` copies it out, `restore` puts a copy back. Add participants before
+// the first save; the name is for messages.
+void add(std::string name, std::function<std::any()> save, std::function<void(const std::any &)> restore);
+
+struct State;
+
+// The whole state now. Call only between dispatches.
+[[nodiscard]] std::shared_ptr<const State> save(psprecomp::Runtime &runtime);
+// Puts `state` back: the next dispatch runs where it was taken.
+void restore(psprecomp::Runtime &runtime, const State &state);
+
+// The bytes a state keeps, for logs.
+[[nodiscard]] std::size_t size(const State &state);
+
+} // namespace portablekit::snapshot
