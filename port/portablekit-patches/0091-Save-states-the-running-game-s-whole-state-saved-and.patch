+// The open files as a save state keeps them (host/snapshot.hpp): every
+// handle's position and pending result, not the host's own streams. A handle
+// to a host file that was closed after the save cannot come back, and says so.
+struct FileSaved {
+    OpenFile::Kind kind{};
+    std::string path;
+    std::uint64_t disc_offset{};
+    std::uint64_t size{};
+    std::uint64_t position{};
+    bool sector_units{};
+    std::shared_ptr<hle_extension::FileFilter> filter;
+    std::uint64_t unfiltered_size{};
+    std::vector<OpenFile::DirectoryEntry> entries;
+    std::size_t next_entry{};
+    std::optional<std::int64_t> async_result;
+    bool release_after_async{};
+    SceUID async_callback{};
+    std::uint32_t async_callback_argument{};
+};
+
+struct IoSaved {
+    std::map<std::uint32_t, FileSaved> files;
+    std::uint32_t next_fd{};
+    std::map<std::uint32_t, DiscReadAhead> read_ahead;
+    std::uint32_t next_read_ahead{};
+    std::string current_directory;
+};
+
+void put_back(OpenFile &live, const FileSaved &f) {
+    live.kind = f.kind;
+    live.path = f.path;
+    live.disc_offset = f.disc_offset;
+    live.size = f.size;
+    live.position = f.position;
+    live.sector_units = f.sector_units;
+    live.filter = f.filter;
+    live.unfiltered_size = f.unfiltered_size;
+    live.entries = f.entries;
+    live.next_entry = f.next_entry;
+    live.async_result = f.async_result;
+    live.release_after_async = f.release_after_async;
+    live.async_callback = f.async_callback;
+    live.async_callback_argument = f.async_callback_argument;
+}
+
+void add_io_to_snapshots() {
+    snapshot::add(
+        "io",
+        [] {
+            const IoState &state = io();
+            IoSaved saved{{}, state.next_fd, state.read_ahead, state.next_read_ahead, state.current_directory};
+            for (const auto &[fd, f] : state.files)
+                saved.files.emplace(fd, FileSaved{f.kind, f.path, f.disc_offset, f.size, f.position, f.sector_units,
+                                                  f.filter, f.unfiltered_size, f.entries, f.next_entry,
+                                                  f.async_result, f.release_after_async, f.async_callback,
+                                                  f.async_callback_argument});
+            return std::any(saved);
+        },
+        [](const std::any &any) {
+            const IoSaved &saved = std::any_cast<const IoSaved &>(any);
+            IoState &state = io();
+            for (auto it = state.files.begin(); it != state.files.end();)
+                it = saved.files.count(it->first) == 0u ? state.files.erase(it) : std::next(it);
+            for (const auto &[fd, f] : saved.files) {
+                const auto live = state.files.find(fd);
+                if (live != state.files.end() && live->second.path == f.path && live->second.kind == f.kind) {
+                    put_back(live->second, f);
+                    continue;
+                }
+                if (f.kind == OpenFile::Kind::Host) {
+                    std::cerr << "[snapshot] " << f.path << " was closed after the save; its handle " << fd
+                              << " does not come back" << std::endl;
+                    continue;
+                }
+                OpenFile &made = state.files[fd];
+                made.host.reset();
+                put_back(made, f);
+            }
+            state.next_fd = saved.next_fd;
+            state.read_ahead = saved.read_ahead;
+            state.next_read_ahead = saved.next_read_ahead;
+            state.current_directory = saved.current_directory;
+        });
+}
+
