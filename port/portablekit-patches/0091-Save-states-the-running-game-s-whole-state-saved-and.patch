@@ -0,0 +1,65 @@
+#include "snapshot.hpp"
+
+#include "kernel/kernel.hpp"
+
+#include <utility>
+
+namespace portablekit::snapshot {
+
+namespace {
+
+struct Participant {
+    std::string name;
+    std::function<std::any()> save;
+    std::function<void(const std::any &)> restore;
+};
+
+std::vector<Participant> &participants() {
+    static std::vector<Participant> list;
+    return list;
+}
+
+} // namespace
+
+struct State {
+    std::vector<std::uint8_t> ram;
+    std::vector<std::uint8_t> vram;
+    psprecomp::AllegrexContext cpu;
+    std::uint64_t starvation_phase{};
+    std::int32_t thread_uid{};
+    std::string thread_name;
+    std::shared_ptr<const Kernel::Saved> kernel;
+    std::vector<std::any> parts;
+};
+
+void add(std::string name, std::function<std::any()> save, std::function<void(const std::any &)> restore) {
+    participants().push_back(Participant{std::move(name), std::move(save), std::move(restore)});
+}
+
+std::shared_ptr<const State> save(psprecomp::Runtime &runtime) {
+    auto state = std::make_shared<State>();
+    state->ram = runtime.memory().bytes();
+    state->vram = runtime.memory().vram_bytes();
+    state->cpu = runtime.cpu();
+    state->starvation_phase = runtime.starvation_phase();
+    state->thread_uid = psprecomp::runtime_thread_uid();
+    state->thread_name = psprecomp::runtime_thread_name();
+    state->kernel = kernel().save_state();
+    state->parts.reserve(participants().size());
+    for (const Participant &p : participants()) state->parts.push_back(p.save());
+    return state;
+}
+
+void restore(psprecomp::Runtime &runtime, const State &state) {
+    runtime.memory().restore_bytes(state.ram, state.vram);
+    runtime.cpu() = state.cpu;
+    runtime.set_starvation_phase(state.starvation_phase);
+    psprecomp::set_runtime_thread_identity(state.thread_uid, state.thread_name);
+    kernel().restore_state(*state.kernel);
+    const std::vector<Participant> &list = participants();
+    for (std::size_t i = 0; i < list.size() && i < state.parts.size(); ++i) list[i].restore(state.parts[i]);
+}
+
+std::size_t size(const State &state) { return state.ram.size() + state.vram.size(); }
+
+} // namespace portablekit::snapshot
