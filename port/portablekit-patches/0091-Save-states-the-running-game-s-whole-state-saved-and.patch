+void GuestMemory::restore_bytes(const std::vector<std::uint8_t> &ram, const std::vector<std::uint8_t> &vram) {
+    if (ram.size() != bytes_.size() || vram.size() != vram_.size())
+        throw Error("a save state's memory does not match this guest's");
+    std::memcpy(bytes_.data(), ram.data(), ram.size());
+    std::memcpy(vram_.data(), vram.data(), vram.size());
+}
