+
+std::shared_ptr<const Kernel::Saved> Kernel::save_state() const {
+    auto saved = std::make_shared<Saved>();
+    for (const auto &[uid, thread] : threads_) saved->threads.emplace(uid, *thread);
+    saved->next_uid = next_uid_;
+    saved->current_uid = current_uid_;
+    saved->next_ready_sequence = next_ready_sequence_;
+    saved->now_us = now_us_;
+    saved->waits_begun = waits_begun_;
+    saved->busy_thread = busy_thread_;
+    saved->busy_waits = busy_waits_;
+    saved->idle_vblanks = idle_vblanks_;
+    saved->next_vblank_us = next_vblank_us_;
+    saved->vblank_count = vblank_count_;
+    saved->dispatch_enabled = dispatch_enabled_;
+    saved->interrupts_enabled = interrupts_enabled_;
+    saved->blocks = blocks_;
+    saved->free_ranges = free_ranges_;
+    saved->guest_calls = guest_calls_;
+    saved->pending_interrupts = pending_interrupts_;
+    saved->interrupt_active = interrupt_active_;
+    saved->interrupted_idle = interrupted_idle_;
+    saved->interrupted_context = interrupted_context_;
+    saved->interrupt_on_return = interrupt_on_return_;
+    saved->semaphores = semaphores;
+    saved->event_flags = event_flags;
+    saved->mutexes = mutexes;
+    saved->mailboxes = mailboxes;
+    saved->callbacks = callbacks;
+    saved->vtimers = vtimers;
+    saved->sub_interrupts = sub_interrupts;
+    return saved;
+}
+
+void Kernel::restore_state(const Saved &saved) {
+    // Threads in place where they exist, so a Thread a caller still points
+    // at stays the same object.
+    for (auto it = threads_.begin(); it != threads_.end();)
+        it = saved.threads.count(it->first) == 0u ? threads_.erase(it) : std::next(it);
+    for (const auto &[uid, thread] : saved.threads) {
+        auto &slot = threads_[uid];
+        if (slot) *slot = thread;
+        else slot = std::make_unique<Thread>(thread);
+    }
+    next_uid_ = saved.next_uid;
+    current_uid_ = saved.current_uid;
+    next_ready_sequence_ = saved.next_ready_sequence;
+    now_us_ = saved.now_us;
+    waits_begun_ = saved.waits_begun;
+    busy_thread_ = saved.busy_thread;
+    busy_waits_ = saved.busy_waits;
+    busy_since_ = std::chrono::steady_clock::now();
+    idle_vblanks_ = saved.idle_vblanks;
+    next_vblank_us_ = saved.next_vblank_us;
+    vblank_count_ = saved.vblank_count;
+    dispatch_enabled_ = saved.dispatch_enabled;
+    interrupts_enabled_ = saved.interrupts_enabled;
+    blocks_ = saved.blocks;
+    free_ranges_ = saved.free_ranges;
+    guest_calls_ = saved.guest_calls;
+    pending_interrupts_ = saved.pending_interrupts;
+    interrupt_active_ = saved.interrupt_active;
+    interrupted_idle_ = saved.interrupted_idle;
+    interrupted_context_ = saved.interrupted_context;
+    interrupt_on_return_ = saved.interrupt_on_return;
+    semaphores = saved.semaphores;
+    event_flags = saved.event_flags;
+    mutexes = saved.mutexes;
+    mailboxes = saved.mailboxes;
+    callbacks = saved.callbacks;
+    vtimers = saved.vtimers;
+    sub_interrupts = saved.sub_interrupts;
+    // Emulated time went back: the hold to real time starts again from here,
+    // or the next frames would race to make up the frames undone.
+    pacing_started_ = false;
+}
