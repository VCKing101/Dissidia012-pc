+            for (std::size_t i = 0; i < m.audio.size(); ++i) {
+                const std::uint64_t cursor = m.audio[i].cursor;  // the sound device's, not the game's
+                m.audio[i] = saved.audio[i];
+                m.audio[i].cursor = cursor;
+            }
+            m.output2_channel = saved.output2_channel;
+            m.ge = saved.ge;
+            ctrl_latch() = saved.latch;
+            audio::sas_cores() = saved.sas;
+        });
+}
