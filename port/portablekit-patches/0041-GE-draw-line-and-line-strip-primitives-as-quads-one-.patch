+    expect(near(box.y0, 0.1f - 0.5f / 136.0f) && near(box.y1, 0.1f + 0.5f / 136.0f),
+           "the quad is one PSP pixel tall, centred on the line");
+    for (const Vertex &v : out) {
+        expect(near(v.position[2], 0.2f), "depth is kept");
+        expect(v.color == (v.position[0] < 0.0f ? 0xFF00FF00u : 0xFFFFFFFFu), "each end keeps its colour");
+        expect(near(v.texcoord[0], v.position[0] < 0.0f ? 0.0f : 1.0f), "each end keeps its texture coordinates");
+    }
