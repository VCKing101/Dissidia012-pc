diff --git a/host/gpu/line_quads.hpp b/host/gpu/line_quads.hpp
new file mode 100644
index 0000000..c167f1e
--- /dev/null
+++ b/host/gpu/line_quads.hpp
@@ -0,0 +1,230 @@
+#pragma once
+
+#include "ge_state.hpp"
+
+#include <array>
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+#include <utility>
+#include <vector>
+
+// GE lines (primitive types 1 and 2) drawn as thin quads.
+//
+// The GE rasterises a line one pixel wide: one pixel for each step along the
+// line's major axis, the way a DDA line is drawn. Vulkan's own line topology
+// draws one framebuffer pixel wide, which at four times the PSP's resolution
+// is a quarter of the line the game drew, and wide lines are an optional
+// feature with their own rules at the ends. So each segment becomes two
+// triangles instead, through the same pipelines, blending, depth and stencil
+// state as any other triangle.
+//
+// The quad is one *PSP* pixel wide, measured along the minor axis, not across
+// the line: a mostly horizontal segment is 1 PSP pixel tall in every column
+// it spans, and a mostly vertical one 1 PSP pixel wide in every row. That is
+// the coverage of the GE's line at 1x (a 45-degree line covers one pixel per
+// column, not 1.41), so an additive line adds the same light per unit of
+// length as on the handheld, and at internal scale N it covers N target
+// pixels across, the same share of the screen. A one-target-pixel line would
+// be a quarter as bright at 4x and break up into dots when anti-aliased away.
+//
+// Ends: the quad runs from one end to the other and stops there, with no cap.
+// The consecutive segments of a strip meet without covering their shared end
+// twice, which matters for the additive lines games draw; at 1x it is the
+// usual half-open rule (the last pixel of a segment is the next one's first).
+//
+// Colour, texture coordinates and depth: each end's two corners carry that
+// end's vertex, so the GPU interpolates them along the line as the GE
+// interpolates a Gouraud-shaded line.
+namespace portablekit::gpu {
+
+namespace line_detail {
+
+inline std::uint32_t lerp_color(std::uint32_t a, std::uint32_t b, double t) {
+    std::uint32_t out = 0u;
+    for (std::uint32_t shift = 0u; shift < 32u; shift += 8u) {
+        const double from = static_cast<double>((a >> shift) & 0xFFu);
+        const double to = static_cast<double>((b >> shift) & 0xFFu);
+        const auto value = static_cast<std::uint32_t>(std::lround(from + (to - from) * t));
+        out |= (value > 255u ? 255u : value) << shift;
+    }
+    return out;
+}
+
+// The vertex a fraction t of the way from a to b: what a segment cut at the
+// near plane starts from. Clip coordinates are linear in the vertex's, so
+// cutting the vertex there cuts the clip-space segment at the same place.
+inline Vertex lerp(const Vertex &a, const Vertex &b, double t) {
+    Vertex out = a;
+    const auto mix = [t](float from, float to) {
+        return static_cast<float>(static_cast<double>(from) + (static_cast<double>(to) - from) * t);
+    };
+    for (std::size_t i = 0; i < 4u; ++i) out.position[i] = mix(a.position[i], b.position[i]);
+    for (std::size_t i = 0; i < 3u; ++i) out.normal[i] = mix(a.normal[i], b.normal[i]);
+    for (std::size_t i = 0; i < 2u; ++i) out.texcoord[i] = mix(a.texcoord[i], b.texcoord[i]);
+    out.color = lerp_color(a.color, b.color, t);
+    return out;
+}
+
+// The inverse of a column-major 4x4 matrix by Gauss-Jordan elimination with
+// partial pivoting; false when it has none.
+inline bool invert(const std::array<double, 16> &m, std::array<double, 16> &out) {
+    // Row-major working copy [A | I].
+    double a[4][8]{};
+    for (std::size_t row = 0; row < 4u; ++row) {
+        for (std::size_t column = 0; column < 4u; ++column) a[row][column] = m[column * 4u + row];
+        a[row][4u + row] = 1.0;
+    }
+    for (std::size_t column = 0; column < 4u; ++column) {
+        std::size_t pivot = column;
+        for (std::size_t row = column + 1u; row < 4u; ++row)
+            if (std::fabs(a[row][column]) > std::fabs(a[pivot][column])) pivot = row;
+        if (!(std::fabs(a[pivot][column]) > 1e-30)) return false;
+        if (pivot != column)
+            for (std::size_t k = 0; k < 8u; ++k) std::swap(a[pivot][k], a[column][k]);
+        const double scale = 1.0 / a[column][column];
+        for (std::size_t k = 0; k < 8u; ++k) a[column][k] *= scale;
+        for (std::size_t row = 0; row < 4u; ++row) {
+            if (row == column || a[row][column] == 0.0) continue;
+            const double factor = a[row][column];
+            for (std::size_t k = 0; k < 8u; ++k) a[row][k] -= factor * a[column][k];
+        }
+    }
+    for (std::size_t row = 0; row < 4u; ++row)
+        for (std::size_t column = 0; column < 4u; ++column) out[column * 4u + row] = a[row][4u + column];
+    return true;
+}
+
+// Two triangles over the quad whose corners are a0, a1 at one end and b0, b1
+// at the other (a0 and b0 on the same side). Culling is off for lines, so the
+// winding does not matter.
+inline void push_quad(std::vector<Vertex> &out, const Vertex &a0, const Vertex &a1, const Vertex &b0,
+                      const Vertex &b1) {
+    out.push_back(a0);
+    out.push_back(b0);
+    out.push_back(b1);
+    out.push_back(a0);
+    out.push_back(b1);
+    out.push_back(a1);
+}
+
+} // namespace line_detail
+
+// Calls f(first, second) with the positions in the primitive (before the
+// index list) of each segment's two ends: pairs for lines, every consecutive
+// pair for a strip. Nothing for other primitives.
+template <typename F>
+void for_each_line_segment(PrimitiveType primitive, std::size_t count, F &&f) {
+    if (primitive == PrimitiveType::Lines) {
+        for (std::size_t i = 0; i + 1u < count; i += 2u) f(i, i + 1u);
+    } else if (primitive == PrimitiveType::LineStrip) {
+        for (std::size_t i = 0; i + 1u < count; ++i) f(i, i + 1u);
+    }
+}
+
+// A through-mode segment: positions are screen pixels, and the pixel a
+// coordinate names is the one whose top-left corner it is (a through-mode
+// sprite from (x, y) to (x + 1, y + 1) is pixel (x, y)), so the quad is centred
+// half a pixel in. `width` is in PSP pixels (1 as the GE draws). Appends six
+// vertices, none for a segment of no length.
+inline void expand_through_line(const Vertex &a, const Vertex &b, std::vector<Vertex> &out, float width = 1.0f) {
+    const float dx = b.position[0] - a.position[0];
+    const float dy = b.position[1] - a.position[1];
+    if (dx == 0.0f && dy == 0.0f) return;
+    const float half = 0.5f * width;
+    const bool x_major = std::fabs(dx) >= std::fabs(dy);
+    const float ox = x_major ? 0.0f : half;
+    const float oy = x_major ? half : 0.0f;
+    const auto corner = [&](const Vertex &v, float sign) {
+        Vertex c = v;
+        c.position[0] = v.position[0] + 0.5f + sign * ox;
+        c.position[1] = v.position[1] + 0.5f + sign * oy;
+        return c;
+    };
+    line_detail::push_quad(out, corner(a, -1.0f), corner(a, 1.0f), corner(b, -1.0f), corner(b, 1.0f));
+}
+
+// A transformed segment. `transform` is projection times view times world
+// (column-major), what the vertex shader multiplies object positions by;
+// `x_scale` and `y_scale` the GE viewport's, PSP pixels per unit of normalised
+// device coordinates (y negative). The segment is cut at the near plane
+// (z >= -w, before the renderer's depth remap); the corners are offset from
+// each projected end by half `width` PSP pixels along the minor axis on the
+// screen, at that end's own depth, and handed back in object space, so the
+// draw keeps its transform (and frame interpolation can blend it like any
+// other draw). Unlike through mode the quad is centred on the projected
+// line: a GE line lights the pixel each step lands in, which is centred on
+// the line on average, and the 3D scene the line belongs to is not snapped to
+// PSP pixels at a higher internal scale either. Appends six vertices; false
+// when nothing could be drawn (behind the eye, a degenerate viewport or a
+// transform without an inverse).
+inline bool expand_transformed_line(const std::array<float, 16> &transform, float x_scale, float y_scale,
+                                    const Vertex &first, const Vertex &second, std::vector<Vertex> &out,
+                                    float width = 1.0f) {
+    if (x_scale == 0.0f || y_scale == 0.0f) return false;
+    std::array<double, 16> m{};
+    for (std::size_t i = 0; i < 16u; ++i) m[i] = transform[i];
+    const auto clip = [&](const Vertex &v) {
+        std::array<double, 4> c{};
+        for (std::size_t row = 0; row < 4u; ++row)
+            c[row] = m[row] * v.position[0] + m[4u + row] * v.position[1] + m[8u + row] * v.position[2] +
+                     m[12u + row];
+        return c;
+    };
+    Vertex a = first, b = second;
+    std::array<double, 4> ca = clip(a), cb = clip(b);
+    // Cut at the near plane, and keep w positive for the division.
+    constexpr double kMinW = 1e-6;
+    const auto cut = [&](double da, double db) {
+        if (da < 0.0 && db < 0.0) return false;
+        if (da < 0.0 || db < 0.0) {
+            const double t = da / (da - db);
+            Vertex &moved = da < 0.0 ? a : b;
+            std::array<double, 4> &moved_clip = da < 0.0 ? ca : cb;
+            moved = line_detail::lerp(a, b, t);
+            for (std::size_t i = 0; i < 4u; ++i) moved_clip[i] = ca[i] + (cb[i] - ca[i]) * t;
+        }
+        return true;
+    };
+    if (!cut(ca[2] + ca[3], cb[2] + cb[3])) return false;
+    if (!cut(ca[3] - kMinW, cb[3] - kMinW)) return false;
+    if (!(ca[3] > 0.0) || !(cb[3] > 0.0)) return false;
+    std::array<double, 16> inverse{};
+    if (!line_detail::invert(m, inverse)) return false;
+
+    const double ax = ca[0] / ca[3], ay = ca[1] / ca[3];
+    const double bx = cb[0] / cb[3], by = cb[1] / cb[3];
+    const double screen_dx = (bx - ax) * x_scale;
+    const double screen_dy = (by - ay) * y_scale;
+    if (!(std::fabs(screen_dx) > 1e-9) && !(std::fabs(screen_dy) > 1e-9)) return true;
+    const double half = 0.5 * static_cast<double>(width);
+    const bool x_major = std::fabs(screen_dx) >= std::fabs(screen_dy);
+    // Half the width in normalised device coordinates.
+    const double ox = x_major ? 0.0 : half / x_scale;
+    const double oy = x_major ? half / y_scale : 0.0;
+    bool ok = true;
+    const auto corner = [&](const Vertex &v, const std::array<double, 4> &c, double sign) {
+        const std::array<double, 4> moved{c[0] + sign * ox * c[3], c[1] + sign * oy * c[3], c[2], c[3]};
+        std::array<double, 4> p{};
+        for (std::size_t row = 0; row < 4u; ++row)
+            p[row] = inverse[row] * moved[0] + inverse[4u + row] * moved[1] + inverse[8u + row] * moved[2] +
+                     inverse[12u + row] * moved[3];
+        Vertex out_vertex = v;
+        if (!(std::fabs(p[3]) > 1e-30)) {
+            ok = false;
+            return out_vertex;
+        }
+        for (std::size_t i = 0; i < 3u; ++i) {
+            out_vertex.position[i] = static_cast<float>(p[i] / p[3]);
+            if (!std::isfinite(out_vertex.position[i])) ok = false;
+        }
+        return out_vertex;
+    };
+    const Vertex a0 = corner(a, ca, -1.0), a1 = corner(a, ca, 1.0);
+    const Vertex b0 = corner(b, cb, -1.0), b1 = corner(b, cb, 1.0);
+    if (!ok) return false;
+    line_detail::push_quad(out, a0, a1, b0, b1);
+    return true;
+}
+
+} // namespace portablekit::gpu
