+    // PSP pixels whatever the target's size).
+    out.clear();
+    expect(portablekit::gpu::expand_transformed_line(identity, 240.0f, -136.0f, vertex_at(0, -0.5f, 0),
+                                                     vertex_at(0.1f, 0.5f, 0), out),
