+    expect(portablekit::gpu::expand_transformed_line(identity, 240.0f, -136.0f, vertex_at(-0.5f, 0.1f, 0.2f, 0xFF00FF00u, 0, 0),
+                                                     vertex_at(0.5f, 0.1f, 0.2f, 0xFFFFFFFFu, 1, 0), out),
+           "a transformed segment is drawn");
+    expect(out.size() == 6u, "a transformed segment is two triangles");
+    const Box box = box_of(out, 0u, out.size());
