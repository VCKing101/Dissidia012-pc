+using portablekit::gpu::Vertex;
+
+Vertex vertex_at(float x, float y, float z, std::uint32_t color = 0xFFFFFFFFu, float u = 0.0f, float v = 0.0f) {
+    Vertex out{};
+    out.position = {x, y, z, 1.0f};
+    out.color = color;
+    out.texcoord = {u, v};
+    return out;
+}
+
+struct Box {
+    float x0{1e30f}, y0{1e30f}, x1{-1e30f}, y1{-1e30f};
+};
+Box box_of(const std::vector<Vertex> &vertices, std::size_t first, std::size_t count) {
+    Box box;
+    for (std::size_t i = first; i < first + count; ++i) {
+        box.x0 = std::min(box.x0, vertices[i].position[0]);
+        box.x1 = std::max(box.x1, vertices[i].position[0]);
+        box.y0 = std::min(box.y0, vertices[i].position[1]);
+        box.y1 = std::max(box.y1, vertices[i].position[1]);
+    }
+    return box;
+}
+bool near(float a, float b, float tolerance = 1e-4f) { return std::fabs(a - b) <= tolerance; }
+
+void test_line_segments() {
+    std::vector<std::pair<std::size_t, std::size_t>> seen;
+    const auto collect = [&](std::size_t a, std::size_t b) { seen.emplace_back(a, b); };
+    portablekit::gpu::for_each_line_segment(PrimitiveType::Lines, 5u, collect);
+    expect(seen == std::vector<std::pair<std::size_t, std::size_t>>{{0u, 1u}, {2u, 3u}}, "lines pair their vertices");
+    seen.clear();
+    portablekit::gpu::for_each_line_segment(PrimitiveType::LineStrip, 4u, collect);
+    expect(seen == std::vector<std::pair<std::size_t, std::size_t>>{{0u, 1u}, {1u, 2u}, {2u, 3u}},
+           "a strip joins consecutive vertices");
+    seen.clear();
+    portablekit::gpu::for_each_line_segment(PrimitiveType::LineStrip, 1u, collect);
+    portablekit::gpu::for_each_line_segment(PrimitiveType::Triangles, 6u, collect);
+    expect(seen.empty(), "no segments from one vertex or from triangles");
+}
+
+void test_through_lines() {
+    std::vector<Vertex> out;
+    // Horizontal, (10, 5) to (20, 5): pixel row 5, columns 10 to 19 (pixel
+    // centres 10.5 to 19.5 inside, 20.5 on the excluded edge).
+    portablekit::gpu::expand_through_line(vertex_at(10, 5, 0, 0xFF0000FFu), vertex_at(20, 5, 0, 0xFFFF0000u), out);
+    expect(out.size() == 6u, "a through segment is two triangles");
+    Box box = box_of(out, 0u, out.size());
+    expect(near(box.x0, 10.5f) && near(box.x1, 20.5f) && near(box.y0, 5.0f) && near(box.y1, 6.0f),
+           "a horizontal through line covers its row, half-open along x");
+    for (const Vertex &v : out)
+        expect(v.color == (v.position[0] < 15.0f ? 0xFF0000FFu : 0xFFFF0000u), "each end keeps its colour");
+    // Steep: one pixel wide in x.
+    out.clear();
+    portablekit::gpu::expand_through_line(vertex_at(0, 0, 0), vertex_at(10, 20, 0), out);
+    box = box_of(out, 0u, out.size());
+    expect(near(box.x0, 0.0f) && near(box.x1, 11.0f) && near(box.y0, 0.5f) && near(box.y1, 20.5f),
+           "a steep through line is one pixel wide along x");
+    out.clear();
+    portablekit::gpu::expand_through_line(vertex_at(3, 3, 0), vertex_at(3, 3, 0), out);
+    expect(out.empty(), "a segment of no length draws nothing");
+}
