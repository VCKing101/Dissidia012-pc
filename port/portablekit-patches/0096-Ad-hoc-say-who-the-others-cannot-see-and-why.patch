+// What the host's status says about each player's relay connections and
+// datagrams: two players who see each other in the server's list but sit in
+// different rooms, then in the same one. Loopback alone, so no firewall asks.
+void relay_report() {
+    Server server;
+    std::uint16_t port = 0;
+    for (std::uint16_t candidate = 38312; candidate < 38400 && port == 0u; candidate += 2) {
+        ServerConfig config;
+        config.adhocctl_port = candidate;
+        config.loopback_only = true;
+        if (server.start(config)) port = candidate;
+    }
+    check(port != 0u, "relay report: a loopback server starts");
+    if (port == 0u) return;
+    const std::uint16_t relay_port = relay_port_for(port);
+    const auto player = [&](const Mac &mac) -> std::optional<ServerPlayer> {
+        for (const ServerPlayer &entry : server.status().players)
+            if (entry.mac == mac) return entry;
+        return std::nullopt;
+    };
+
+    Client &a = Client::get();
+    Identity identity;
+    identity.server = "127.0.0.1:" + std::to_string(port);
+    identity.nickname = "HunterA";
+    identity.mac = kMacA;
+    identity.product = kProduct;
+    a.start(identity);
+    a.join("LOBBY0");
+    check(wait_until([&] { return a.in_group(); }), "relay report: A joins LOBBY0");
+    const int pdp = a.pdp_open(100, 8192);
+    check(wait_until([&] { return a.diagnostics().relay_links_up == 1u; }), "relay report: A's socket reaches the relay");
+
+    // B, by hand, in another room, with a socket on the same port.
+    Raw b(port);
+    b.send(ctl::login(kMacB, "HunterB", kProduct));
+    b.send(ctl::connect("LOBBY1"));
+    Raw b_pdp(relay_port);
+    b_pdp.send(relay::init(relay::kInitPdp, kMacB, 100, Mac{}, 0));
+    check(wait_until([&] {
+              const auto pa = player(kMacA);
+              const auto pb = player(kMacB);
+              return pa && pb && pa->relay_connections == 1u && pb->relay_connections == 1u && pb->group &&
+                     *pb->group == "LOBBY1" && pa->in_group_ms.has_value();
+          }),
+          "relay report: the status lists each player's room and relay connection");
+
+    // B, alone in its room, broadcasts as other emulators do (this client
+    // sends a copy to each peer it knows instead, so alone it sends nothing).
+    const std::string hello = "hello";
+    b_pdp.send(relay::pdp_header(kBroadcastMac, 100, static_cast<std::uint32_t>(hello.size())) + hello);
+    check(wait_until([&] {
+              const auto pb = player(kMacB);
+              return pb && pb->datagrams_sent == 1u && pb->datagrams_unheard == 1u;
+          }),
+          "relay report: a broadcast nobody in the room can take counts as unheard");
+
+    b.send(ctl::connect("LOBBY0"));
+    check(wait_until([&] { return a.peers().size() == 1u; }), "relay report: B moves to A's room");
+    a.pdp_send(pdp, kBroadcastMac, 100, hello.data(), hello.size());
+    const auto header = b_pdp.read(relay::kPdpHeaderSize);
+    const auto body = b_pdp.read(hello.size());
+    check(header && wire::get_mac(header->data()) == kMacA && body == hello, "relay report: now B receives A's");
+    check(wait_until([&] {
