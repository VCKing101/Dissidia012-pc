+// A session whose server answers and whose relay port does not, as when only
+// the first port is forwarded: the player's own copy notices and says so. The
+// server here is a few lines that answer the login and the join; nothing
+// listens on the port after it.
+void relay_out_of_reach() {
+    Socket listener = kNoSocket;
+    std::uint16_t port = 0;
+    for (std::uint16_t candidate = 38412; candidate < 38500 && port == 0u; candidate += 2) {
+        const auto bind_loopback = [](std::uint16_t number) {
+            Socket s = ::socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);
+            const Address address = Address::ipv4_address(htonl(INADDR_LOOPBACK), number);
+            if (::bind(s, reinterpret_cast<const sockaddr *>(&address.storage), address.length) != 0 ||
+                ::listen(s, 4) != 0) {
+                close_socket(s);
+                return kNoSocket;
+            }
+            return s;
+        };
+        Socket relay = bind_loopback(static_cast<std::uint16_t>(candidate + 1));
+        if (relay == kNoSocket) continue;  // something listens there
+        close_socket(relay);
+        listener = bind_loopback(candidate);
+        if (listener != kNoSocket) port = candidate;
+    }
+    check(port != 0u, "relay out of reach: a stand-in server listens");
+    if (port == 0u) return;
+    set_nonblocking(listener);
+
+    Client &a = Client::get();
+    Identity identity;
+    identity.server = "127.0.0.1:" + std::to_string(port);
+    identity.nickname = "Stranded";
+    identity.mac = kMacA;
+    identity.product = kProduct;
+    a.start(identity);
+    a.join("LOBBY0");
+    Socket s = kNoSocket;
+    wait_until([&] { return (s = ::accept(listener, nullptr, nullptr)) != kNoSocket; });
+    check(s != kNoSocket, "relay out of reach: the client connects to the server");
+    if (s == kNoSocket) {
+        close_socket(listener);
+        a.stop();
+        return;
+    }
+    set_nonblocking(s);
+    // Login, then the join, then the server's confirmation of it.
+    std::string in;
+    wait_until([&] {
+        char buffer[512];
+        const auto count = ::recv(s, buffer, static_cast<int>(sizeof(buffer)), 0);
+        if (count > 0) in.append(buffer, static_cast<std::size_t>(count));
+        return in.size() >= ctl::client_packet_size(ctl::kLogin) + ctl::client_packet_size(ctl::kConnect);
+    });
+    const std::string joined = ctl::joined(kMacA);
+    ::send(s, joined.data(), static_cast<int>(joined.size()), kSendFlags);
+    check(wait_until([&] { return a.in_group(); }), "relay out of reach: the server confirms the join");
+    const int pdp = a.pdp_open(100, 8192);
+
+    check(wait_until([&] { return a.diagnostics().relay_failures != 0u; }, 15000),
+          "relay out of reach: the client counts a relay connection that never came up");
+    Diagnostics d = a.diagnostics();
+    std::cout << "     why: " << d.relay_error << ", down for " << d.relay_down_ms.value_or(0u) << " ms" << std::endl;
+    check(d.relay_down_ms.has_value() && !d.relay_error.empty(), "relay out of reach: it says since when and why");
+    check(wait_until([&] { return relay_unreachable(a.diagnostics()); }, 15000),
+          "relay out of reach: after a while it counts as unreachable");
+
+    const std::filesystem::path directory =
+        std::filesystem::temp_directory_path() / ("portablekit-adhoc-test-" + std::to_string(port));
+    const std::filesystem::path log = a.save_log(directory, {"build: test"});
+    std::string text;
+    if (std::ifstream file{log, std::ios::binary}; file) text.assign(std::istreambuf_iterator<char>(file), {});
+    check(text.find("build: test") != std::string::npos && text.find("UNREACHABLE") != std::string::npos &&
+              text.find("cannot connect to the relay") != std::string::npos,
+          "relay out of reach: the saved log has the caller's lines, the relay's state and the report");
+    std::error_code ec;
+    std::filesystem::remove_all(directory, ec);
+
+    a.pdp_close(pdp);
+    a.stop();
+    close_socket(s);
+    close_socket(listener);
+}
