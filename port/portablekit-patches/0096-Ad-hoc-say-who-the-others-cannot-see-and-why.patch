+    c.send(ctl::login(mac_c, "HunterC", kProduct));
+    c.send(ctl::connect("LOBBY0"));
+    check(wait_until([&] { return a.peers().size() == 2u; }), "relay report: C joins the room");
+    a.pdp_send(pdp, kBroadcastMac, 100, hello.data(), hello.size());
+    check(b_pdp.read(relay::kPdpHeaderSize + hello.size()).has_value(), "relay report: B receives A's next one");
+    check(wait_until([&] {
