+// The relay out of reach while the server answers: the game is in a group and
+// has sockets, but none of their relay connections has come up for this long
+// and some were refused or went unanswered. The others in the group then
+// neither see nor hear this player, so the interface says so.
+inline constexpr std::uint64_t kRelayUnreachableMs = 10000u;
+[[nodiscard]] inline bool relay_unreachable(const Diagnostics &d) {
+    return d.relay_down_ms && *d.relay_down_ms >= kRelayUnreachableMs && d.relay_failures != 0u;
+}
