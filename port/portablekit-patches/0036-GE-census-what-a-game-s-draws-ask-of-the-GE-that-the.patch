--- /dev/null
+++ b/host/gpu/ge_census.hpp
@@ -0,0 +1,52 @@
+#pragma once
+
+#include "ge_state.hpp"
+
+#include <array>
+#include <cstdint>
+#include <string>
+
+// <prefix>_GE_CENSUS=<file>: a census of the GE features a game's draws use
+// that this renderer does not reproduce exactly. Every draw is checked against
+// a list of such features (state the GE state machine ignores, modes the shader
+// approximates, render-to-texture cases the renderer reads from guest memory
+// instead of from the render target, block transfers between targets, ...);
+// each hit is counted, per scene and for the whole run, with the frame and
+// scene it was first seen in and the first draw's state words as an example.
+// The result is one JSON file, written at exit, at each scene change and every
+// 1,800 frames, so a run cut short still leaves one.
+//
+// Scenes: `<prefix>_GE_CENSUS_SCENE` names the first one ("start" by default);
+// the input script's `scene NAME` step starts the next.
+//
+// Nothing here changes what is drawn. With the variable unset every hook
+// returns at its first test.
+namespace portablekit::gpu::census {
+
+[[nodiscard]] bool enabled() noexcept;
+
+// The scene the counts from here on belong to.
+void set_scene(const std::string &name);
+// A game frame was shown from `display_address`.
+void note_frame(std::uint32_t display_address);
+// A draw as the GE state machine hands it to the renderer, with the raw
+// command registers it was made with (registers[command] = the command's
+// 24-bit data).
+void note_draw(const psprecomp::GuestMemory &memory, const DrawCall &call,
+               const std::array<std::uint32_t, 256> &registers);
+// The renderer's choice of texture source for the draw just noted: the render
+// target (`from_target`, its first texel at pixel x, y of it) or guest memory.
+void note_texture_source(const DrawCall &call, bool from_target, std::uint32_t x, std::uint32_t y);
+// A GE block transfer.
+void note_transfer(const BlockTransfer &transfer, const std::array<std::uint32_t, 256> &registers);
+// A command the GE state machine ignored.
+void note_unhandled(std::uint32_t command, std::uint32_t data);
+// A DMA copy out of or into VRAM.
+void note_vram_copy(std::uint32_t destination, std::uint32_t source, std::uint32_t size);
+// Something the renderer dropped or replaced for the draw being recorded
+// ("render.vertex_space_full", "render.texture_decode_failed").
+void note_renderer(const char *feature);
+// Writes the JSON now (also done at exit by the host).
+void write();
+
+} // namespace portablekit::gpu::census
