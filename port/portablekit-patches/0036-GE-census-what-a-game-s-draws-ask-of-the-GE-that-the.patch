+bool start() {
+    const char *path = portablekit::env("GE_CENSUS");
+    if (path == nullptr || *path == '\0') return false;
+    State &s = state();
+    s.path = path;
+    if (const char *scene = portablekit::env("GE_CENSUS_SCENE"); scene != nullptr && *scene != '\0') s.scene = scene;
+    s.scene_order.push_back(s.scene);
+    s.scenes[s.scene];
+    std::cout << "[census] GE census to " << s.path << ", scene " << s.scene << std::endl;
+    return true;
+}
