+
+void hit(State &s, const std::string &name, const std::string &variant, const std::string &detail,
+         const std::uint32_t *words, std::size_t word_count) {
+    Feature &feature = s.features[name];
+    if (feature.count == 0u) {
+        feature.first_frame = s.frame;
+        feature.first_scene = s.scene;
+        feature.example.frame = s.frame;
+        feature.example.scene = s.scene;
+        feature.example.detail = detail;
+        for (std::size_t i = 0; i < word_count; ++i)
+            feature.example.words.emplace_back(words[i], s.registers[words[i]] & 0x00FFFFFFu);
+        if (find_info(name) == nullptr) std::cout << "[census] feature without a description: " << name << std::endl;
+    }
+    ++feature.count;
+    if (!variant.empty()) ++feature.variants[variant];
+    ++s.scenes[s.scene].features[name];
+}
+
+void hit_draw(State &s, const std::string &name, const std::string &variant, const std::string &detail) {
+    hit(s, name, variant, detail, kDrawWords, std::size(kDrawWords));
+}
+
+std::uint32_t bytes_per_pixel(std::uint32_t format) { return format == 3u ? 4u : 2u; }
+
+std::uint32_t texture_bits(TextureFormat format) {
+    switch (format) {
+    case TextureFormat::Rgba8888:
+    case TextureFormat::Clut32: return 32u;
+    case TextureFormat::Clut8:
+    case TextureFormat::Dxt3:
+    case TextureFormat::Dxt5: return 8u;
+    case TextureFormat::Clut4:
+    case TextureFormat::Dxt1: return 4u;
+    default: return 16u;
+    }
+}
+
+bool is_clut(TextureFormat format) {
+    return format == TextureFormat::Clut4 || format == TextureFormat::Clut8 || format == TextureFormat::Clut16 ||
+           format == TextureFormat::Clut32;
+}
+
+bool is_dxt(TextureFormat format) {
+    return format == TextureFormat::Dxt1 || format == TextureFormat::Dxt3 || format == TextureFormat::Dxt5;
+}
+
+// The target (canonical address) whose 480x272 bytes hold `address`, drawn
+// within `recent` frames; 0 when none.
+std::uint32_t target_holding(const State &s, std::uint32_t address, std::uint64_t recent = ~0ull) {
+    const std::uint32_t wanted = GuestMemory::canonical(address);
+    std::uint32_t found = 0u;
+    for (const auto &[base, target] : s.targets) {
+        if (recent != ~0ull && s.frame - target.last_frame > recent) continue;
+        const std::uint32_t rows = target.rows != 0u ? target.rows : 272u;
+        const std::uint32_t bytes = target.stride * rows * bytes_per_pixel(target.format);
+        if (wanted >= base && wanted - base < bytes) {
+            if (found == 0u || base > found) found = base;  // the innermost start
+        }
+    }
+    return found;
+}
+
+std::uint64_t hash_bytes(const std::uint8_t *data, std::size_t size, std::size_t step = 1u) {
+    std::uint64_t key = 0xCBF29CE484222325ull;
+    if (step == 1u) {
+        for (std::size_t i = 0; i < size; ++i) key = (key ^ data[i]) * 0x100000001B3ull;
+    } else {
+        for (std::size_t i = 0; i + 4u <= size; i += step) {
+            std::uint32_t word{};
+            std::memcpy(&word, data + i, sizeof(word));
+            key = (key ^ word) * 0x100000001B3ull;
+        }
+    }
+    return key;
+}
+
+// The texel rectangle a draw's vertices reach, or false for a draw whose
+// vertices were not decoded on the CPU.
+bool texel_bounds(const DrawCall &call, float &u0, float &v0, float &u1, float &v1) {
+    if (call.vertices.empty()) return false;
+    u0 = v0 = 1e30f;
+    u1 = v1 = -1e30f;
+    const float width = static_cast<float>(call.texture.width);
+    const float height = static_cast<float>(call.texture.height);
+    for (const Vertex &vertex : call.vertices) {
+        float u = vertex.texcoord[0];
+        float v = vertex.texcoord[1];
+        if (!call.through) {
+            u = (u * call.texture.scale_u + call.texture.offset_u) * width;
+            v = (v * call.texture.scale_v + call.texture.offset_v) * height;
+        }
+        u0 = std::min(u0, u);
+        v0 = std::min(v0, v);
+        u1 = std::max(u1, u);
+        v1 = std::max(v1, v);
+    }
+    return true;
+}
+
+bool identity(const std::array<float, 16> &m) {
+    for (std::size_t i = 0; i < 16u; ++i) {
+        const float want = (i % 5u == 0u) ? 1.0f : 0.0f;
+        if (std::abs(m[i] - want) > 1e-5f) return false;
+    }
+    return true;
+}
+
+std::string target_detail(const DrawCall &call) {
+    std::ostringstream out;
+    out << "target " << hex(call.target.color_address) << " fmt " << call.target.color_format << " stride "
+        << call.target.color_stride << " prim " << static_cast<int>(call.primitive) << " count "
+        << call.primitive_count << (call.through ? " through" : " transformed");
+    if (call.blend.enabled)
+        out << " blend " << call.blend.source_factor << "/" << call.blend.destination_factor << " eq "
+            << call.blend.equation;
+    if (!call.vertices.empty()) out << " colour0 " << hex(call.vertices.front().color);
+    if (call.texture.enabled)
+        out << " texture " << hex(call.texture.address) << " fmt " << static_cast<int>(call.texture.format) << " "
+            << call.texture.width << "x" << call.texture.height << " bufw " << call.texture.buffer_width;
+    return out.str();
+}
+
+void write_locked(State &s) {
+    std::ostringstream out;
+    out << "{\n  \"frames\": " << s.frame << ",\n  \"draws\": " << s.draws << ",\n  \"scenes\": [\n";
+    for (std::size_t i = 0; i < s.scene_order.size(); ++i) {
+        const std::string &name = s.scene_order[i];
+        const Scene &scene = s.scenes[name];
+        out << "    {\"name\": " << quoted(name) << ", \"first_frame\": " << scene.first_frame
+            << ", \"last_frame\": " << scene.last_frame << ", \"frames\": " << scene.frames
+            << ", \"draws\": " << scene.draws << ", \"features\": {";
+        bool first = true;
+        for (const auto &[feature, count] : scene.features) {
+            out << (first ? "" : ", ") << quoted(feature) << ": " << count;
+            first = false;
+        }
+        out << "}, \"unhandled_commands\": {";
+        first = true;
+        for (const auto &[command, count] : scene.unhandled) {
+            out << (first ? "" : ", ") << quoted(hex(command, 2)) << ": " << count;
+            first = false;
+        }
+        out << "}}" << (i + 1u < s.scene_order.size() ? "," : "") << "\n";
+    }
+    out << "  ],\n  \"features\": [\n";
+    std::vector<std::pair<std::string, const Feature *>> sorted;
+    for (const auto &[name, feature] : s.features) sorted.emplace_back(name, &feature);
+    std::sort(sorted.begin(), sorted.end(),
+              [](const auto &a, const auto &b) { return a.second->count > b.second->count; });
+    for (std::size_t i = 0; i < sorted.size(); ++i) {
+        const auto &[name, feature] = sorted[i];
+        const FeatureInfo *info = find_info(name);
+        out << "    {\"feature\": " << quoted(name) << ", \"category\": " << quoted(info ? info->category : "")
+            << ", \"impact\": " << quoted(info ? info->impact : "") << ", \"count\": " << feature->count
+            << ", \"first_frame\": " << feature->first_frame << ", \"first_scene\": " << quoted(feature->first_scene)
+            << ",\n     \"description\": " << quoted(info ? info->description : "") << ",\n     \"scenes\": {";
+        bool first = true;
+        for (const std::string &scene : s.scene_order) {
+            const auto found = s.scenes[scene].features.find(name);
+            if (found == s.scenes[scene].features.end()) continue;
+            out << (first ? "" : ", ") << quoted(scene) << ": " << found->second;
+            first = false;
+        }
+        out << "},\n     \"variants\": {";
+        first = true;
+        for (const auto &[variant, count] : feature->variants) {
+            out << (first ? "" : ", ") << quoted(variant) << ": " << count;
+            first = false;
+        }
+        out << "},\n     \"example\": {\"frame\": " << feature->example.frame
+            << ", \"scene\": " << quoted(feature->example.scene) << ", \"draw\": " << quoted(feature->example.detail)
+            << ", \"words\": {";
+        first = true;
+        for (const auto &[command, data] : feature->example.words) {
+            out << (first ? "" : ", ") << quoted(hex(command, 2)) << ": " << quoted(hex(command << 24u | data));
+            first = false;
+        }
+        out << "}}}" << (i + 1u < sorted.size() ? "," : "") << "\n";
+    }
+    out << "  ],\n  \"unhandled_commands\": {";
+    bool first = true;
+    for (const auto &[command, count] : s.unhandled) {
+        out << (first ? "" : ", ") << quoted(hex(command, 2)) << ": " << count;
+        first = false;
+    }
+    out << "}\n}\n";
+    const std::string temporary = s.path + ".tmp";
+    {
+        std::ofstream file(temporary, std::ios::binary | std::ios::trunc);
+        if (!file) return;
+        file << out.str();
+    }
+    std::error_code ec;
+    std::filesystem::rename(temporary, s.path, ec);
+    s.last_write_frame = s.frame;
+}
+
+} // namespace
+
+// Read on first use, not at static initialisation: the variable's prefix
+// comes from the game profile.
+bool enabled() noexcept {
+    static const bool on = start();
+    return on;
+}
+
+void set_scene(const std::string &name) {
+    if (!enabled()) return;
+    State &s = state();
+    std::lock_guard guard(s.lock);
+    if (name == s.scene) return;
+    s.scene = name;
+    if (s.scenes.find(name) == s.scenes.end()) {
+        s.scene_order.push_back(name);
+        s.scenes[name].first_frame = s.frame;
+    }
+    std::cout << "[census] scene " << name << " from frame " << s.frame << std::endl;
+    write_locked(s);
+}
+
+void note_frame(std::uint32_t display_address) {
+    if (!enabled()) return;
+    State &s = state();
+    std::lock_guard guard(s.lock);
+    ++s.frame;
+    s.displayed.insert(GuestMemory::canonical(display_address));
+    Scene &scene = s.scenes[s.scene];
+    if (scene.frames == 0u) scene.first_frame = s.frame;
+    ++scene.frames;
+    scene.last_frame = s.frame;
+    if (s.frame - s.last_write_frame >= 1800u) write_locked(s);
+}
+
+void note_draw(const GuestMemory &memory, const DrawCall &call, const std::array<std::uint32_t, 256> &registers) {
+    if (!enabled()) return;
+    State &s = state();
+    std::lock_guard guard(s.lock);
+    s.registers = registers;
+    ++s.draws;
+    ++s.scenes[s.scene].draws;
+    const auto reg = [&](std::uint32_t command) { return registers[command] & 0x00FFFFFFu; };
+    const auto on = [&](std::uint32_t command) { return (registers[command] & 1u) != 0u; };
+    const bool clear = call.clear_mode;
+    const std::string detail = target_detail(call);
+    const std::uint32_t target = GuestMemory::canonical(call.target.color_address);
+    s.draw_target = target;
+    s.draw_texture = call.texture.enabled ? call.texture.address : 0u;
+
+    // Targets: their layout over time, and how they share memory.
+    {
+        const auto found = s.targets.find(target);
+        if (found != s.targets.end()) {
+            if (found->second.format != call.target.color_format)
+                hit_draw(s, "target.format_changed", std::to_string(found->second.format) + "->" +
+                                                         std::to_string(call.target.color_format), detail);
+            if (found->second.stride != call.target.color_stride)
+                hit_draw(s, "target.stride_changed", std::to_string(found->second.stride) + "->" +
+                                                         std::to_string(call.target.color_stride), detail);
+        }
+        if (const std::uint32_t outer = target_holding(s, target, 1u); outer != 0u && outer != target)
+            hit_draw(s, "target.inside_other_target", hex(outer) + " holds " + hex(target), detail);
+        for (const auto &[depth, last] : s.depths) {
+            if (s.frame - last > 1u) continue;
+            const std::uint32_t stride = s.depth_strides[depth];
+            if (target >= depth && target - depth < stride * 272u * 2u) {
+                hit_draw(s, "target.on_depth_buffer", hex(depth), detail);
+                break;
+            }
+        }
+        const std::uint32_t stride = call.target.color_stride;
+        if (stride != 64u && stride != 128u && stride != 256u && stride != 512u)
+            hit_draw(s, "target.odd_stride", std::to_string(stride), detail);
+        // The rows the draw can reach: the scissor, and within it the
+        // vertices of a through-mode draw or the viewport of another.
+        float bottom = static_cast<float>(call.viewport.scissor_y2 + 1u);
+        if (call.through && !call.vertices.empty()) {
+            float lowest = 0.0f;
+            for (const Vertex &vertex : call.vertices) lowest = std::max(lowest, vertex.position[1]);
+            bottom = std::min(bottom, lowest);
+        } else if (!call.through && call.viewport.y_scale != 0.0f) {
+            bottom = std::min(bottom, call.viewport.y_offset - call.viewport.offset_y + std::abs(call.viewport.y_scale));
+        }
+        const auto rows = static_cast<std::uint32_t>(std::clamp(bottom + 0.5f, 1.0f, 272.0f));
+        TargetSeen &seen_target = s.targets[target];
+        const bool relaid = seen_target.stride != call.target.color_stride || seen_target.format != call.target.color_format;
+        seen_target.rows = relaid ? rows : std::max(seen_target.rows, rows);
+        seen_target.stride = call.target.color_stride;
+        seen_target.format = call.target.color_format;
+        seen_target.last_frame = s.frame;
+        const bool depth_used = !clear ? call.depth.test_enabled : (call.clear_flags & 4u) != 0u;
+        if (depth_used) {
+            const std::uint32_t depth = GuestMemory::canonical(call.target.depth_address);
+            s.depths[depth] = s.frame;
+            s.depth_strides[depth] = call.target.depth_stride;
+            if (call.target.depth_stride != call.target.color_stride)
+                hit_draw(s, "target.depth_stride_mismatch",
+                         std::to_string(call.target.depth_stride) + " vs " + std::to_string(call.target.color_stride),
+                         detail);
+        }
+    }
+
+    // Primitives and vertices.
+    if (call.primitive == PrimitiveType::Points) hit_draw(s, "prim.points", call.through ? "through" : "transformed", detail);
+    if (call.primitive == PrimitiveType::Lines || call.primitive == PrimitiveType::LineStrip)
+        hit_draw(s, "prim.lines", call.through ? "through" : "transformed", detail);
+    if (((call.vertex_type >> 18u) & 7u) != 0u)
+        hit_draw(s, "vertex.morph", std::to_string(((call.vertex_type >> 18u) & 7u) + 1u) + " targets", detail);
+    if (!clear && (reg(0x50) & 1u) == 0u && call.has_vertex_color && call.primitive != PrimitiveType::Sprites &&
+        call.primitive != PrimitiveType::Points)
+        hit_draw(s, "shade.flat", "", detail);
+
+    // Viewport, depth range, the 480x272 limit.
+    if (!clear) {
+        const auto minz = static_cast<float>(reg(0xD6) & 0xFFFFu);
+        const auto maxz = static_cast<float>(reg(0xD7) & 0xFFFFu);
+        if (!call.through) {
+            const ViewportState &vp = call.viewport;
+            if (vp.z_scale == 0.0f) {
+                hit_draw(s, "viewport.z_scale_zero", "", detail);
+            } else {
+                const float low = vp.z_offset - std::abs(vp.z_scale);
+                const float high = vp.z_offset + std::abs(vp.z_scale);
+                if (low < -0.5f || high > 65535.5f) hit_draw(s, "viewport.depth_clamped", "", detail);
+                if (minz > std::max(low, 0.0f) + 0.5f || maxz < std::min(high, 65535.0f) - 0.5f)
+                    hit_draw(s, "depth.range_minz_maxz", "narrower than the viewport", detail);
+            }
+            if (on(0x1C) && !call.vertices.empty()) {
+                // Clip-space depth of every vertex; past the planes is where
+                // clipping and clamping differ.
+                std::array<float, 16> m{};
+                const auto multiply = [](const std::array<float, 16> &a, const std::array<float, 16> &b) {
+                    std::array<float, 16> out{};
+                    for (std::size_t c = 0; c < 4u; ++c)
+                        for (std::size_t r = 0; r < 4u; ++r)
+                            for (std::size_t k = 0; k < 4u; ++k) out[c * 4u + r] += a[k * 4u + r] * b[c * 4u + k];
+                    return out;
+                };
+                m = multiply(call.projection, multiply(call.view, call.world));
+                bool far = false, near = false;
+                for (const Vertex &vertex : call.vertices) {
+                    const float x = vertex.position[0], y = vertex.position[1], z = vertex.position[2];
+                    const float cz = m[2] * x + m[6] * y + m[10] * z + m[14];
+                    const float cw = m[3] * x + m[7] * y + m[11] * z + m[15];
+                    if (cz > cw) far = true;
+                    if (cz < -cw) near = true;
+                }
+                if (far) hit_draw(s, "clip.depth_clamp_far", near ? "also near" : "", detail);
+                else if (near) hit_draw(s, "clip.depth_clamp_near", "", detail);
+            }
+        }
+    }
+    {
+        bool beyond = false;
+        const ViewportState &vp = call.viewport;
+        const bool scissor_beyond = vp.scissor_x2 > 479u || vp.scissor_y2 > 271u;
+        if (scissor_beyond && call.through && !call.vertices.empty()) {
+            for (const Vertex &vertex : call.vertices)
+                if (vertex.position[0] > 480.5f || vertex.position[1] > 272.5f) beyond = true;
+        } else if (scissor_beyond && !call.through && vp.x_scale != 0.0f) {
+            const float right = vp.x_offset - vp.offset_x + std::abs(vp.x_scale);
+            const float bottom = vp.y_offset - vp.offset_y + std::abs(vp.y_scale);
+            beyond = right > 480.5f || bottom > 272.5f;
+        }
+        if (beyond) hit_draw(s, "target.beyond_480x272", call.through ? "through" : "transformed", detail);
+    }
+
+    if (clear) return;  // nothing below applies in clear mode
+
+    // Fragment tests and operations.
+    if (call.alpha_test.enabled) {
+        const std::uint32_t function = call.alpha_test.function;
+        if (function == 0u) hit_draw(s, "alpha_test.never", "", detail);
+        if (function == 1u) hit_draw(s, "alpha_test.always", "", detail);
+        if (call.alpha_test.mask != 0xFFu) hit_draw(s, "alpha_test.mask", hex(call.alpha_test.mask, 2), detail);
+        if (function == 2u || function == 3u) hit_draw(s, "alpha_test.equality", function == 2u ? "equal" : "notequal", detail);
+    }
+    if (on(0x27)) {
+        static const char *kNames[] = {"never", "always", "equal", "notequal"};
+        hit_draw(s, "color_test", kNames[reg(0xD8) & 3u], detail);
+    }
+    if (on(0x28) && (reg(0xE6) & 0xFu) != 3u) {
+        static const char *kOps[] = {"clear", "and", "and_reverse", "copy", "and_inverted", "noop", "xor", "or",
+                                     "nor", "equiv", "inverted", "or_reverse", "copy_inverted", "or_inverted",
+                                     "nand", "set"};
+        hit_draw(s, "logic_op", kOps[reg(0xE6) & 0xFu], detail);
+    }
+    if (on(0x20) && call.target.color_format != 3u) hit_draw(s, "dither.16bit_target", "", detail);
+    if (on(0x25)) hit_draw(s, "antialias", "", detail);
+
+    // Blending.
+    if (call.blend.enabled) {
+        const BlendState &blend = call.blend;
+        if (blend.equation == 5u) hit_draw(s, "blend.abs_diff", "", detail);
+        const auto doubled = [](std::uint32_t factor) { return factor >= 6u && factor <= 9u; };
+        if (blend.equation < 3u && (doubled(blend.source_factor) || doubled(blend.destination_factor)))
+            hit_draw(s, "blend.doubled_alpha_factor",
+                     std::to_string(blend.source_factor) + "/" + std::to_string(blend.destination_factor), detail);
+        const auto plain = [](std::uint32_t color) {
+            color &= 0x00FFFFFFu;
+            return color == 0u || color == 0x00FFFFFFu;
+        };
+        if (blend.equation < 3u && blend.source_factor == 10u && blend.destination_factor == 10u &&
+            !plain(blend.fixed_source) && !plain(blend.fixed_destination) &&
+            ((blend.fixed_source + blend.fixed_destination) & 0x00FFFFFFu) != 0x00FFFFFFu)
+            hit_draw(s, "blend.two_fixed_colors", hex(blend.fixed_source, 6) + "/" + hex(blend.fixed_destination, 6),
+                     detail);
+        const auto destination_alpha = [](std::uint32_t factor) {
+            return factor == 4u || factor == 5u || factor == 8u || factor == 9u;
+        };
+        if (blend.equation < 3u && (destination_alpha(blend.source_factor) || destination_alpha(blend.destination_factor))) {
+            if (call.target.color_format == 0u) hit_draw(s, "blend.dst_alpha_5650_target", "", detail);
+            else if (call.target.color_format != 3u)
+                hit_draw(s, "blend.dst_alpha_16bit_target", std::to_string(call.target.color_format), detail);
+        }
+    }
+
+    if (!call.texture.enabled) return;
+    const TextureState &texture = call.texture;
+
+    // Texture function.
+    const std::uint32_t function = texture.function;
+    if (function == 2u) hit_draw(s, "tfx.blend_env_color", hex(reg(0xCA), 6), detail);
+    if (function == 4u) hit_draw(s, "tfx.add", "", detail);
+    if (function > 4u) hit_draw(s, "tfx.invalid", std::to_string(function), detail);
+    const bool texture_has_alpha = !(texture.format == TextureFormat::Rgba5650 ||
+                                     (is_clut(texture.format) && texture.clut_format == 0u));
+    if (!texture.alpha_from_texture && texture_has_alpha) {
+        static const char *kFunctions[] = {"modulate", "decal", "blend", "replace", "add", "5", "6", "7"};
+        hit_draw(s, "tfx.tcc_rgb", kFunctions[function & 7u], detail);
+    }
+
+    // Texture coordinate generation.
+    const std::uint32_t map_mode = reg(0xC0) & 3u;
+    if (map_mode == 1u) {
+        static const char *kSources[] = {"position", "uv", "normalized_normal", "normal"};
+        const std::uint32_t source = (reg(0xC0) >> 8u) & 3u;
+        if (source == 1u && identity(call.texture_matrix))
+            hit_draw(s, "texmap.projection_identity_uv", "", detail);
+        else
+            hit_draw(s, "texmap.projection", kSources[source], detail);
+    } else if (map_mode == 2u) {
+        hit_draw(s, "texmap.env_map", "lights " + std::to_string(reg(0xC1) & 3u) + "," +
+                                          std::to_string((reg(0xC1) >> 8u) & 3u), detail);
+    }
+
+    // Levels and filtering.
+    const std::uint32_t levels = (reg(0xC2) >> 16u) & 7u;
+    const std::uint32_t level_mode = reg(0xC8) & 3u;
+    const auto bias = static_cast<std::int8_t>((reg(0xC8) >> 16u) & 0xFFu);
+    if (levels > 0u) {
+        hit_draw(s, "tex.mipmaps", std::to_string(levels + 1u) + " levels", detail);
+        if (level_mode == 1u && bias >= 16) hit_draw(s, "tex.lod_const_level", std::to_string(bias / 16), detail);
+        if (level_mode == 2u) hit_draw(s, "tex.lod_slope", "", detail);
+    }
+    if (texture.mag_filter == 0u || texture.min_filter == 0u || texture.min_filter == 4u || texture.min_filter == 6u)
+        hit_draw(s, "tex.filter_nearest_ignored", std::to_string(texture.min_filter) + "/" + std::to_string(texture.mag_filter), detail);
+
+    // Size, layout and address.
+    if (texture.width > 512u || texture.height > 512u)
+        hit_draw(s, "tex.size_over_512", std::to_string(texture.width) + "x" + std::to_string(texture.height), detail);
+    if (!is_dxt(texture.format) && texture.buffer_width < texture.width)
+        hit_draw(s, "tex.bufw_below_width", std::to_string(texture.buffer_width) + "<" + std::to_string(texture.width), detail);
+    if ((texture.address & 0x0F000000u) == 0x04000000u && (texture.address & 0x00E00000u) != 0u)
+        hit_draw(s, "tex.vram_mirror_address", hex(texture.address), detail);
+    {
+        const std::uint32_t wanted = GuestMemory::canonical(texture.address);
+        for (const auto &[depth, last] : s.depths) {
+            if (s.frame - last > 2u) continue;
+            const std::uint32_t stride = s.depth_strides[depth];
+            if (wanted >= depth && wanted - depth < stride * 272u * 2u) {
+                hit_draw(s, "tex.reads_depth_buffer", hex(depth), detail);
+                break;
+            }
+        }
+    }
+
+    // Texture cache keys (texture_decode.cpp, texture_key).
+    const std::uint32_t texture_bytes =
+        std::max<std::uint32_t>(texture.buffer_width, texture.width) * texture.height * texture_bits(texture.format) / 8u;
+    if (is_clut(texture.format)) {
+        if (texture.clut_shift != 0u || texture.clut_mask != 0xFFu || texture.clut_offset != 0u)
+            hit_draw(s, "clut.shift_mask_offset",
+                     "shift " + std::to_string(texture.clut_shift) + " mask " + hex(texture.clut_mask, 2) +
+                         " start " + std::to_string(texture.clut_offset),
+                     detail);
+        const auto key = std::make_tuple(texture.address, static_cast<std::uint32_t>(texture.width) << 16u | texture.height,
+                                         static_cast<std::uint32_t>(texture.format), texture.clut_address,
+                                         texture.clut_format);
+        const std::uint32_t variant = texture.clut_shift | texture.clut_mask << 8u | texture.clut_offset << 16u;
+        const auto [entry, inserted] = s.clut_variants.try_emplace(key, variant);
+        if (!inserted && entry->second != variant)
+            hit_draw(s, "clut.variant_cache_collision", hex(entry->second, 6) + " then " + hex(variant, 6), detail);
+        const std::uint32_t clut_bytes = std::max<std::uint32_t>(texture.clut_load_bytes, 4u);
+        if (const std::uint8_t *clut = memory.raw_pointer(texture.clut_address, clut_bytes)) {
+            std::uint32_t first_word{};
+            std::memcpy(&first_word, clut, sizeof(first_word));
+            const std::uint64_t hash = hash_bytes(clut, clut_bytes);
+            auto &seen = s.cluts[GuestMemory::canonical(texture.clut_address)];
+            if (seen.hash != 0u && seen.hash != hash && seen.first_word == first_word)
+                hit_draw(s, "clut.change_missed_by_key", hex(texture.clut_address), detail);
+            seen = {hash, first_word};
+        }
+    } else if (!is_dxt(texture.format) && texture_bytes > 64u * 1024u) {
+        // Large textures are keyed by one word in every 256 bytes. Checked
+        // once a frame per address, against a hash of every byte.
+        auto &seen = s.large_textures[GuestMemory::canonical(texture.address)];
+        if (seen.frame != s.frame && target_holding(s, texture.address, 1u) == 0u) {
+            if (const std::uint8_t *data = memory.raw_pointer(texture.address, texture_bytes)) {
+                const std::uint64_t full = hash_bytes(data, texture_bytes, 4u);
+                const std::uint64_t sampled = hash_bytes(data, texture_bytes, 256u);
+                if (seen.frame != ~0ull && full != seen.full && sampled == seen.sampled)
+                    hit_draw(s, "tex.large_change_missed_by_key", hex(texture.address), detail);
+                seen = {full, sampled, s.frame};
+            }
+        }
+    }
+
+    // Interpolation: perspective draws the in-between frames will not move.
+    if (!call.through && s.displayed.count(target) == 0u && call.projection[11] != 0.0f)
+        hit_draw(s, "interp.offscreen_perspective", hex(target), detail);
+}
+
+void note_texture_source(const DrawCall &call, bool from_target, std::uint32_t x, std::uint32_t y) {
+    if (!enabled() || !call.texture.enabled || call.clear_mode) return;
+    State &s = state();
+    std::lock_guard guard(s.lock);
+    const TextureState &texture = call.texture;
+    const std::string detail = target_detail(call);
+    // A miss counts only against a target drawn this frame or the last: VRAM
+    // a target used long ago may hold an ordinary texture now.
+    const std::uint32_t holder = target_holding(s, texture.address, from_target ? ~0ull : 1u);
+    if (holder == 0u && !from_target) return;
+    const std::uint32_t draw_target = GuestMemory::canonical(call.target.color_address);
+    if (!from_target) {
+        const TargetSeen &seen = s.targets[holder];
+        const std::string variant = "target " + hex(holder) + " fmt " + std::to_string(seen.format) + ", texture fmt " +
+                                    std::to_string(static_cast<int>(texture.format));
+        if (texture.swizzled) hit_draw(s, "fbtex.miss_swizzled", variant, detail);
+        else if (is_clut(texture.format)) hit_draw(s, "fbtex.miss_clut_view", variant, detail);
+        else if (is_dxt(texture.format)) hit_draw(s, "fbtex.miss_other_format", variant, detail);
+        else if (texture_bits(texture.format) != bytes_per_pixel(seen.format) * 8u)
+            hit_draw(s, "fbtex.miss_bpp_mismatch", variant, detail);
+        else if (texture.buffer_width != seen.stride)
+            hit_draw(s, "fbtex.miss_stride_mismatch", variant + " bufw " + std::to_string(texture.buffer_width) +
+                                                          " stride " + std::to_string(seen.stride), detail);
+        else hit_draw(s, "fbtex.miss_guest_memory", variant, detail);
+        return;
+    }
+    const TargetSeen &seen = s.targets[holder != 0u ? holder : GuestMemory::canonical(texture.address)];
+    hit_draw(s, "fbtex.sampled", "fmt " + std::to_string(seen.format) + " as " + std::to_string(static_cast<int>(texture.format)), detail);
+    if (holder == draw_target) hit_draw(s, "fbtex.self_sample", "", detail);
+    if (static_cast<std::uint32_t>(texture.format) != seen.format && texture.format != TextureFormat::Rgba5650)
+        hit_draw(s, "fbtex.format_reinterpreted",
+                 std::to_string(seen.format) + " as " + std::to_string(static_cast<int>(texture.format)), detail);
+    if ((seen.format == 1u || seen.format == 2u) && texture.format != TextureFormat::Rgba5650 &&
+        (call.blend.enabled || call.alpha_test.enabled) && texture.alpha_from_texture)
+        hit_draw(s, "fbtex.alpha_from_16bit_target", std::to_string(seen.format), detail);
+    float u0 = 0, v0 = 0, u1 = 0, v1 = 0;
+    if (texel_bounds(call, u0, v0, u1, v1)) {
+        if (static_cast<float>(x) + u1 > 480.5f || static_cast<float>(y) + v1 > 272.5f)
+            hit_draw(s, "fbtex.samples_beyond_480x272", call.through ? "through" : "transformed", detail);
+        const bool outside_u = u0 < -0.5f || u1 > static_cast<float>(texture.width) + 0.5f;
+        const bool outside_v = v0 < -0.5f || v1 > static_cast<float>(texture.height) + 0.5f;
+        if ((texture.wrap_s == 0u && outside_u) || (texture.wrap_t == 0u && outside_v))
+            hit_draw(s, "fbtex.repeat_wrap", "", detail);
+    }
+}
+
+void note_transfer(const BlockTransfer &transfer, const std::array<std::uint32_t, 256> &registers) {
+    if (!enabled()) return;
+    State &s = state();
+    std::lock_guard guard(s.lock);
+    s.registers = registers;
+    std::ostringstream detail;
+    detail << "transfer " << hex(transfer.source) << " (" << transfer.source_x << "," << transfer.source_y << " row "
+           << transfer.source_stride << ") -> " << hex(transfer.destination) << " (" << transfer.destination_x << ","
+           << transfer.destination_y << " row " << transfer.destination_stride << ") " << transfer.width << "x"
+           << transfer.height << " x" << transfer.bytes_per_pixel;
+    const auto first_byte = [&](std::uint32_t base, std::uint32_t x, std::uint32_t y, std::uint32_t stride) {
+        return base + (y * stride + x) * transfer.bytes_per_pixel;
+    };
+    const std::uint32_t from = first_byte(transfer.source, transfer.source_x, transfer.source_y, transfer.source_stride);
+    const std::uint32_t to = first_byte(transfer.destination, transfer.destination_x, transfer.destination_y,
+                                        transfer.destination_stride);
+    const std::uint32_t from_target = target_holding(s, from);
+    const std::uint32_t to_target = target_holding(s, to);
+    if (from_target != 0u) {
+        hit(s, "transfer.from_target", hex(from_target), detail.str(), kTransferWords, std::size(kTransferWords));
+        if (bytes_per_pixel(s.targets[from_target].format) != transfer.bytes_per_pixel)
+            hit(s, "transfer.bpp_vs_target", "source", detail.str(), kTransferWords, std::size(kTransferWords));
+    }
+    if (to_target != 0u) {
+        hit(s, "transfer.into_target", hex(to_target), detail.str(), kTransferWords, std::size(kTransferWords));
+        if (bytes_per_pixel(s.targets[to_target].format) != transfer.bytes_per_pixel)
+            hit(s, "transfer.bpp_vs_target", "destination", detail.str(), kTransferWords, std::size(kTransferWords));
+    }
+    const std::uint32_t span_from = transfer.source_stride * transfer.height * transfer.bytes_per_pixel;
+    const std::uint32_t span_to = transfer.destination_stride * transfer.height * transfer.bytes_per_pixel;
+    const std::uint32_t a = GuestMemory::canonical(from);
+    const std::uint32_t b = GuestMemory::canonical(to);
+    if (a < b + span_to && b < a + span_from)
+        hit(s, "transfer.overlapping", "", detail.str(), kTransferWords, std::size(kTransferWords));
+}
+
+void note_unhandled(std::uint32_t command, std::uint32_t data) {
+    if (!enabled()) return;
+    State &s = state();
+    std::lock_guard guard(s.lock);
+    ++s.unhandled[command];
+    ++s.scenes[s.scene].unhandled[command];
+    const std::uint32_t none[] = {0u};
+    const std::string detail = "command " + hex(command, 2) + " data " + hex(data, 6);
+    if (command == 0x07u) hit(s, "bbox.ignored", "", detail, none, 0u);
+    else if (command >= 0xF0u && command <= 0xF9u) hit(s, "immediate_draw.ignored", hex(command, 2), detail, none, 0u);
+    else if (command >= 0x0E00u) hit(s, "signal.unhandled", hex(command & 0xFFu, 2), detail, none, 0u);
+}
+
+void note_vram_copy(std::uint32_t destination, std::uint32_t source, std::uint32_t size) {
+    if (!enabled()) return;
+    State &s = state();
+    std::lock_guard guard(s.lock);
+    const std::uint32_t none[] = {0u};
+    std::ostringstream detail;
+    detail << "dma " << hex(source) << " -> " << hex(destination) << " " << size << " bytes";
+    if (const std::uint32_t target = target_holding(s, source); target != 0u)
+        hit(s, "dma.copy_from_target", hex(target), detail.str(), none, 0u);
+    if (const std::uint32_t target = target_holding(s, destination); target != 0u)
+        hit(s, "dma.copy_into_target", hex(target), detail.str(), none, 0u);
+}
+
+void note_renderer(const char *feature) {
+    if (!enabled()) return;
+    State &s = state();
+    std::lock_guard guard(s.lock);
+    hit_draw(s, feature, "", "target " + hex(s.draw_target) + " texture " + hex(s.draw_texture));
+}
+
+void write() {
+    if (!enabled()) return;
+    State &s = state();
+    std::lock_guard guard(s.lock);
+    write_locked(s);
+    std::cout << "[census] " << s.features.size() << " features over " << s.frame << " frames and " << s.draws
+              << " draws written to " << s.path << std::endl;
+}
+
+} // namespace portablekit::gpu::census
