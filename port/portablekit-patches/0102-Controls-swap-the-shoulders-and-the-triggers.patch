@@ -767,8 +769,6 @@ void read_gamepad(SDL_Gamepad *device, PadState &pad, int &analog_x, int &analog
     held(SDL_GAMEPAD_BUTTON_DPAD_RIGHT, 0x0020u);
     held(SDL_GAMEPAD_BUTTON_DPAD_DOWN, 0x0040u);
     held(SDL_GAMEPAD_BUTTON_DPAD_LEFT, 0x0080u);
-    held(SDL_GAMEPAD_BUTTON_LEFT_SHOULDER, 0x0100u);
-    held(SDL_GAMEPAD_BUTTON_RIGHT_SHOULDER, 0x0200u);
     held(SDL_GAMEPAD_BUTTON_START, 0x0008u);
     held(SDL_GAMEPAD_BUTTON_BACK, 0x0001u);
     held(SDL_GAMEPAD_BUTTON_NORTH, 0x1000u);
@@ -801,11 +801,23 @@ void read_gamepad(SDL_Gamepad *device, PadState &pad, int &analog_x, int &analog
     // gets the triggers as those instead, unless the player chose a profile.
     const std::uint32_t extras = portablekit::active_extra_buttons();
     const bool profiled = tuning.triggers != 0u && tuning.triggers <= profiles.size();
-    if (axis(SDL_GAMEPAD_AXIS_LEFT_TRIGGER) > tuning.trigger) {
+    bool left_shoulder = SDL_GetGamepadButton(device, SDL_GAMEPAD_BUTTON_LEFT_SHOULDER);
+    bool right_shoulder = SDL_GetGamepadButton(device, SDL_GAMEPAD_BUTTON_RIGHT_SHOULDER);
+    bool left_pulled = axis(SDL_GAMEPAD_AXIS_LEFT_TRIGGER) > tuning.trigger;
+    bool right_pulled = axis(SDL_GAMEPAD_AXIS_RIGHT_TRIGGER) > tuning.trigger;
+    // Swap shoulders and triggers: each pair does all the other would,
+    // the extra buttons L2 and R2 and a trigger profile included.
+    if (tuning.swap_triggers) {
+        std::swap(left_shoulder, left_pulled);
+        std::swap(right_shoulder, right_pulled);
+    }
+    if (left_shoulder) buttons |= 0x0100u;
+    if (right_shoulder) buttons |= 0x0200u;
+    if (left_pulled) {
         pad.extra |= input::kExtraL2;
         if (profiled || (extras & input::kExtraL2) == 0u) buttons |= left_trigger;
     }
-    if (axis(SDL_GAMEPAD_AXIS_RIGHT_TRIGGER) > tuning.trigger) {
+    if (right_pulled) {
         pad.extra |= input::kExtraR2;
         if (profiled || (extras & input::kExtraR2) == 0u) buttons |= right_trigger;
     }
@@ -2456,7 +2468,7 @@ struct VulkanRenderer::Impl {
                           << (tuning.right_stick_mode == settings::RightStick::DPad     ? "as D-pad"
                               : tuning.right_stick_mode == settings::RightStick::Camera ? "as camera"
                                                                                         : "off")
-                          << "\n";
+                          << (tuning.swap_triggers ? ", L and R on the triggers" : "") << "\n";
             } else {
                 std::cout << (listed(old1_id) ? "[pad] player 1 has no gamepad\n" : "[pad] gamepad disconnected\n");
             }
@@ -5183,14 +5195,15 @@ void VulkanRenderer::Impl::apply_texture_edits() {
     if (off || profile.edit_texture == nullptr || profile.edited_textures.empty()) return;
     const settings::Settings &s = settings::current();
     TextureEditContext context;
-    context.prompts =
-        input::button_prompts(s.button_prompts, pad_kind(gamepad), s.confirm_south, profile.confirm_button == 1u);
+    context.prompts = input::button_prompts(s.button_prompts, pad_kind(gamepad), s.confirm_south,
+                                            profile.confirm_button == 1u, s.swap_triggers);
     context.sharp_textures = sharp_textures;
     if (edit_context && *edit_context == context) return;
     const bool first = !edit_context;
     edit_context = context;
     if (profile.button_prompts)
-        std::cout << "[render] button prompts: " << input::prompt_style_name(context.prompts.style) << "\n";
+        std::cout << "[render] button prompts: " << input::prompt_style_name(context.prompts.style)
+                  << (context.prompts.l_r_on_triggers ? ", L and R on the triggers" : "") << "\n";
     if (first) return;
     // Drawn again as they are next used.
     device_wait_idle();
