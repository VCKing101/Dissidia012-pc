-// Client to server. Ping, Disconnect and Scan are the opcode alone.
-inline std::string login(const Mac &mac, std::string_view nickname, std::string_view product) {
+// A copy's version tag (GameProfile::adhoc_version) rides in the login's
+// nickname field, after the nickname's terminating NUL: "v=", the tag, NUL.
+// A server that knows nothing of it reads the nickname up to its NUL and
+// never sees the tag, so a tagged copy logs in anywhere; a server that does
+// keeps copies with different tags apart (server.hpp).
+inline constexpr std::size_t kVersionTagLength = 48;
+inline constexpr std::string_view kVersionMark = "v=";
+
+// A version tag: 1 to kVersionTagLength letters, digits and . _ - +.
+[[nodiscard]] inline bool version_tag_ok(std::string_view tag) {
+    if (tag.empty() || tag.size() > kVersionTagLength) return false;
+    for (const char c : tag)
+        if (!((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '.' || c == '_' ||
+              c == '-' || c == '+'))
+            return false;
+    return true;
+}
+
+// Client to server. Ping, Disconnect and Scan are the opcode alone. A
+// version tag that is not version_tag_ok() is left out.
+inline std::string login(const Mac &mac, std::string_view nickname, std::string_view product,
+                         std::string_view version = {}) {
     std::string out;
     wire::put8(out, kLogin);
     wire::put_mac(out, mac);
-    wire::put_fixed(out, nickname.substr(0, kNicknameLength - 1u), kNicknameLength);
+    std::string field;
+    if (version_tag_ok(version)) {
+        // The nickname keeps what room the tag leaves it.
+        const std::size_t room = kNicknameLength - 1u - kVersionMark.size() - version.size() - 1u;
+        field.append(nickname.substr(0, room));
+        field.push_back('\0');
+        field.append(kVersionMark);
+        field.append(version);
+    } else {
+        field.append(nickname.substr(0, kNicknameLength - 1u));
+    }
+    wire::put_fixed(out, field, kNicknameLength);
     wire::put_fixed(out, product, kProductCodeLength);
     return out;
 }
+
+// The version tag in a login's nickname field (kNicknameLength bytes), empty
+// for none or one that is not version_tag_ok().
+[[nodiscard]] inline std::string login_version(const char *field) {
+    std::size_t at = 0;
+    while (at < kNicknameLength && field[at] != '\0') ++at;
+    ++at;
+    if (at + kVersionMark.size() > kNicknameLength ||
+        std::string_view(field + at, kVersionMark.size()) != kVersionMark)
+        return {};
+    at += kVersionMark.size();
+    std::string tag = wire::get_fixed(field + at, kNicknameLength - at);
+    return version_tag_ok(tag) ? tag : std::string{};
+}
 inline std::string connect(std::string_view group) {
     std::string out;
     wire::put8(out, kConnect);
