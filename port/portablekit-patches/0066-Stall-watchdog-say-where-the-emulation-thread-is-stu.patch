index 67a15ba..e425bd1 100644
--- a/include/psprecomp/runtime.hpp
+++ b/include/psprecomp/runtime.hpp
@@ -63,6 +63,21 @@ public:
     NidRegistry &nids() noexcept;
     const NidRegistry &nids() const noexcept;
 
+    // What the emulation thread is doing, for a watchdog on another thread:
+    // the HLE function it is inside (null when none), and running counts of
+    // HLE calls and of starvation boundaries (a guest thread preempted after a
+    // stretch with no import). Written by the emulation thread only, with
