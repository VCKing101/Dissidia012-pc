 }
 
+// Where the emulation thread is, as this thread can see it, and what its
+// counts over the last second say it is doing. Its context is read while it
+// may be writing it; a report can bear a torn value.
+std::string emulation_thread(const State &s, const psprecomp::Runtime::Activity &before,
+                             const psprecomp::Runtime::Activity &after, std::int64_t now) {
+    const psprecomp::Runtime *runtime = s.runtime.load();
+    const char *name = psprecomp::runtime_thread_name();
+    const std::uint64_t calls = after.hle_calls - before.hle_calls;
+    const std::uint64_t preemptions = after.starvation_boundaries - before.starvation_boundaries;
+    const std::string call = runtime != nullptr ? runtime->hle_function_name(after.hle_function) : std::string();
+    std::ostringstream out;
+    out << "[stall] the emulation thread: guest thread " << psprecomp::runtime_thread_uid() << " '"
+        << name << "', last dispatched " << psprecomp::hex32(psprecomp::runtime_dispatch_pc());
+    if (runtime != nullptr)
+        out << ", pc " << psprecomp::hex32(runtime->cpu().pc) << " ra " << psprecomp::hex32(runtime->cpu().gpr[31]);
+    out << "; " << (call.empty() ? std::string("in no HLE call") : "in " + call) << "; in the last second " << calls
+        << " HLE calls and " << preemptions << " preemptions\n[stall] ";
+    if (s.last_idle_ms.load() != 0 && now - s.last_idle_ms.load() < 1500)
+        out << "every guest thread waits: the scheduler's own [stall] lines say on what";
+    else if (calls == 0u && !call.empty())
+        out << "stuck in the port's handling of " << call << ", which has not returned for at least a second";
+    // A preemption is a guest thread that ran a stretch with no HLE call; the
+    // calls counted meanwhile are the other threads' it let run.
+    else if (preemptions != 0u)
+        out << "looping in the game's code with no HLE call (pc is in the loop or the last function it called)";
+    else if (calls != 0u)
+        out << "looping through HLE calls: the game waits for something that does not come";
+    else
+        out << "no HLE call and no preemption: a loop inside one recompiled function, or in host code it called "
+               "(a port's override)";
+    return out.str();
+}
+
 void watch() {
     State &s = state();
+    psprecomp::Runtime::Activity before = psprecomp::Runtime::activity();
     for (;;) {
         std::this_thread::sleep_for(std::chrono::seconds(1));
+        const psprecomp::Runtime::Activity previous = std::exchange(before, psprecomp::Runtime::activity());
         const std::int64_t now = now_ms();
         const std::int64_t stalled = stalled_ms(s, now);
         if (stalled < stall_limit_ms()) continue;
@@ -98,7 +137,8 @@ void watch() {
                                            : "last went idle " + std::to_string(now - s.last_idle_ms.load()) +
                                                  " ms ago")
             << "\n"
-            << pad_history(s, now) << "\n";
+            << pad_history(s, now) << "\n"
+            << emulation_thread(s, previous, before, now) << "\n";
         std::cerr << out.str() << std::flush;
     }
 }
@@ -140,6 +180,8 @@ void note_pad(std::uint32_t buttons) {
 
 void set_stalled_pump(std::function<void()> pump) { state().pump = std::move(pump); }
 
+void set_runtime(const psprecomp::Runtime &runtime) { state().runtime.store(&runtime); }
+
 void idle(const Kernel &kernel) {
     if (!enabled()) return;
     State &s = state();
