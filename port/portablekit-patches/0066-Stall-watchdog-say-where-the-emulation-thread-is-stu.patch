     // Binds a PSP import stub's address, so a jump to it calls the HLE and
diff --git a/src/runtime.cpp b/src/runtime.cpp
index 72c0ad7..3531431 100644
--- a/src/runtime.cpp
+++ b/src/runtime.cpp
@@ -5,6 +5,7 @@
 
 #include <algorithm>
 #include <array>
+#include <atomic>
 #include <cstdlib>
 #include <cstring>
 #include <iostream>
@@ -28,6 +29,27 @@ RuntimePostImportHook g_post_import_hook = nullptr;
 std::int32_t g_runtime_thread_uid = -1;
 std::array<char, 64> g_runtime_thread_name{};
 std::uint32_t g_runtime_dispatch_pc = 0u;
+// Runtime::activity(). The emulation thread is the only writer, so a count
+// goes up by a relaxed load and store, a plain one on the usual hosts.
+std::atomic<const Runtime::HleFunction *> g_activity_hle_function{nullptr};
+std::atomic<std::uint64_t> g_activity_hle_calls{0u};
+std::atomic<std::uint64_t> g_activity_starvation_boundaries{0u};
+
+void count_activity(std::atomic<std::uint64_t> &count) noexcept {
+    count.store(count.load(std::memory_order_relaxed) + 1u, std::memory_order_relaxed);
+}
+
+// Marks an HLE call in progress for Runtime::activity(), until it returns or
+// throws.
+struct HleActivity {
+    explicit HleActivity(const Runtime::HleFunction *function) noexcept {
+        count_activity(g_activity_hle_calls);
+        g_activity_hle_function.store(function, std::memory_order_relaxed);
+    }
+    ~HleActivity() { g_activity_hle_function.store(nullptr, std::memory_order_relaxed); }
+    HleActivity(const HleActivity &) = delete;
+    HleActivity &operator=(const HleActivity &) = delete;
+};
 RuntimeHeartbeatHook g_heartbeat_hook = nullptr;
 std::uint64_t g_heartbeat_interval = 0u;
 RuntimeStarvationHook g_starvation_hook = nullptr;
@@ -206,6 +228,7 @@ bool Runtime::run_starvation_boundary(AllegrexContext &ctx) {
     if (g_starvation_hook == nullptr || interval == 0u) return true;
     // Preserve excess work if a context switch deferred several boundaries.
     dispatches_since_import_ -= std::min(dispatches_since_import_, interval);
+    count_activity(g_activity_starvation_boundaries);
     const RuntimeExecutionContextToken before = capture_runtime_execution_context();
     g_starvation_hook(*this, ctx);
     const bool same_context = runtime_execution_context_matches(before);
@@ -1377,7 +1400,10 @@ void Runtime::invoke_import_cached(std::uint32_t slot, std::string_view library,
     }
 
     if (hle_first_calls_) note_first_hle_call(library, nid, ctx);
-    (*bound)(*this, ctx);
+    {
+        const HleActivity activity(bound);
+        (*bound)(*this, ctx);
+    }
     if (!stopped_ && g_post_import_hook != nullptr) g_post_import_hook(*this, ctx);
 }
 
@@ -1397,10 +1423,33 @@ void Runtime::invoke_import(std::string_view library, std::uint32_t nid, Allegre
         return;
     }
     if (hle_first_calls_) note_first_hle_call(library, nid, ctx);
-    function_it->second(*this, ctx);
+    {
+        const HleActivity activity(&function_it->second);
+        function_it->second(*this, ctx);
+    }
     if (!stopped_ && g_post_import_hook != nullptr) g_post_import_hook(*this, ctx);
 }
 
+Runtime::Activity Runtime::activity() noexcept {
+    return Activity{g_activity_hle_function.load(std::memory_order_relaxed),
+                    g_activity_hle_calls.load(std::memory_order_relaxed),
+                    g_activity_starvation_boundaries.load(std::memory_order_relaxed)};
+}
+
+// Only the emulation thread changes the HLE table (at start, and when a
+// module's imports are bound), so another thread can walk it while that one
+// is stalled.
+std::string Runtime::hle_function_name(const HleFunction *function) const {
+    if (function == nullptr) return {};
+    for (const auto &[library, functions] : hle_) {
+        for (const auto &[nid, registered] : functions) {
+            if (&registered != function) continue;
+            return library + "::" + nids_.resolve(library, nid).value_or(hex32(nid));
+        }
+    }
+    return {};
+}
+
 AllegrexContext &Runtime::cpu() noexcept { return cpu_; }
 const AllegrexContext &Runtime::cpu() const noexcept { return cpu_; }
 
