 namespace portablekit::gpu::interpolation {
 namespace {
 
+// How a draw is turned and sized in eye space: the three basis vectors of view
+// times world, one after another.
+using Pose = std::array<float, 9>;
+
+Pose eye_pose_of(const DrawSummary &draw) noexcept {
+    Pose pose{};
+    for (std::size_t column = 0; column < 3u; ++column)
+        for (std::size_t row = 0; row < 3u; ++row)
+            for (std::size_t k = 0; k < 4u; ++k)
+                pose[column * 3u + row] += draw.view[k * 4u + row] * draw.world[column * 4u + k];
+    return pose;
+}
+
+// The squared difference of each basis vector against the longer of the two,
+// summed: 0 for the same pose, about 0.1 for a quarter's growth in size, 4(1 -
+// cos a) for a turn by a.
+float pose_difference(const Pose &a, const Pose &b) noexcept {
+    float total = 0.0f;
+    for (std::size_t column = 0; column < 3u; ++column) {
+        float difference = 0.0f, size_a = 0.0f, size_b = 0.0f;
+        for (std::size_t row = 0; row < 3u; ++row) {
+            const float x = a[column * 3u + row], y = b[column * 3u + row];
+            difference += (x - y) * (x - y);
+            size_a += x * x;
+            size_b += y * y;
+        }
+        const float size = std::max(size_a, size_b);
+        if (size > 1e-12f) total += difference / size;
+    }
+    return total;
+}
+
+// A drawing-order partner this close in pose is the same copy (a turn of about
+// 8 degrees, or a growth of 8%, in one game frame).
+constexpr float kSamePose = 0.02f;
+// A copy further from this in pose is another copy (a turn of about 32
+// degrees, or nearly doubling in size).
+constexpr float kOtherPose = 0.6f;
+
+// A sprite: a quad, as a strip or fan of four vertices or two triangles of six.
+constexpr std::uint32_t kSpriteVertices = 6u;
+// The newer sprites each older one considers, nearest first.
+constexpr std::size_t kNearestSprites = 4u;
+// Above this many pairs in one pool of sprites, its draws stay as they paired.
+constexpr std::size_t kMaxSpritePairs = std::size_t{1} << 18u;
+
+// The sprites that may be one another: one texture, vertex format, size,
+// primitive and view, whichever vertices they read.
+std::uint64_t sprite_pool_of(const DrawSummary &draw) noexcept {
+    return std::uint64_t{draw.texture_address} << 32u | std::uint64_t{draw.vertex_type & 0xFFFFFFu} << 8u |
+           std::uint64_t{draw.count & 7u} << 5u | std::uint64_t{static_cast<std::uint8_t>(draw.primitive) & 7u} << 2u |
+           std::uint64_t{draw.split_view & 3u};
+}
+
 constexpr float kPi = 3.14159265358979f;
 
 float length3(const float *v) noexcept { return std::sqrt(v[0] * v[0] + v[1] * v[1] + v[2] * v[2]); }
