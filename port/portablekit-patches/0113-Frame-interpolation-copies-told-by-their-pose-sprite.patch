-            for (std::int32_t at = slot_for(key_of(from), from).first; at >= 0; at = next_[static_cast<std::size_t>(at)])
-                if (taken_[static_cast<std::size_t>(at)] == 0u)
-                    candidates_.push_back({squared_distance(predicted, at), i, at});
+            const OlderPose pose = poses ? older_pose(from) : OlderPose{};
+            for (std::int32_t at = slot_for(key_of(from), from).first; at >= 0; at = next_[static_cast<std::size_t>(at)]) {
+                if (taken_[static_cast<std::size_t>(at)] != 0u) continue;
+                float distance = squared_distance(predicted, at);
+                if (poses) {
+                    const float change = pose_change(pose, at);
