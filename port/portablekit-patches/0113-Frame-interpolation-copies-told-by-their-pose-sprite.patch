+            }
         }
-        std::sort(candidates_.begin(), candidates_.end(), [](const Candidate &a, const Candidate &b) {
-            return a.distance < b.distance || (a.distance == b.distance && a.older < b.older);
-        });
-        for (const Candidate &candidate : candidates_) {
-            std::int32_t &partner = out.newer_of[static_cast<std::size_t>(candidate.older)];
-            if (partner >= 0 || taken_[static_cast<std::size_t>(candidate.newer)] != 0u) continue;
-            partner = candidate.newer;
-            taken_[static_cast<std::size_t>(candidate.newer)] = 1u;
-            ++out.matched;
+        const auto pair_nearest_first = [&] {
+            std::sort(candidates_.begin(), candidates_.end(), [](const Candidate &a, const Candidate &b) {
+                return a.distance < b.distance || (a.distance == b.distance && a.older < b.older);
+            });
+            for (const Candidate &candidate : candidates_) {
+                std::int32_t &partner = out.newer_of[static_cast<std::size_t>(candidate.older)];
+                if (partner >= 0 || taken_[static_cast<std::size_t>(candidate.newer)] != 0u) continue;
+                partner = candidate.newer;
+                taken_[static_cast<std::size_t>(candidate.newer)] = 1u;
+                ++out.matched;
+            }
+            for (const auto &[i, in_order] : unsettled_)
+                if (out.newer_of[static_cast<std::size_t>(i)] != in_order) ++out.reordered;
+        };
+        pair_nearest_first();
+
+        // Sprites again, by pool: the address a quad was written to says
+        // nothing about which quad it is (CutThresholds::sprite_pools).
+        if (thresholds.sprite_pools) {
+            older_sprites_.clear();
+            newer_sprites_.clear();
+            for (std::size_t i = 0; i < older.size(); ++i)
+                if (older[i].eligible && older[i].count <= kSpriteVertices &&
+                    out.views[std::min<std::size_t>(older[i].split_view, kViews - 1u)].found)
+                    older_sprites_.push_back({sprite_pool_of(older[i]), static_cast<std::int32_t>(i)});
+            for (std::size_t i = 0; i < newer.size(); ++i)
+                if (newer[i].eligible && newer[i].count <= kSpriteVertices)
+                    newer_sprites_.push_back({sprite_pool_of(newer[i]), static_cast<std::int32_t>(i)});
+            std::sort(older_sprites_.begin(), older_sprites_.end());
+            std::sort(newer_sprites_.begin(), newer_sprites_.end());
+            unsettled_.clear();
+            candidates_.clear();
+            const float reach = thresholds.max_own_motion * thresholds.max_own_motion;
+            const auto by_pool = [](const std::pair<std::uint64_t, std::int32_t> &a, std::uint64_t pool) {
+                return a.first < pool;
+            };
+            auto newer_first = newer_sprites_.begin();
+            for (auto first = older_sprites_.begin(); first != older_sprites_.end();) {
+                const std::uint64_t pool = first->first;
+                auto last = first;
+                while (last != older_sprites_.end() && last->first == pool) ++last;
+                newer_first = std::lower_bound(newer_first, newer_sprites_.end(), pool, by_pool);
+                auto newer_last = newer_first;
+                while (newer_last != newer_sprites_.end() && newer_last->first == pool) ++newer_last;
+                const std::size_t olds = static_cast<std::size_t>(last - first);
+                const std::size_t news = static_cast<std::size_t>(newer_last - newer_first);
+                if ((olds >= 2u || news >= 2u) && olds * news <= kMaxSpritePairs) {
+                    // A sprite whose partner is where the camera carries it
+                    // keeps it: quads with their places in their vertices
+                    // share one matrix, and only their addresses tell them
+                    // apart.
+                    const std::size_t pool_start = unsettled_.size();
+                    for (auto sprite = first; sprite != last; ++sprite) {
+                        const DrawSummary &from = older[static_cast<std::size_t>(sprite->second)];
+                        std::int32_t &partner = out.newer_of[static_cast<std::size_t>(sprite->second)];
+                        if (partner >= 0 && squared_distance(predicted_of(from), partner) <= close * close &&
