+                            if (distance > reach) continue;
+                            if (found == kNearestSprites && distance >= nearest[found - 1u].first) continue;
+                            std::size_t at = found < kNearestSprites ? found++ : kNearestSprites - 1u;
+                            for (; at > 0u && nearest[at - 1u].first > distance; --at) nearest[at] = nearest[at - 1u];
+                            nearest[at] = {distance, other->second};
+                        }
