+                    for (std::size_t u = pool_start; u < unsettled_.size(); ++u) {
+                        const std::int32_t older_draw = unsettled_[u].first;
+                        const DrawSummary &from = older[static_cast<std::size_t>(older_draw)];
+                        const std::array<float, 3> predicted = predicted_of(from);
+                        std::array<std::pair<float, std::int32_t>, kNearestSprites> nearest{};
+                        std::size_t found = 0u;
+                        for (auto other = newer_first; other != newer_last; ++other) {
+                            if (taken_[static_cast<std::size_t>(other->second)] != 0u) continue;
