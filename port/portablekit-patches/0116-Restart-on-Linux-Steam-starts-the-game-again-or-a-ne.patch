 bool report_problem(const std::string &title, const std::string &message, bool ask_setup);
 bool report_problem_in_dialog(const std::string &title, const std::string &message, bool ask_setup);
 
+// Both restarts below, on Linux: the program quits as it always does, and the
+// new run starts once it has exited.
+// - Under Steam (its launcher sets SteamGameId), Steam starts it, as the
+//   player's Play would: a helper, a user service of its own (systemd-run
+//   --user) so that it is none of the game's processes, waits for the game and
+//   Steam's launcher of it to end, then asks Steam to run the game
+//   (steam -ifrunning steam://rungameid/<id>). Steam's screen shows for a
+//   moment between the two. The setup's restart leaves kSetupMarkerFile for
+//   the next start, as Steam cannot pass --install. Any new run started inside
+//   the game instead, in place (exec) or as a process of its own, left the
+//   Steam Deck's Gaming Mode on a black screen, with the Steam button doing
+//   nothing, until the Deck slept, more often than not.
+//   <PREFIX>_RESTART_NOT_THROUGH_STEAM=1 starts it as off Steam.
+// - Off Steam, or without systemd-run: the program starts the new run as it
+//   exits, as a process of its own, which waits for it to be gone
+//   (wait_for_previous_run) before it does anything.
+// <PREFIX>_RESTART_IN_PLACE=1 replaces the process in place, as before.
+// Windows starts the new run at once (_exec does), and macOS replaces the
+// process.
+
 // "Set up game data again" in the in-game menu: the game quits, and the
 // program starts again with --install once it has shut down.
 void request_setup_on_exit();
 [[nodiscard]] bool setup_requested_on_exit();
-// Replaces this process with `program --install`. Returns only on failure,
-// with the exit code to use.
+// Starts `program --install` (see above). The exit code to use: on Linux the
+// new run starts as this one exits; elsewhere this returns only on failure.
 int restart_for_setup(const char *program);
 
 // "Restart now" after a save import in the in-game menu: the game quits, and
@@ -130,8 +150,15 @@ int restart_for_setup(const char *program);
 // screen, where the game reads its saves.
 void request_restart_on_exit();
 [[nodiscard]] bool restart_requested_on_exit();
-// Replaces this process with a new run of the same program and arguments.
-// Returns only on failure, with the exit code to use.
+// Starts a new run of the same program and arguments (see above). The exit
+// code to use: on Linux the new run starts as this one exits; elsewhere this
+// returns only on failure.
 int restart(char **argv);
 
+// First thing in the program: when one of the restarts above started this
+// run, waits for the run that started it to have exited (at most 30 seconds).
+// The host's main does it; a port with a main of its own in front calls it
+// first. Nothing elsewhere than Linux.
+void wait_for_previous_run();
+
 } // namespace portablekit::install
