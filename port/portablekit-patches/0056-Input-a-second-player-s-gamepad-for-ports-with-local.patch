+// A plain second virtual pad, which the renderer gives player 2 by its name.
+void attach_second_pad(State &s) {
+    SDL_VirtualJoystickDesc desc;
+    SDL_INIT_INTERFACE(&desc);
+    desc.type = SDL_JOYSTICK_TYPE_GAMEPAD;
+    desc.naxes = SDL_GAMEPAD_AXIS_COUNT;
+    desc.nbuttons = SDL_GAMEPAD_BUTTON_COUNT;
+    desc.axis_mask = (1u << SDL_GAMEPAD_AXIS_COUNT) - 1u;
+    desc.button_mask = (1u << SDL_GAMEPAD_BUTTON_COUNT) - 1u;
+    desc.name = kInputScriptName2;
+    // A device of its own to SDL: with the first pad's ids it would get the
+    // first pad's mapping and gamepad name.
+    desc.vendor_id = 0x5054u;
+    desc.product_id = 0x0002u;
+    const SDL_JoystickID id = SDL_AttachVirtualJoystick(&desc);
+    if (id == 0) {
+        std::cout << "[script] cannot attach a second virtual gamepad: " << SDL_GetError() << std::endl;
+        return;
+    }
+    s.pad2 = SDL_OpenJoystick(id);
+    s.pad2_id = id;
+}
+
