@@ -2357,7 +2380,35 @@ struct VulkanRenderer::Impl {
         if (joysticks == 0) std::cout << "[pad] no gamepad connected, keyboard only\n";
     }
 
+    // Player 2's pad; a scripted one takes over from a real one, as for
+    // player 1.
+    void open_second_gamepad(SDL_JoystickID id, bool scripted) {
+        if (gamepad2 != nullptr) {
+            if (!scripted) return;
+            SDL_CloseGamepad(gamepad2);
+            gamepad2 = nullptr;
+        }
+        SDL_Gamepad *device = SDL_OpenGamepad(id);
+        if (device == nullptr) {
+            std::cout << "[pad] SDL_OpenGamepad failed: " << SDL_GetError() << "\n";
+            return;
+        }
+        gamepad2 = device;
+        gamepad2_id = id;
+        const char *name = SDL_GetGamepadName(device);
+        std::cout << "[pad] player 2: " << (name != nullptr ? name : "gamepad") << " connected\n";
+    }
+
     void close_gamepad(SDL_JoystickID id) {
+        if (gamepad2 != nullptr && id == gamepad2_id) {
+            SDL_CloseGamepad(gamepad2);
+            gamepad2 = nullptr;
+            gamepad2_id = 0;
+            pad2 = PadState{};
+            std::cout << "[pad] player 2's gamepad disconnected\n";
+            scan_gamepads();
+            return;
+        }
         if (gamepad == nullptr || id != gamepad_id) return;
         input::motion::gamepad_changed(nullptr);
         SDL_CloseGamepad(gamepad);
