     // Only the first pad is used; a second one arriving is ignored rather than
     // stealing the stick from whoever is already playing.
     void open_gamepad(SDL_JoystickID id) {
+        if ((gamepad != nullptr && id == gamepad_id) || (gamepad2 != nullptr && id == gamepad2_id)) return;
+        // The script's two virtual pads by their joystick names: SDL may give
+        // both the first one's gamepad name.
+        if (const char *id_name = SDL_GetJoystickNameForID(id); second_pad_wanted) {
+            // The input script's second virtual pad is always player 2's;
+            // any other pad is player 2's once player 1 has one.
+            const bool script2 = id_name != nullptr && std::strcmp(id_name, portablekit::kInputScriptName2) == 0;
