     // The gamepad adds to the same bits and offsets, so both sources are live.
     if (impl_->gamepad != nullptr) read_gamepad(impl_->gamepad, pad, analog_x, analog_y);
+    // Player 2's gamepad is a pad of its own.
+    PadState second{};
+    if (impl_->gamepad2 != nullptr) {
+        int second_x = 0;
+        int second_y = 0;
+        read_gamepad(impl_->gamepad2, second, second_x, second_y);
+        second.analog_x = static_cast<std::uint8_t>(std::clamp(0x80 + second_x, 0, 255));
+        second.analog_y = static_cast<std::uint8_t>(std::clamp(0x80 + second_y, 0, 255));
+    }
+    impl_->pad2 = second;
     // So do the on-screen controls.
     if (impl_->touch_visible) {
         pad.buttons |= impl_->touch.buttons();
@@ -6924,6 +6986,23 @@ void VulkanRenderer::Impl::sample_pad(bool focused) {
 
 PadState VulkanRenderer::pad() const noexcept { return impl_ ? impl_->pad : PadState{}; }
 
+void VulkanRenderer::set_second_pad_wanted(bool wanted) {
+    if (!impl_ || impl_->second_pad_wanted == wanted) return;
+    impl_->second_pad_wanted = wanted;
+    if (wanted) {
+        impl_->scan_gamepads();
+    } else if (impl_->gamepad2 != nullptr) {
+        SDL_CloseGamepad(impl_->gamepad2);
+        impl_->gamepad2 = nullptr;
+        impl_->gamepad2_id = 0;
+        impl_->pad2 = PadState{};
+    }
+}
+
+bool VulkanRenderer::second_pad_connected() const noexcept { return impl_ && impl_->gamepad2 != nullptr; }
+
+PadState VulkanRenderer::second_pad() const noexcept { return impl_ ? impl_->pad2 : PadState{}; }
+
 bool VulkanRenderer::touch_controls_visible() const noexcept {
     return impl_ && impl_->touch_visible && impl_->game_input && settings::current().touch_controls;
 }
