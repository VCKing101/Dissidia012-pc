@@ -6954,6 +7030,16 @@ void VulkanRenderer::submit(const DrawCall &call, const GuestMemory &memory) {
         }
         return left <= 0.0f && top <= 0.0f && right >= screen_w && bottom >= screen_h && area >= screen_w * screen_h;
     }();
+    // A draw that tests or writes a depth buffer whose newest picture is in
+    // another target's depth image takes a copy of it first; a clear of the
+    // whole screen needs nothing loaded.
+    const bool reads_depth = key.depth_test && key.depth_function != 1u;
+    const bool writes_depth = key.depth_test && key.depth_write;
+    if (impl.shared_depth && (reads_depth || (writes_depth && !clear_covers))) {
+        std::string error;
+        if (Impl::Target *target = impl.target_for(call.target.color_address, error); target != nullptr)
+            impl.share_depth(*target, call.target.depth_address, call.target.depth_stride);
+    }
     // A draw that tests or writes the stencil after the alpha was written
     // needs the stencil brought up to date first (Target::stencil_sync).
     if (stencil_target && (reads_stencil || writes_stencil)) {
@@ -6987,6 +7073,17 @@ void VulkanRenderer::submit(const DrawCall &call, const GuestMemory &memory) {
             impl.snapshot_guest_words(memory, call.target.color_address, drawn);
         drawn.last_drawn_frame = impl.frames;
         drawn.draw_serial = ++impl.target_draw_counter;
+        if (impl.shared_depth && writes_depth) {
+            // This target's depth image now has the newest picture of the
+            // depth buffer; a new number once others have copied the last.
+            Impl::DepthPicture &picture = impl.depth_pictures[call.target.depth_address];
+            if (picture.holder != call.target.color_address || picture.copied || picture.version == 0u ||
+                drawn.depth_version != picture.version) {
+                picture = {call.target.color_address, ++impl.depth_versions, call.target.depth_stride, false};
+                drawn.depth_address = call.target.depth_address;
+                drawn.depth_version = picture.version;
+            }
+        }
         if (stencil_target) {
             // A draw that writes alpha, or blends with the destination's,
             // after the stencil changed needs the alpha brought up to date.
