     if (!create_image(target_extent.width, target_extent.height, depth_format,
-                      VK_IMAGE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT, target.depth, target.depth_memory,
-                      target.depth_view, depth_aspect(), error))
