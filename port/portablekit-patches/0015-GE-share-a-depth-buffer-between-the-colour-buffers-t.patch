 }
 
+void VulkanRenderer::Impl::share_depth(Target &target, std::uint32_t address, std::uint32_t stride) {
+    const auto found = depth_pictures.find(address);
+    if (found == depth_pictures.end()) return;
+    DepthPicture &picture = found->second;
+    if (picture.holder == target.address ||
+        (target.depth_address == address && target.depth_version == picture.version))
+        return;
+    // Another row length puts the same addresses at other pixels.
+    if (picture.stride != stride) return;
+    // The target's own newest picture of another depth buffer would be lost.
+    if (target.depth_address != 0u && target.depth_address != address) {
+        const auto mine = depth_pictures.find(target.depth_address);
+        if (mine != depth_pictures.end() && mine->second.holder == target.address) return;
+    }
+    const auto holder = targets.find(picture.holder);
+    if (holder == targets.end() || !holder->second.initialized) return;
+    end_pass();
+    initialize_layouts(command_buffer, target);
+    transition(command_buffer, holder->second.depth, VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL,
+               VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, depth_aspect());
+    transition(command_buffer, target.depth, VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL,
+               VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, depth_aspect());
+    // Only the depth: the stencil belongs to the colour buffer's alpha.
+    VkImageCopy region{};
+    region.srcSubresource = {VK_IMAGE_ASPECT_DEPTH_BIT, 0u, 0u, 1u};
+    region.dstSubresource = region.srcSubresource;
+    region.extent = {target_extent.width, target_extent.height, 1u};
+    vkCmdCopyImage(command_buffer, holder->second.depth, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, target.depth,
+                   VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1u, &region);
+    transition(command_buffer, target.depth, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+               VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL, depth_aspect());
+    transition(command_buffer, holder->second.depth, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+               VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL, depth_aspect());
+    perf::count_target_copy();
+    picture.copied = true;
+    target.depth_address = address;
+    target.depth_version = picture.version;
+    static const bool trace = portablekit::env("TRACE_FB_TEXTURES") != nullptr;
+    if (trace)
+        std::cout << "[fbtex] frame " << frames << " depth 0x" << std::hex << address << " copied from target 0x"
+                  << picture.holder << " to 0x" << target.address << std::dec << "\n";
+}
