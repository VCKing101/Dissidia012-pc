         enum class StencilSync : std::uint8_t { Same, StencilNewer, AlphaNewer };
         StencilSync stencil_sync{StencilSync::AlphaNewer};
+        // The guest depth buffer, and which picture of it, the depth image
+        // holds (DepthPicture); 0: none in particular.
+        std::uint32_t depth_address{};
+        std::uint64_t depth_version{};
     };
     std::map<std::uint32_t, Target> targets;
+    // Depth buffers by guest address. Each target has its own depth image,
+    // but the GE tests against the depth buffer the draw names, which
+    // several colour buffers may share: a game draws its scene into one
+    // buffer and its shadow volumes into another, testing against the
+    // scene's depth. Each picture of a depth buffer is numbered, and a draw
+    // that uses a depth buffer whose newest picture another target holds
+    // copies it into its own depth image first. <prefix>_NO_SHARED_DEPTH
+    // keeps each target's depth to itself, as before.
+    struct DepthPicture {
+        std::uint32_t holder{};    // the target whose depth image has it
+        std::uint64_t version{};
+        std::uint32_t stride{};    // the depth buffer's row length
+        bool copied{};             // another target took a copy of it
+    };
+    std::map<std::uint32_t, DepthPicture> depth_pictures;
+    std::uint64_t depth_versions{};
+    bool shared_depth{};
+    // Brings `target`'s depth image up to date with the depth buffer at
+    // `address`, ending the pass in progress if it copies.
+    void share_depth(Target &target, std::uint32_t address, std::uint32_t stride);
     // Write-back of the displayed framebuffer to guest VRAM (write_back_frame):
     // present() scales the target to 480x272 and copies it into a mapped
     // buffer; begin_frame(), after the frame fence, takes the pixels; the next
@@ -2526,6 +2550,13 @@ bool VulkanRenderer::initialize(const RendererConfig &config, std::string &error
     attachments[1] = attachments[0];
     impl.choose_depth_format();
     attachments[1].format = impl.depth_format;
+    if (portablekit::env("NO_SHARED_DEPTH") == nullptr) {
+        VkFormatProperties properties{};
+        vkGetPhysicalDeviceFormatProperties(impl.physical_device, impl.depth_format, &properties);
+        constexpr VkFormatFeatureFlags kCopy = VK_FORMAT_FEATURE_TRANSFER_SRC_BIT | VK_FORMAT_FEATURE_TRANSFER_DST_BIT;
+        impl.shared_depth = (properties.optimalTilingFeatures & kCopy) == kCopy;
+        if (!impl.shared_depth) std::cout << "[render] depth images cannot be copied; depth buffers are not shared\n";
+    }
     // The stencil is the guest's alpha bits: kept from pass to pass, like the
     // colour, whichever way the depth is loaded.
     if (impl.stencil) {
@@ -3970,8 +4001,9 @@ bool VulkanRenderer::Impl::create_target(Target &target, std::string &error) {
