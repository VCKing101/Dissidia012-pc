-// interval. <prefix>_TRACE_CHEATS=1: each pass's cheats, with what they did.
+// interval. <prefix>_TRACE_CHEATS=1: each pass's cheats, with what they did. <prefix>_CHEATS_ONLINE=1: cheats
+// run during ad hoc play too.
 
 #include "psprecomp/elf32.hpp"
 #include "psprecomp/runtime.hpp"
@@ -57,6 +60,15 @@ struct Overview {
 };
 
 [[nodiscard]] Overview overview();
+// True while the game has ad hoc play running (adhoc_networking_on(): from
