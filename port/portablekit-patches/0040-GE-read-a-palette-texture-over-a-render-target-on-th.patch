+// The texture's palette from guest memory as a 512x1 texture, decoded once
+// per distinct palette and kept while it is drawn with. `hash` receives what
+// tells palettes apart.
+VkDescriptorSet VulkanRenderer::Impl::palette_descriptor(const GuestMemory &memory, const TextureState &texture,
+                                                         std::uint64_t &hash) {
+    std::array<std::uint32_t, kPaletteEntries> entries{};
+    decode_palette(memory, texture, kPaletteEntries, entries.data());
+    hash = 0xCBF29CE484222325ull;
+    for (const std::uint32_t entry : entries) hash = (hash ^ entry) * 0x100000001B3ull;
+    for (Palette &palette : palettes) {
+        if (palette.hash == hash) {
+            palette.used_frame = frames;
+            return palette.texture.descriptor;
+        }
+    }
+    if (palettes.size() >= kMaxPalettes) {
+        // The palette drawn with longest ago goes, once no frame in flight
+        // or recorded for drawing again can name it.
+        auto oldest = palettes.end();
+        for (auto it = palettes.begin(); it != palettes.end(); ++it)
+            if (it->used_frame + 3u <= frames && (oldest == palettes.end() || it->used_frame < oldest->used_frame))
+                oldest = it;
+        if (oldest == palettes.end()) return VK_NULL_HANDLE;
+        slots[slot].retired_textures.push_back(oldest->texture);
+        palettes.erase(oldest);
+    }
+    Palette added;
+    added.texture = create_texture_image(kPaletteEntries, 1u);
+    if (added.texture.descriptor == VK_NULL_HANDLE) {
+        destroy_texture(added.texture);
+        return VK_NULL_HANDLE;
+    }
+    upload_texture(added.texture.image, kPaletteEntries, 1u, entries.data());
+    added.hash = hash;
+    added.used_frame = frames;
+    palettes.push_back(added);
+    return palettes.back().texture.descriptor;
+}
