diff --git a/host/gpu/shaders/fb_clut.frag b/host/gpu/shaders/fb_clut.frag
new file mode 100644
index 0000000..1f0b3d8
--- /dev/null
+++ b/host/gpu/shaders/fb_clut.frag
@@ -0,0 +1,83 @@
+#version 450
+
+// A render target read as a palette texture (CLUT4/8/16/32 over rendered
+// pixels): each pixel of the target's copy, at the internal scale, is turned
+// back into the guest pixel the GE would hold in VRAM (5650, 5551, 4444 or
+// 8888), the texel's index is taken from its bits, shifted, masked and
+// offset as the CLUT format command says, and looked up in the palette. The
+// result is an ordinary RGBA8 picture of the texture at the internal scale,
+// which the draw then samples as it samples any render target.
+//
+// The output image is the target's size times the texels per pixel across:
+// output pixel x is texel coordinate (x + 0.5) / scale.x, in the target's
+// pixel (x / texels per pixel). One draw: the triangle of level.vert.
+
+layout(set = 0, binding = 0) uniform sampler2D source;   // the target's copy
+// The palette: 512 decoded entries in a row (mode 0), or the copy of the
+// render target that holds the CLUT (mode 1).
+layout(set = 1, binding = 0) uniform sampler2D palette;
+
+layout(push_constant) uniform Params {
+    ivec4 view;     // x: bits per texel (4, 8, 16, 32), y: the target's pixel format, z: texels per pixel, w: palette mode
+    ivec4 clut;     // x: index shift, y: index mask, z: start (already times 16), w: the CLUT's entry format
+    vec4 scale;     // x, y: image pixels per guest pixel
+    ivec4 clut_at;  // mode 1: the first entry's guest pixel x, y, the holding target's row length and pixel format
+} p;
+
+layout(location = 0) out vec4 color;
+
+// The guest pixel a rendered colour stands for. The renderer keeps 8 bits a
+// channel in every target; the GE stores the top bits of each, as the
+// write-back to guest memory does.
+uint pack_pixel(vec4 value, int format) {
+    uvec4 c = uvec4(clamp(value, 0.0, 1.0) * 255.0 + 0.5);
+    if (format == 0) return (c.r >> 3) | ((c.g >> 2) << 5) | ((c.b >> 3) << 11);
+    if (format == 1) return (c.r >> 3) | ((c.g >> 3) << 5) | ((c.b >> 3) << 10) | ((c.a >> 7) << 15);
+    if (format == 2) return (c.r >> 4) | ((c.g >> 4) << 4) | ((c.b >> 4) << 8) | ((c.a >> 4) << 12);
+    return c.r | (c.g << 8) | (c.b << 16) | (c.a << 24);
+}
+
+// A palette entry in its format, as a colour.
+vec4 unpack_entry(uint value, int format) {
+    if (format == 0)
+        return vec4(float(value & 31u) / 31.0, float((value >> 5) & 63u) / 63.0, float((value >> 11) & 31u) / 31.0, 1.0);
+    if (format == 1)
+        return vec4(float(value & 31u) / 31.0, float((value >> 5) & 31u) / 31.0, float((value >> 10) & 31u) / 31.0,
+                    float((value >> 15) & 1u));
+    if (format == 2)
+        return vec4(float(value & 15u), float((value >> 4) & 15u), float((value >> 8) & 15u),
+                    float((value >> 12) & 15u)) / 15.0;
+    return vec4(float(value & 255u), float((value >> 8) & 255u), float((value >> 16) & 255u),
+                float(value >> 24)) / 255.0;
+}
+
+void main() {
+    ivec2 at = ivec2(gl_FragCoord.xy);
+    int per_pixel = max(p.view.z, 1);
+    ivec2 limit = textureSize(source, 0) - 1;
+    ivec2 from = min(ivec2(at.x / per_pixel, at.y), limit);
+    uint word = pack_pixel(texelFetch(source, from, 0), p.view.y);
+
+    // Which of the pixel's texels this is: texels run from the low bits up.
+    int bits = p.view.x;
+    uint index = word;
+    if (bits < 32) {
+        int texel = int(floor((float(at.x) + 0.5) / p.scale.x));
+        int part = texel % per_pixel;
+        index = (word >> uint(part * bits)) & ((1u << uint(bits)) - 1u);
+    }
+    uint entry = (((index >> uint(p.clut.x)) & uint(p.clut.y)) | uint(p.clut.z)) & 511u;
+
+    if (p.view.w == 0) {
+        color = texelFetch(palette, ivec2(int(entry), 0), 0);
+        return;
+    }
+    // The CLUT lies in a render target: entry n is the guest pixel n after
+    // the first, read from the middle of that pixel at the internal scale.
+    int stride = max(p.clut_at.z, 1);
+    int linear = p.clut_at.y * stride + p.clut_at.x + int(entry);
+    vec2 guest = vec2(float(linear % stride), float(linear / stride)) + 0.5;
+    ivec2 holder_limit = textureSize(palette, 0) - 1;
+    ivec2 held = min(ivec2(guest * p.scale.xy), holder_limit);
+    color = unpack_entry(pack_pixel(texelFetch(palette, held, 0), p.clut_at.w), p.clut.w);
+}
diff --git a/host/gpu/texture_decode.cpp b/host/gpu/texture_decode.cpp
index 10b3ec6..6ad2486 100644
--- a/host/gpu/texture_decode.cpp
+++ b/host/gpu/texture_decode.cpp
@@ -545,4 +545,22 @@ std::uint64_t texture_key(const GuestMemory &memory, const TextureState &texture
     return key;
 }
 
+void decode_palette(const GuestMemory &memory, const TextureState &texture, std::uint32_t entries,
+                    std::uint32_t *out) {
+    const std::uint32_t size = texture.clut_format == 3u ? 4u : 2u;
+    for (std::uint32_t entry = 0; entry < entries; ++entry) {
+        const std::uint32_t address = texture.clut_address + entry * size;
+        if (!memory.contains(address, size)) {
+            out[entry] = 0u;
+            continue;
+        }
+        switch (texture.clut_format) {
+        case 0u: out[entry] = expand_5650(memory.load16(address)); break;
+        case 1u: out[entry] = expand_5551(memory.load16(address)); break;
+        case 2u: out[entry] = expand_4444(memory.load16(address)); break;
+        default: out[entry] = memory.load32(address); break;
+        }
+    }
+}
+
 } // namespace portablekit::gpu
