+void VulkanRenderer::Impl::destroy_palette_view(PaletteView &view) {
+    if (view.descriptor != VK_NULL_HANDLE) vkFreeDescriptorSets(device, descriptor_pool, 1u, &view.descriptor);
+    if (view.framebuffer != VK_NULL_HANDLE) vkDestroyFramebuffer(device, view.framebuffer, nullptr);
+    if (view.view != VK_NULL_HANDLE) vkDestroyImageView(device, view.view, nullptr);
+    if (view.image != VK_NULL_HANDLE) vkDestroyImage(device, view.image, nullptr);
+    if (view.memory != VK_NULL_HANDLE) vkFreeMemory(device, view.memory, nullptr);
+    view = PaletteView{};
+}
+
+// With the device idle: on a change of the internal resolution, and at exit.
+void VulkanRenderer::Impl::destroy_palette_views() {
+    for (PaletteView &view : palette_views) destroy_palette_view(view);
+    palette_views.clear();
+}
+
+void VulkanRenderer::Impl::destroy_palette_pipeline() {
+    destroy_palette_views();
+    for (Palette &palette : palettes) destroy_texture(palette.texture);
+    palettes.clear();
+    if (palette_pipeline != VK_NULL_HANDLE) vkDestroyPipeline(device, palette_pipeline, nullptr);
+    if (palette_layout != VK_NULL_HANDLE) vkDestroyPipelineLayout(device, palette_layout, nullptr);
+    if (palette_vertex != VK_NULL_HANDLE) vkDestroyShaderModule(device, palette_vertex, nullptr);
+    if (palette_fragment != VK_NULL_HANDLE) vkDestroyShaderModule(device, palette_fragment, nullptr);
+    if (palette_render_pass != VK_NULL_HANDLE) vkDestroyRenderPass(device, palette_render_pass, nullptr);
+    palette_pipeline = VK_NULL_HANDLE;
+    palette_layout = VK_NULL_HANDLE;
+    palette_vertex = VK_NULL_HANDLE;
+    palette_fragment = VK_NULL_HANDLE;
+    palette_render_pass = VK_NULL_HANDLE;
+}
