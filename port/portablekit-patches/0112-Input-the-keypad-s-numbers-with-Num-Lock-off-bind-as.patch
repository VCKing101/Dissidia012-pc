+bool key_held(const Bindings &bindings, int position, bool num_lock, const std::function<bool(int)> &down) {
+    const int number = keypad_number_of(position);
+    if (number < 0) return down(position);
+    // Both of a keypad key's bindings are its number's position, where SDL
+    // reports it whatever Num Lock says.
+    if (!down(number)) return false;
+    const int off = num_lock_off_position(number);
+    const auto bound = [&](int at) {
+        for (const Slots &slots : bindings)
+            for (const Binding binding : slots)
+                if (binding == key(static_cast<std::uint16_t>(at))) return true;
+        return false;
+    };
+    const bool number_bound = bound(number), off_bound = bound(off);
+    if (number_bound && off_bound) return position == (num_lock ? number : off);
+    return position == number ? !off_bound : !number_bound;
+}
