+// The keypad's numbers with Num Lock on and off: one key, two controls.
+void test_num_lock() {
+    const Binding up = from_name("Keypad Up"), clear = from_name("Keypad Clear");
+    check(name(key(96)) == "Keypad 8" && name(up) == "Keypad Up" && up == key(508) && name(clear) == "Keypad Clear" &&
+              from_name("keypad pageup") == key(509) && name(key(511)) == "Keypad Delete",
+          "the Num Lock off keys have names of their own");
+    check(typed_position(96, true) == 96 && typed_position(96, false) == 508 && typed_position(99, false) == 511 &&
+              typed_position(89, false) == 501 && typed_position(26, false) == 26 && typed_position(82, false) == 82,
+          "with Num Lock off, only the keypad's numbers are typed as their second keys");
+    check(keypad_number_of(508) == 96 && keypad_number_of(96) == 96 && keypad_number_of(82) == -1 &&
+              keypad_number_of(500) == -1 && keypad_number_of(88) == -1,
+          "both keys are one keypad key");
+
+    const auto read_keys = [](const Bindings &b, std::set<int> keys, bool num_lock) {
+        const auto down = [&](int position) { return keys.count(position) != 0; };
+        return read(b, [&](Binding x) {
+            const int position = key_position(x);
+            return position >= 0 && key_held(b, position, num_lock, down);
+        });
+    };
+    // 8 4 5 6 to move with Num Lock on, and the D-pad (a battle's camera) with it off.
+    Bindings b = default_bindings();
+    b[static_cast<std::size_t>(Action::StickUp)] = {from_name("Keypad 8"), kNone};
+    b[static_cast<std::size_t>(Action::StickDown)] = {from_name("Keypad 5"), kNone};
+    b[static_cast<std::size_t>(Action::Up)] = {from_name("Up"), up};
+    b[static_cast<std::size_t>(Action::Down)] = {from_name("Down"), clear};
+    PadInput pad = read_keys(b, {96}, true);
+    check(pad.stick_y == -127 && pad.buttons == 0u, "Num Lock on: Keypad 8 moves");
+    pad = read_keys(b, {96}, false);
+    check(pad.stick_y == 0 && pad.buttons == 0x0010u, "Num Lock off: the same key presses the D-pad's up");
+    pad = read_keys(b, {93}, false);
+    check(pad.stick_y == 0 && pad.buttons == 0x0040u, "and Keypad 5 its down, as Keypad Clear");
+    pad = read_keys(b, {82}, true);
+    check(pad.buttons == 0x0010u && pad.stick_y == 0, "the arrow key is its own key either way");
+
+    // Bound one way, a keypad key plays the same with Num Lock on or off.
+    b = default_bindings();
+    b[static_cast<std::size_t>(Action::StickUp)] = {from_name("Keypad 8"), kNone};
+    check(read_keys(b, {96}, false).stick_y == -127 && read_keys(b, {96}, true).stick_y == -127,
+          "a keypad bound before Num Lock counted still moves with it off");
+    b[static_cast<std::size_t>(Action::StickUp)] = {up, kNone};
+    check(read_keys(b, {96}, true).stick_y == -127 && read_keys(b, {96}, false).stick_y == -127,
+          "a key bound with Num Lock off still moves with it on");
+    check(read_keys(b, {508}, false).stick_y == 0, "only the keypad key presses its Num Lock off binding");
+
+    // The menu binds a key typed with Num Lock off apart from the number.
+    b = default_bindings();
+    assign(b, Action::StickUp, key(static_cast<std::uint16_t>(typed_position(96, true))));
+    assign(b, Action::Up, key(static_cast<std::uint16_t>(typed_position(96, false))));
+    check(slots_of(b, Action::StickUp)[0] == from_name("W") && slots_of(b, Action::StickUp)[1] == key(96) &&
+              slots_of(b, Action::Up)[0] == from_name("Up") && slots_of(b, Action::Up)[1] == up,
+          "binding the key again with Num Lock off leaves its number bound");
+    Slots slots{};
+    check(parse("Up / Keypad Up", slots) && slots[1] == up && format(slots) == "Up / Keypad Up",
+          "they round-trip through settings.ini");
+}
