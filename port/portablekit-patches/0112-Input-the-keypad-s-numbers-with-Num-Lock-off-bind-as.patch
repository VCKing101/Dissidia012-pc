diff --git a/host/input/bindings.hpp b/host/input/bindings.hpp
index ff90ac9..7a745b3 100644
--- a/host/input/bindings.hpp
+++ b/host/input/bindings.hpp
@@ -88,6 +88,35 @@ inline constexpr std::uint16_t kKeyPositions = 512u;
 [[nodiscard]] constexpr int key_position(Binding binding) {
     return binding != kNone && binding < kKeyPositions ? binding : -1;
 }
+
+// The keypad's number keys with Num Lock off, as printed under the numbers:
+// Keypad End (1), Down (2), PageDown (3), Left (4), Clear (5), Right (6),
+// Home (7), Up (8), PageUp (9), Insert (0) and Delete (Period). Positions SDL
+// leaves unused (past its dynamic keys, below SDL_SCANCODE_COUNT), so they
+// bind apart from the numbers and one key can press two controls, one with
+// Num Lock on and one with it off.
+inline constexpr std::uint16_t kKeypadFirst = 89u;  // Keypad 1 (SDL_SCANCODE_KP_1)
+inline constexpr std::uint16_t kKeypadLast = 99u;   // Keypad Period
+inline constexpr std::uint16_t kNumLockOffFirst = 501u;
+inline constexpr std::uint16_t kNumLockOffLast = kNumLockOffFirst + (kKeypadLast - kKeypadFirst);
+static_assert(kNumLockOffLast < kKeyPositions);
+// A keypad number key's position with Num Lock off; any other position as it is.
+[[nodiscard]] constexpr int num_lock_off_position(int position) {
+    return position >= kKeypadFirst && position <= kKeypadLast ? position - kKeypadFirst + kNumLockOffFirst
+                                                               : position;
+}
+// The keypad number key a position is, either way (Keypad 8 for Keypad Up
+// and for Keypad 8), or -1 for any other key.
+[[nodiscard]] constexpr int keypad_number_of(int position) {
+    if (position >= kKeypadFirst && position <= kKeypadLast) return position;
+    if (position >= kNumLockOffFirst && position <= kNumLockOffLast) return position - kNumLockOffFirst + kKeypadFirst;
+    return -1;
+}
+// The key a press at `position` is bound as: with Num Lock off, a keypad
+// number key's Num Lock off position.
+[[nodiscard]] constexpr int typed_position(int position, bool num_lock) {
+    return num_lock ? position : num_lock_off_position(position);
+}
 // The mouse button, 1-5, or 0 for a key, the wheel or none.
 [[nodiscard]] constexpr int mouse_button_of(Binding binding) {
     return binding > kMouse && binding <= kMouse + 5u ? binding - kMouse : 0;
@@ -160,6 +189,16 @@ struct PadInput {
 };
 [[nodiscard]] PadInput read(const Bindings &bindings, const std::function<bool(Binding)> &held);
 
+// Whether the key bound at `position` is held, given which keys are down by
+// the positions SDL reports (`down`) and Num Lock. Any key but the keypad's
+// numbers is held while it is down. A keypad number key bound both ways
+// presses its number's binding with Num Lock on and its Num Lock off
+// binding with it off; bound only one way, it presses that binding either
+// way, so a keypad bound before Num Lock counted, or with Num Lock off, plays
+// as it did.
+[[nodiscard]] bool key_held(const Bindings &bindings, int position, bool num_lock,
+                            const std::function<bool(int)> &down);
