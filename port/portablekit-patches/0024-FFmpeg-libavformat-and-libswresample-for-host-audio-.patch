-# FFmpeg 7.1.5 (libavcodec 61, libavutil 59), the release the Linux packages use.
+# FFmpeg 7.1.5 (libavcodec 61, libavutil 59, libavformat 61, libswresample 5),
+# the release the Linux packages use.
 set(PORTABLEKIT_FFMPEG_VERSION 7.1.5)
 set(PORTABLEKIT_FFMPEG_URL "https://ffmpeg.org/releases/ffmpeg-${PORTABLEKIT_FFMPEG_VERSION}.tar.xz")
 set(PORTABLEKIT_FFMPEG_SHA256 de668509caf9e35e3cd162473441fdb29538c6d96ed080292b3cf9e6fc5d558f)
-set(PORTABLEKIT_FFMPEG_SOVERSIONS avcodec 61 avutil 59)
+set(PORTABLEKIT_FFMPEG_SOVERSIONS avcodec 61 avutil 59 avformat 61 swresample 5)
 
-# Only what the game needs: the ATRAC3, ATRAC3plus and H.264 decoders. The host
-# splits the movie streams into access units and converts pixels itself, so no
-# demuxer, parser, scaler or resampler is built. No GPL or non-free parts: the
-# result is LGPL-2.1-or-later, which the build checks.
+# Only what is needed: the ATRAC3, ATRAC3plus and H.264 decoders for the game,
+# whose movie streams the host splits into access units and whose pixels it
+# converts itself; and for host audio files the WAV, MP3, Ogg and FLAC
+# demuxers, their parsers, the MP3, Vorbis, Opus, FLAC and PCM decoders and the
+# resampler. Host files are read through the host's own I/O, so no protocol is
+# built. No scaler, filter, device or network code. No GPL or non-free parts:
+# the result is LGPL-2.1-or-later, which the build checks.
 set(PORTABLEKIT_FFMPEG_CONFIGURE_FLAGS
     --enable-shared
     --disable-static
     --disable-programs
     --disable-doc
     --disable-avdevice
-    --disable-avformat
     --disable-avfilter
     --disable-swscale
-    --disable-swresample
     --disable-network
     --disable-autodetect
     --disable-everything
-    --enable-decoder=atrac3,atrac3p,h264
+    --enable-decoder=atrac3,atrac3p,h264,mp3float,vorbis,opus,flac,pcm_s16le,pcm_s24le,pcm_s32le,pcm_f32le,pcm_u8
+    --enable-demuxer=wav,mp3,ogg,flac
+    --enable-parser=mpegaudio,vorbis,opus,flac
     --disable-x86asm
     --disable-debug)
 
@@ -47,7 +56,7 @@ set(PORTABLEKIT_FFMPEG_CONFIGURE_FLAGS
