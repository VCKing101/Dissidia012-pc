+// A host file read through FFmpeg with the host's own I/O, so paths are the
+// host's (wide on Windows) and no FFmpeg protocol is needed.
+class InputFile {
+public:
+    ~InputFile() { close(); }
+
+    bool open(const std::filesystem::path &path, std::string &error) {
+#if defined(_WIN32)
+        file_ = _wfopen(path.c_str(), L"rb");
+#else
+        file_ = std::fopen(path.c_str(), "rb");
+#endif
+        if (file_ == nullptr) {
+            error = "cannot open the file";
+            return false;
+        }
+        std::error_code ec;
+        size_ = static_cast<std::int64_t>(std::filesystem::file_size(path, ec));
+        constexpr int kBufferSize = 64 * 1024;
+        auto *buffer = static_cast<unsigned char *>(av_malloc(kBufferSize));
+        io_ = buffer != nullptr ? avio_alloc_context(buffer, kBufferSize, 0, this, &read, nullptr, &seek) : nullptr;
+        if (io_ == nullptr) {
+            av_free(buffer);
+            error = "out of memory";
+            return false;
+        }
+        format_ = avformat_alloc_context();
+        if (format_ == nullptr) {
+            error = "out of memory";
+            return false;
+        }
+        format_->pb = io_;
+        format_->flags |= AVFMT_FLAG_CUSTOM_IO;
+        // The name only helps FFmpeg guess the container from the extension.
+        const std::string name = install::path_to_utf8(path.filename());
+        if (const int result = avformat_open_input(&format_, name.c_str(), nullptr, nullptr); result < 0) {
+            error = "not a file FFmpeg can read (" + av_error(result) + ")";
+            return false;
+        }
+        if (const int result = avformat_find_stream_info(format_, nullptr); result < 0) {
+            error = "cannot read the streams (" + av_error(result) + ")";
+            return false;
+        }
+        const AVCodec *codec = nullptr;
+        stream_ = av_find_best_stream(format_, AVMEDIA_TYPE_AUDIO, -1, -1, &codec, 0);
+        if (stream_ < 0 || codec == nullptr) {
+            error = stream_ == AVERROR_DECODER_NOT_FOUND ? "no decoder for its audio in this build" : "no audio stream";
+            return false;
+        }
+        decoder_ = avcodec_alloc_context3(codec);
+        if (decoder_ == nullptr ||
+            avcodec_parameters_to_context(decoder_, format_->streams[stream_]->codecpar) < 0) {
+            error = "cannot set up the decoder";
+            return false;
+        }
+        // So the decoder can account for the samples it drops (encoder delay
+        // and padding) in the packets' times.
+        decoder_->pkt_timebase = format_->streams[stream_]->time_base;
+        if (const int result = avcodec_open2(decoder_, codec, nullptr); result < 0) {
+            error = "the decoder refused the stream (" + av_error(result) + ")";
+            return false;
+        }
+        return true;
+    }
+
+    void close() {
+        avcodec_free_context(&decoder_);
+        if (format_ != nullptr) avformat_close_input(&format_);
+        if (io_ != nullptr) {
+            av_freep(&io_->buffer);
+            avio_context_free(&io_);
+        }
+        if (file_ != nullptr) {
+            std::fclose(file_);
+            file_ = nullptr;
+        }
+    }
+
+    [[nodiscard]] AVFormatContext *format() const noexcept { return format_; }
+    [[nodiscard]] AVCodecContext *decoder() const noexcept { return decoder_; }
+    [[nodiscard]] int stream() const noexcept { return stream_; }
+
+    // An integer tag of the file or of its audio stream (LOOPSTART and so on).
+    [[nodiscard]] std::optional<std::int64_t> integer_tag(const char *key) const {
+        for (const AVDictionary *dictionary : {format_->metadata, format_->streams[stream_]->metadata}) {
+            const AVDictionaryEntry *entry = av_dict_get(dictionary, key, nullptr, 0);
+            if (entry == nullptr || entry->value == nullptr) continue;
+            char *end = nullptr;
+            const long long value = std::strtoll(entry->value, &end, 10);
+            if (end != entry->value && value >= 0) return value;
+        }
+        return std::nullopt;
+    }
+
+private:
+    static int read(void *opaque, std::uint8_t *buffer, int size) {
+        auto *self = static_cast<InputFile *>(opaque);
+        const std::size_t count = std::fread(buffer, 1u, static_cast<std::size_t>(size), self->file_);
+        return count == 0u ? AVERROR_EOF : static_cast<int>(count);
+    }
+    static std::int64_t seek(void *opaque, std::int64_t offset, int whence) {
+        auto *self = static_cast<InputFile *>(opaque);
+        if ((whence & AVSEEK_SIZE) != 0) return self->size_;
+        whence &= ~AVSEEK_FORCE;
+#if defined(_WIN32)
+        if (_fseeki64(self->file_, offset, whence) != 0) return -1;
+        return _ftelli64(self->file_);
+#else
+        if (fseeko(self->file_, static_cast<off_t>(offset), whence) != 0) return -1;
+        return static_cast<std::int64_t>(ftello(self->file_));
+#endif
+    }
+
+    std::FILE *file_{};
+    std::int64_t size_{-1};
+    AVIOContext *io_{};
+    AVFormatContext *format_{};
+    AVCodecContext *decoder_{};
+    int stream_{-1};
+};
+
+std::shared_ptr<HostPcm> decode(const HostTrack &track) {
+    const auto started = std::chrono::steady_clock::now();
+    InputFile input;
+    std::string error;
+    if (!input.open(track.file, error)) return silence(error);
+    AVCodecContext *decoder = input.decoder();
+
+    AVChannelLayout out_layout{};
+    av_channel_layout_default(&out_layout, 2);
+    AVChannelLayout in_layout{};
+    if (decoder->ch_layout.order == AV_CHANNEL_ORDER_UNSPEC || av_channel_layout_check(&decoder->ch_layout) == 0)
+        av_channel_layout_default(&in_layout, std::max(decoder->ch_layout.nb_channels, 1));
+    else
+        av_channel_layout_copy(&in_layout, &decoder->ch_layout);
+    SwrContext *resampler = nullptr;
+    int result = swr_alloc_set_opts2(&resampler, &out_layout, AV_SAMPLE_FMT_S16, static_cast<int>(kHostAudioRate),
+                                     &in_layout, decoder->sample_fmt, decoder->sample_rate, 0, nullptr);
+    if (result >= 0) result = swr_init(resampler);
+    const unsigned source_channels = static_cast<unsigned>(in_layout.nb_channels);
+    av_channel_layout_uninit(&in_layout);
+    av_channel_layout_uninit(&out_layout);
+    if (result < 0) {
+        swr_free(&resampler);
+        return silence("cannot resample it (" + av_error(result) + ")");
+    }
+
+    auto pcm = std::make_shared<HostPcm>();
+    pcm->source_rate = static_cast<std::uint32_t>(decoder->sample_rate);
+    pcm->source_channels = source_channels;
+    pcm->codec = decoder->codec != nullptr && decoder->codec->name != nullptr ? decoder->codec->name : "?";
+    if (input.format()->duration > 0)
+        pcm->samples.reserve(static_cast<std::size_t>(
+            std::min<std::int64_t>(input.format()->duration / 1000 * kHostAudioRate / 1000 + kHostAudioRate, kMaxFrames) *
+            2));
+
+    bool too_long = false;
+    std::vector<std::int16_t> chunk;
+    const auto convert = [&](const AVFrame *frame) {
+        const int in_count = frame != nullptr ? frame->nb_samples : 0;
+        const int out_count = swr_get_out_samples(resampler, in_count);
+        if (out_count <= 0) return;
+        chunk.resize(static_cast<std::size_t>(out_count) * 2u);
+        auto *out = reinterpret_cast<std::uint8_t *>(chunk.data());
+        const int made = swr_convert(resampler, &out, out_count,
+                                     frame != nullptr ? reinterpret_cast<const std::uint8_t *const *>(frame->extended_data)
+                                                      : nullptr,
+                                     in_count);
+        if (made <= 0) return;
+        if (pcm->frames() + static_cast<std::uint32_t>(made) > kMaxFrames) {
+            too_long = true;
+            return;
+        }
+        pcm->samples.insert(pcm->samples.end(), chunk.begin(), chunk.begin() + static_cast<std::ptrdiff_t>(made) * 2);
+    };
+
+    AVPacket *packet = av_packet_alloc();
+    AVFrame *frame = av_frame_alloc();
+    const auto receive = [&]() {
+        while (!too_long && avcodec_receive_frame(decoder, frame) == 0) {
+            convert(frame);
+            av_frame_unref(frame);
+        }
+    };
+    while (!too_long && av_read_frame(input.format(), packet) >= 0) {
+        if (packet->stream_index == input.stream() && avcodec_send_packet(decoder, packet) >= 0) receive();
+        av_packet_unref(packet);
+    }
+    if (!too_long) {
+        avcodec_send_packet(decoder, nullptr);
+        receive();
+        convert(nullptr);  // what the resampler still holds
+    }
+    av_frame_free(&frame);
+    av_packet_free(&packet);
+    swr_free(&resampler);
+
+    if (too_long) return silence("longer than 30 minutes");
+    if (pcm->frames() == 0u) return silence("no audio decoded");
+    pcm->samples.shrink_to_fit();
+
+    std::optional<std::int64_t> tag_end;
+    const std::optional<std::int64_t> tag_start = input.integer_tag("LOOPSTART");
+    if (const auto length = input.integer_tag("LOOPLENGTH"); tag_start && length && *length > 0)
+        tag_end = *tag_start + *length;
+    else if (const auto end = input.integer_tag("LOOPEND"); tag_start && end)
+        tag_end = *end;  // taken as the first sample after the loop
+    resolve_loop(*pcm, track, tag_start, tag_end);
+
+    const auto ms = std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() - started);
+    std::ostringstream line;
+    line << "[host-audio] decoded " << describe(track) << ": " << pcm->codec << ", " << pcm->source_rate << " Hz, "
+         << pcm->source_channels << " channel(s), " << pcm->frames() << " frames at 44100 Hz ("
+         << static_cast<double>(pcm->frames()) / kHostAudioRate << " s), ";
+    if (pcm->loop_start < 0) line << "no loop";
+    else line << "loop " << pcm->loop_start << ".." << pcm->loop_end;
+    line << ", in " << ms.count() << " ms";
+    std::cout << line.str() << std::endl;
+    return pcm;
+}
+
+bool can_decode() { return true; }
+
+bool probe(const std::filesystem::path &file, std::string &error) {
+    InputFile input;
+    return input.open(file, error);
+}
+
+#else // !PORTABLEKIT_HAS_HOST_AUDIO
+
+std::shared_ptr<HostPcm> decode(const HostTrack &) { return silence("this build cannot decode host audio files"); }
+bool can_decode() { return false; }
+bool probe(const std::filesystem::path &, std::string &error) {
+    error = "this build cannot decode host audio files (no libavformat)";
+    return false;
+}
+
+#endif
+
+struct Entry {
+    HostTrack track;
+    std::weak_ptr<const HostPcm> decoded;
+    std::shared_future<std::shared_ptr<const HostPcm>> pending;
+};
+
+struct Registry {
+    std::mutex lock;
+    std::map<std::uint32_t, Entry> tracks;
+    std::deque<std::shared_ptr<const HostPcm>> kept;
+};
+
+Registry &registry() {
+    static Registry instance;
+    return instance;
+}
+
+void keep(Registry &tracks, const std::shared_ptr<const HostPcm> &pcm) {
+    auto &kept = tracks.kept;
+    kept.erase(std::remove(kept.begin(), kept.end(), pcm), kept.end());
+    kept.push_front(pcm);
+    while (kept.size() > kKeptTracks) kept.pop_back();
+}
+
+std::shared_ptr<const HostPcm> decode_logged(const HostTrack &track) {
+    auto pcm = decode(track);
+    if (pcm->failed) std::cerr << "[host-audio] " << describe(track) << ": " << pcm->error << "\n";
+    return pcm;
+}
+
+// The decoded track, or the decode in flight for it, starting one with
+// `policy` if there is neither.
+std::shared_ptr<const HostPcm> obtain(std::uint32_t id, std::launch policy, bool wait) {
+    Registry &tracks = registry();
+    std::shared_future<std::shared_ptr<const HostPcm>> pending;
+    {
+        std::lock_guard<std::mutex> guard(tracks.lock);
+        const auto found = tracks.tracks.find(id);
+        if (found == tracks.tracks.end()) return nullptr;
+        Entry &entry = found->second;
+        if (auto decoded = entry.decoded.lock()) {
+            keep(tracks, decoded);
+            return decoded;
+        }
+        if (!entry.pending.valid()) entry.pending = std::async(policy, decode_logged, entry.track).share();
+        pending = entry.pending;
+    }
+    if (!wait) return nullptr;
+    std::shared_ptr<const HostPcm> decoded = pending.get();
+    std::lock_guard<std::mutex> guard(tracks.lock);
+    Entry &entry = tracks.tracks.at(id);
+    entry.decoded = decoded;
+    entry.pending = {};
+    keep(tracks, decoded);
+    return decoded;
+}
+
+void put_le16(std::vector<std::uint8_t> &out, std::uint32_t value) {
+    out.push_back(static_cast<std::uint8_t>(value));
+    out.push_back(static_cast<std::uint8_t>(value >> 8u));
+}
+void put_le32(std::vector<std::uint8_t> &out, std::uint32_t value) {
+    for (unsigned shift = 0; shift < 32u; shift += 8u) out.push_back(static_cast<std::uint8_t>(value >> shift));
+}
+void put_id(std::vector<std::uint8_t> &out, const char *id) { out.insert(out.end(), id, id + 4); }
+
+// The stand-in: a header, then frames of zero bytes.
+class VirtualAtracFile final : public hle_extension::FileFilter {
+public:
+    VirtualAtracFile(std::vector<std::uint8_t> header, std::uint64_t data_size)
+        : header_(std::move(header)), size_(header_.size() + data_size) {}
+    [[nodiscard]] std::uint64_t size() const override { return size_; }
+    std::size_t read(std::uint64_t offset, std::uint8_t *destination, std::size_t length) override {
+        if (offset >= size_) return 0u;
+        length = static_cast<std::size_t>(std::min<std::uint64_t>(length, size_ - offset));
+        std::size_t done = 0u;
+        if (offset < header_.size()) {
+            done = std::min<std::size_t>(length, header_.size() - static_cast<std::size_t>(offset));
+            std::memcpy(destination, header_.data() + offset, done);
+        }
+        std::memset(destination + done, 0, length - done);
+        return length;
+    }
+
+private:
+    std::vector<std::uint8_t> header_;
+    std::uint64_t size_;
+};
+
+} // namespace
+
+bool host_audio_available() {
+    static const bool available = can_decode() && portablekit::env("NO_HOST_AUDIO") == nullptr;
+    return available;
+}
+
+bool probe_host_audio(const std::filesystem::path &file, std::string &error) {
+    if (!host_audio_available()) {
+        error = can_decode() ? "host audio is turned off (" + portablekit::env_name("NO_HOST_AUDIO") + ")"
+                             : "this build cannot decode host audio files (no libavformat)";
+        return false;
+    }
+    return probe(file, error);
+}
+
+bool register_host_track(std::uint32_t id, HostTrack track) {
+    if (!host_audio_available()) return false;
+    Registry &tracks = registry();
+    std::lock_guard<std::mutex> guard(tracks.lock);
+    return tracks.tracks.emplace(id, Entry{std::move(track), {}, {}}).second;
+}
+
+bool host_track_registered(std::uint32_t id) {
+    Registry &tracks = registry();
+    std::lock_guard<std::mutex> guard(tracks.lock);
+    return tracks.tracks.contains(id);
+}
+
+std::shared_ptr<const HostPcm> host_track_pcm(std::uint32_t id) { return obtain(id, std::launch::deferred, true); }
+
+void prefetch_host_track(std::uint32_t id) { (void)obtain(id, std::launch::async, false); }
+
+std::shared_ptr<hle_extension::FileFilter> virtual_atrac_file(std::uint32_t id, std::uint32_t block_align) {
+    if (block_align < 8u || block_align > 0x2000u) {
+        std::cerr << "[host-audio] track " << id << ": frame size " << block_align << " is out of range\n";
+        return nullptr;
+    }
+    const auto pcm = host_track_pcm(id);
+    if (!pcm || pcm->failed) return nullptr;
+
+    // Enough frames for every sample whatever the decoder delay sceAtrac
+    // allows for (fact's sample count is what ends the track): two more than
+    // the samples need.
+    const std::uint32_t total = pcm->frames();
+    const std::uint32_t frames = (total + kFrameSamples - 1u) / kFrameSamples + 2u;
+    const std::uint64_t data_size = static_cast<std::uint64_t>(frames) * block_align;
+
+    std::vector<std::uint8_t> header;
+    put_id(header, "RIFF");
+    put_le32(header, 0u);  // patched below
+    put_id(header, "WAVE");
+    // WAVE_FORMAT_EXTENSIBLE with the ATRAC3plus sub-format, stereo, as the
+    // PSP's own ATRAC3plus files are; the codec bytes are left zero, since
+    // no ATRAC decoder ever sees this file.
+    put_id(header, "fmt ");
+    put_le32(header, 52u);
+    put_le16(header, 0xFFFEu);
+    put_le16(header, 2u);
+    put_le32(header, kHostAudioRate);
+    put_le32(header, static_cast<std::uint32_t>(static_cast<std::uint64_t>(block_align) * kHostAudioRate / kFrameSamples));
+    put_le16(header, block_align);
+    put_le16(header, 0u);
+    put_le16(header, 34u);
+    put_le16(header, kFrameSamples);
+    put_le32(header, 3u);  // front left and right
+    constexpr std::uint8_t kAtrac3PlusGuid[16] = {0xBF, 0xAA, 0x23, 0xE9, 0x58, 0xCB, 0x71, 0x44,
+                                                  0xA1, 0x19, 0xFF, 0xFA, 0x01, 0xE4, 0xCE, 0x62};
+    header.insert(header.end(), std::begin(kAtrac3PlusGuid), std::end(kAtrac3PlusGuid));
+    header.insert(header.end(), 12u, 0u);
+    put_id(header, "fact");
+    put_le32(header, 8u);
+    put_le32(header, total);
+    put_le32(header, 0u);  // no encoder delay
+    if (pcm->loop_start >= 0) {
+        put_id(header, "smpl");
+        put_le32(header, 60u);
+        for (int i = 0; i < 7; ++i) put_le32(header, 0u);  // manufacturer ... SMPTE offset
+        put_le32(header, 1u);                             // one loop
+        put_le32(header, 0u);                             // no sampler data
+        put_le32(header, 0u);                             // cue point id
+        put_le32(header, 0u);                             // forward
+        put_le32(header, static_cast<std::uint32_t>(pcm->loop_start));
+        put_le32(header, static_cast<std::uint32_t>(pcm->loop_end));
+        put_le32(header, 0u);  // fraction
+        put_le32(header, 0u);  // forever
+    }
+    put_id(header, "PKHA");
+    put_le32(header, 8u);
+    put_le32(header, kHostChunkVersion);
+    put_le32(header, id);
+    put_id(header, "data");
+    put_le32(header, static_cast<std::uint32_t>(data_size));
+    const std::uint64_t riff_size = header.size() - 8u + data_size;
+    for (unsigned i = 0; i < 4u; ++i) header[4u + i] = static_cast<std::uint8_t>(riff_size >> (8u * i));
+    return std::make_shared<VirtualAtracFile>(std::move(header), data_size);
+}
+
+} // namespace portablekit::audio
