+namespace portablekit::audio {
+namespace {
+
+// Longer than any game's music; a track this long would hold 300 MiB.
+constexpr std::uint32_t kMaxFrames = 30u * 60u * kHostAudioRate;
+// Decoded tracks kept after nothing plays them any more.
+constexpr std::size_t kKeptTracks = 3u;
+// Samples per ATRAC3plus frame, which the stand-in file is counted in.
+constexpr std::uint32_t kFrameSamples = 2048u;
+
+std::string describe(const HostTrack &track) {
+    return track.name.empty() ? install::path_to_utf8(track.file) : track.name;
+}
+
+std::shared_ptr<HostPcm> silence(std::string error) {
+    auto pcm = std::make_shared<HostPcm>();
+    pcm->samples.assign(static_cast<std::size_t>(kHostAudioRate) * 2u, 0);
+    pcm->loop_start = 0;
+    pcm->loop_end = static_cast<std::int32_t>(kHostAudioRate - 1u);
+    pcm->failed = true;
+    pcm->error = std::move(error);
+    return pcm;
+}
+
+std::int64_t to_frames(const HostLoopPoint &point, std::uint32_t source_rate) {
+    if (point.unit == HostLoopPoint::Unit::Microseconds)
+        return static_cast<std::int64_t>(std::llround(static_cast<double>(point.value) * kHostAudioRate / 1e6));
+    if (source_rate == 0u) return point.value;
+    return static_cast<std::int64_t>(
+        std::llround(static_cast<double>(point.value) * kHostAudioRate / static_cast<double>(source_rate)));
+}
+
+// Sets the loop from the track's settings, the file's tags (`tag_start`,
+// `tag_end` in source samples, end excluded) and its length.
+void resolve_loop(HostPcm &pcm, const HostTrack &track, std::optional<std::int64_t> tag_start,
+                  std::optional<std::int64_t> tag_end) {
+    const auto frames = static_cast<std::int64_t>(pcm.frames());
+    HostTrack::Loop mode = track.loop;
+    HostLoopPoint start = track.loop_start;
+    std::optional<HostLoopPoint> end = track.loop_end;
+    if (mode == HostTrack::Loop::Auto) {
+        if (tag_start) {
+            mode = HostTrack::Loop::Range;
+            start = {HostLoopPoint::Unit::Samples, *tag_start};
+            end.reset();
+            if (tag_end) end = HostLoopPoint{HostLoopPoint::Unit::Samples, *tag_end};
+        } else {
+            mode = HostTrack::Loop::Whole;
+        }
+    }
+    switch (mode) {
+    case HostTrack::Loop::None:
+        pcm.loop_start = pcm.loop_end = -1;
+        return;
+    case HostTrack::Loop::Range: {
+        const std::int64_t first = to_frames(start, pcm.source_rate);
+        const std::int64_t last = end ? to_frames(*end, pcm.source_rate) - 1 : frames - 1;
+        if (first >= 0 && first < last && last < frames) {
+            pcm.loop_start = static_cast<std::int32_t>(first);
+            pcm.loop_end = static_cast<std::int32_t>(last);
+            return;
+        }
+        std::cerr << "[host-audio] " << describe(track) << ": loop " << first << ".." << last
+                  << " (frames at 44100 Hz) is outside the track's " << frames << " frames; looping the whole track\n";
+        [[fallthrough]];
+    }
+    case HostTrack::Loop::Whole:
+    case HostTrack::Loop::Auto:
+        pcm.loop_start = 0;
+        pcm.loop_end = static_cast<std::int32_t>(frames - 1);
+        return;
+    }
+}
