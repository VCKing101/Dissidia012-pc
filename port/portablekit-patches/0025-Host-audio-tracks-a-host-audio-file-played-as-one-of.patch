+#pragma once
+
+// Host audio tracks: audio files of the host's own (MP3, Ogg Vorbis, Opus,
+// FLAC, WAV) that a port plays where a game plays one of its ATRAC tracks,
+// with no ATRAC encoding.
+//
+// A port registers a track under a 32-bit id of its choosing, then serves the
+// game a stand-in ATRAC3plus WAVE file for it (virtual_atrac_file), usually
+// through a file provider (hle_extension::add_file_provider) at a path the
+// game opens. The stand-in has the track's length and loop points in its
+// `fact` and `smpl` chunks, a private "PKHA" chunk naming the id, and frames
+// of silence. sceAtrac (hle/hle_atrac.cpp) recognises the chunk and takes each
+// frame from the decoded host file instead of the ATRAC decoder. Everything
+// else -- the game's buffer and its reads, sceAtracAddStreamData, loop counts,
+// reset positions -- runs as for one of the game's own tracks, because to the
+// game it is one.
+//
+// Files are decoded with FFmpeg (libavformat, libavcodec, libswresample) to
+// 44,100 Hz 16-bit stereo, what ATRAC decodes to, the first time a track is
+// needed, and kept in memory while it plays. Without libavformat in the build,
+// or with <prefix>_NO_HOST_AUDIO set, nothing is registered and no stand-in is
+// made, so the game plays its own tracks.
+
+#include <cstddef>
+#include <cstdint>
+#include <filesystem>
+#include <memory>
+#include <optional>
+#include <string>
+#include <vector>
+
+namespace portablekit::hle_extension {
+class FileFilter;
+}
+
+namespace portablekit::audio {
+
+inline constexpr std::uint32_t kHostAudioRate = 44'100u;
+
+// A loop point: a sample of the file at its own rate, or a time.
+struct HostLoopPoint {
+    enum class Unit { Samples, Microseconds };
+    Unit unit = Unit::Samples;
+    std::int64_t value{};
+};
+
+struct HostTrack {
+    std::filesystem::path file;
+    enum class Loop {
+        Auto,   // the file's LOOPSTART with LOOPLENGTH or LOOPEND tags, else Whole
+        Whole,  // the whole file, over and over
+        Range,  // from loop_start (included) to loop_end (excluded; none: the end)
+        None,   // plays once
+    };
+    Loop loop = Loop::Auto;
+    HostLoopPoint loop_start{};
+    std::optional<HostLoopPoint> loop_end;
+    std::string name;  // for the log
+};
+
+// A decoded track: 44,100 Hz stereo, interleaved 16-bit samples.
+struct HostPcm {
+    std::vector<std::int16_t> samples;
+    // Frames (stereo samples), both ends included; -1 without a loop.
+    std::int32_t loop_start{-1};
+    std::int32_t loop_end{-1};
+    std::uint32_t source_rate{};
+    unsigned source_channels{};
+    std::string codec;
+    // The file could not be decoded: the samples are a second of silence and
+    // `error` says why.
+    bool failed{};
+    std::string error;
+
+    [[nodiscard]] std::uint32_t frames() const noexcept { return static_cast<std::uint32_t>(samples.size() / 2u); }
+};
+
+// True when the build can decode host files and <prefix>_NO_HOST_AUDIO is not
+// set.
+[[nodiscard]] bool host_audio_available();
+
+// Opens `file` far enough to know it has an audio stream that can be decoded,
+// without decoding it; `error` says why not.
+[[nodiscard]] bool probe_host_audio(const std::filesystem::path &file, std::string &error);
+
+// Registers `track` under `id`. False when the id is taken or host audio is
+// not available.
+bool register_host_track(std::uint32_t id, HostTrack track);
+[[nodiscard]] bool host_track_registered(std::uint32_t id);
+
+// The decoded track, decoding it now if no earlier call or prefetch has; null
+// for an id nobody registered. The last few decoded tracks are kept, so a
+// track played again is not decoded again.
+[[nodiscard]] std::shared_ptr<const HostPcm> host_track_pcm(std::uint32_t id);
+// Starts decoding the track on a worker thread, so that host_track_pcm finds
+// it ready, for a port that knows which track comes next (a menu choice).
+void prefetch_host_track(std::uint32_t id);
+
+// The stand-in ATRAC3plus WAVE file for track `id`, in frames of
+// `block_align` bytes (the game's own tracks' frame size is the safest
+// choice), decoding the track if need be. Null for an unknown id, a track
+// that cannot be decoded, or a block size out of range; the log says which.
+[[nodiscard]] std::shared_ptr<hle_extension::FileFilter> virtual_atrac_file(std::uint32_t id,
+                                                                            std::uint32_t block_align);
+
+// The private WAVE chunk of a stand-in file: "PKHA", eight bytes, a version
+// (1) and the track id, both little-endian.
+inline constexpr std::uint32_t kHostChunkId = 0x41484B50u;  // "PKHA" read little-endian
+inline constexpr std::uint32_t kHostChunkVersion = 1u;
+
+} // namespace portablekit::audio
