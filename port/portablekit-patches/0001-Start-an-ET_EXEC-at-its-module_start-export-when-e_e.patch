From e96c0ced044d88f7e0cb5661850af467d97a6f0a Mon Sep 17 00:00:00 2001
From: VCKing101 <59761021+VCKing101@users.noreply.github.com>
Date: Sun, 18 Oct 2026 17:52:43 +1030
Subject: [PATCH 01/41] Start an ET_EXEC at its module_start export when
 e_entry is 0

Some disc executables leave e_entry at 0 and name their entry only as the
module_start export (NID 0xD632ACDB) of the module info's system library,
which is what the PSP's loader starts. Elf32Image::runtime_entry() now falls
back to that export, read from the file, when e_entry is 0.

Tested on Windows (MSVC 19.44) with one game whose executable has e_entry 0:
the loader thread starts at the export. Framework tests pass.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 include/psprecomp/elf32.hpp |  4 ++++
 src/elf32.cpp               | 39 ++++++++++++++++++++++++++++++++++++-
 2 files changed, 42 insertions(+), 1 deletion(-)

diff --git a/include/psprecomp/elf32.hpp b/include/psprecomp/elf32.hpp
index a59328f..b32aaf7 100644
--- a/include/psprecomp/elf32.hpp
+++ b/include/psprecomp/elf32.hpp
@@ -83,6 +83,10 @@ public:
 
     [[nodiscard]] std::uint32_t entry() const noexcept;
     [[nodiscard]] std::uint32_t runtime_entry(std::uint32_t load_base = kDefaultPspUserLoadBase) const noexcept;
+    // The module_start export of an ET_EXEC's module info, read from the
+    // file; 0 when there is none. runtime_entry() falls back to it when
+    // e_entry is 0.
+    [[nodiscard]] std::uint32_t module_start_export() const noexcept;
     [[nodiscard]] std::uint16_t type() const noexcept;
     [[nodiscard]] bool is_psp_prx() const noexcept;
     [[nodiscard]] const std::vector<std::uint8_t> &bytes() const noexcept;
diff --git a/src/elf32.cpp b/src/elf32.cpp
index 2cd5669..c869c5d 100644
--- a/src/elf32.cpp
+++ b/src/elf32.cpp
@@ -159,7 +159,44 @@ void Elf32Image::parse() {
 
 std::uint32_t Elf32Image::entry() const noexcept { return entry_; }
 std::uint32_t Elf32Image::runtime_entry(std::uint32_t load_base) const noexcept {
-    return is_psp_prx() ? load_base + entry_ : entry_;
+    if (is_psp_prx()) return load_base + entry_;
+    // Some disc executables leave e_entry at 0 and name their entry only as
+    // the module_start export of the module info's system library (NID
+    // 0xD632ACDB), which is what the PSP's own loader starts. Address 0 is
+    // never user code, so take the export then.
+    if (entry_ == 0u) {
+        if (const std::uint32_t start = module_start_export(); start != 0u) return start;
+    }
+    return entry_;
+}
+
+std::uint32_t Elf32Image::module_start_export() const noexcept {
+    constexpr std::uint32_t kModuleStartNid = 0xD632ACDBu;
+    try {
+        if (is_psp_prx()) return 0u;
+        const std::uint32_t info = module_info_address(0u);
+        if (info == 0u) return 0u;
+        const std::uint32_t ent_top = read_word_at_vaddr(info + 36u);
+        const std::uint32_t ent_end = read_word_at_vaddr(info + 40u);
+        // Each export entry: name, version and attributes, its length in
+        // words, the variable and function counts, and the table of NIDs
+        // followed by the values in the same order.
+        for (std::uint32_t cursor = ent_top; cursor < ent_end;) {
+            const std::uint32_t counts = read_word_at_vaddr(cursor + 8u);
+            const std::uint32_t length_words = counts & 0xFFu;
+            const std::uint32_t variables = (counts >> 8u) & 0xFFu;
+            const std::uint32_t functions = counts >> 16u;
+            const std::uint32_t table = read_word_at_vaddr(cursor + 12u);
+            const std::uint32_t total = variables + functions;
+            for (std::uint32_t i = 0; i < functions; ++i) {
+                if (read_word_at_vaddr(table + i * 4u) == kModuleStartNid)
+                    return read_word_at_vaddr(table + (total + i) * 4u);
+            }
+            cursor += std::max<std::uint32_t>(length_words, 4u) * 4u;
+        }
+    } catch (const Error &) {
+    }
+    return 0u;
 }
 std::uint16_t Elf32Image::type() const noexcept { return type_; }
 bool Elf32Image::is_psp_prx() const noexcept { return type_ == kElfTypePspPrx; }
