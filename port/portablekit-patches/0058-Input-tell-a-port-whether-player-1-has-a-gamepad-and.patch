--- a/host/hle/hle_extension_host.cpp
+++ b/host/hle/hle_extension_host.cpp
@@ -123,6 +123,8 @@ SecondPad second_pad() {
                      sample.analog_y,  sample.right_x, sample.right_y};
 }
 
+bool first_pad_connected() { return ::portablekit::first_pad_connected(); }
+
 } // namespace hle_extension
 
 HleExtensionReport install_linked_hle_extensions(Runtime &runtime, HleRegistrar &hle) {
diff --git a/host/hle/hle_media.cpp b/host/hle/hle_media.cpp
index 2be6d5f..e690158 100644
--- a/host/hle/hle_media.cpp
+++ b/host/hle/hle_media.cpp
@@ -1178,6 +1178,14 @@ SecondPadSample second_pad_sample() {
     return sample;
 }
 
+bool first_pad_connected() {
+#if defined(PORTABLEKIT_HAS_RENDERER)
+    return media().renderer && media().renderer->available() && media().renderer->first_pad_connected();
+#else
+    return false;
+#endif
+}
+
 void initialize_renderer() {
 #if defined(PORTABLEKIT_HAS_RENDERER)
     (void)ensure_renderer();
diff --git a/host/ui/input_script.cpp b/host/ui/input_script.cpp
index f036525..b58cf36 100644
--- a/host/ui/input_script.cpp
+++ b/host/ui/input_script.cpp
@@ -39,6 +39,7 @@ struct State {
     std::deque<Step> steps;
     std::uint64_t frame{};
     SDL_Joystick *pad{};
+    SDL_JoystickID pad_id{};
     SDL_Joystick *pad2{};  // the second virtual pad, for pad2 and axis2 steps
     SDL_JoystickID pad2_id{};
     // Releases due later: frame, key or pad buttons (of `joystick`).
@@ -112,6 +113,7 @@ bool mouse_step(const std::string &action) { return action == "mouse" || action
 
 bool sensor_step(const std::string &action) { return action == "tilt" || action == "gyro"; }
 
+void attach_pad(State &s);
 void attach_second_pad(State &s);
 
 void run(const Step &step) {
@@ -169,6 +171,15 @@ void run(const Step &step) {
             buttons.push_back(button);
         }
         s.releases.push_back({s.frame + frames, SDLK_UNKNOWN, buttons, 0u, joystick});
+    } else if (step.action == "detach") {
+        // Player 1's pad unplugged.
+        if (s.pad == nullptr) return;
+        SDL_CloseJoystick(s.pad);
+        SDL_DetachVirtualJoystick(s.pad_id);
+        s.pad = nullptr;
+        s.pad_id = 0;
+    } else if (step.action == "attach") {
+        if (s.pad == nullptr) attach_pad(s);
     } else if (step.action == "detach2") {
         // Player 2's pad unplugged, as a cable pulled or a battery gone flat.
         if (s.pad2 == nullptr) return;
@@ -363,6 +374,7 @@ void attach_pad(State &s) {
         return;
     }
     s.pad = SDL_OpenJoystick(id);
+    s.pad_id = id;
 }
 
 // A plain second virtual pad, which the renderer gives player 2 by its name.
