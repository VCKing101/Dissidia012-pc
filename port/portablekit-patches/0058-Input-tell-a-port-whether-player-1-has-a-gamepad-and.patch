 bool VulkanRenderer::second_pad_connected() const noexcept { return impl_ && impl_->gamepad2 != nullptr; }
 
+bool VulkanRenderer::first_pad_connected() const noexcept { return impl_ && impl_->gamepad != nullptr; }
+
 PadState VulkanRenderer::second_pad() const noexcept { return impl_ ? impl_->pad2 : PadState{}; }
 
 bool VulkanRenderer::touch_controls_visible() const noexcept {
diff --git a/host/gpu/vulkan_renderer.hpp b/host/gpu/vulkan_renderer.hpp
index 40748c0..9b08d55 100644
