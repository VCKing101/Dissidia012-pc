     void set_second_pad_wanted(bool wanted);
     [[nodiscard]] bool second_pad_connected() const noexcept;
     [[nodiscard]] PadState second_pad() const noexcept;
+    // Player 1 has a gamepad (pad() reads one, not only the keyboard).
+    [[nodiscard]] bool first_pad_connected() const noexcept;
     // Reads the keyboard, mouse buttons and gamepad again for pad() without
     // handling window events (issue #8): the game reads its pad each frame,
     // and taking the state then instead of at the last flip saves up to a
diff --git a/host/hle/hle_common.hpp b/host/hle/hle_common.hpp
index 6d4597f..d3c82a6 100644
