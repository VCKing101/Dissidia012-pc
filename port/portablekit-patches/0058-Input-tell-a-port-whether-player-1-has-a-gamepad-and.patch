 // 4: add_file_provider.
 // 5: extra_buttons.
 // 6: want_second_pad, second_pad.
-#define PORTABLEKIT_HLE_EXTENSION_INTERFACE 6
+// 7: first_pad_connected.
+#define PORTABLEKIT_HLE_EXTENSION_INTERFACE 7
 
 namespace portablekit::hle_extension {
 
@@ -308,6 +309,9 @@ struct SecondPad {
 };
 void want_second_pad(bool wanted);
 [[nodiscard]] SecondPad second_pad();
+// Player 1 has a gamepad (not only the keyboard): for telling player 1 that
+// it went away, as second_pad().connected tells it for player 2.
+[[nodiscard]] bool first_pad_connected();
 
 } // namespace portablekit::hle_extension
 
