 //                     (leftx, lefty, rightx, righty, lefttrigger, righttrigger)
 //   pad2 ..., axis2 ...  the same on a second virtual gamepad, player 2's
 //                     while a port wants one (kInputScriptName2)
-//   detach2, attach2  unplug that second pad, and plug it in again
+//   detach, attach    unplug the virtual gamepad, and plug it in again
+//   detach2, attach2  the same for the second pad
 //   tilt ROLL [PITCH] hold the virtual gamepad's accelerometer where it reads
 //                     with the pad rolled ROLL degrees (right side down
 //                     positive) and pitched PITCH degrees back from flat, 0 by
diff --git a/include/portablekit/hle_extension.hpp b/include/portablekit/hle_extension.hpp
index 380f194..e53b36b 100644
--- a/include/portablekit/hle_extension.hpp
