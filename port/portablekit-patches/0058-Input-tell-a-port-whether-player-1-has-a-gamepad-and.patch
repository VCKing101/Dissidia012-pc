+++ b/host/hle/hle_common.hpp
@@ -92,6 +92,8 @@ struct SecondPadSample {
     std::uint8_t right_y{0x80u};
 };
 [[nodiscard]] SecondPadSample second_pad_sample();
+// Player 1 has a gamepad, not only the keyboard.
+[[nodiscard]] bool first_pad_connected();
 
 // True when <prefix>_TRACE_SYNC is set: logs kernel object activity.
 [[nodiscard]] bool trace_sync();
