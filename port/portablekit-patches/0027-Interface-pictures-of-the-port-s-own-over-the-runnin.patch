index cabfd80..cc809d9 100644
--- a/host/ui/layer.cpp
+++ b/host/ui/layer.cpp
@@ -1,11 +1,13 @@
 #include "../profile.hpp"
 #include "ui/layer.hpp"
+#include "ui/ui.hpp"
 
 #include "app_paths.hpp"
 
 #include "ui/input_script.hpp"
 #include "ui/widgets.hpp"
 
