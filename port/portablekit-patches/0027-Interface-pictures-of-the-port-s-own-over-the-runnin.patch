diff --git a/host/gpu/vulkan_renderer.cpp b/host/gpu/vulkan_renderer.cpp
index c36a600..7c5c838 100644
--- a/host/gpu/vulkan_renderer.cpp
+++ b/host/gpu/vulkan_renderer.cpp
@@ -5807,6 +5807,29 @@ void VulkanRenderer::hold_frame(bool hold) {
 }
 
 SDL_Window *VulkanRenderer::window() const noexcept { return impl_ ? impl_->window : nullptr; }
+
+std::array<float, 4> VulkanRenderer::game_picture() const noexcept {
+    if (!impl_ || impl_->window == nullptr || impl_->swapchain_extent.width == 0u ||
+        impl_->swapchain_extent.height == 0u)
+        return {0.0f, 0.0f, static_cast<float>(kPspWidth), static_cast<float>(kPspHeight)};
+    int width = 0;
+    int height = 0;
+    if (!SDL_GetWindowSize(impl_->window, &width, &height) || width <= 0 || height <= 0)
+        return {0.0f, 0.0f, static_cast<float>(kPspWidth), static_cast<float>(kPspHeight)};
+    // The rectangle of the last game frame shown, in swapchain pixels, to
+    // window coordinates.
+    const float x_scale = static_cast<float>(width) / static_cast<float>(impl_->swapchain_extent.width);
+    const float y_scale = static_cast<float>(height) / static_cast<float>(impl_->swapchain_extent.height);
+    VkOffset3D low = impl_->picture_low;
+    VkOffset3D high = impl_->picture_high;
+    if (high.x <= low.x || high.y <= low.y) {
+        low = {0, 0, 0};
+        high = {static_cast<std::int32_t>(impl_->swapchain_extent.width),
+                static_cast<std::int32_t>(impl_->swapchain_extent.height), 1};
+    }
+    return {static_cast<float>(low.x) * x_scale, static_cast<float>(low.y) * y_scale,
+            static_cast<float>(high.x - low.x) * x_scale, static_cast<float>(high.y - low.y) * y_scale};
+}
 std::string VulkanRenderer::device_name() const { return impl_ ? impl_->device_name : std::string{}; }
 SDL_Gamepad *VulkanRenderer::gamepad() const noexcept { return impl_ ? impl_->gamepad : nullptr; }
 
