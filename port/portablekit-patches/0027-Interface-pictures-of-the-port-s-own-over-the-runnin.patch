 #include "install/user_data.hpp"
@@ -66,6 +68,20 @@ const char *const kJapaneseFonts[] = {
     "C:/Windows/Fonts/msgothic.ttc",
 };
 
+ImFont *g_game_text_font = nullptr;
+
+// The game's own text face as a font of the interface's, for pictures drawn
+// beside the game's text (add_game_overlay). The face is the one in use when
+// the interface starts.
+void load_game_text_font() {
+    std::string path;
+    int index = 0;
+    if (!fonts::active_face(path, index)) return;
+    ImFontConfig config;
+    config.FontNo = index;
+    g_game_text_font = ImGui::GetIO().Fonts->AddFontFromFileTTF(path.c_str(), 0.0f, &config);
+}
+
 bool exists(const char *path) {
     std::error_code ec;
     return std::filesystem::is_regular_file(install::path_from_utf8(path), ec);
@@ -152,6 +168,7 @@ bool Layer::attach(gpu::VulkanRenderer &renderer) {
     // Any connected pad drives the interface, not only the one the game reads.
     ImGui_ImplSDL3_SetGamepadMode(ImGui_ImplSDL3_GamepadMode_AutoAll);
     load_fonts();
+    load_game_text_font();
     std::string error;
     if (!renderer.initialize_ui(error)) {
         std::cout << "[ui] cannot draw the interface (" << error << "); no menu\n";
@@ -354,4 +371,15 @@ bool Layer::run(const std::function<bool()> &frame, bool show_game) {
     }
 }
 
+ImFont *game_text_font() {
+    return g_game_text_font != nullptr ? g_game_text_font : ImGui::GetFont();
+}
+
+GamePicture game_picture() {
+    const Layer &layer = Layer::get();
+    if (!layer.attached()) return {};
+    const std::array<float, 4> rect = Layer::get().renderer().game_picture();
+    return {rect[0], rect[1], rect[2], rect[3]};
+}
+
 } // namespace portablekit::ui
diff --git a/host/ui/menu.cpp b/host/ui/menu.cpp
index 3670dfb..cb7bf05 100644
--- a/host/ui/menu.cpp
+++ b/host/ui/menu.cpp
@@ -1552,6 +1552,21 @@ void set_status_overlay(bool (*visible)(), void (*draw)()) {
     g_status_overlay_draw = draw;
 }
 
+namespace {
+struct GameOverlay {
+    bool (*visible)();
+    void (*draw)();
+};
+std::vector<GameOverlay> &game_overlays() {
+    static std::vector<GameOverlay> list;
+    return list;
+}
+} // namespace
+
+void add_game_overlay(bool (*visible)(), void (*draw)()) {
+    if (visible != nullptr && draw != nullptr) game_overlays().push_back({visible, draw});
+}
+
 void draw_over_game() {
     Layer &layer = Layer::get();
     if (!layer.attached()) return;
@@ -1578,8 +1593,14 @@ void draw_over_game() {
     const bool overlay = network_overlay();
     const bool touch = !menu && layer.renderer().touch_controls_visible();
     const bool status = g_status_overlay_visible != nullptr && g_status_overlay_visible();
-    if (hint_left <= 0.0 && !overlay && !menu && !touch && !status) return;
+    // The port's pictures beside the game's screens, under the menu.
+    std::uint32_t game_overlay_mask = 0u;
+    for (std::size_t i = 0; i < game_overlays().size() && i < 32u; ++i)
+        if (game_overlays()[i].visible()) game_overlay_mask |= 1u << i;
+    if (hint_left <= 0.0 && !overlay && !menu && !touch && !status && game_overlay_mask == 0u) return;
     layer.begin_frame();
+    for (std::size_t i = 0; i < game_overlays().size() && i < 32u; ++i)
+        if ((game_overlay_mask & (1u << i)) != 0u) game_overlays()[i].draw();
     if (touch) draw_touch_controls(layer.renderer().touch_controls(), settings::current().touch_opacity);
     if (hint_left > 0.0) draw_hint(hint_left);
     if (overlay) draw_network_overlay();
diff --git a/host/ui/ui.hpp b/host/ui/ui.hpp
index 3a9e140..8733bbf 100644
--- a/host/ui/ui.hpp
+++ b/host/ui/ui.hpp
@@ -3,6 +3,8 @@
 #include <memory>
 #include <string>
 
+struct ImFont;
+
 // The port's own interface, drawn with Dear ImGui over the game's window: the
 // in-game menu and the first-run setup screens. Only builds with the renderer
 // have it.
@@ -29,6 +31,29 @@ void draw_over_game();
 // every game frame; `draw` then builds it inside that frame with ImGui.
 void set_status_overlay(bool (*visible)(), void (*draw)());
 
+// A picture of the port's own over the running game, beside one of the game's
+// screens (a hint by one of its menus, say). `visible` is asked before every
+// game frame; when it says so, `draw` builds its part of that frame with
+// ImGui, usually on ImGui::GetForegroundDrawList() at places found with
+// game_picture(). The game's dialogs and the menu, when open, are drawn
+// instead. Several may be added; they are drawn in the order added.
+void add_game_overlay(bool (*visible)(), void (*draw)());
+// Where the game's 480x272 picture was last drawn, in ImGui's coordinates
+// (window coordinates): a point (x, y) of the PSP's screen is at
+// (left + x * width / 480, top + y * height / 272). The whole PSP screen
+// before the interface is attached.
+struct GamePicture {
+    float left{};
+    float top{};
+    float width{480.0f};
+    float height{272.0f};
+};
+[[nodiscard]] GamePicture game_picture();
+// The face the game's text is drawn with (the menu's Font setting when the
+// interface started), as an ImGui font, for text that sits beside the game's;
+// the interface's own font when there is none. Only inside a frame.
+[[nodiscard]] ImFont *game_text_font();
+
 // After a game frame's window events: whether the player asked for the menu
 // (Esc, or L3+R3 on a gamepad).
 [[nodiscard]] bool menu_requested();
