+namespace portablekit::ui {
+namespace {
+
+// The pause around the screens: taken by the outermost, given back by it.
+int g_depth = 0;
+
+class Paused {
+public:
+    Paused() {
+        if (g_depth++ > 0) return;
+        Layer &layer = Layer::get();
+        stall_watchdog::note_menu(true);
+        audio::AudioSink::instance().set_paused(true);
+        layer.renderer().set_game_input(false);
+        layer.set_interactive(true);
+        mute_skin_sounds(true);
+    }
+    ~Paused() {
+        if (--g_depth > 0) return;
+        Layer &layer = Layer::get();
+        mute_skin_sounds(false);
+        layer.set_interactive(false);
+        layer.renderer().set_game_input(true);
+        audio::AudioSink::instance().set_paused(false);
+        stall_watchdog::note_menu(false);
+        // Go on at normal speed rather than racing to make up the pause.
+        kernel().resync_real_time();
+        perf::restart_measurement();
+    }
+    Paused(const Paused &) = delete;
+    Paused &operator=(const Paused &) = delete;
+};
+
+float font() { return Layer::get().font_size(); }
+
+bool pressed(std::initializer_list<ImGuiKey> keys, bool repeat) {
+    for (const ImGuiKey key : keys)
+        if (ImGui::IsKeyPressed(key, repeat)) return true;
+    return false;
+}
+
+// What the player pressed this frame.
+struct Keys {
+    bool up{}, down{}, confirm{}, back{};
+};
+
+Keys read_keys() {
+    Layer &layer = Layer::get();
+    (void)layer.take_menu_toggle();  // the menu does not open over these screens
+    Keys k;
+    k.back = layer.take_back();
+    k.up = pressed({ImGuiKey_UpArrow}, true);
+    k.down = pressed({ImGuiKey_DownArrow}, true);
+    k.confirm = pressed({ImGuiKey_Enter, ImGuiKey_KeypadEnter}, false);
+    // A button held when the screen opened, such as the one that led to it,
+    // does nothing until it is released.
+    if (layer.gamepad_armed()) {
+        const bool south = layer.confirm_south();
+        const ImGuiKey confirm = south ? ImGuiKey_GamepadFaceDown : ImGuiKey_GamepadFaceRight;
+        const ImGuiKey back = south ? ImGuiKey_GamepadFaceRight : ImGuiKey_GamepadFaceDown;
+        k.up = k.up || pressed({ImGuiKey_GamepadDpadUp, ImGuiKey_GamepadLStickUp}, true);
+        k.down = k.down || pressed({ImGuiKey_GamepadDpadDown, ImGuiKey_GamepadLStickDown}, true);
+        k.confirm = k.confirm || ImGui::IsKeyPressed(confirm, false);
+        k.back = k.back || ImGui::IsKeyPressed(back, false);
+    }
+    return k;
+}
+
+bool mouse_moved() {
+    const ImGuiIO &io = ImGui::GetIO();
+    return io.MouseDelta.x * io.MouseDelta.x + io.MouseDelta.y * io.MouseDelta.y > 0.0f;
+}
