diff --git a/host/ui/adhoc_chooser.cpp b/host/ui/adhoc_chooser.cpp
new file mode 100644
index 0000000..711d8c8
--- /dev/null
+++ b/host/ui/adhoc_chooser.cpp
@@ -0,0 +1,178 @@
+// How to play, asked over the paused game when it goes online with nothing
+// chosen and the port has a public server (GameProfile::public_server): Play
+// online, Host a session or Join a session (a session on this network, a
+// recent one, or an address typed in), each screen with Back. Registered with
+// adhoc::set_adhoc_chooser() when the interface attaches; the game's
+// sceNetAdhocctlInit asks it (adhoc_ask_for_choice()), or the port from its
+// game's menu (GameProfile::adhoc_choice_at_init).
+#include "ui/choice_screen.hpp"
+
+#include "adhoc/discovery.hpp"
+#include "adhoc/port_mapping.hpp"
+#include "adhoc/protocol.hpp"
+#include "adhoc/session.hpp"
+#include "profile.hpp"
+#include "settings/settings.hpp"
+
+#include <SDL3/SDL.h>
+
+#include <algorithm>
+#include <string>
+#include <vector>
+
+namespace portablekit::ui {
+namespace {
+
+std::string players_line() {
+    const auto players = portablekit::game().public_server_players;
+    const int count = players != nullptr ? players() : -1;
+    if (count < 0) return {};
+    return count == 1 ? "1 player is on now.\n" : std::to_string(count) + " players are on now.\n";
+}
+
+bool address_character(char32_t c) {
+    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '.' || c == ':' ||
+           c == '-' || c == '[' || c == ']';
+}
+
+// What hosting is doing, for the notice after Host a session. Copies the
+// internet address once the router gives it.
+std::string hosting_text(std::string &copied) {
+    if (adhoc_loopback_only()) return "Hosting, for copies of the game on this computer only.";
+    if (!settings::current().adhoc_router_ports)
+        return "Hosting. Players on this network find your session by themselves. Over the internet, they need your "
+               "router's ports opened by hand.";
+    const adhoc::RouterStatus router = adhoc_router_status();
+    const std::uint16_t port = adhoc_host_status().adhocctl_port;
+    switch (router.state) {
+    case adhoc::RouterState::Off:
+    case adhoc::RouterState::Working: return "Hosting. Asking your router to open its ports…";
+    case adhoc::RouterState::Failed:
+        return "Hosting, but your router did not open its ports (" + router.error +
+               "). Players on this network can join; players on the internet may not reach you. Play online needs "
+               "no ports.";
+    case adhoc::RouterState::Open: break;
+    }
+    if (router.shared)
+        return "Hosting, but your provider shares your internet address, so players on the internet cannot reach "
+               "you. Players on this network can join. Over the internet, choose Play online instead.";
+    const std::string address =
+        router.external_address + (port == adhoc::kAdhocctlPort ? std::string() : ":" + std::to_string(port));
+    if (copied != address) {
+        SDL_SetClipboardText(address.c_str());
+        copied = address;
+    }
+    return "Hosting. Your internet address is " + address +
+           ", copied for you to send to the others. Players on this network find your session by themselves.";
+}
+
+// Host a session: true once hosting, after the notice.
+bool host() {
+    if (!adhoc_host_start()) {
+        const std::string error = adhoc_host_error();
+        notice_over_game([&] { return "This PC could not host a session: " + error + "."; });
+        return false;
+    }
+    std::string copied;
+    notice_over_game([&] { return hosting_text(copied); });
+    return true;
+}
+
+// Join a session: true once joined.
+bool join() {
+    adhoc::Discovery &discovery = adhoc::Discovery::get();
+    std::size_t selected = 0;
+    for (;;) {
+        std::vector<std::string> addresses;  // the address each choice joins; empty for the last two
+        const int pick = choose_over_game(
+            [&](ChoiceView &view) {
+                const settings::Settings &s = settings::current();
+                if (!adhoc_loopback_only()) {
+                    discovery.start_listening();
+                    discovery.query(s.adhoc_recent);
+                }
+                view.title = "Join a Session";
+                view.prompt = "Choose a session to join.";
+                view.items.clear();
+                addresses.clear();
+                const std::vector<adhoc::FoundHost> hosts = adhoc_loopback_only() ? std::vector<adhoc::FoundHost>{}
+                                                                                  : discovery.hosts();
+                for (const adhoc::FoundHost &found : hosts) {
+                    const unsigned n = found.info.players;
+                    view.items.push_back({found.info.name.empty() ? found.join_address() : found.info.name,
+                                          "On this network: " + found.join_address() + ", " +
+                                              (n == 1u ? std::string("1 player") : std::to_string(n) + " players") +
+                                              ".",
+                                          true});
+                    addresses.push_back(found.join_address());
+                }
+                for (const std::string &address : s.adhoc_recent) {
+                    if (std::find(addresses.begin(), addresses.end(), address) != addresses.end()) continue;
+                    view.items.push_back({address, "A session you joined before.", true});
+                    addresses.push_back(address);
+                }
+                view.items.push_back({"Enter an Address", "Type the address the host sent you.", true});
+                view.items.push_back({"Back", "Back to choosing how to play.", true});
+            },
+            selected);
+        if (pick < 0 || static_cast<std::size_t>(pick) == addresses.size() + 1u) return false;
+        selected = static_cast<std::size_t>(pick);
+        if (static_cast<std::size_t>(pick) < addresses.size()) {
+            adhoc_join(addresses[static_cast<std::size_t>(pick)]);
+            return true;
+        }
+        TextInputRequest request;
+        request.title = "Host's Address";
+        request.prompt = "Enter the address the host sent you.";
+        request.max_length = 64u;
+        request.allowed = address_character;
+        if (const std::optional<std::string> typed = type_over_game(std::move(request)); typed && !typed->empty()) {
+            adhoc_join(*typed);
+            return true;
+        }
+    }
+}
+
+bool run_adhoc_chooser() {
+    std::size_t selected = 0;
+    for (;;) {
+        const int pick = choose_over_game(
+            [](ChoiceView &view) {
+                view.title = "Online";
+                view.prompt = "How do you want to play?";
+                const settings::Settings &s = settings::current();
+                std::string note;
+                const std::string address =
+                    s.adhoc_online_server.empty() ? portablekit::game().public_server(note) : s.adhoc_online_server;
+                view.items = {
+                    {"Play Online",
+                     address.empty() ? note
+                                     : players_line() +
+                                           "Play with everyone on the game's server. Nothing to set up and no address "
+                                           "to send.",
+                     !address.empty()},
+                    {"Host a Session",
+                     "Play with friends: this PC runs the session and they join it. You send them your address; the "
+                     "game asks your router to open its ports.",
+                     true},
+                    {"Join a Session", "Join a session a friend hosts, on this network or by the address they send you.",
+                     true},
+                    {"Back", "Stay offline. You can choose later, here or on the menu's Network page.", true},
+                };
+            },
+            selected);
+        if (pick < 0 || pick == 3) return false;
+        selected = static_cast<std::size_t>(pick);
+        if (pick == 0) {
+            adhoc_play_online();
+            return true;
+        }
+        if (pick == 1 ? host() : join()) return true;
+    }
+}
+
+} // namespace
+
+void install_adhoc_chooser() { set_adhoc_chooser(run_adhoc_chooser); }
+
+} // namespace portablekit::ui
