+        const ImVec2 t = ImGui::CalcTextSize(view.items[i].label.c_str());
+        draw->AddText({std::round(left + (size.x - t.x) * 0.5f), std::round(y + (size.y - t.y) * 0.5f)},
+                      view.items[i].enabled ? (selected ? band::kText : band::kTextDim) : IM_COL32(150, 150, 160, 160),
+                      view.items[i].label.c_str());
+        y += size.y + gap;
+    }
+    if (view.selected < view.items.size()) {
+        ImGui::SetCursorScreenPos({std::round((io.DisplaySize.x - width) * 0.5f), y + gap});
+        ImGui::PushTextWrapPos(std::round((io.DisplaySize.x + width) * 0.5f));
+        ImGui::PushStyleColor(ImGuiCol_Text, band::kTextDim);
+        ImGui::TextUnformatted(view.items[view.selected].detail.c_str());
+        ImGui::PopStyleColor();
+        ImGui::PopTextWrapPos();
+    }
+    ImGui::End();
+}
+
+void draw_notice(const std::string &text, bool &confirmed) {
+    const ImGuiIO &io = ImGui::GetIO();
+    begin_overlay("##notice");
+    ImDrawList *draw = ImGui::GetWindowDrawList();
+    const float width = std::min(io.DisplaySize.x * 0.8f, font() * 34.0f);
+    ImGui::PushTextWrapPos(0.0f);
+    const ImVec2 text_size = ImGui::CalcTextSize(text.c_str(), nullptr, false, width);
+    ImGui::PopTextWrapPos();
+    const ImVec2 ok{std::round(font() * 5.5f), std::round(font() * 1.7f)};
+    const float gap = std::round(font() * 1.1f);
+    const float block = text_size.y + gap + ok.y;
+    const float top = std::round((io.DisplaySize.y - block) * 0.5f);
+    draw_band(ImGui::GetBackgroundDrawList(), top - font(), top + block + font());
+    ImGui::SetCursorScreenPos({std::round((io.DisplaySize.x - width) * 0.5f), top});
+    ImGui::PushTextWrapPos(std::round((io.DisplaySize.x + width) * 0.5f));
+    ImGui::PushStyleColor(ImGuiCol_Text, band::kText);
+    ImGui::TextUnformatted(text.c_str());
+    ImGui::PopStyleColor();
+    ImGui::PopTextWrapPos();
+    const float left = std::round((io.DisplaySize.x - ok.x) * 0.5f);
+    const float y = top + text_size.y + gap;
+    ImGui::SetCursorScreenPos({left, y});
+    if (ImGui::InvisibleButton("##ok", ok)) confirmed = true;
+    draw_choice(draw, {left, y}, {left + ok.x, y + ok.y}, true);
+    const ImVec2 t = ImGui::CalcTextSize("OK");
+    draw->AddText({std::round(left + (ok.x - t.x) * 0.5f), std::round(y + (ok.y - t.y) * 0.5f)}, band::kText, "OK");
+    ImGui::End();
+}
+
+} // namespace
+
+int choose_over_game(const std::function<void(ChoiceView &)> &step, std::size_t selected) {
+    Layer &layer = Layer::get();
+    if (!layer.attached()) return -1;
+    Paused paused;
+    ChoiceView view;
+    int chosen = -1;
+    const bool open = layer.run(
+        [&] {
+            step(view);
+            if (view.items.empty()) return false;
+            selected = std::min(selected, view.items.size() - 1u);
+            const Keys keys = read_keys();
+            if (keys.back) {
+                skin_sound(DialogSound::Back);
+                chosen = -1;
+                return false;
+            }
+            const std::size_t was = selected;
+            if (keys.up) selected = selected == 0u ? view.items.size() - 1u : selected - 1u;
+            if (keys.down) selected = selected + 1u == view.items.size() ? 0u : selected + 1u;
+            ChoiceSkinView shown;
+            shown.title = view.title;
+            shown.prompt = view.prompt;
+            shown.items = view.items;
+            shown.selected = selected;
+            shown.confirm_south = layer.confirm_south();
+            SkinPointer pointer;
+            if (const auto draw_skin = skin_ready(dialog_skin().choices)) draw_skin(shown, pointer);
+            else draw_choices(shown, pointer);
+            if (pointer.hovered >= 0 && mouse_moved()) selected = static_cast<std::size_t>(pointer.hovered);
+            if (selected != was) skin_sound(DialogSound::Move);
+            std::optional<std::size_t> pick;
+            if (keys.confirm) pick = selected;
+            if (pointer.clicked >= 0) pick = static_cast<std::size_t>(pointer.clicked);
+            if (pick && *pick < view.items.size()) {
+                if (!view.items[*pick].enabled) {
+                    skin_sound(DialogSound::Refused);
+                    return true;
+                }
+                skin_sound(DialogSound::Confirm);
+                chosen = static_cast<int>(*pick);
+                return false;
+            }
+            return true;
+        },
+        true);
+    return open ? chosen : -1;
+}
+
+void notice_over_game(const std::function<std::string()> &text) {
+    Layer &layer = Layer::get();
+    if (!layer.attached()) return;
+    Paused paused;
+    layer.run(
+        [&] {
+            const std::string shown = text();
+            const Keys keys = read_keys();
+            bool confirmed = keys.confirm || keys.back;
+            if (const auto draw_skin = skin_ready(dialog_skin().message)) {
+                MessageSkinView view;
+                view.text = shown;
+                view.confirm_south = layer.confirm_south();
+                SkinPointer pointer;
+                draw_skin(view, pointer);
+                confirmed = confirmed || pointer.clicked == 0;
+            } else {
+                draw_notice(shown, confirmed);
+            }
+            if (confirmed) skin_sound(DialogSound::Confirm);
+            return !confirmed;
+        },
+        true);
+}
+
+std::optional<std::string> type_over_game(TextInputRequest request) {
+    Layer &layer = Layer::get();
+    if (!layer.attached()) return std::nullopt;
+    Paused paused;
+    std::optional<std::string> result;
+    request.game_look = true;
+    open_text_input(std::move(request), [&](std::optional<std::string> text) { result = std::move(text); });
+    const bool open = layer.run(
+        [&] {
+            (void)layer.take_menu_toggle();
+            text_input_frame();
+            return text_input_open();
+        },
+        true);
+    if (!open && text_input_open()) cancel_text_input();
+    return result;
+}
+
+} // namespace portablekit::ui
