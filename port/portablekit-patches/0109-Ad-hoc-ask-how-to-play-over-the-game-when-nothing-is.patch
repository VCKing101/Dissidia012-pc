+#pragma once
+
+// Screens of a port's own over the paused game: a list of choices, a notice
+// with OK, and the keyboard. Each runs on the game's thread and returns when
+// the player is done with it; the game stands still meanwhile, as behind
+// wait_over_game()'s band (no input reaches it, its sound stops). They are
+// drawn in the port's look for the game's dialogs (dialog_skin.hpp: choices,
+// message, keyboard) when it has one, and in PortableKit's otherwise.
+//
+// Controls: up and down (D-pad, left stick, arrow keys, the mouse) move over
+// the choices, confirm (Enter, the confirm button, a click) chooses, back
+// (Esc, the back button) leaves.
+//
+// Screens run inside one another's pause: a notice or the keyboard opened from
+// a choice keeps the game paused until the outermost screen returns.
+#include "ui/dialog_skin.hpp"
+#include "ui/text_input.hpp"
+
+#include <cstddef>
+#include <functional>
+#include <optional>
+#include <string>
+#include <vector>
+
+namespace portablekit::ui {
+
+struct ChoiceView {
+    std::string title;
+    std::string prompt;
+    std::vector<ChoiceSkinItem> items;
+};
+
+// `step` fills the view before every interface frame (a detail may change, a
+// count come in). Returns the index of the choice made, or -1 when the player
+// backed out, the window closed, or there is no interface.
+int choose_over_game(const std::function<void(ChoiceView &)> &step, std::size_t selected = 0);
+
+// A message with OK. `text` is asked before every frame, so it can change as
+// something finishes. Returns when the player confirms (or backs out).
+void notice_over_game(const std::function<std::string()> &text);
+
+// The keyboard over the paused game, in the game's look when the port has one
+// (TextInputRequest::game_look is set): the text after OK, nullopt after
+// Cancel or without an interface.
+std::optional<std::string> type_over_game(TextInputRequest request);
+
+} // namespace portablekit::ui
