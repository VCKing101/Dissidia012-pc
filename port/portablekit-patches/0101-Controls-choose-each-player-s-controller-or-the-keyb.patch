diff --git a/host/input/players.cpp b/host/input/players.cpp
new file mode 100644
index 0000000..47a90f8
--- /dev/null
+++ b/host/input/players.cpp
@@ -0,0 +1,137 @@
+#include "input/players.hpp"
+
+#include <algorithm>
+#include <cstdio>
+
+namespace portablekit::input {
+
+std::string gamepad_model(std::uint16_t vendor, std::uint16_t product) {
+    char text[16];
+    std::snprintf(text, sizeof text, "%04x%04x", static_cast<unsigned>(vendor), static_cast<unsigned>(product));
+    return text;
+}
+
+std::string format_player_device(const PlayerDevice &device) {
+    switch (device.choice) {
+    case DeviceChoice::Keyboard: return "keyboard";
+    case DeviceChoice::Gamepad: return "pad:" + device.model + ":" + device.name;
+    case DeviceChoice::Automatic: break;
+    }
+    return "auto";
+}
+
+bool parse_player_device(std::string_view text, PlayerDevice &device) {
+    if (text == "auto") {
+        device = PlayerDevice{};
+        return true;
+    }
+    if (text == "keyboard") {
+        device = PlayerDevice{DeviceChoice::Keyboard, {}, {}};
+        return true;
+    }
+    constexpr std::string_view kPad = "pad:";
+    if (!text.starts_with(kPad)) return false;
+    text.remove_prefix(kPad.size());
+    const std::size_t colon = text.find(':');
+    const std::string_view model = text.substr(0, colon);
+    if (model.empty()) return false;
+    device = PlayerDevice{DeviceChoice::Gamepad, std::string(model),
+                          colon == std::string_view::npos ? std::string{} : std::string(text.substr(colon + 1))};
+    return true;
+}
+
+namespace {
+
+struct Pool {
+    std::span<const ConnectedPad> pads;
+    std::uint32_t taken1{};
+    std::uint32_t taken2{};
+
+    [[nodiscard]] bool connected(std::uint32_t id) const {
+        return id != 0u && std::any_of(pads.begin(), pads.end(), [&](const ConnectedPad &p) { return p.id == id; });
+    }
+    [[nodiscard]] bool free(std::uint32_t id) const { return connected(id) && id != taken1 && id != taken2; }
+
+    // The gamepad of kind `model`: `keep` if it is one, else the first free.
+    [[nodiscard]] std::uint32_t by_model(const std::string &model, std::uint32_t keep) const {
+        for (const ConnectedPad &p : pads)
+            if (p.id == keep && p.model == model && free(p.id)) return p.id;
+        for (const ConnectedPad &p : pads)
+            if (p.model == model && free(p.id)) return p.id;
+        return 0u;
+    }
+};
+
+} // namespace
+
+PadAssignment assign_pads(const PadSituation &s) {
+    PadAssignment out;
+    Pool pool{s.pads};
+    const bool p1_keyboard = s.player1.choice == DeviceChoice::Keyboard;
+    out.keyboard_player2 = s.second_wanted && s.player2.choice == DeviceChoice::Keyboard && !p1_keyboard;
+
+    // Gamepads chosen by name first: they are that player's even while the
+    // other is on Automatic. Player 2's is kept for player 2 while player 2
+    // is not wanted, though not read.
+    if (s.player1.choice == DeviceChoice::Gamepad) pool.taken1 = pool.by_model(s.player1.model, s.current1);
+    std::uint32_t reserved2 = 0u;
+    if (s.player2.choice == DeviceChoice::Gamepad) {
+        reserved2 = pool.by_model(s.player2.model, s.current2);
+        pool.taken2 = reserved2;
+    }
+
+    // Player 1 on Automatic, or a chosen gamepad not connected.
+    if (pool.taken1 == 0u && !p1_keyboard) {
+        const auto script = std::find_if(s.pads.begin(), s.pads.end(),
+                                         [&](const ConnectedPad &p) { return p.script1 && pool.free(p.id); });
+        const auto own = [&](std::uint32_t id) {
+            const auto pad = std::find_if(s.pads.begin(), s.pads.end(), [&](const ConnectedPad &p) { return p.id == id; });
+            return pad != s.pads.end() && !pad->script2 && pool.free(id);
+        };
+        if (script != s.pads.end()) {
+            pool.taken1 = script->id;
+        } else if (own(s.current1)) {
+            pool.taken1 = s.current1;
+        } else {
+            // A gamepad nobody has; then, unless player 2 is playing,
+            // player 2's own.
+            const bool player2s_own = s.second_wanted && s.current2 != 0u && s.player2.choice != DeviceChoice::Gamepad;
+            for (const ConnectedPad &p : s.pads)
+                if (own(p.id) && !(player2s_own && p.id == s.current2)) {
+                    pool.taken1 = p.id;
+                    break;
+                }
+            // An input script's second pad too: it was player 2's, and is
+            // only moving up.
+            if (pool.taken1 == 0u && player2s_own && !s.second_playing && pool.free(s.current2))
+                pool.taken1 = s.current2;
+        }
+    }
+    out.player1 = pool.taken1;
+
+    if (!s.second_wanted) return out;
+    out.player2 = reserved2;
+    // Player 2 on Automatic, or a chosen gamepad not connected.
+    if (out.player2 == 0u && !out.keyboard_player2) {
+        const auto script = std::find_if(s.pads.begin(), s.pads.end(),
+                                         [&](const ConnectedPad &p) { return p.script2 && pool.free(p.id); });
+        const auto own = [&](std::uint32_t id) {
+            const auto pad = std::find_if(s.pads.begin(), s.pads.end(), [&](const ConnectedPad &p) { return p.id == id; });
+            return pad != s.pads.end() && !pad->script1 && pool.free(id);
+        };
+        if (script != s.pads.end()) {
+            out.player2 = script->id;
+        } else if (own(s.current2)) {
+            out.player2 = s.current2;
+        } else {
+            for (const ConnectedPad &p : s.pads)
+                if (own(p.id)) {
+                    out.player2 = p.id;
+                    break;
+                }
+        }
+    }
+    return out;
+}
+
+} // namespace portablekit::input
diff --git a/host/input/players.hpp b/host/input/players.hpp
new file mode 100644
index 0000000..191ddf0
--- /dev/null
+++ b/host/input/players.hpp
@@ -0,0 +1,75 @@
+#pragma once
+
+// Which device each player plays on (Controls > Player 1 and Player 2,
+// input.player1 and input.player2): the gamepads the renderer finds, and the
+// keyboard with the mouse. No SDL here: the renderer lists the pads it sees
+// and opens the ones assign_pads() gives each player.
+
+#include <cstdint>
+#include <span>
+#include <string>
+#include <string_view>
+
+namespace portablekit::input {
+
+// A player's choice. Automatic: player 1 gets the keyboard and the first
+// gamepad free, player 2 the next gamepad. Keyboard: the keyboard and mouse
+// alone. Gamepad: a gamepad of that model, the first of them free when two
+// are alike; while none is connected, the player is on Automatic.
+enum class DeviceChoice : std::uint8_t { Automatic, Keyboard, Gamepad };
+
+struct PlayerDevice {
+    DeviceChoice choice{DeviceChoice::Automatic};
+    // Gamepad: its USB vendor and product ids, 8 hex digits ("054c0ce6"), the
+    // same over USB and Bluetooth.
+    std::string model;
+    std::string name;  // Gamepad: its name, shown while it is not connected
+    bool operator==(const PlayerDevice &) const = default;
+};
+
+// A gamepad's model as PlayerDevice::model holds it.
+[[nodiscard]] std::string gamepad_model(std::uint16_t vendor, std::uint16_t product);
+
+// "auto", "keyboard", or "pad:<model>:<name>" (the name may hold colons).
+[[nodiscard]] std::string format_player_device(const PlayerDevice &device);
+[[nodiscard]] bool parse_player_device(std::string_view text, PlayerDevice &device);
+
+// A gamepad connected, in the order SDL lists them.
+struct ConnectedPad {
+    std::uint32_t id{};  // SDL_JoystickID, never 0
+    std::string model;
+    // An input script's virtual pad (ui/input_script.hpp): its first is
+    // player 1's and its second player 2's over any real pad, unless the
+    // player chose a gamepad by name.
+    bool script1{};
+    bool script2{};
+};
+
+struct PadSituation {
+    std::span<const ConnectedPad> pads;
+    PlayerDevice player1;
+    PlayerDevice player2;
+    // The port wants a second player's pad (VulkanRenderer::set_second_pad_wanted).
+    bool second_wanted{};
+    // Player 2 is playing (set_second_player_playing): player 2's gamepad
+    // stays player 2's when player 1's goes. Otherwise it moves to player 1,
+    // who has none, as a gamepad does when player 2 is not wanted.
+    bool second_playing{};
+    // The gamepads each player has now (0 for none), kept while they can be.
+    std::uint32_t current1{};
+    std::uint32_t current2{};
+};
+
+struct PadAssignment {
+    std::uint32_t player1{};  // 0: no gamepad
+    std::uint32_t player2{};  // 0: no gamepad
+    // The keyboard and mouse are player 2's, not player 1's. Only while a
+    // second player is wanted: otherwise they are player 1's whatever
+    // player 2's choice.
