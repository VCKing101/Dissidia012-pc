 int cycle(int value, int delta, int count) { return ((value + delta) % count + count) % count; }
 
+// What a player can play on (Controls > Player 1 and Player 2): Automatic,
+// the keyboard and mouse, each model of gamepad connected, and the one
+// chosen while none of it is.
+struct DeviceOption {
+    input::PlayerDevice device;
+    std::string label;
+    bool missing{};  // a gamepad chosen and not connected
+};
+
+bool same_device(const input::PlayerDevice &a, const input::PlayerDevice &b) {
+    return a.choice == b.choice && (a.choice != input::DeviceChoice::Gamepad || a.model == b.model);
+}
+
+std::vector<DeviceOption> device_options(const input::PlayerDevice &chosen) {
+    std::vector<DeviceOption> list{{input::PlayerDevice{}, "Automatic"},
+                                   {input::PlayerDevice{input::DeviceChoice::Keyboard, {}, {}}, "Keyboard and mouse"}};
+    int count = 0;
+    if (SDL_JoystickID *ids = SDL_GetGamepads(&count); ids != nullptr) {
+        for (int i = 0; i < count; ++i) {
+            const char *name = SDL_GetGamepadNameForID(ids[i]);
+            input::PlayerDevice pad{input::DeviceChoice::Gamepad,
+                                    input::gamepad_model(SDL_GetGamepadVendorForID(ids[i]),
+                                                         SDL_GetGamepadProductForID(ids[i])),
+                                    name != nullptr ? name : "Gamepad"};
+            // Two alike are one choice: each player who chooses it gets one.
+            if (std::any_of(list.begin(), list.end(), [&](const DeviceOption &o) { return same_device(o.device, pad); }))
+                continue;
+            std::string label = pad.name;
+            list.push_back({std::move(pad), std::move(label)});
+        }
+        SDL_free(ids);
+    }
+    if (std::none_of(list.begin(), list.end(), [&](const DeviceOption &o) { return same_device(o.device, chosen); }))
+        list.push_back({chosen, (chosen.name.empty() ? std::string("Gamepad") : chosen.name) + " (not connected)", true});
+    return list;
+}
+
+// A player's device row. On Automatic, and for a gamepad not connected, it
+// says what the player has now (`now`: a gamepad's name, "keyboard and
+// mouse", "none", or empty while there is no such player).
+void device_row(const char *label, const char *key, input::PlayerDevice &device, const std::string &now,
+                std::string description) {
+    const std::vector<DeviceOption> options = device_options(device);
+    int at = 0;
+    for (std::size_t i = 0; i < options.size(); ++i)
+        if (same_device(options[i].device, device)) at = static_cast<int>(i);
+    std::string value = options[static_cast<std::size_t>(at)].label;
+    if (device.choice == input::DeviceChoice::Automatic && !now.empty()) value += ": " + now;
+    if (options[static_cast<std::size_t>(at)].missing && !now.empty() && now != "none") value += ", using " + now;
+    if (const int delta = choice_row(label, value, options_for(key, std::move(description)))) {
+        device = options[static_cast<std::size_t>(cycle(at, delta, static_cast<int>(options.size())))].device;
+        settings::save();
+    }
+}
