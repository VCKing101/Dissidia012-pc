+              parse_player_device("auto", parsed) && parsed == PlayerDevice{} && !parse_player_device("pad:", parsed) &&
+              !parse_player_device("mouse", parsed),
+          "keyboard and auto read; a pad with no id and anything else do not");
+
+    const PlayerDevice automatic{};
