+    const PlayerDevice dualsense{DeviceChoice::Gamepad, "ds", "DualSense"};
+    const PlayerDevice xbox{DeviceChoice::Gamepad, "xb", "Xbox"};
+    const ConnectedPad ds{1u, "ds"};
+    const ConnectedPad xb{2u, "xb"};
+    const ConnectedPad ds2{3u, "ds"};
+    const auto assign = [](std::initializer_list<ConnectedPad> list, PlayerDevice one, PlayerDevice two, bool wanted,
