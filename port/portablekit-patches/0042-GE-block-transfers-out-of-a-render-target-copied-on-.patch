+std::uint64_t VulkanRenderer::Impl::key_over_transfers(const GuestMemory &memory, const TextureState &texture,
+                                                       std::uint64_t key) const {
+    const std::uint32_t bits = texture_bits_per_pixel(texture.format);
+    const std::uint32_t row = std::max<std::uint32_t>(texture.buffer_width, texture.width);
+    if (texture.height == 0u || row == 0u) return key;
+    const std::uint32_t start = GuestMemory::canonical(texture.address);
+    const std::uint32_t bytes = static_cast<std::uint32_t>(
+        (static_cast<std::uint64_t>(row) * (texture.height - 1u) + texture.width) * bits / 8u);
+    bool over = false;
+    for (const TransferRange &range : transfer_ranges)
+        over = over || (start < range.end && range.start < start + bytes);
+    if (!over) return key;
+    const std::uint8_t *data = memory.raw_pointer(texture.address, bytes);
+    if (data == nullptr) return key;
+    std::uint64_t lanes[4] = {key, key ^ 0x9E3779B97F4A7C15ull, key ^ 0xC2B2AE3D27D4EB4Full,
+                              key ^ 0x165667B19E3779F9ull};
+    std::uint32_t offset = 0u;
+    for (; offset + 32u <= bytes; offset += 32u) {
+        for (int lane = 0; lane < 4; ++lane) {
+            std::uint64_t word{};
+            std::memcpy(&word, data + offset + static_cast<std::uint32_t>(lane) * 8u, sizeof(word));
+            lanes[lane] = (lanes[lane] ^ word) * 0x100000001B3ull;
+        }
+    }
+    for (; offset < bytes; ++offset) lanes[0] = (lanes[0] ^ data[offset]) * 0x100000001B3ull;
+    std::uint64_t mixed = lanes[0];
+    for (int lane = 1; lane < 4; ++lane) mixed = (mixed ^ lanes[lane]) * 0x100000001B3ull;
+    return mixed;
+}
