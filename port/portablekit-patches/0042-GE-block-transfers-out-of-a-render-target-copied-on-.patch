 namespace {
 
+// Every byte of guest pixels x0..x1, y0..y1 of a buffer at `base` with rows
+// of `stride` pixels of `bytes_per_pixel`; 0 when they are not all in guest
+// memory.
+std::uint64_t hash_guest_rect(const GuestMemory &memory, std::uint32_t base, std::uint32_t stride,
+                              std::uint32_t bytes_per_pixel, const std::array<std::uint32_t, 4> &rect) {
+    std::uint64_t lanes[4] = {0xCBF29CE484222325ull, 0x9E3779B97F4A7C15ull, 0xC2B2AE3D27D4EB4Full,
+                              0x165667B19E3779F9ull};
+    const std::size_t row_bytes = static_cast<std::size_t>(rect[2] - rect[0]) * bytes_per_pixel;
+    for (std::uint32_t y = rect[1]; y < rect[3]; ++y) {
+        const std::uint32_t at = base + (y * stride + rect[0]) * bytes_per_pixel;
+        const std::uint8_t *row = memory.raw_pointer(at, row_bytes);
+        if (row == nullptr) return 0u;
+        std::size_t offset = 0;
+        for (; offset + 32u <= row_bytes; offset += 32u) {
+            for (int lane = 0; lane < 4; ++lane) {
+                std::uint64_t word{};
+                std::memcpy(&word, row + offset + static_cast<std::size_t>(lane) * 8u, sizeof(word));
+                lanes[lane] = (lanes[lane] ^ word) * 0x100000001B3ull;
+            }
+        }
+        for (; offset < row_bytes; ++offset) lanes[0] = (lanes[0] ^ row[offset]) * 0x100000001B3ull;
+    }
+    std::uint64_t hash = lanes[0];
+    for (int lane = 1; lane < 4; ++lane) hash = (hash ^ lanes[lane]) * 0x100000001B3ull;
+    return hash == 0u ? 1u : hash;
+}
+
 // 480x272 RGBA pixels (red in the low byte) into guest framebuffer rows of
 // `stride` pixels in `format`: 8888 copied, the 16-bit formats packed a row at
 // a time into a buffer the compiler vectorises. The same bits as the
@@ -8501,6 +8619,174 @@ void store_rows(std::uint8_t *out, std::uint32_t stride, std::uint32_t format, c
 
 } // namespace
 
+bool VulkanRenderer::Impl::transfer_target_unchanged(const GuestMemory &memory, Target &target) {
+    // Guest memory cannot change while a display list is walked.
+    if (target.transfer_checked_list != display_lists || display_lists == 0u) {
+        target.transfer_checked_list = display_lists;
+        target.transfer_unchanged =
+            hash_guest_rect(memory, target.address, target.stride, framebuffer_bytes_per_pixel(target.format),
+                            target.transfer_rect) == target.transfer_hash;
+    }
+    return target.transfer_unchanged;
+}
+
+// After a GE block transfer has copied guest memory (block_transfer() in
+// hle_media.cpp): when it copied pixels of a render target, the same pixels
+// are copied on the GPU, at the internal scale, into a target that stands
+// for the destination, so a texture the game draws from the copy (a capture
+// of the screen behind a cut-in, say) samples the render instead of the 1x
+// picture read_back_framebuffer() left in guest memory. The source target's
+// pixels as they are now, in command order: a later draw into it changes
+// nothing here, and a draw recorded for frame interpolation samples a
+// snapshot of the copy as for any target. Guest memory keeps the 1x copy, for
+// the game's own reads, and the copy is used only while every byte of it is
+// unchanged (find_framebuffer_texture()). Into another target the game draws
+// to, nothing is copied (guest memory changes, the target does not, as
+// before). Textures over the latest transfers' destinations are keyed by
+// every byte (texture_for()), so a changed copy is never drawn from an older
+// decode. <prefix>_NO_TRANSFER_TARGETS copies in guest memory only;
+// <prefix>_TRANSFER_SAMPLED_KEY keys those textures by a word in 256, as
+// before; <prefix>_TRACE_TRANSFERS logs each transfer.
+void VulkanRenderer::copy_block_transfer(const BlockTransfer &transfer, const GuestMemory &memory) {
+    Impl &impl = *impl_;
+    if (!impl.ready) return;
+    static const bool trace = portablekit::env("TRACE_TRANSFERS") != nullptr;
+    static const bool sampled_key = portablekit::env("TRANSFER_SAMPLED_KEY") != nullptr;
+    static const bool disabled =
+        portablekit::env("NO_TRANSFER_TARGETS") != nullptr || portablekit::env("NO_FB_TEXTURES") != nullptr;
+    const std::uint32_t bytes_per_pixel = transfer.bytes_per_pixel;
+    const std::uint32_t destination = GuestMemory::canonical(transfer.destination);
+    const std::uint32_t source = GuestMemory::canonical(transfer.source);
+    if (!sampled_key && bytes_per_pixel != 0u && transfer.width != 0u && transfer.height != 0u) {
+        const std::uint32_t start =
+            destination + (transfer.destination_y * transfer.destination_stride + transfer.destination_x) *
+                              bytes_per_pixel;
+        const std::uint32_t end =
+            start + ((transfer.height - 1u) * transfer.destination_stride + transfer.width) * bytes_per_pixel;
+        auto &ranges = impl.transfer_ranges;
+        ranges.erase(std::remove_if(ranges.begin(), ranges.end(),
+                                    [&](const Impl::TransferRange &range) { return range.start == start; }),
+                     ranges.end());
+        if (ranges.size() >= 16u) ranges.erase(ranges.begin());
+        ranges.push_back({start, end});
+    }
+    const auto log = [&](const char *outcome) {
+        if (!trace) return;
+        std::cout << "[transfer] frame " << impl.frames << " 0x" << std::hex << source << std::dec << " ("
+                  << transfer.source_x << "," << transfer.source_y << " row " << transfer.source_stride << ") -> 0x"
+                  << std::hex << destination << std::dec << " (" << transfer.destination_x << ","
+                  << transfer.destination_y << " row " << transfer.destination_stride << ") " << transfer.width << "x"
+                  << transfer.height << " x" << bytes_per_pixel << ": " << outcome << "\n";
+    };
+    if (disabled) return log("guest memory only (switched off)");
+
+    // The source: a target the transfer reads with its own row length and
+    // pixel size.
+    const auto holding = [&](std::uint32_t address) -> Impl::Target * {
+        for (auto &[base_address, target] : impl.targets) {
+            if (!target.initialized) continue;
+            const std::uint32_t base = GuestMemory::canonical(base_address);
+            const std::uint32_t bytes = target.stride * kPspHeight * framebuffer_bytes_per_pixel(target.format);
+            if (address >= base && address - base < bytes) return &target;
+        }
+        return nullptr;
+    };
+    Impl::Target *from = holding(source);
+    if (from == nullptr || from->guest_words.empty()) return log("not from a render target");
+    if (from->from_transfer && !impl.transfer_target_unchanged(memory, *from))
+        return log("from a copy whose memory has changed");
+    const std::uint32_t from_base = GuestMemory::canonical(from->address);
+    if (transfer.source_stride != from->stride || bytes_per_pixel != framebuffer_bytes_per_pixel(from->format) ||
+        (source - from_base) % bytes_per_pixel != 0u)
+        return log("another row length or pixel size than its target");
+    const std::uint32_t from_row = from->stride * bytes_per_pixel;
+    const std::uint32_t from_x = (source - from_base) % from_row / bytes_per_pixel + transfer.source_x;
+    const std::uint32_t from_y = (source - from_base) / from_row + transfer.source_y;
+    // Both rectangles within the 480x272 a target holds.
+    const std::uint32_t to_x = transfer.destination_x;
+    const std::uint32_t to_y = transfer.destination_y;
+    if (from_x >= kPspWidth || from_y >= kPspHeight || to_x >= kPspWidth || to_y >= kPspHeight)
+        return log("outside the 480x272 a target holds");
+    const std::uint32_t width = std::min({transfer.width, kPspWidth - from_x, kPspWidth - to_x});
+    const std::uint32_t height = std::min({transfer.height, kPspHeight - from_y, kPspHeight - to_y});
+    if (width == 0u || height == 0u || transfer.destination_stride < to_x + width)
+        return log("an empty or ragged rectangle");
+
+    // The destination: its own transfer target, or none when it lies in a
+    // target the game draws to.
+    Impl::Target *to = nullptr;
+    if (const auto found = impl.targets.find(destination);
+        found != impl.targets.end() && found->second.from_transfer)
+        to = &found->second;
+    if (to == nullptr) {
+        if (Impl::Target *other = holding(destination); other != nullptr && !other->from_transfer)
+            return log("into a render target: guest memory only");
+        std::size_t count = 0u;
+        for (const auto &[address, target] : impl.targets) count += target.from_transfer ? 1u : 0u;
+        if (count >= 4u) return log("four transfer targets already: guest memory only");
+    }
+    if (to == from) return log("within one target: guest memory only");
+    if (!impl.recording) begin_frame();
+    std::string error;
+    if (to == nullptr) {
+        to = impl.target_for(destination, error);
+        if (to == nullptr) return log("no target could be made");
+        to->from_transfer = true;
+    }
+    // Copied as the source's colour (with its alpha brought up from the
+    // stencil) now holds it.
+    if (from->stencil_sync == Impl::Target::StencilSync::StencilNewer) impl.bring_alpha_up_to_date(*from);
+    impl.end_pass();
+    impl.initialize_layouts(impl.command_buffer, *to);
+    const VkExtent2D extent = impl.target_extent;
+    const auto scaled_x = [&](std::uint32_t x) {
+        return static_cast<std::int32_t>(static_cast<std::uint64_t>(x) * extent.width / kPspWidth);
+    };
+    const auto scaled_y = [&](std::uint32_t y) {
+        return static_cast<std::int32_t>(static_cast<std::uint64_t>(y) * extent.height / kPspHeight);
+    };
+    impl.transition(impl.command_buffer, from->color, VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL,
+                    VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+    impl.transition(impl.command_buffer, to->color, VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL,
+                    VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+    VkImageBlit blit{};
+    blit.srcSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0u, 0u, 1u};
+    blit.dstSubresource = blit.srcSubresource;
+    blit.srcOffsets[0] = {scaled_x(from_x), scaled_y(from_y), 0};
+    blit.srcOffsets[1] = {scaled_x(from_x + width), scaled_y(from_y + height), 1};
+    blit.dstOffsets[0] = {scaled_x(to_x), scaled_y(to_y), 0};
+    blit.dstOffsets[1] = {scaled_x(to_x + width), scaled_y(to_y + height), 1};
+    vkCmdBlitImage(impl.command_buffer, from->color, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, to->color,
+                   VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1u, &blit, VK_FILTER_NEAREST);
+    perf::count_target_copy();
+    impl.transition(impl.command_buffer, from->color, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+                    VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL);
+    impl.transition(impl.command_buffer, to->color, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+                    VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL);
+
+    // The picture is the rectangle copied, or the earlier one it lies in;
+    // anything else (another layout, pieces that make no rectangle) starts
+    // it again.
+    std::array<std::uint32_t, 4> &rect = to->transfer_rect;
+    const std::array<std::uint32_t, 4> copied{to_x, to_y, to_x + width, to_y + height};
+    const bool same_layout = to->stride == transfer.destination_stride && to->format == from->format;
+    const bool inside = copied[0] >= rect[0] && copied[1] >= rect[1] && copied[2] <= rect[2] && copied[3] <= rect[3];
+    if (!same_layout || !inside) rect = copied;
+    to->stride = transfer.destination_stride;
+    to->format = from->format;
+    to->stencil_sync = Impl::Target::StencilSync::AlphaNewer;
+    to->last_drawn_frame = impl.frames;
+    to->draw_serial = ++impl.target_draw_counter;
+    to->drawn_right = rect[2];
+    to->drawn_bottom = rect[3];
+    impl.snapshot_guest_words(memory, destination, *to);
+    to->transfer_hash = hash_guest_rect(memory, destination, to->stride, bytes_per_pixel, rect);
+    to->transfer_checked_list = impl.display_lists;
+    to->transfer_unchanged = to->transfer_hash != 0u;
+    census::note_renderer("transfer.gpu_copy");
+    log("copied on the GPU at the internal scale");
+}
+
