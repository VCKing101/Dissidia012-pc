+// <prefix>_PERF_CSV=<file>: one CSV row per present and one per game frame
+// (flip), for frame-time statistics over a scripted run (1% lows, dips,
+// hitches and what caused them). Off, every note below is one test of a flag.
+// Present rows: when, the time since the present before, what it showed
+// (PresentKind), the blend fraction, the grid moments skipped before it, how
+// late it was and the rate. Frame rows: the frame's guest, render, wait,
+// pacing and GPU time, and what happened in it: pipelines created and their
+// time, pipelines the prewarm had ready, textures decoded and their time,
+// texture-key hashing time, render-target snapshots and their size,
+// interpolation's pairing (cut reason, matched of eligible draws) and the
+// presents it could not make. The input script's `scene NAME` is a column.
+[[nodiscard]] bool csv_enabled() noexcept;
+enum class PresentKind : std::uint8_t {
+    Flip,      // the game's frame at its flip, no interpolation
+    Blended,   // an in-between frame drawn by interpolation
+    Newest,    // the newer frame as it is (a present on a frame's own moment)
+    Older,     // the older frame as it is (t = 0)
+    Cut,       // interpolation refused: a camera cut, unmatched draws, no frame before
+    Textures,  // a texture the older frame drew was dropped
+    Other,
+};
+// The present about to be counted (count_present) showed `kind`.
+void note_present(PresentKind kind, float t, std::uint32_t skipped, double late_ms) noexcept;
+// A present due that was not made: the display had no image free
+// (`blocked`), or the presents made while the game's code ran had taken half
+// a frame (`over budget`).
+void note_missed_present(bool blocked) noexcept;
+void note_pipeline_created(double milliseconds) noexcept;
+void note_pipeline_prewarmed() noexcept;
+void note_texture_decoded(double milliseconds) noexcept;
+void note_texture_key(double milliseconds) noexcept;
+void note_snapshot(std::uint64_t bytes) noexcept;
+void note_pairing(const char *cut, std::uint32_t matched, std::uint32_t eligible) noexcept;
+// When the next present between flips is due (steady clock, microseconds;
+// 0: none), for <prefix>_TRACE_STALL_SAMPLES=present, which samples the
+// emulation thread while a present is overdue.
+void note_present_due(std::int64_t steady_us) noexcept;
+// The scene the input script names (also the census's).
+void set_scene(const std::string &name);
+
 // Frame times in milliseconds, a ring written at `history_cursor()`.
 inline constexpr std::size_t kHistoryFrames = 192u;
 [[nodiscard]] const std::array<float, kHistoryFrames> &frame_history();
