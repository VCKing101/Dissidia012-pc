+    double pipeline_ms{};
+    double pipeline_max_ms{};
+    std::uint32_t prewarmed{};
+    std::uint32_t textures{};
+    double texture_ms{};
+    double key_ms{};
+    std::uint32_t snapshots{};
+    std::uint64_t snapshot_bytes{};
+    std::uint32_t presents{};
