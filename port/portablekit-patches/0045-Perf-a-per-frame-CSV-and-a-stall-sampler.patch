+namespace {
+
+#if defined(_WIN32)
+// <prefix>_TRACE_STALL_SAMPLES[=ms]: while a game frame (flip to flip) has
+// taken longer than the threshold (default 50 ms), a thread of its own
+// samples the emulation thread's host stack every few milliseconds; the next
+// flip prints the commonest stacks as [stall-sample] lines, module+offset or
+// with names when the program's PDB is next to it. For finding out what a
+// long frame was busy with when the frame statistics cannot say. Windows only.
+//
+// The emulation thread is stopped only to copy its registers and the top of
+// its stack; the walk and the names are worked out after it runs again, so
+// the sampler never waits on a lock the stopped thread holds.
+std::atomic<std::int64_t> &present_due_us() {
+    static std::atomic<std::int64_t> value{0};
+    return value;
+}
+
+class StallSampler {
+public:
+    static StallSampler *get() {
+        static StallSampler *sampler = [] () -> StallSampler * {
+            const char *text = portablekit::env("TRACE_STALL_SAMPLES");
+            if (text == nullptr) return nullptr;
+            auto *made = new StallSampler();
+            made->presents_ = std::strcmp(text, "present") == 0;
+            const double ms = std::strtod(text, nullptr);
+            made->threshold_ms_ = ms >= 5.0 ? ms : 50.0;
+            return made;
+        }();
+        return sampler;
+    }
+
+    // At every flip, on the emulation thread.
+    void flip(double frame_ms) {
+        if (guest_ == nullptr) {
+            DuplicateHandle(GetCurrentProcess(), GetCurrentThread(), GetCurrentProcess(), &guest_, 0, FALSE,
+                            DUPLICATE_SAME_ACCESS);
+            thread_ = std::thread([this] { run(); });
+            thread_.detach();
+        }
+        std::map<std::string, int> stacks;
+        int samples = 0;
+        {
+            std::lock_guard<std::mutex> guard(lock_);
+            stacks.swap(stacks_);
+            samples = samples_;
+            samples_ = 0;
+            frame_start_.store(std::chrono::steady_clock::now().time_since_epoch().count());
+        }
+        if (samples == 0) return;
+        std::vector<std::pair<int, std::string>> sorted;
+        for (auto &[stack, count] : stacks) sorted.emplace_back(count, stack);
+        std::sort(sorted.begin(), sorted.end(), [](const auto &a, const auto &b) { return a.first > b.first; });
+        std::printf("[stall-sample] a %.1f ms frame, %d samples past %.0f ms:\n", frame_ms, samples, threshold_ms_);
+        for (std::size_t i = 0; i < sorted.size() && i < 6u; ++i)
+            std::printf("[stall-sample]   x%d %s\n", sorted[i].first, sorted[i].second.c_str());
+        std::fflush(stdout);
+    }
+
+private:
+    static constexpr std::size_t kStackCopy = 256u * 1024u;
+
+    struct Copy {
+        std::uint64_t base{};
+        std::size_t size{};
+        std::vector<std::uint8_t> bytes = std::vector<std::uint8_t>(kStackCopy);
+    };
+    static Copy &copy() {
+        static Copy value;
+        return value;
+    }
+    static BOOL CALLBACK read_memory(HANDLE process, DWORD64 address, PVOID buffer, DWORD size, LPDWORD read) {
+        const Copy &c = copy();
+        if (address >= c.base && address + size <= c.base + c.size) {
+            std::memcpy(buffer, c.bytes.data() + (address - c.base), size);
+            if (read != nullptr) *read = size;
+            return TRUE;
+        }
+        SIZE_T done = 0;
+        const BOOL ok = ReadProcessMemory(process, reinterpret_cast<LPCVOID>(address), buffer, size, &done);
+        if (read != nullptr) *read = static_cast<DWORD>(done);
+        return ok;
+    }
+
+    std::string name(HANDLE process, DWORD64 pc) {
+        const DWORD64 base = SymGetModuleBase64(process, pc);
+        char module[MAX_PATH] = "?";
+        if (base != 0) {
+            char path[MAX_PATH]{};
+            GetModuleFileNameA(reinterpret_cast<HMODULE>(base), path, MAX_PATH);
+            const char *slash = std::strrchr(path, '\\');
+            std::snprintf(module, sizeof module, "%s", slash != nullptr ? slash + 1 : path);
+        }
+        alignas(SYMBOL_INFO) char buffer[sizeof(SYMBOL_INFO) + 256]{};
+        auto *symbol = reinterpret_cast<SYMBOL_INFO *>(buffer);
+        symbol->SizeOfStruct = sizeof(SYMBOL_INFO);
+        symbol->MaxNameLen = 255;
+        DWORD64 displacement = 0;
+        char text[400];
+        if (SymFromAddr(process, pc, &displacement, symbol))
+            std::snprintf(text, sizeof text, "%s!%s", module, symbol->Name);
+        else
+            std::snprintf(text, sizeof text, "%s+0x%llx", module, static_cast<unsigned long long>(pc - base));
+        return text;
+    }
+
+    void run() {
+        HANDLE process = GetCurrentProcess();
+        SymSetOptions(SYMOPT_UNDNAME | SYMOPT_DEFERRED_LOADS);
+        SymInitialize(process, nullptr, TRUE);
+        for (;;) {
+            Sleep(presents_ ? 1 : 4);
+            if (presents_) {
+                // A present more than 2 ms overdue.
+                const std::int64_t due = present_due_us().load();
+                const std::int64_t now = std::chrono::duration_cast<std::chrono::microseconds>(
+                                             std::chrono::steady_clock::now().time_since_epoch())
+                                             .count();
+                if (due == 0 || now < due + 2000) continue;
+            } else {
+                const auto start = std::chrono::steady_clock::time_point(
+                    std::chrono::steady_clock::duration(frame_start_.load()));
