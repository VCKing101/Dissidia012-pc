+MatchImage resample(const std::uint8_t *rgba, std::uint32_t from_width, std::uint32_t from_height,
+                    std::uint32_t width, std::uint32_t height) {
+    MatchImage out;
+    out.width = width;
+    out.height = height;
+    out.rgba.assign(static_cast<std::size_t>(width) * height * 4u, 0u);
+    if (rgba == nullptr || from_width == 0u || from_height == 0u || width == 0u || height == 0u) return out;
+    // Averaged with the colour weighted by alpha, so the colour of clear
+    // pixels does not bleed into the solid ones beside them.
+    const std::vector<Span> across = spans(from_width, width);
+    const std::vector<Span> down = spans(from_height, height);
+    std::vector<float> rows(static_cast<std::size_t>(width) * from_height * 4u, 0.0f);
+    for (std::uint32_t y = 0; y < from_height; ++y) {
+        const std::uint8_t *row = rgba + static_cast<std::size_t>(y) * from_width * 4u;
+        float *target = rows.data() + static_cast<std::size_t>(y) * width * 4u;
+        for (std::uint32_t x = 0; x < width; ++x) {
+            float r = 0.0f, g = 0.0f, b = 0.0f, a = 0.0f;
+            const Span &span = across[x];
+            for (std::size_t i = 0; i < span.weights.size(); ++i) {
+                const std::uint8_t *p = row + (span.first + i) * 4u;
+                const float w = span.weights[i];
+                const float alpha = p[3] * w;
+                r += p[0] * alpha;
+                g += p[1] * alpha;
+                b += p[2] * alpha;
+                a += alpha;
+            }
+            target[x * 4u + 0u] = r;
+            target[x * 4u + 1u] = g;
+            target[x * 4u + 2u] = b;
+            target[x * 4u + 3u] = a;
+        }
+    }
+    for (std::uint32_t y = 0; y < height; ++y) {
+        const Span &span = down[y];
+        for (std::uint32_t x = 0; x < width; ++x) {
+            float sum[4] = {};
+            for (std::size_t i = 0; i < span.weights.size(); ++i) {
+                const float *p = rows.data() + ((span.first + i) * width + x) * 4u;
+                for (int c = 0; c < 4; ++c) sum[c] += p[c] * span.weights[i];
+            }
+            std::uint8_t *q = out.rgba.data() + (static_cast<std::size_t>(y) * width + x) * 4u;
+            const float alpha = sum[3];
+            q[3] = static_cast<std::uint8_t>(std::clamp(alpha + 0.5f, 0.0f, 255.0f));
+            for (int c = 0; c < 3; ++c)
+                q[c] = alpha > 0.0f ? static_cast<std::uint8_t>(std::clamp(sum[c] / alpha + 0.5f, 0.0f, 255.0f)) : 0u;
+        }
+    }
+    return out;
+}
+
+void match_thumbnail_size(std::uint32_t width, std::uint32_t height, std::uint32_t &out_width,
+                          std::uint32_t &out_height) {
+    const std::uint32_t longer = std::max(width, height);
+    if (longer <= kThumbnailSide) {
+        out_width = width;
+        out_height = height;
+        return;
+    }
+    out_width = std::max(1u, width * kThumbnailSide / longer);
+    out_height = std::max(1u, height * kThumbnailSide / longer);
+}
+
+float match_score(const MatchImage &a, const MatchImage &b) {
+    if (a.width != b.width || a.height != b.height || a.rgba.size() != b.rgba.size()) return kNoScore;
+    std::size_t both = 0u, either = 0u;
+    std::uint64_t difference = 0u;
+    for (std::size_t i = 0; i < a.rgba.size(); i += 4u) {
+        const bool solid_a = a.rgba[i + 3u] >= kSolidAlpha;
+        const bool solid_b = b.rgba[i + 3u] >= kSolidAlpha;
+        if (!solid_a && !solid_b) continue;
+        ++either;
+        if (!solid_a || !solid_b) continue;
+        ++both;
+        for (std::size_t c = 0; c < 3u; ++c)
+            difference += static_cast<std::uint64_t>(std::abs(int(a.rgba[i + c]) - int(b.rgba[i + c])));
+    }
+    if (either == 0u) return kNoScore;
+    const float overlap = static_cast<float>(both) / static_cast<float>(either);
+    const float colour = both != 0u ? static_cast<float>(difference) / (3.0f * static_cast<float>(both)) : 100.0f;
+    return colour + 100.0f * (1.0f - overlap);
+}
+
+bool match_informative(const MatchImage &image) {
+    std::size_t solid = 0u;
+    double sum[3] = {}, squares[3] = {};
+    for (std::size_t i = 0; i < image.rgba.size(); i += 4u) {
+        if (image.rgba[i + 3u] < kSolidAlpha) continue;
+        ++solid;
+        for (std::size_t c = 0; c < 3u; ++c) {
+            const double v = image.rgba[i + c];
+            sum[c] += v;
+            squares[c] += v * v;
+        }
+    }
+    if (solid < kMinSolidPixels) return false;
+    double spread = 0.0;
+    for (int c = 0; c < 3; ++c) {
+        const double mean = sum[c] / static_cast<double>(solid);
+        spread = std::max(spread, std::sqrt(std::max(0.0, squares[c] / static_cast<double>(solid) - mean * mean)));
+    }
+    return spread >= kMinSpread;
+}
+
+void index_match_candidate(MatchCandidate &candidate, const std::uint8_t *rgba, std::uint32_t width,
+                           std::uint32_t height) {
+    candidate.width = width;
+    candidate.height = height;
+    candidate.signature = resample(rgba, width, height, kSignatureSide, kSignatureSide);
+    std::uint32_t thumb_width = 0u, thumb_height = 0u;
+    match_thumbnail_size(width, height, thumb_width, thumb_height);
+    candidate.thumbnail = resample(rgba, width, height, thumb_width, thumb_height);
+}
+
+MatchDecision match_texture(const std::vector<MatchCandidate> &candidates, const std::uint8_t *rgba,
+                            std::uint32_t width, std::uint32_t height, std::uint64_t cache_key) {
+    MatchDecision decision;
+    if (rgba == nullptr || width == 0u || height == 0u) return decision;
+    MatchImage native;
+    native.width = width;
+    native.height = height;
+    native.rgba.assign(rgba, rgba + static_cast<std::size_t>(width) * height * 4u);
+    decision.informative = match_informative(native);
+    if (!decision.informative) return decision;
+
+    const MatchImage signature = resample(rgba, width, height, kSignatureSide, kSignatureSide);
+    std::uint32_t thumb_width = 0u, thumb_height = 0u;
+    match_thumbnail_size(width, height, thumb_width, thumb_height);
+    const MatchImage thumbnail =
+        thumb_width == width && thumb_height == height ? native : resample(rgba, width, height, thumb_width, thumb_height);
+
+    // The shortlist: the closest signatures among images of the texture's
+    // shape whose keys can name it.
+    std::vector<std::pair<float, int>> ranked;
+    for (std::size_t i = 0; i < candidates.size(); ++i) {
+        const MatchCandidate &c = candidates[i];
+        if (c.width == 0u || static_cast<std::uint64_t>(c.width) * height != static_cast<std::uint64_t>(c.height) * width)
+            continue;
+        const bool named = std::any_of(c.prefixes.begin(), c.prefixes.end(),
+                                       [&](std::uint64_t prefix) {
+                                           // A key with no address half names the texture at any address.
+                                           return prefix == 0u || prefix == cache_key ||
+                                                  (prefix >> 32u == 0u && prefix == (cache_key & 0xFFFFFFFFull));
+                                       });
+        if (!named) continue;
+        ranked.emplace_back(match_score(signature, c.signature), static_cast<int>(i));
+    }
+    if (ranked.empty()) return decision;
+    const std::size_t shortlist = std::min(kShortlist, ranked.size());
+    std::partial_sort(ranked.begin(), ranked.begin() + static_cast<std::ptrdiff_t>(shortlist), ranked.end());
+
+    // Each again at thumbnail size.
+    std::vector<std::pair<float, int>> verified;
+    std::vector<MatchImage> sized(shortlist);
+    for (std::size_t i = 0; i < shortlist; ++i) {
+        const MatchCandidate &c = candidates[static_cast<std::size_t>(ranked[i].second)];
+        sized[i] = c.thumbnail.width == thumb_width && c.thumbnail.height == thumb_height
+                       ? c.thumbnail
+                       : resample(c.thumbnail.rgba.data(), c.thumbnail.width, c.thumbnail.height, thumb_width,
+                                  thumb_height);
+        verified.emplace_back(match_score(thumbnail, sized[i]), static_cast<int>(i));
+    }
+    std::sort(verified.begin(), verified.end());
+    const auto &[best_score, best_slot] = verified[0];
+    decision.closest = ranked[static_cast<std::size_t>(best_slot)].second;
+    decision.score = best_score;
+    if (verified.size() > 1u) {
+        decision.runner_up = verified[1].first;
+        decision.alike = match_score(sized[static_cast<std::size_t>(best_slot)],
+                                     sized[static_cast<std::size_t>(verified[1].second)]);
+    }
+    decision.recolour = recoloured_share(signature, candidates[static_cast<std::size_t>(decision.closest)].signature);
+    const bool clear = decision.runner_up >= kRunnerUpRatio * decision.score || decision.alike < kSamePicture;
+    if (decision.score < kScoreLimit && clear && decision.recolour <= kRecolourShare) decision.best = decision.closest;
+    return decision;
+}
+
+TexturePackMatcher::TexturePackMatcher(std::filesystem::path pack_folder, std::vector<MatchCandidate> images,
+                                       std::string pack_id, std::filesystem::path match_root, ImageReader reader)
+    : folder_(std::move(pack_folder)), candidates_(std::move(images)), pack_id_(std::move(pack_id)),
+      root_(std::move(match_root)), reader_(std::move(reader)) {
+    // Matches made before are known at once; only new textures wait for the
+    // index.
+    load_matches();
+    worker_ = std::thread([this] { worker_main(); });
+}
+
+TexturePackMatcher::~TexturePackMatcher() {
+    stopping_ = true;
+    {
+        std::lock_guard lock(mutex_);
+    }
+    wake_.notify_all();
+    worker_.join();
+}
+
+TexturePackMatcher::Known TexturePackMatcher::known(std::uint64_t cache_key, std::uint32_t data_hash,
+                                                    std::string &file) const {
+    std::lock_guard lock(mutex_);
+    if (const auto found = matches_.find({cache_key, data_hash}); found != matches_.end()) {
+        file = found->second;
+        return Known::Matched;
+    }
+    // Then at any address, then for any palette: the wildcard order of keys.
+    for (const std::uint64_t wider : {cache_key & 0xFFFFFFFFull, std::uint64_t{0u}}) {
+        if (const auto found = matches_.find({wider, data_hash}); found != matches_.end()) {
+            file = found->second;
+            return Known::Matched;
+        }
+    }
+    return unmatched_.count({cache_key, data_hash}) != 0u ? Known::Unmatched : Known::No;
+}
+
+namespace {
+
+std::uint64_t shape_of(std::uint32_t width, std::uint32_t height) {
+    const std::uint32_t divisor = std::max(1u, std::gcd(width, height));
+    return static_cast<std::uint64_t>(width / divisor) << 32u | (height / divisor);
+}
+
+} // namespace
+
+bool TexturePackMatcher::has_shape(std::uint32_t width, std::uint32_t height) const {
+    if (!ready_.load(std::memory_order_acquire)) return true;
+    return shapes_.count(shape_of(width, height)) != 0u;
+}
+
+bool TexturePackMatcher::submit(Job job) {
+    const std::size_t bytes = job.pixels.size() * sizeof(std::uint32_t);
+    {
+        std::lock_guard lock(mutex_);
+        if (queued_bytes_ + bytes > kMaxQueuedBytes) return false;
+        queued_bytes_ += bytes;
+        queue_.push_back(std::move(job));
+    }
+    wake_.notify_one();
+    return true;
+}
+
+void TexturePackMatcher::drain() {
+    std::unique_lock lock(mutex_);
+    idle_.wait(lock, [&] { return stopping_ || (ready_ && queue_.empty() && !busy_); });
+}
+
+std::string TexturePackMatcher::status() const {
+    if (!ready_) {
+        return "reading images to match: " + std::to_string(indexed_.load()) + " of " +
+               std::to_string(candidates_.size());
+    }
+    std::lock_guard lock(mutex_);
+    return std::to_string(matches_.size()) + " matched by picture";
+}
+
+void TexturePackMatcher::worker_main() {
+    const auto started = std::chrono::steady_clock::now();
+    load_index();
+    const std::size_t loaded = indexed_.load();
+    build_index();
+    if (stopping_) {
+        idle_.notify_all();
+        return;
+    }
+    if (indexed_.load() != loaded) save_index();
+    std::size_t unreadable = 0u;
+    for (const MatchCandidate &c : candidates_) {
+        unreadable += c.width == 0u ? 1u : 0u;
+        if (c.width != 0u) shapes_.insert(shape_of(c.width, c.height));
+    }
+    const double seconds = std::chrono::duration<double>(std::chrono::steady_clock::now() - started).count();
+    char took[32];
+    std::snprintf(took, sizeof(took), "%.1f", seconds);
+    std::cout << "[texpack] matching by picture: " << candidates_.size() << " images ready ("
+              << (indexed_.load() - loaded) << " read in " << took << " s"
+              << (unreadable != 0u ? ", " + std::to_string(unreadable) + " unreadable" : std::string()) << ")\n";
+    {
+        std::lock_guard lock(mutex_);
+        ready_ = true;
+    }
+    idle_.notify_all();
+
+    for (;;) {
+        Job job;
+        {
+            std::unique_lock lock(mutex_);
+            wake_.wait(lock, [&] { return stopping_ || !queue_.empty(); });
+            if (stopping_) break;
+            job = std::move(queue_.front());
+            queue_.pop_front();
+            queued_bytes_ -= std::min(queued_bytes_, job.pixels.size() * sizeof(std::uint32_t));
+            busy_ = true;
+        }
+        const MatchDecision decision =
+            match_texture(candidates_, reinterpret_cast<const std::uint8_t *>(job.pixels.data()), job.width,
+                          job.height, job.cache_key);
+        std::string file;
+        char key[32];
+        if (decision.best >= 0) {
+            const MatchCandidate &c = candidates_[static_cast<std::size_t>(decision.best)];
+            file = c.file;
+            // The match is kept in the form of the pack's key: with this
+            // texture's first half, with its dimension and palette at any
+            // address, or for any palette, so other palettes find it.
+            const std::uint64_t low = job.cache_key & 0xFFFFFFFFull;
+            const auto has = [&](std::uint64_t prefix) {
+                return std::find(c.prefixes.begin(), c.prefixes.end(), prefix) != c.prefixes.end();
+            };
+            const std::uint64_t kept = job.cache_key != 0u && has(job.cache_key) ? job.cache_key
+                                       : low != 0u && has(low)                    ? low
+                                                                                  : 0u;
+            format_key(key, kept, job.data_hash);
+            std::lock_guard lock(mutex_);
+            matches_[{kept, job.data_hash}] = file;
+            append_match_line("hashes", std::string(key) + " = " + file);
+        } else {
+            format_key(key, job.cache_key, job.data_hash);
+            std::lock_guard lock(mutex_);
+            unmatched_.insert({job.cache_key, job.data_hash});
+            // Only textures that were compared with something are saved: a
+            // texture no image has the shape of costs nothing to try again,
+            // and lines of text, new with every text, would fill the file.
+            if (decision.closest >= 0) append_match_line("unmatched", key);
+        }
+        if (texture_pack_trace()) {
+            char scores[96];
+            std::snprintf(scores, sizeof(scores), "%.1f, next %.1f, alike %.1f, recoloured %.0f%%", decision.score,
+                          decision.runner_up, decision.alike, 100.0f * decision.recolour);
+            format_key(key, job.cache_key, job.data_hash);
+            const std::string closest =
+                decision.closest >= 0 ? candidates_[static_cast<std::size_t>(decision.closest)].file : "-";
+            std::cout << "[texpack] " << key << " " << job.width << "x" << job.height
+                      << (decision.best >= 0         ? " matched " + file + " ("
+                          : !decision.informative    ? std::string(" not matched: too plain (")
+                                                     : " not matched: closest " + closest + " (")
+                      << (decision.informative ? scores : "-") << ")\n";
+        }
+        if (job.done) job.done(file);
+        {
+            std::lock_guard lock(mutex_);
+            busy_ = false;
+        }
+        idle_.notify_all();
+    }
+    idle_.notify_all();
+}
+
+void TexturePackMatcher::build_index() {
+    std::vector<std::size_t> missing;
+    for (std::size_t i = 0; i < candidates_.size(); ++i)
+        if (!candidates_[i].indexed) missing.push_back(i);
+    if (missing.empty()) return;
+    std::atomic<std::size_t> next{0};
+    const unsigned threads = std::clamp(std::thread::hardware_concurrency() / 4u, 1u, 3u);
+    std::vector<std::thread> readers;
+    for (unsigned t = 0; t < threads; ++t) {
+        readers.emplace_back([&] {
+            std::vector<std::uint8_t> rgba;
+            for (;;) {
+                if (stopping_) return;
+                const std::size_t at = next.fetch_add(1u);
+                if (at >= missing.size()) return;
+                MatchCandidate &c = candidates_[missing[at]];
+                std::uint32_t width = 0u, height = 0u;
+                if (reader_(c.file, rgba, width, height) && width != 0u && height != 0u)
+                    index_match_candidate(c, rgba.data(), width, height);
+                else
+                    c.width = c.height = 0u;
+                c.indexed = true;
+                indexed_.fetch_add(1u);
+            }
+        });
+    }
+    for (std::thread &reader : readers) reader.join();
+}
+
+void TexturePackMatcher::load_index() {
+    if (root_.empty()) return;
+    std::ifstream in(root_ / (pack_id_ + ".index"), std::ios::binary);
+    if (!in) return;
+    char magic[8] = {};
+    std::uint32_t version = 0u, count = 0u;
+    if (!in.read(magic, sizeof(magic)) || std::memcmp(magic, kIndexMagic, sizeof(magic)) != 0 || !get(in, version) ||
+        version != kIndexVersion || !get(in, count))
+        return;
+    std::unordered_map<std::string, std::size_t> by_name;
+    for (std::size_t i = 0; i < candidates_.size(); ++i) by_name.emplace(candidates_[i].file, i);
+    for (std::uint32_t n = 0; n < count; ++n) {
+        std::uint32_t name_length = 0u, width = 0u, height = 0u, thumb_width = 0u, thumb_height = 0u;
+        FileStamp saved;
+        if (!get(in, name_length) || name_length > 4096u) return;
+        std::string name(name_length, '\0');
+        if (!in.read(name.data(), name_length) || !get(in, saved.size) || !get(in, saved.time) || !get(in, width) ||
+            !get(in, height) || !get(in, thumb_width) || !get(in, thumb_height) || thumb_width > kThumbnailSide ||
+            thumb_height > kThumbnailSide)
+            return;
+        MatchCandidate entry;
+        entry.width = width;
+        entry.height = height;
+        if (width != 0u) {
+            entry.signature = {kSignatureSide, kSignatureSide,
+                               std::vector<std::uint8_t>(kSignatureSide * kSignatureSide * 4u)};
+            entry.thumbnail = {thumb_width, thumb_height,
+                               std::vector<std::uint8_t>(static_cast<std::size_t>(thumb_width) * thumb_height * 4u)};
+            if (!in.read(reinterpret_cast<char *>(entry.signature.rgba.data()),
+                         static_cast<std::streamsize>(entry.signature.rgba.size())) ||
+                !in.read(reinterpret_cast<char *>(entry.thumbnail.rgba.data()),
+                         static_cast<std::streamsize>(entry.thumbnail.rgba.size())))
+                return;
+        }
+        const auto found = by_name.find(name);
+        // An image changed since it was read is read again.
+        if (found == by_name.end() || !(stamp(folder_ / std::filesystem::path(name)) == saved)) continue;
+        MatchCandidate &c = candidates_[found->second];
+        c.width = entry.width;
+        c.height = entry.height;
+        c.signature = std::move(entry.signature);
+        c.thumbnail = std::move(entry.thumbnail);
+        c.indexed = true;  // unreadable ones too, so they are not tried again
+        indexed_.fetch_add(1u);
+    }
+}
+
+void TexturePackMatcher::save_index() const {
+    if (root_.empty()) return;
+    std::error_code ec;
+    std::filesystem::create_directories(root_, ec);
+    const std::filesystem::path path = root_ / (pack_id_ + ".index");
+    const std::filesystem::path temporary = root_ / (pack_id_ + ".index.part");
+    {
+        std::ofstream out(temporary, std::ios::binary | std::ios::trunc);
+        if (!out) return;
+        out.write(kIndexMagic, sizeof(kIndexMagic));
+        put(out, kIndexVersion);
+        put(out, static_cast<std::uint32_t>(candidates_.size()));
+        for (const MatchCandidate &c : candidates_) {
+            put(out, static_cast<std::uint32_t>(c.file.size()));
+            out.write(c.file.data(), static_cast<std::streamsize>(c.file.size()));
+            const FileStamp now = stamp(folder_ / std::filesystem::path(c.file));
+            put(out, now.size);
+            put(out, now.time);
+            put(out, c.width);
+            put(out, c.height);
+            const bool has = c.width != 0u;
+            put(out, has ? c.thumbnail.width : 0u);
+            put(out, has ? c.thumbnail.height : 0u);
+            if (has) {
+                out.write(reinterpret_cast<const char *>(c.signature.rgba.data()),
+                          static_cast<std::streamsize>(c.signature.rgba.size()));
+                out.write(reinterpret_cast<const char *>(c.thumbnail.rgba.data()),
+                          static_cast<std::streamsize>(c.thumbnail.rgba.size()));
+            }
+        }
+        if (!out) return;
+    }
+    std::filesystem::rename(temporary, path, ec);
+    if (ec) std::filesystem::remove(temporary, ec);
+}
+
+void TexturePackMatcher::load_matches() {
+    if (root_.empty()) return;
+    std::ifstream in(root_ / (pack_id_ + ".ini"));
+    std::string line, section;
+    while (std::getline(in, line)) {
+        line = trim(line);
+        if (line.empty() || line[0] == '#' || line[0] == ';') continue;
+        if (line.front() == '[') {
+            section = line;
+            continue;
+        }
+        std::uint64_t cache_key = 0u;
+        std::uint32_t data_hash = 0u;
+        if (section == "[hashes]") {
+            const std::size_t equals = line.find('=');
+            if (equals == std::string::npos || !parse_key(trim(line.substr(0, equals)), cache_key, data_hash)) continue;
+            matches_[{cache_key, data_hash}] = trim(line.substr(equals + 1u));
+        } else if (section == "[unmatched]" && parse_key(line, cache_key, data_hash)) {
+            unmatched_.insert({cache_key, data_hash});
+        }
+    }
+}
+
+void TexturePackMatcher::append_match_line(const std::string &section, const std::string &line) {
+    // Under mutex_. Each line goes under its section's header; the file may
+    // repeat headers, which readers of the format allow.
+    if (root_.empty()) return;
+    std::error_code ec;
+    std::filesystem::create_directories(root_, ec);
+    const std::filesystem::path path = root_ / (pack_id_ + ".ini");
+    const bool fresh = !std::filesystem::exists(path, ec);
+    std::ofstream out(path, std::ios::app);
+    if (!out) return;
+    if (fresh) {
+        out << "# Textures matched by picture to the images of a texture pack whose textures.ini uses\n"
+               "# hash = quick, in this program's keys. Delete this file to match them again.\n";
+        last_section_.clear();
+    }
+    if (last_section_ != section) {
+        out << "[" << section << "]\n";
+        last_section_ = section;
+    }
+    out << line << "\n";
+}
+
+} // namespace portablekit::gpu
