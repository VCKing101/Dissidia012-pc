+// Packs whose textures.ini says `hash = quick` were keyed with PPSSPP's first
+// hash, which this framework does not compute. Their keys' first halves (the
+// dimension and palette word, texture_pack.hpp) are the same as ours, but the
+// data halves cannot be found by hashing. Instead each texture the pack does
+// not already cover is matched to the pack's images by picture, the first
+// time the game draws it, and the match is kept:
+//
+//   1. Index: every image the pack names is shrunk once to a 16x16 signature
+//      and a thumbnail at most 64 pixels on its longer side (box filter). The
+//      index is saved, so only new or changed images are read again.
+//   2. Match: the game's texture is compared with the signatures of the images
+//      of its shape whose key's first half is its own, or zero; the four
+//      closest are compared again at thumbnail size.
+//   3. The closest is accepted only when it scores below 45 and the next is at
+//      least 1.7 times further off, or the next is the same picture; and when
+//      it is not a recolour: at signature size, where an upscale's redrawn
+//      detail is blurred away, at most 8% of the pixels may differ in chroma
+//      by more than 16. A texture in another costume's colours keeps its own
+//      picture rather than take the pack's image for the first colours.
+//
+// Two images of one size are scored over the pixels solid (alpha >= 128) in
+// either: the mean RGB difference where both are solid, plus 100 times the
+// share of those pixels solid in only one. Textures with fewer than 16 solid
+// pixels or nearly one colour are never matched. The limits were set on a
+// community pack of over two thousand images against dumps of a game's menus
+// and a battle, where every accepted match was right.
+//
+// A match to a key whose first half is zero (any palette) is kept as a
+// data-only key, so the texture's other palettes find it too, as such keys do
+// in the format. Matches are written to <match root>/<pack id>.ini as
+// `[hashes]` lines in this framework's keys; textures that matched nothing are
+// listed under `[unmatched]` and not compared again. Deleting the file matches
+// everything again.
+//
+// This file knows nothing about Vulkan or the GE.
+namespace portablekit::gpu {
+
+// An RGBA8 image, rows packed, red in the lowest byte.
+struct MatchImage {
+    std::uint32_t width{};
+    std::uint32_t height{};
+    std::vector<std::uint8_t> rgba;
+};
+
+// `rgba` (from_width x from_height) at width x height, each new pixel the
+// average of the area it covers.
+[[nodiscard]] MatchImage resample(const std::uint8_t *rgba, std::uint32_t from_width, std::uint32_t from_height,
+                                  std::uint32_t width, std::uint32_t height);
+// A thumbnail's size: the longer side at most 64, the shape kept.
+void match_thumbnail_size(std::uint32_t width, std::uint32_t height, std::uint32_t &out_width,
+                          std::uint32_t &out_height);
+// The score above for two images of one size; 999 when neither has a solid
+// pixel.
+[[nodiscard]] float match_score(const MatchImage &a, const MatchImage &b);
+// False when a texture has too few solid pixels, or too little colour, to be
+// matched.
+[[nodiscard]] bool match_informative(const MatchImage &image);
+
+// One image of the pack and the keys that name it.
+struct MatchCandidate {
+    std::string file;                     // relative to the pack
+    std::vector<std::uint64_t> prefixes;  // first halves of its keys; 0 stands for any
+    std::uint32_t width{};                // the image's size; 0 when it cannot be read
+    std::uint32_t height{};
+    MatchImage signature;                 // 16x16
+    MatchImage thumbnail;                 // match_thumbnail_size()
+    bool indexed{};                       // read, or found unreadable
+};
+
+// Fills a candidate's size, signature and thumbnail from its decoded image.
+void index_match_candidate(MatchCandidate &candidate, const std::uint8_t *rgba, std::uint32_t width,
+                           std::uint32_t height);
+
+struct MatchDecision {
+    int best{-1};         // the accepted candidate; -1 when none is
+    int closest{-1};      // the closest candidate, accepted or not
+    float score{999.0f};
+    float runner_up{999.0f};
+    float alike{999.0f};  // the closest two candidates scored against each other
+    float recolour{};     // share of signature pixels whose chroma differs, for the closest
+    bool informative{};
+};
+
+// Compares a game texture (RGBA8, width x height) with the candidates;
+// `cache_key` is its key's first half.
+[[nodiscard]] MatchDecision match_texture(const std::vector<MatchCandidate> &candidates, const std::uint8_t *rgba,
+                                          std::uint32_t width, std::uint32_t height, std::uint64_t cache_key);
+
+// A pack's matching: its index, the matches found so far and the thread that
+// builds the index and compares the textures.
+class TexturePackMatcher {
+public:
+    struct Job {
+        std::uint64_t cache_key{};
+        std::uint32_t data_hash{};
+        std::uint32_t width{};
+        std::uint32_t height{};
+        std::vector<std::uint32_t> pixels;  // RGBA8, red in the low byte
+        // Called on the matcher's thread with the matched image, or an empty
+        // name when nothing matched. Never called after the matcher is gone.
+        std::function<void(const std::string &file)> done;
+    };
+    // Reads one of the pack's images as RGBA8; false when it cannot.
+    using ImageReader = std::function<bool(const std::string &file, std::vector<std::uint8_t> &rgba,
+                                           std::uint32_t &width, std::uint32_t &height)>;
+
+    // `images`: each image file of the pack in `pack_folder`, with its keys'
+    // first halves. The index and the matches are saved as
+    // <match_root>/<pack_id>.index and .ini; an empty root saves nothing.
+    TexturePackMatcher(std::filesystem::path pack_folder, std::vector<MatchCandidate> images, std::string pack_id,
+                       std::filesystem::path match_root, ImageReader reader);
+    ~TexturePackMatcher();
+    TexturePackMatcher(const TexturePackMatcher &) = delete;
+    TexturePackMatcher &operator=(const TexturePackMatcher &) = delete;
+
+    enum class Known : std::uint8_t { No, Matched, Unmatched };
+    // What earlier matching found for a texture: its own key first, then its
+    // data half alone.
+    [[nodiscard]] Known known(std::uint64_t cache_key, std::uint32_t data_hash, std::string &file) const;
+    // False when no image of the pack has a texture's shape, once the index
+    // is ready: such a texture need not be decoded to know it matches nothing.
+    [[nodiscard]] bool has_shape(std::uint32_t width, std::uint32_t height) const;
+    // Queues a texture. False when too much is queued; the caller can try
+    // again later.
+    bool submit(Job job);
+    // Waits until the queue is empty (for tests and the offline check).
+    void drain();
+
+    // For the menu: how far the index is, or how many textures matched.
+    [[nodiscard]] std::string status() const;
+
+private:
+    using Key = std::pair<std::uint64_t, std::uint32_t>;
+    struct KeyHash {
+        std::size_t operator()(const Key &key) const noexcept {
+            return static_cast<std::size_t>(key.first * 0x9E3779B97F4A7C15ull ^ key.second);
+        }
+    };
+
+    void worker_main();
+    void build_index();
+    void load_index();
+    void save_index() const;
+    void load_matches();
+    void append_match_line(const std::string &section, const std::string &line);
+
+    std::filesystem::path folder_;
+    std::vector<MatchCandidate> candidates_;
+    std::string pack_id_;
+    std::filesystem::path root_;
+    ImageReader reader_;
+
+    mutable std::mutex mutex_;
+    std::condition_variable wake_;
+    std::condition_variable idle_;
+    std::deque<Job> queue_;
+    std::size_t queued_bytes_{};
+    bool busy_{};
+    std::atomic<bool> stopping_{false};
+    std::unordered_map<Key, std::string, KeyHash> matches_;
+    std::unordered_set<Key, KeyHash> unmatched_;
+    std::string last_section_;  // of the matches file, as this session last wrote it
+    // The images' shapes, width and height divided by their greatest common
+    // divisor; written before ready_ is set and only read after.
+    std::unordered_set<std::uint64_t> shapes_;
+    std::atomic<std::size_t> indexed_{0};
+    std::atomic<bool> ready_{false};
+    std::thread worker_;
+};
+
+} // namespace portablekit::gpu
