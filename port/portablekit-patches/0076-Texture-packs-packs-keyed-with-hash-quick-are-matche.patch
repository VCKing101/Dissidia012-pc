+void TexturePack::start_matching(const std::filesystem::path &match_root) {
+    // One candidate per image, with the first halves of the keys naming it.
+    std::unordered_map<std::string, std::size_t> by_file;
+    std::vector<MatchCandidate> images;
+    for (const auto &[key, name] : quick_entries_) {
+        if (name.empty()) continue;
+        const auto [at, inserted] = by_file.try_emplace(name, images.size());
+        if (inserted) {
+            images.emplace_back();
+            images.back().file = name;
+        }
+        std::vector<std::uint64_t> &prefixes = images[at->second].prefixes;
+        if (std::find(prefixes.begin(), prefixes.end(), key.cache_key) == prefixes.end())
+            prefixes.push_back(key.cache_key);
+    }
+    // The pack is known by its textures.ini, wherever it is kept.
+    const std::vector<std::uint8_t> ini = read_file(directory_ / "textures.ini");
+    char id[24];
+    std::snprintf(id, sizeof(id), "%016llx",
+                  static_cast<unsigned long long>(XXH64(ini.data(), ini.size(), kDataSeed)));
+    auto reader = [this](const std::string &name, std::vector<std::uint8_t> &rgba, std::uint32_t &width,
+                         std::uint32_t &height) {
+        std::vector<std::uint8_t> bytes = read_file(directory_ / std::filesystem::path(name));
+        if (bytes.empty()) {
+            std::filesystem::path folded;
+            {
+                std::lock_guard lock(resolve_mutex_);
+                folded = resolve(name);
+            }
+            if (!folded.empty()) bytes = read_file(folded);
+        }
+        int w = 0, h = 0, channels = 0;
+        stbi_uc *image = bytes.empty() ? nullptr
+                                       : stbi_load_from_memory(bytes.data(), static_cast<int>(bytes.size()), &w, &h,
+                                                               &channels, 4);
+        if (image == nullptr || w <= 0 || h <= 0 || w > kMaxImageSide || h > kMaxImageSide) {
+            if (image != nullptr) stbi_image_free(image);
+            return false;
+        }
+        rgba.assign(image, image + static_cast<std::size_t>(w) * static_cast<std::size_t>(h) * 4u);
+        stbi_image_free(image);
+        width = static_cast<std::uint32_t>(w);
+        height = static_cast<std::uint32_t>(h);
+        return true;
+    };
+    std::cout << "[texpack] textures.ini uses hash = quick: " << quick_entries_.size()
+              << " keys are matched to the game's textures by picture\n";
+    matcher_ = std::make_unique<TexturePackMatcher>(directory_, std::move(images), id, match_root, std::move(reader));
+}
