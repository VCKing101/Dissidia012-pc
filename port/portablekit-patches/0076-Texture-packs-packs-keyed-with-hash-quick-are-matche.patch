+// The source pixels each output pixel covers, with their shares of it.
+struct Span {
+    std::uint32_t first{};
+    std::vector<float> weights;
+};
+
+std::vector<Span> spans(std::uint32_t from, std::uint32_t to) {
+    std::vector<Span> out(to);
+    const double scale = static_cast<double>(from) / static_cast<double>(to);
+    for (std::uint32_t i = 0; i < to; ++i) {
+        const double begin = i * scale;
+        const double end = (i + 1u) * scale;
+        Span &span = out[i];
+        span.first = static_cast<std::uint32_t>(begin);
+        double total = 0.0;
+        for (std::uint32_t s = span.first; s < from && static_cast<double>(s) < end; ++s) {
+            const double weight = std::min(end, s + 1.0) - std::max(begin, static_cast<double>(s));
+            span.weights.push_back(static_cast<float>(weight));
+            total += weight;
+        }
+        if (span.weights.empty()) {
+            span.first = std::min(span.first, from - 1u);
+            span.weights.push_back(1.0f);
+            total = 1.0;
+        }
+        for (float &weight : span.weights) weight = static_cast<float>(weight / total);
+    }
+    return out;
+}
+
+// The share of pixels solid in both whose chroma (Cb, Cr) differs by more
+// than kRecolourChroma.
+float recoloured_share(const MatchImage &a, const MatchImage &b) {
+    if (a.rgba.size() != b.rgba.size()) return 1.0f;
+    std::size_t both = 0u, changed = 0u;
+    for (std::size_t i = 0; i < a.rgba.size(); i += 4u) {
+        if (a.rgba[i + 3u] < kSolidAlpha || b.rgba[i + 3u] < kSolidAlpha) continue;
+        ++both;
+        const auto chroma = [](const std::uint8_t *p, float &cb, float &cr) {
+            cb = -0.1687f * p[0] - 0.3313f * p[1] + 0.5f * p[2];
+            cr = 0.5f * p[0] - 0.4187f * p[1] - 0.0813f * p[2];
+        };
+        float cb_a = 0.0f, cr_a = 0.0f, cb_b = 0.0f, cr_b = 0.0f;
+        chroma(&a.rgba[i], cb_a, cr_a);
+        chroma(&b.rgba[i], cb_b, cr_b);
+        if (std::hypot(cb_a - cb_b, cr_a - cr_b) > kRecolourChroma) ++changed;
+    }
+    return both != 0u ? static_cast<float>(changed) / static_cast<float>(both) : 0.0f;
+}
+
+void format_key(char (&text)[32], std::uint64_t cache_key, std::uint32_t data_hash) {
+    std::snprintf(text, sizeof(text), "%016llx%08x", static_cast<unsigned long long>(cache_key),
+                  static_cast<unsigned>(data_hash));
+}
+
+bool parse_key(const std::string &text, std::uint64_t &cache_key, std::uint32_t &data_hash) {
+    if (text.size() != 24u) return false;
+    char *end = nullptr;
+    cache_key = std::strtoull(text.substr(0, 16u).c_str(), &end, 16);
+    if (end == nullptr || *end != '\0') return false;
+    data_hash = static_cast<std::uint32_t>(std::strtoul(text.substr(16u).c_str(), &end, 16));
+    return end != nullptr && *end == '\0';
+}
+
+std::string trim(const std::string &text) {
+    std::size_t begin = 0u, end = text.size();
+    while (begin < end && std::isspace(static_cast<unsigned char>(text[begin])) != 0) ++begin;
+    while (end > begin && std::isspace(static_cast<unsigned char>(text[end - 1u])) != 0) --end;
+    return text.substr(begin, end - begin);
+}
+
+template <typename T> void put(std::ostream &out, const T &value) {
+    out.write(reinterpret_cast<const char *>(&value), sizeof(value));
+}
+template <typename T> bool get(std::istream &in, T &value) {
+    return static_cast<bool>(in.read(reinterpret_cast<char *>(&value), sizeof(value)));
+}
