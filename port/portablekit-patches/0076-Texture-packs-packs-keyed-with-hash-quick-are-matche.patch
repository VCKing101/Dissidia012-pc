+// A test picture: smooth gradients with a few hard edges, `shift` added to
+// every colour.
+std::vector<std::uint8_t> picture(std::uint32_t width, std::uint32_t height, int shift, std::uint32_t seed = 1u) {
+    std::vector<std::uint8_t> rgba(static_cast<std::size_t>(width) * height * 4u);
+    for (std::uint32_t y = 0; y < height; ++y) {
+        for (std::uint32_t x = 0; x < width; ++x) {
+            std::uint8_t *p = rgba.data() + (static_cast<std::size_t>(y) * width + x) * 4u;
+            const std::uint32_t u = x * 64u / width, v = y * 64u / height;
+            const int r = static_cast<int>((u * 4u * seed) % 256u);
+            const int g = static_cast<int>((v * 4u + seed * 50u) % 256u);
+            const int b = ((u / 16u + v / 16u) % 2u) != 0u ? 200 : 40;
+            p[0] = static_cast<std::uint8_t>(std::clamp(r + shift, 0, 255));
+            p[1] = static_cast<std::uint8_t>(std::clamp(g + shift, 0, 255));
+            p[2] = static_cast<std::uint8_t>(std::clamp(b + shift, 0, 255));
+            p[3] = 255u;
+        }
+    }
+    return rgba;
+}
