+std::shared_ptr<Replacement> TexturePack::find_by_picture(const TextureState &texture, const TexturePackKey &key,
+                                                          std::uint32_t covered_width, std::uint32_t covered_height,
+                                                          const TexturePixels &pixels) {
+    std::string file;
+    const TexturePackMatcher::Known known = matcher_->known(key.cache_key, key.data_hash, file);
+    if (known == TexturePackMatcher::Known::Matched) {
+        if (texture_pack_trace())
+            std::cout << "[texpack] 0x" << std::hex << texture.address << std::dec << " " << texture.width << "x"
+                      << texture.height << " key " << format_texture_pack_key(key) << " -> " << file
+                      << " (matched by picture)\n";
+        return replacement_for(file, key, texture, covered_width, covered_height);
+    }
+    if (known == TexturePackMatcher::Known::Unmatched) return nullptr;
+    if (const auto waiting = matching_.find(key); waiting != matching_.end()) return waiting->second;
+    if (!matcher_->has_shape(texture.width, texture.height)) return nullptr;
+    std::vector<std::uint32_t> decoded;
+    if (!pixels || !pixels(decoded) || decoded.size() < static_cast<std::size_t>(texture.width) * texture.height) {
+        if (texture_pack_trace())
+            std::cout << "[texpack] 0x" << std::hex << texture.address << std::dec << " " << texture.width << "x"
+                      << texture.height << " key " << format_texture_pack_key(key)
+                      << " cannot be decoded to match by picture\n";
+        return nullptr;
+    }
+    if (texture_pack_trace())
+        std::cout << "[texpack] 0x" << std::hex << texture.address << std::dec << " " << texture.width << "x"
+                  << texture.height << " fmt=" << static_cast<int>(texture.format) << " key "
+                  << format_texture_pack_key(key) << " (matching by picture)\n";
+    auto placeholder = std::make_shared<Replacement>();
+    placeholder->state.store(Replacement::State::Matching, std::memory_order_relaxed);
+    placeholder->texture_width = texture.width;
+    placeholder->texture_height = texture.height;
+    placeholder->covered_width = covered_width;
+    placeholder->covered_height = covered_height;
+    auto filter = lookup(filters_, key);
+    if (filter == filters_.end()) filter = filters_.find(TexturePackKey{});
+    if (filter != filters_.end()) placeholder->filter = filter->second;
+    TexturePackMatcher::Job job;
+    job.cache_key = key.cache_key;
+    job.data_hash = key.data_hash;
+    job.width = texture.width;
+    job.height = texture.height;
+    job.pixels = std::move(decoded);
+    // The game's texture is drawn until then. A match is decoded like any
+    // image; a texture that matched nothing stays the game's.
+    job.done = [placeholder, folder = directory_](const std::string &name) {
+        if (name.empty()) {
+            placeholder->state.store(Replacement::State::Failed, std::memory_order_release);
+            return;
+        }
+        placeholder->name = name;
+        placeholder->file = folder / std::filesystem::path(name);
+        placeholder->state.store(Replacement::State::Unloaded, std::memory_order_release);
+    };
+    if (!matcher_->submit(std::move(job))) return nullptr;
+    matching_.emplace(key, placeholder);
+    return placeholder;
+}
