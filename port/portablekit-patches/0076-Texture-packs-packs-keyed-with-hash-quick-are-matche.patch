+constexpr std::uint32_t kSignatureSide = 16u;
+constexpr std::uint32_t kThumbnailSide = 64u;
+constexpr std::size_t kShortlist = 4u;
+constexpr float kScoreLimit = 45.0f;
+constexpr float kRunnerUpRatio = 1.7f;
+constexpr float kSamePicture = 3.0f;
+constexpr float kRecolourChroma = 16.0f;
+constexpr float kRecolourShare = 0.08f;
+constexpr std::uint8_t kSolidAlpha = 128u;
+constexpr std::size_t kMinSolidPixels = 16u;
+constexpr double kMinSpread = 6.0;
+constexpr float kNoScore = 999.0f;
+// Pixels waiting for the matcher, at most; a burst of textures at a scene's
+// start is held, not dropped.
+constexpr std::size_t kMaxQueuedBytes = 256u * 1024u * 1024u;
