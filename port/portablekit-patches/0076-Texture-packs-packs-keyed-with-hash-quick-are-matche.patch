+                         const std::vector<std::uint8_t> &rgba) {
+    MatchCandidate c;
+    c.file = file;
+    c.prefixes = {prefix};
+    index_match_candidate(c, rgba.data(), width, height);
+    c.indexed = true;
+    return c;
+}
