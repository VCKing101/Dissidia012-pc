+int match_folder(const fs::path &pack, const fs::path &dump, const fs::path &state) {
+    std::ifstream ini(pack / "textures.ini");
+    std::string line, section;
+    std::unordered_map<std::string, std::size_t> by_file;
+    std::vector<MatchCandidate> images;
+    while (std::getline(ini, line)) {
+        while (!line.empty() && (line.back() == '\r' || line.back() == ' ')) line.pop_back();
+        if (!line.empty() && line.front() == '[') {
+            section = line;
+            continue;
+        }
+        const std::size_t equals = line.find('=');
+        if (section != "[hashes]" || equals == std::string::npos) continue;
+        std::string key = line.substr(0, equals), name = line.substr(equals + 1u);
+        while (!key.empty() && key.back() == ' ') key.pop_back();
+        while (!name.empty() && name.front() == ' ') name.erase(0, 1);
+        std::replace(name.begin(), name.end(), '\\', '/');
+        if (key.size() != 24u || name.empty() || key.substr(16u) == "00000000") continue;
+        const std::uint64_t prefix = std::strtoull(key.substr(0, 16u).c_str(), nullptr, 16);
+        const auto [at, inserted] = by_file.try_emplace(name, images.size());
+        if (inserted) {
+            images.emplace_back();
+            images.back().file = name;
+        }
+        images[at->second].prefixes.push_back(prefix);
+    }
+    auto reader = [&](const std::string &name, std::vector<std::uint8_t> &rgba, std::uint32_t &width,
+                      std::uint32_t &height) {
+        int w = 0, h = 0, n = 0;
+        stbi_uc *image = stbi_load((pack / fs::path(name)).string().c_str(), &w, &h, &n, 4);
+        if (image == nullptr) return false;
+        rgba.assign(image, image + static_cast<std::size_t>(w) * h * 4u);
+        stbi_image_free(image);
+        width = static_cast<std::uint32_t>(w);
+        height = static_cast<std::uint32_t>(h);
+        return true;
+    };
+    std::printf("%zu images\n", images.size());
+    TexturePackMatcher matcher(pack, images, "offline", state, reader);
+    std::size_t textures = 0u;
+    for (const auto &entry : fs::directory_iterator(dump)) {
+        const std::string stem = entry.path().stem().string();
+        if (entry.path().extension() != ".png" || stem.size() != 24u) continue;
+        int w = 0, h = 0, n = 0;
+        stbi_uc *image = stbi_load(entry.path().string().c_str(), &w, &h, &n, 4);
+        if (image == nullptr) continue;
+        TexturePackMatcher::Job job;
+        job.cache_key = std::strtoull(stem.substr(0, 16u).c_str(), nullptr, 16);
+        job.data_hash = static_cast<std::uint32_t>(std::strtoul(stem.substr(16u).c_str(), nullptr, 16));
+        job.width = static_cast<std::uint32_t>(w);
+        job.height = static_cast<std::uint32_t>(h);
+        job.pixels.resize(static_cast<std::size_t>(w) * h);
+        std::memcpy(job.pixels.data(), image, job.pixels.size() * 4u);
+        stbi_image_free(image);
+        job.done = [stem](const std::string &file) {
+            if (!file.empty()) std::printf("match %s %s\n", stem.c_str(), file.c_str());
+        };
+        while (!matcher.submit(std::move(job))) matcher.drain();
+        ++textures;
+    }
+    matcher.drain();
+    std::printf("%zu textures, %s\n", textures, matcher.status().c_str());
+    return 0;
+}
