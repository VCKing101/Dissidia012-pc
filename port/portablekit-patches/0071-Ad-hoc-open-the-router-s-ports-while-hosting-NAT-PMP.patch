+
+// The default gateway's IPv4 address (network order), 0 when it cannot be
+// found here.
+std::uint32_t default_gateway() {
+#if defined(_WIN32)
+    MIB_IPFORWARDROW row{};
+    if (GetBestRoute(htonl(0x08080808u), 0, &row) == NO_ERROR) return static_cast<std::uint32_t>(row.dwForwardNextHop);
+    return 0u;
+#elif defined(__linux__)
+    std::ifstream routes("/proc/net/route");
+    std::string line;
+    std::getline(routes, line);  // the column names
+    while (std::getline(routes, line)) {
+        std::istringstream in(line);
+        std::string name, destination, gateway;
+        if (!(in >> name >> destination >> gateway)) continue;
+        // Printed as the address's bytes in memory order: the value read back
+        // is the network-order word on a little-endian machine.
+        if (destination == "00000000") return static_cast<std::uint32_t>(std::strtoul(gateway.c_str(), nullptr, 16));
+    }
+    return 0u;
+#else
+    return 0u;
+#endif
+}
+
+bool wait_readable(Socket s, int timeout_ms) {
+    PollEntry entry{};
+    entry.fd = s;
+    entry.events = POLLIN;
+    return poll_sockets(&entry, 1u, timeout_ms) > 0 && (entry.revents & POLLIN) != 0;
+}
+
+// One NAT-PMP exchange: the request sent up to four times, 250 ms apart and
+// doubling, as RFC 6886 asks.
+std::optional<NatPmpReply> natpmp_ask(Socket s, const std::vector<std::uint8_t> &request, std::uint8_t opcode,
+                                      int tries) {
+    int timeout = 250;
+    for (int attempt = 0; attempt < tries; ++attempt, timeout *= 2) {
+        if (::send(s, reinterpret_cast<const char *>(request.data()), static_cast<int>(request.size()), 0) < 0)
+            return std::nullopt;
+        const auto until = Clock::now() + std::chrono::milliseconds(timeout);
+        while (Clock::now() < until) {
+            const int left = static_cast<int>(
+                std::chrono::duration_cast<std::chrono::milliseconds>(until - Clock::now()).count());
+            if (!wait_readable(s, std::max(left, 1))) break;
+            std::uint8_t data[64];
+            const int got = static_cast<int>(::recv(s, reinterpret_cast<char *>(data), sizeof(data), 0));
+            if (got <= 0) break;
+            const auto reply = natpmp_parse(data, static_cast<std::size_t>(got));
+            if (reply && reply->opcode == opcode) return reply;
+        }
+    }
+    return std::nullopt;
+}
+
+// An HTTP exchange with `url`'s host: the request sent, everything read until
+// the router closes. `local` gets this machine's address on that connection.
+std::optional<std::string> http_exchange(const Url &url, const std::string &request, std::string *local = nullptr) {
+    addrinfo hints{};
+    hints.ai_family = AF_INET;
+    hints.ai_socktype = SOCK_STREAM;
+    addrinfo *found = nullptr;
+    if (getaddrinfo(url.host.c_str(), std::to_string(url.port).c_str(), &hints, &found) != 0 || found == nullptr)
+        return std::nullopt;
+    const Socket s = ::socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);
+    if (s == kNoSocket) {
+        freeaddrinfo(found);
+        return std::nullopt;
+    }
+    set_nonblocking(s);
+    no_sigpipe(s);
+    const int connected = ::connect(s, found->ai_addr, static_cast<int>(found->ai_addrlen));
+    freeaddrinfo(found);
+    if (connected != 0 && !connect_pending(socket_error())) {
+        close_socket(s);
+        return std::nullopt;
+    }
+    PollEntry entry{};
+    entry.fd = s;
+    entry.events = POLLOUT;
+    if (poll_sockets(&entry, 1u, kHttpTimeoutMs) <= 0 || (entry.revents & POLLOUT) == 0) {
+        close_socket(s);
+        return std::nullopt;
+    }
+    if (local != nullptr) {
+        sockaddr_in mine{};
+        socklen_t size = sizeof(mine);
+        if (getsockname(s, reinterpret_cast<sockaddr *>(&mine), &size) == 0) *local = ipv4_text(mine.sin_addr.s_addr);
+    }
+    std::size_t sent = 0;
+    const auto until = Clock::now() + std::chrono::milliseconds(kHttpTimeoutMs);
+    while (sent < request.size() && Clock::now() < until) {
+        const int n = static_cast<int>(
+            ::send(s, request.data() + sent, static_cast<int>(request.size() - sent), kSendFlags));
+        if (n > 0) sent += static_cast<std::size_t>(n);
+        else if (n < 0 && !would_block(socket_error())) break;
+        else std::this_thread::sleep_for(std::chrono::milliseconds(5));
+    }
+    std::string reply;
+    while (sent == request.size() && Clock::now() < until) {
+        if (!wait_readable(s, 100)) continue;
+        char buffer[4096];
+        const int n = static_cast<int>(::recv(s, buffer, sizeof(buffer), 0));
+        if (n > 0) reply.append(buffer, static_cast<std::size_t>(n));
+        else if (n == 0 || !would_block(socket_error())) break;
+    }
+    close_socket(s);
+    if (sent != request.size() || reply.empty()) return std::nullopt;
+    return reply;
+}
+
+struct SoapResult {
+    bool answered{};  // the router replied at all
+    int status{};
+    std::string body;
+    [[nodiscard]] int upnp_error() const { return std::atoi(xml_value(body, "errorCode").c_str()); }
+};
+
+SoapResult soap(const WanService &service, const std::string &action,
+                const std::vector<std::pair<std::string, std::string>> &arguments, std::string *local = nullptr) {
+    SoapResult result;
+    const std::optional<Url> url = parse_url(service.control_url);
+    if (!url) return result;
+    const std::string body = soap_body(service.type, action, arguments);
+    const std::string request = "POST " + url->path + " HTTP/1.1\r\nHost: " + url->host + ":" +
+                                std::to_string(url->port) +
+                                "\r\nContent-Type: text/xml; charset=\"utf-8\"\r\nSOAPAction: \"" + service.type + "#" +
+                                action + "\"\r\nContent-Length: " + std::to_string(body.size()) +
+                                "\r\nConnection: close\r\n\r\n" + body;
+    const std::optional<std::string> raw = http_exchange(*url, request, local);
+    if (!raw) return result;
+    const std::optional<HttpResponse> response = parse_http_response(*raw);
+    if (!response) return result;
+    result.answered = true;
+    result.status = response->status;
+    result.body = response->body;
+    return result;
+}
+
+// The routers that answer an SSDP search for an internet gateway, the
+// gateway's own first.
+std::vector<std::string> ssdp_locations(std::uint32_t gateway) {
+    std::vector<std::string> locations;
+    const Socket s = ::socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
+    if (s == kNoSocket) return locations;
+    set_nonblocking(s);
+    set_option(s, IPPROTO_IP, IP_MULTICAST_TTL, 2);
+    const Address to = Address::ipv4_address(htonl(0xEFFFFFFAu), 1900u);  // 239.255.255.250
+    for (const char *target : {"urn:schemas-upnp-org:device:InternetGatewayDevice:1",
+                               "urn:schemas-upnp-org:device:InternetGatewayDevice:2",
+                               "urn:schemas-upnp-org:service:WANIPConnection:1"}) {
+        const std::string message = ssdp_search(target);
+        ::sendto(s, message.data(), static_cast<int>(message.size()), 0, reinterpret_cast<const sockaddr *>(&to.storage),
+                 static_cast<int>(to.length));
+    }
+    const auto until = Clock::now() + kSsdpWait;
+    while (Clock::now() < until) {
+        if (!wait_readable(s, 100)) continue;
+        char buffer[2048];
+        sockaddr_in from{};
+        socklen_t size = sizeof(from);
+        const int n = static_cast<int>(
+            ::recvfrom(s, buffer, sizeof(buffer) - 1u, 0, reinterpret_cast<sockaddr *>(&from), &size));
+        if (n <= 0) continue;
+        const std::string location = ssdp_gateway_location(std::string(buffer, static_cast<std::size_t>(n)));
+        if (location.empty() || std::find(locations.begin(), locations.end(), location) != locations.end()) continue;
+        if (from.sin_addr.s_addr == gateway) locations.insert(locations.begin(), location);
+        else locations.push_back(location);
+    }
+    close_socket(s);
+    return locations;
+}
+
+std::string upnp_error_text(const SoapResult &result) {
+    if (!result.answered) return "no answer";
+    switch (result.upnp_error()) {
+    case 0: return "HTTP " + std::to_string(result.status);
+    case 606: return "not authorized (port mapping is turned off on the router)";
+    case 718: return "the port is already forwarded to another device";
+    case 724: return "the router wants the same port outside and inside";
+    case 725: return "the router only takes permanent mappings";
+    default: return "error " + std::to_string(result.upnp_error());
+    }
+}
+
+} // namespace
+
+struct PortMapper::Impl {
+    mutable std::mutex mutex;
+    std::condition_variable wake;
+    std::thread worker;
+    bool stopping{};
+    RouterStatus status;
+    std::vector<ForwardedPort> wanted;
+
+    // What the worker holds, to give back.
+    std::string method;
+    Socket natpmp{kNoSocket};
+    WanService service;
+    std::string local_address;
+    std::vector<ForwardedPort> held;
+
+    void set(RouterState state, const std::string &error = {}) {
+        std::lock_guard lock(mutex);
+        status.state = state;
+        status.error = error;
+        status.method = method;
+        status.ports = held;
+    }
+
+    bool stop_requested() {
+        std::lock_guard lock(mutex);
+        return stopping;
+    }
+
+    // NAT-PMP: true once every port is held. `error` says why not; `spoken`
+    // whether the gateway answered at all.
+    bool natpmp_open(const std::vector<ForwardedPort> &ports, std::string &error, bool &spoken) {
+        spoken = false;
+        const std::uint32_t gateway = default_gateway();
+        if (gateway == 0u) {
+            error = "no default gateway found";
+            return false;
+        }
+        natpmp = ::socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
+        if (natpmp == kNoSocket) return false;
+        const Address to = Address::ipv4_address(gateway, kNatPmpPort);
+        if (::connect(natpmp, reinterpret_cast<const sockaddr *>(&to.storage), static_cast<int>(to.length)) != 0) {
+            error = "cannot reach the gateway";
+            return false;
+        }
+        const auto address = natpmp_ask(natpmp, natpmp_address_request(), 128u, 4);
+        if (!address) {
+            error = "the gateway " + ipv4_text(gateway) + " did not answer NAT-PMP";
+            return false;
+        }
+        spoken = true;
+        if (address->result != 0u) {
+            error = "NAT-PMP: " + natpmp_result_text(address->result);
+            return false;
+        }
+        {
+            std::lock_guard lock(mutex);
+            status.external_address = ipv4_text(address->external_address);
+        }
+        method = "NAT-PMP";
+        for (const ForwardedPort &p : ports) {
+            const auto reply = natpmp_ask(natpmp, natpmp_map_request(p.udp, p.port, p.port, kLease), p.udp ? 129u : 130u, 3);
+            if (!reply) {
+                error = "NAT-PMP: no answer for " + describe_ports({p});
+                return false;
+            }
+            if (reply->result != 0u) {
+                error = "NAT-PMP: " + describe_ports({p}) + ": " + natpmp_result_text(reply->result);
+                return false;
+            }
+            held.push_back(p);
+            if (reply->external_port != p.port) {
+                error = "NAT-PMP: the router offered " + std::to_string(reply->external_port) + " for " +
+                        describe_ports({p}) + ", which is in use outside";
+                return false;
+            }
+        }
+        return true;
+    }
+
+    bool upnp_open(const std::vector<ForwardedPort> &ports, std::string &error) {
+        const std::vector<std::string> locations = ssdp_locations(default_gateway());
+        if (locations.empty()) {
+            error = "no UPnP router answered";
+            return false;
+        }
+        for (const std::string &location : locations) {
+            const std::optional<Url> url = parse_url(location);
+            if (!url) continue;
+            const std::string request = "GET " + url->path + " HTTP/1.1\r\nHost: " + url->host + ":" +
+                                        std::to_string(url->port) + "\r\nConnection: close\r\n\r\n";
+            const std::optional<std::string> raw = http_exchange(*url, request);
+            const std::optional<HttpResponse> description = raw ? parse_http_response(*raw) : std::nullopt;
+            if (!description || description->status != 200) continue;
+            const std::optional<WanService> found = find_wan_service(description->body, location);
+            if (!found) continue;
+            service = *found;
+            const SoapResult address = soap(service, "GetExternalIPAddress", {}, &local_address);
+            if (address.answered && address.status == 200) {
+                std::lock_guard lock(mutex);
+                status.external_address = xml_value(address.body, "NewExternalIPAddress");
+            }
+            if (local_address.empty()) continue;
+            method = "UPnP";
+            for (const ForwardedPort &p : ports) {
+                if (!upnp_add(p, error)) return false;
+                held.push_back(p);
+            }
+            return true;
+        }
+        error = "no UPnP router offered port mapping";
+        return false;
+    }
+
+    bool upnp_add(const ForwardedPort &p, std::string &error) {
+        const auto add = [&](std::uint32_t lease) {
+            return soap(service, "AddPortMapping",
+                        {{"NewRemoteHost", ""},
+                         {"NewExternalPort", std::to_string(p.port)},
+                         {"NewProtocol", p.udp ? "UDP" : "TCP"},
+                         {"NewInternalPort", std::to_string(p.port)},
+                         {"NewInternalClient", local_address},
+                         {"NewEnabled", "1"},
+                         {"NewPortMappingDescription", portablekit::game().app_name},
+                         {"NewLeaseDuration", std::to_string(lease)}});
+        };
+        SoapResult result = add(kLease);
+        if (result.answered && result.upnp_error() == 725) result = add(0u);
+        if (result.answered && result.status == 200) return true;
+        error = "UPnP: " + describe_ports({p}) + ": " + upnp_error_text(result);
+        return false;
+    }
+
+    void give_back() {
+        for (const ForwardedPort &p : held) {
+            if (method == "NAT-PMP" && natpmp != kNoSocket) {
+                natpmp_ask(natpmp, natpmp_map_request(p.udp, p.port, 0u, 0u), p.udp ? 129u : 130u, 2);
+            } else if (method == "UPnP") {
+                soap(service, "DeletePortMapping",
+                     {{"NewRemoteHost", ""}, {"NewExternalPort", std::to_string(p.port)},
+                      {"NewProtocol", p.udp ? "UDP" : "TCP"}});
+            }
+        }
+        if (!held.empty()) log("gave back " + describe_ports(held));
+        held.clear();
+        if (natpmp != kNoSocket) close_socket(natpmp);
+        natpmp = kNoSocket;
+        method.clear();
+    }
+
+    // Renews every lease; false when the router stopped agreeing.
+    bool renew(std::string &error) {
+        for (const ForwardedPort &p : held) {
+            if (method == "NAT-PMP") {
+                const auto reply =
+                    natpmp_ask(natpmp, natpmp_map_request(p.udp, p.port, p.port, kLease), p.udp ? 129u : 130u, 3);
+                if (!reply || reply->result != 0u || reply->external_port != p.port) {
+                    error = "NAT-PMP: the router stopped renewing " + describe_ports({p});
+                    return false;
+                }
+            } else if (!upnp_add(p, error)) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    void run(std::vector<ForwardedPort> ports) {
+        WinsockSession winsock;
+        set(RouterState::Working);
+        std::string natpmp_error, upnp_error;
+        bool spoken = false;
+        bool open = natpmp_open(ports, natpmp_error, spoken);
+        if (!open) {
+            give_back();
+            open = !stop_requested() && upnp_open(ports, upnp_error);
+            if (!open) give_back();
+        }
+        if (!open) {
+            const std::string error = spoken ? natpmp_error : (upnp_error.empty() ? natpmp_error : upnp_error);
+            log("could not open " + describe_ports(ports) + ": " + error +
+                (spoken || upnp_error.empty() ? "" : " (" + natpmp_error + ")"));
+            set(RouterState::Failed, error);
+            return;
+        }
+        {
+            std::lock_guard lock(mutex);
+            log(method + " opened " + describe_ports(held) + " on " + status.external_address);
+        }
+        set(RouterState::Open);
+        std::unique_lock lock(mutex);
+        while (!stopping) {
+            if (wake.wait_for(lock, std::chrono::seconds(kLease / 2u), [this] { return stopping; })) break;
+            lock.unlock();
+            std::string error;
+            const bool renewed = renew(error);
+            if (!renewed) log(error);
+            set(renewed ? RouterState::Open : RouterState::Failed, error);
+            lock.lock();
+        }
+        lock.unlock();
+        give_back();
+        set(RouterState::Off);
+    }
+};
+
+PortMapper::PortMapper() : impl_(new Impl) {}
+PortMapper::~PortMapper() = default;  // never runs: get() leaks the one instance
+
+PortMapper &PortMapper::get() {
+    static PortMapper *mapper = new PortMapper;
+    return *mapper;
+}
+
+void PortMapper::start(std::vector<ForwardedPort> ports) {
+    {
+        std::lock_guard lock(impl_->mutex);
+        if (impl_->worker.joinable() && !impl_->stopping && impl_->wanted == ports) return;
+    }
+    stop();
+    std::lock_guard lock(impl_->mutex);
+    impl_->stopping = false;
+    impl_->wanted = ports;
+    impl_->status = RouterStatus{};
+    impl_->status.state = RouterState::Working;
+    impl_->worker = std::thread([this, ports] { impl_->run(ports); });
+}
+
+void PortMapper::stop() {
+    std::thread worker;
+    {
+        std::lock_guard lock(impl_->mutex);
+        impl_->stopping = true;
+        impl_->wanted.clear();
+        worker = std::move(impl_->worker);
+    }
+    impl_->wake.notify_all();
+    if (worker.joinable()) worker.join();
+    std::lock_guard lock(impl_->mutex);
+    impl_->status = RouterStatus{};
+}
+
+RouterStatus PortMapper::status() const {
+    std::lock_guard lock(impl_->mutex);
+    return impl_->status;
+}
+
+} // namespace portablekit::adhoc
