new file mode 100644
index 0000000..3c96efa
--- /dev/null
+++ b/host/adhoc/port_mapping.hpp
@@ -0,0 +1,131 @@
+#pragma once
+
+// Asking the home router to forward ports to this machine while it hosts, so
+// that players on the internet can reach a hosted session without anyone
+// setting up port forwarding by hand. Two protocols, tried in turn:
+//
+// - NAT-PMP (RFC 6886): UDP requests to the default gateway's port 5351.
+//   Apple's routers and many ISPs' speak it; a PCP router (RFC 6887) answers
+//   it too.
+// - UPnP IGD: the router found with an SSDP search, its WANIPConnection or
+//   WANPPPConnection service asked over SOAP (AddPortMapping).
+//
+// Every port is asked for at the same number outside as inside: a client
+// finds the relay at the adhocctl port plus one, and a game's own ports are
+// fixed. A router that offers another number counts as a refusal. Leases are
+// an hour, renewed at half time, and given back when hosting stops; a
+// process that dies leaves them to run out.
+//
+// Neither works behind a carrier's NAT (mobile data, some broadband), where
+// the router's outside address is not on the internet; the status says what
+// the router reported, and a player can compare it with what websites see.
+
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <vector>
+
+namespace portablekit::adhoc {
+
+struct ForwardedPort {
+    bool udp{};
+    std::uint16_t port{};
+    bool operator==(const ForwardedPort &other) const { return udp == other.udp && port == other.port; }
+};
+
+// "TCP 27312, 27313 and UDP 27420".
+[[nodiscard]] std::string describe_ports(const std::vector<ForwardedPort> &ports);
+
+enum class RouterState {
+    Off,      // not asked (not hosting, or turned off)
+    Working,  // asking the router
+    Open,     // every port forwarded
+    Failed,   // the router did not answer or refused; `error` says which
+};
+
+struct RouterStatus {
+    RouterState state{RouterState::Off};
+    std::string method;            // "NAT-PMP" or "UPnP"
+    std::string external_address;  // the router's outside address, as it reports it
+    std::string error;
+    std::vector<ForwardedPort> ports;
+};
+
+class PortMapper {
+public:
+    // One for the process, never destroyed (its thread may be renewing a
+    // lease when the process ends).
+    static PortMapper &get();
+
+    // Asks the router for `ports` on a thread of its own and keeps them until
+    // stop(); a second start() with other ports starts over.
+    void start(std::vector<ForwardedPort> ports);
+    // Gives the ports back and waits for that (a few seconds at most).
+    void stop();
+    [[nodiscard]] RouterStatus status() const;
+
+    PortMapper(const PortMapper &) = delete;
+    PortMapper &operator=(const PortMapper &) = delete;
+
+private:
+    PortMapper();
+    ~PortMapper();
+    struct Impl;
+    Impl *impl_;
+};
+
+// The protocols' messages, apart from the sockets, for the tests.
+namespace router_wire {
+
+// NAT-PMP: a request for the outside address, and for a mapping (lifetime 0
+// gives one back).
+[[nodiscard]] std::vector<std::uint8_t> natpmp_address_request();
+[[nodiscard]] std::vector<std::uint8_t> natpmp_map_request(bool udp, std::uint16_t internal, std::uint16_t external,
+                                                           std::uint32_t lifetime);
+struct NatPmpReply {
+    std::uint8_t opcode{};  // the request's opcode plus 128
+    std::uint16_t result{};
+    std::uint32_t external_address{};  // network order, for opcode 128
+    std::uint16_t internal_port{};
+    std::uint16_t external_port{};
+    std::uint32_t lifetime{};
+};
+[[nodiscard]] std::optional<NatPmpReply> natpmp_parse(const std::uint8_t *data, std::size_t size);
+[[nodiscard]] std::string natpmp_result_text(std::uint16_t result);
+
+// SSDP: the search for internet gateways, and the LOCATION of an answer that
+// is one ("" otherwise).
+[[nodiscard]] std::string ssdp_search(const std::string &search_target);
+[[nodiscard]] std::string ssdp_gateway_location(const std::string &response);
+
+struct Url {
+    std::string host;
+    std::uint16_t port{80};
+    std::string path{"/"};
+};
+// http:// URLs only.
+[[nodiscard]] std::optional<Url> parse_url(const std::string &url);
+
+// The device description's WANIPConnection (preferred) or WANPPPConnection
+// service: its type and the full URL of its control point.
+struct WanService {
+    std::string type;
+    std::string control_url;
+};
+[[nodiscard]] std::optional<WanService> find_wan_service(const std::string &description, const std::string &location);
+
+// A SOAP action's request body, and a value (or UPnP errorCode) from a reply.
+[[nodiscard]] std::string soap_body(const std::string &service, const std::string &action,
+                                    const std::vector<std::pair<std::string, std::string>> &arguments);
+[[nodiscard]] std::string xml_value(const std::string &xml, const std::string &tag);
+
+// An HTTP response's status and body, with a chunked body put back together.
+struct HttpResponse {
+    int status{};
+    std::string body;
+};
+[[nodiscard]] std::optional<HttpResponse> parse_http_response(const std::string &raw);
+
+} // namespace router_wire
+
+} // namespace portablekit::adhoc
