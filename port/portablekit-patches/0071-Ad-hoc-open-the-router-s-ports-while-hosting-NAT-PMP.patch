+std::string describe_ports(const std::vector<ForwardedPort> &ports) {
+    std::string text;
+    for (const bool udp : {false, true}) {
+        std::vector<std::uint16_t> numbers;
+        for (const ForwardedPort &p : ports)
+            if (p.udp == udp) numbers.push_back(p.port);
+        if (numbers.empty()) continue;
+        if (!text.empty()) text += " and ";
+        text += udp ? "UDP " : "TCP ";
+        for (std::size_t i = 0; i < numbers.size(); ++i) text += (i != 0u ? ", " : "") + std::to_string(numbers[i]);
+    }
+    return text;
+}
+
+namespace router_wire {
+namespace {
+
+void put16(std::vector<std::uint8_t> &out, std::size_t at, std::uint16_t v) {
+    out[at] = static_cast<std::uint8_t>(v >> 8u);
+    out[at + 1u] = static_cast<std::uint8_t>(v & 0xFFu);
+}
+void put32(std::vector<std::uint8_t> &out, std::size_t at, std::uint32_t v) {
+    put16(out, at, static_cast<std::uint16_t>(v >> 16u));
+    put16(out, at + 2u, static_cast<std::uint16_t>(v & 0xFFFFu));
+}
+std::uint16_t get16(const std::uint8_t *in) { return static_cast<std::uint16_t>((in[0] << 8u) | in[1]); }
+std::uint32_t get32(const std::uint8_t *in) {
+    return (static_cast<std::uint32_t>(get16(in)) << 16u) | get16(in + 2u);
+}
+
+std::string lower(std::string text) {
+    std::transform(text.begin(), text.end(), text.begin(),
+                   [](unsigned char c) { return static_cast<char>(c >= 'A' && c <= 'Z' ? c + 32 : c); });
+    return text;
+}
+
+std::string trim(const std::string &text) {
+    const auto first = text.find_first_not_of(" \t\r\n");
+    if (first == std::string::npos) return {};
+    return text.substr(first, text.find_last_not_of(" \t\r\n") - first + 1u);
+}
+
+// The value of a header line, by its name in any case.
+std::string header(const std::string &message, const std::string &name) {
+    std::istringstream in(message);
+    std::string line;
+    const std::string wanted = lower(name) + ":";
+    while (std::getline(in, line)) {
+        if (lower(line).rfind(wanted, 0) == 0) return trim(line.substr(wanted.size()));
+    }
+    return {};
+}
+
+std::string escape(const std::string &text) {
+    std::string out;
+    for (const char c : text) {
+        if (c == '&') out += "&amp;";
+        else if (c == '<') out += "&lt;";
+        else if (c == '>') out += "&gt;";
+        else out += c;
+    }
+    return out;
+}
+
+} // namespace
+
+std::vector<std::uint8_t> natpmp_address_request() { return {0u, 0u}; }
+
+std::vector<std::uint8_t> natpmp_map_request(bool udp, std::uint16_t internal, std::uint16_t external,
+                                             std::uint32_t lifetime) {
+    std::vector<std::uint8_t> out(12u, 0u);
+    out[1] = udp ? 1u : 2u;
+    put16(out, 4u, internal);
+    put16(out, 6u, external);
+    put32(out, 8u, lifetime);
+    return out;
+}
+
+std::optional<NatPmpReply> natpmp_parse(const std::uint8_t *data, std::size_t size) {
+    if (size < 8u || data[0] != 0u || data[1] < 128u) return std::nullopt;
+    NatPmpReply reply;
+    reply.opcode = data[1];
+    reply.result = get16(data + 2u);
+    if (reply.opcode == 128u) {
+        if (size < 12u) return std::nullopt;
+        std::memcpy(&reply.external_address, data + 8u, 4u);
+    } else if (reply.opcode == 129u || reply.opcode == 130u) {
+        if (size < 16u) return std::nullopt;
+        reply.internal_port = get16(data + 8u);
+        reply.external_port = get16(data + 10u);
+        reply.lifetime = get32(data + 12u);
+    } else {
+        return std::nullopt;
+    }
+    return reply;
+}
+
+std::string natpmp_result_text(std::uint16_t result) {
+    switch (result) {
+    case 0: return "success";
+    case 1: return "unsupported version";
+    case 2: return "refused (port mapping is turned off on the router)";
+    case 3: return "the router has no internet connection";
+    case 4: return "the router is out of mappings";
+    case 5: return "unsupported request";
+    default: return "error " + std::to_string(result);
+    }
+}
+
+std::string ssdp_search(const std::string &search_target) {
+    return "M-SEARCH * HTTP/1.1\r\n"
+           "HOST: 239.255.255.250:1900\r\n"
+           "MAN: \"ssdp:discover\"\r\n"
+           "MX: 2\r\n"
+           "ST: " +
+           search_target + "\r\n\r\n";
+}
+
+std::string ssdp_gateway_location(const std::string &response) {
+    const std::string target = lower(header(response, "ST") + " " + header(response, "NT"));
+    if (target.find("internetgatewaydevice") == std::string::npos &&
+        target.find("wanipconnection") == std::string::npos && target.find("wanpppconnection") == std::string::npos)
+        return {};
+    return header(response, "LOCATION");
+}
+
+std::optional<Url> parse_url(const std::string &url) {
+    const std::string scheme = "http://";
+    if (lower(url.substr(0, scheme.size())) != scheme) return std::nullopt;
+    const std::string rest = url.substr(scheme.size());
+    const std::size_t slash = rest.find('/');
+    const std::string authority = rest.substr(0, slash);
+    Url out;
+    out.path = slash == std::string::npos ? "/" : rest.substr(slash);
+    const std::size_t colon = authority.rfind(':');
+    out.host = authority.substr(0, colon);
+    if (colon != std::string::npos) {
+        const long port = std::strtol(authority.c_str() + colon + 1u, nullptr, 10);
+        if (port <= 0 || port > 65535) return std::nullopt;
+        out.port = static_cast<std::uint16_t>(port);
+    }
+    if (out.host.empty()) return std::nullopt;
+    return out;
+}
+
+std::string xml_value(const std::string &xml, const std::string &tag) {
+    std::size_t at = 0;
+    while ((at = xml.find(tag, at)) != std::string::npos) {
+        const std::size_t end = at + tag.size();
+        // <tag> or <prefix:tag>, with or without attributes.
+        const bool opens = at > 0u && (xml[at - 1u] == '<' || xml[at - 1u] == ':');
+        const bool whole = end < xml.size() && (xml[end] == '>' || xml[end] == ' ');
+        bool element = opens;
+        if (opens && xml[at - 1u] == ':') {
+            const std::size_t lt = xml.rfind('<', at);
+            element = lt != std::string::npos && xml.find_first_of(" >/", lt) >= at && xml[lt + 1u] != '/';
+        }
+        if (element && whole) {
+            const std::size_t gt = xml.find('>', end);
+            if (gt == std::string::npos) return {};
+            const std::size_t close = xml.find('<', gt);
+            return trim(xml.substr(gt + 1u, close == std::string::npos ? std::string::npos : close - gt - 1u));
+        }
+        at = end;
+    }
+    return {};
+}
+
+std::optional<WanService> find_wan_service(const std::string &description, const std::string &location) {
+    const std::optional<Url> where = parse_url(location);
+    if (!where) return std::nullopt;
+    std::string base = xml_value(description, "URLBase");
+    if (base.empty() || !parse_url(base))
+        base = "http://" + where->host + ":" + std::to_string(where->port) + "/";
+    std::optional<WanService> found;
+    std::size_t at = 0;
+    while ((at = description.find("<service>", at)) != std::string::npos) {
+        const std::size_t end = description.find("</service>", at);
+        const std::string block = description.substr(at, end == std::string::npos ? std::string::npos : end - at);
+        at = end == std::string::npos ? description.size() : end;
+        const std::string type = xml_value(block, "serviceType");
+        const bool ip = type.find(":WANIPConnection:") != std::string::npos;
+        const bool ppp = type.find(":WANPPPConnection:") != std::string::npos;
+        if (!ip && !ppp) continue;
+        std::string control = xml_value(block, "controlURL");
+        if (control.empty()) continue;
+        if (!parse_url(control)) {
+            const std::optional<Url> b = parse_url(base);
+            const std::string root = "http://" + b->host + ":" + std::to_string(b->port);
+            if (control.front() == '/') {
+                control = root + control;
+            } else {
+                std::string dir = b->path.substr(0, b->path.rfind('/') + 1u);
+                control = root + dir + control;
+            }
+        }
+        // An IP connection before a PPP one: a router that lists both is
+        // usually connected through the first.
+        if (!found || (ip && found->type.find(":WANPPPConnection:") != std::string::npos))
+            found = WanService{type, control};
+    }
+    return found;
+}
+
+std::string soap_body(const std::string &service, const std::string &action,
+                      const std::vector<std::pair<std::string, std::string>> &arguments) {
+    std::string body = "<?xml version=\"1.0\"?>\r\n"
+                       "<s:Envelope xmlns:s=\"http://schemas.xmlsoap.org/soap/envelope/\" "
+                       "s:encodingStyle=\"http://schemas.xmlsoap.org/soap/encoding/\"><s:Body><u:" +
+                       action + " xmlns:u=\"" + service + "\">";
+    for (const auto &[name, value] : arguments) body += "<" + name + ">" + escape(value) + "</" + name + ">";
+    body += "</u:" + action + "></s:Body></s:Envelope>\r\n";
+    return body;
+}
+
+std::optional<HttpResponse> parse_http_response(const std::string &raw) {
+    const std::size_t split = raw.find("\r\n\r\n");
+    if (split == std::string::npos || raw.rfind("HTTP/", 0) != 0) return std::nullopt;
+    const std::string head = raw.substr(0, split);
+    HttpResponse response;
+    const std::size_t space = head.find(' ');
+    if (space == std::string::npos) return std::nullopt;
+    response.status = std::atoi(head.c_str() + space + 1u);
+    std::string body = raw.substr(split + 4u);
+    if (lower(header(head, "Transfer-Encoding")).find("chunked") != std::string::npos) {
+        std::string joined;
+        std::size_t at = 0;
+        while (at < body.size()) {
+            const std::size_t line = body.find("\r\n", at);
+            if (line == std::string::npos) break;
+            const unsigned long size = std::strtoul(body.substr(at, line - at).c_str(), nullptr, 16);
+            if (size == 0u) break;
+            joined += body.substr(line + 2u, size);
+            at = line + 2u + size + 2u;
+        }
+        body = joined;
+    }
+    response.body = body;
+    return response;
+}
