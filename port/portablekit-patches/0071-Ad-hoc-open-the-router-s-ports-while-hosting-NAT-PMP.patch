+// The server's two ports and the game's own, asked of the router, unless the
+// setting or <PREFIX>_NO_ROUTER_PORTS turns that off.
+void open_router_ports(std::uint16_t adhocctl_port, const std::vector<adhoc::ForwardedPort> &also) {
+    const char *off = std::getenv(portablekit::env_name("NO_ROUTER_PORTS").c_str());
+    if (!settings::current().adhoc_router_ports || (off != nullptr && *off != '\0' && *off != '0')) return;
+    std::vector<adhoc::ForwardedPort> ports = {{false, adhocctl_port}, {false, adhoc::relay_port_for(adhocctl_port)}};
+    for (const adhoc::ForwardedPort &port : also)
+        if (std::find(ports.begin(), ports.end(), port) == ports.end()) ports.push_back(port);
+    adhoc::PortMapper::get().start(ports);
+}
+
 } // namespace
 
+void adhoc_host_forward_also(adhoc::ForwardedPort port) {
+    HostState &state = host();
+    std::lock_guard lock(state.mutex);
+    if (std::find(state.also.begin(), state.also.end(), port) == state.also.end()) state.also.push_back(port);
+}
