+// NAT-PMP and UPnP messages, against canned replies of the kind real routers
+// send.
+void router_messages() {
+    using namespace portablekit::adhoc::router_wire;
+    const std::vector<std::uint8_t> map = natpmp_map_request(true, 27420, 27420, 3600);
+    check(map == std::vector<std::uint8_t>{0, 1, 0, 0, 0x6B, 0x1C, 0x6B, 0x1C, 0, 0, 0x0E, 0x10},
+          "NAT-PMP: a UDP mapping request");
+    const std::uint8_t address_reply[] = {0, 128, 0, 0, 0, 0, 0x12, 0x34, 203, 0, 113, 7};
+    const auto address = natpmp_parse(address_reply, sizeof(address_reply));
+    check(address && address->result == 0 && Address::ipv4_address(address->external_address, 0).host() == "203.0.113.7",
+          "NAT-PMP: the outside address from a reply");
+    const std::uint8_t map_reply[] = {0, 130, 0, 0, 0, 0, 0, 9, 0x6A, 0xB0, 0x6A, 0xB1, 0, 0, 0x0E, 0x10};
+    const auto mapped = natpmp_parse(map_reply, sizeof(map_reply));
+    check(mapped && mapped->opcode == 130 && mapped->internal_port == 27312 && mapped->external_port == 27313 &&
+              mapped->lifetime == 3600,
+          "NAT-PMP: a TCP mapping reply, with the port the router chose");
+    check(!natpmp_parse(map_reply, 10), "NAT-PMP: a short reply is refused");
+
+    const std::string ssdp = "HTTP/1.1 200 OK\r\nCACHE-CONTROL: max-age=120\r\n"
+                             "ST: urn:schemas-upnp-org:device:InternetGatewayDevice:1\r\n"
+                             "Location: http://192.168.1.1:5000/rootDesc.xml\r\nSERVER: Router UPnP/1.1\r\n\r\n";
+    check(ssdp_gateway_location(ssdp) == "http://192.168.1.1:5000/rootDesc.xml", "SSDP: a gateway's location");
+    check(ssdp_gateway_location("HTTP/1.1 200 OK\r\nST: urn:schemas-upnp-org:device:MediaServer:1\r\n"
+                                "LOCATION: http://192.168.1.9/d.xml\r\n\r\n")
+              .empty(),
+          "SSDP: a device that is no gateway is passed over");
+
+    const std::string description =
+        "<?xml version=\"1.0\"?><root><device><deviceList><device><serviceList>"
+        "<service><serviceType>urn:schemas-upnp-org:service:WANPPPConnection:1</serviceType>"
+        "<controlURL>/ctl/PPP</controlURL></service>"
+        "<service><serviceType>urn:schemas-upnp-org:service:WANIPConnection:1</serviceType>"
+        "<controlURL>ctl/IPConn</controlURL></service>"
+        "</serviceList></device></deviceList></device></root>";
+    const auto service = find_wan_service(description, "http://192.168.1.1:5000/desc/rootDesc.xml");
+    check(service && service->type == "urn:schemas-upnp-org:service:WANIPConnection:1" &&
+              service->control_url == "http://192.168.1.1:5000/ctl/IPConn",
+          "UPnP: the IP connection service, its control URL made whole");
+
+    const std::string body = soap_body("urn:schemas-upnp-org:service:WANIPConnection:1", "AddPortMapping",
+                                       {{"NewExternalPort", "27312"}, {"NewPortMappingDescription", "A & B"}});
+    check(body.find("<u:AddPortMapping xmlns:u=\"urn:schemas-upnp-org:service:WANIPConnection:1\">") !=
+                  std::string::npos &&
+              body.find("<NewPortMappingDescription>A &amp; B</NewPortMappingDescription>") != std::string::npos,
+          "UPnP: a SOAP request body, its values escaped");
+
+    const auto fault = parse_http_response("HTTP/1.1 500 Internal Server Error\r\nTransfer-Encoding: chunked\r\n\r\n"
+                                           "1c\r\n<s:Envelope><s:Body><UPnPErr\r\n"
+                                           "1f\r\nor><errorCode>718</errorCode></\r\n"
+                                           "13\r\nUPnPError></s:Body>\r\n0\r\n\r\n");
+    check(fault && fault->status == 500 && xml_value(fault->body, "errorCode") == "718",
+          "UPnP: a chunked fault's error code");
+    check(xml_value("<s:Body><u:GetExternalIPAddressResponse><NewExternalIPAddress>198.51.100.4"
+                    "</NewExternalIPAddress></u:GetExternalIPAddressResponse></s:Body>",
+                    "NewExternalIPAddress") == "198.51.100.4",
+          "UPnP: the outside address from a reply");
+    check(describe_ports({{false, 27312}, {false, 27313}, {true, 27420}}) == "TCP 27312, 27313 and UDP 27420",
+          "the ports in words");
+}
