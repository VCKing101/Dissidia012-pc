     }
 }
 
+// The test profile's region release (TEST00002) announces its own disc id: on a
+// server it meets the profile's own product code (TEST00001), and with
+// regions_apart it is kept apart as before. Loopback alone.
+void region_releases_meet() {
+    for (const bool apart : {false, true}) {
+        const std::string label = apart ? "regions apart: " : "regions meet: ";
+        Server server;
+        std::uint16_t port = 0;
+        for (std::uint16_t candidate = 39412; candidate < 39500 && port == 0u; candidate += 2) {
+            ServerConfig config;
+            config.adhocctl_port = candidate;
+            config.loopback_only = true;
+            config.public_server = true;
+            config.regions_apart = apart;
+            if (server.start(config)) port = candidate;
+        }
+        check(port != 0u, label + "a loopback server starts");
+        if (port == 0u) continue;
+        const std::size_t joined_size = ctl::server_packet_size(ctl::kConnectBssid);
+        const std::size_t peer_size = ctl::server_packet_size(ctl::kConnect);
+        Raw own(port);
+        own.send(ctl::login(kMacA, "HunterA", "TEST00001", "one"));
+        own.send(ctl::connect("LOBBY0"));
+        check(own.read(joined_size).has_value(), label + "the profile's disc joins LOBBY0");
+        Raw other(port);
+        other.send(ctl::login(kMacB, "HunterB", "TEST00002", "one"));
+        other.send(ctl::connect("LOBBY0"));
+        if (!apart) {
+            const auto told = other.read(peer_size);
+            check(told && static_cast<std::uint8_t>((*told)[0]) == ctl::kConnect &&
+                      wire::get_mac(told->data() + 1 + ctl::kNicknameLength) == kMacA,
+                  label + "the region release's player is told about the profile's");
+            const auto told_own = own.read(peer_size);
+            check(told_own && static_cast<std::uint8_t>((*told_own)[0]) == ctl::kConnect &&
+                      wire::get_mac(told_own->data() + 1 + ctl::kNicknameLength) == kMacB,
+                  label + "and the profile's player about the region release's");
+        } else {
+            check(other.read(joined_size).has_value() && !own.read(1u, 500).has_value(),
+                  label + "each disc's player has a LOBBY0 of its own");
+        }
+        bool products_kept = false;
+        wait_until([&] {
+            int own_disc = 0, region_disc = 0;
+            for (const ServerPlayer &p : server.status().players) {
+                own_disc += p.product == "TEST00001";
+                region_disc += p.product == "TEST00002";
+            }
+            return products_kept = own_disc == 1 && region_disc == 1;
+        });
+        check(products_kept, label + "the status keeps the product code each game announced");
+        server.stop();
+    }
+}
