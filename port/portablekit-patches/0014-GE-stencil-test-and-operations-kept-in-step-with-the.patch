+// stencil bit plane adds its weight where the stencil has that bit, through
+// the stencil test (an equal test on the one bit) and additive alpha.
+void VulkanRenderer::Impl::copy_stencil_to_alpha(Target &target) {
+    target.stencil_sync = Target::StencilSync::Same;
