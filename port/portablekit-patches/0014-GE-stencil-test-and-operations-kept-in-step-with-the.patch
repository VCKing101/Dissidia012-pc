+    target.stencil_sync = Target::StencilSync::Same;
+    perf::count_stencil_copy();
+}
+
+void VulkanRenderer::Impl::bring_alpha_up_to_date(Target &target) {
+    if (target.stencil_sync != Target::StencilSync::StencilNewer || !target.initialized) return;
+    const std::uint32_t last_drawn = last_drawn_target;
