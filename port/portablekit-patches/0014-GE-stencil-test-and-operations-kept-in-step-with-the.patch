+        return;
+    }
+    static const bool trace = portablekit::env("TRACE_STENCIL") != nullptr;
+    if (trace)
+        std::cout << "[stencil] frame " << frames << " stencil of 0x" << std::hex << target.address << std::dec
+                  << " from the alpha (format " << target.format << ")\n";
