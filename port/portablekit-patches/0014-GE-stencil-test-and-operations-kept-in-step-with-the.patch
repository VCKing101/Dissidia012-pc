+// The PSP's stencil is the frame buffer's alpha bits. The renderer keeps it in
+// an 8-bit stencil attachment, as the value those bits read as when widened by
+// repeating them: 0 or 0xFF in 5551, a multiple of 0x11 in 4444, the alpha
+// byte in 8888. The alpha channel of the colour target then holds the same
+// number over 255, and a value the GE writes lands in the bits the format
+// keeps (bit 7 in 5551, the high nibble in 4444). Whether the GE widens the
+// bits this way when it compares has not been measured; for the reference and
+// mask pairs seen so far (0x80 with mask 0x80, 0 with mask 0x80) it makes no
+// difference. 5650 has no alpha, and so no stencil.
+std::uint32_t stored_stencil(std::uint32_t format, std::uint32_t value) {
+    switch (format) {
+    case 1u: return (value & 0x80u) != 0u ? 0xFFu : 0u;
+    case 2u: return ((value >> 4u) & 0xFu) * 0x11u;
+    default: return value & 0xFFu;
+    }
+}
+
+// The stencil bits a draw may write, from the same pixel mask as
+// pixel_write_mask(): the alpha bit of a 5551 pixel (bit 15 of 0xE8, read as
+// the 16-bit pixel), the alpha nibble of a 4444 pixel (bits 12..15, each one
+// widened to both nibbles of the stored value), the alpha byte (0xE9) in 8888.
+std::uint32_t stencil_write_mask(std::uint32_t format, std::uint32_t color_mask, std::uint32_t alpha_mask) {
+    static const bool ignore = portablekit::env("NO_PIXEL_MASK") != nullptr;
+    if (ignore) return 0xFFu;
+    switch (format) {
+    case 1u: return (color_mask & 0x8000u) != 0u ? 0u : 0xFFu;
+    case 2u: {
+        const std::uint32_t nibble = ~(color_mask >> 12u) & 0xFu;
+        return nibble | (nibble << 4u);
+    }
+    default: return ~alpha_mask & 0xFFu;
+    }
+}
+
+// One bit plane of the stored stencil, as the passes that copy between the
+// stencil and the alpha channel take it: the bit tested (in the stored stencil
+// and in the alpha byte alike), the stencil bits a set alpha bit stands for,
+// and its weight in the alpha byte.
+struct StencilPlane {
+    std::uint32_t bit;
+    std::uint32_t stencil_bits;
+    std::uint32_t weight;
+};
+std::vector<StencilPlane> stencil_planes(std::uint32_t format) {
+    std::vector<StencilPlane> planes;
+    switch (format) {
+    case 0u: break;
+    case 1u: planes.push_back({0x80u, 0xFFu, 0xFFu}); break;
+    case 2u:
+        for (std::uint32_t k = 0; k < 4u; ++k) planes.push_back({0x10u << k, 0x11u << k, 0x11u << k});
+        break;
+    default:
+        for (std::uint32_t b = 0; b < 8u; ++b) planes.push_back({1u << b, 1u << b, 1u << b});
+        break;
+    }
+    return planes;
+}
+
+VkStencilOp to_stencil_op(std::uint32_t operation) {
+    switch (operation) {
+    case 1u: return VK_STENCIL_OP_ZERO;
+    case 2u: return VK_STENCIL_OP_REPLACE;
+    case 3u: return VK_STENCIL_OP_INVERT;
+    case 4u: return VK_STENCIL_OP_INCREMENT_AND_CLAMP;
+    case 5u: return VK_STENCIL_OP_DECREMENT_AND_CLAMP;
+    default: return VK_STENCIL_OP_KEEP;
+    }
+}
