     bool cull_clockwise_{};
diff --git a/host/gpu/shaders/ge.frag b/host/gpu/shaders/ge.frag
index aba5143..c46e302 100644
--- a/host/gpu/shaders/ge.frag
+++ b/host/gpu/shaders/ge.frag
@@ -71,7 +71,27 @@ void main() {
         return;
     }
     int alpha_function = int(push.texture_params.w + 0.5);
-    float reference = push.texture_params.z / 255.0;
+    // texture_params.z: the reference, plus 256 times a mask when only some
+    // bits of the alpha byte are tested; those are compared exactly. The
+    // renderer's copies from alpha to stencil test one bit at a time this way.
+    int packed = int(push.texture_params.z + 0.5);
+    int alpha_mask = packed >> 8;
+    if (alpha_mask != 0) {
+        int value = int(color.a * 255.0 + 0.5) & alpha_mask;
+        int wanted = packed & alpha_mask;
+        bool hit = true;
+        if (alpha_function == 1) hit = false;
+        else if (alpha_function == 2) hit = value == wanted;
+        else if (alpha_function == 3) hit = value != wanted;
+        else if (alpha_function == 4) hit = value < wanted;
+        else if (alpha_function == 5) hit = value <= wanted;
+        else if (alpha_function == 6) hit = value > wanted;
+        else if (alpha_function == 7) hit = value >= wanted;
+        if (!hit) discard;
+        out_color = color;
+        return;
+    }
+    float reference = float(packed & 255) / 255.0;
     float alpha = color.a;
     bool passed = true;
     if (alpha_function == 1) passed = false;                     // never
