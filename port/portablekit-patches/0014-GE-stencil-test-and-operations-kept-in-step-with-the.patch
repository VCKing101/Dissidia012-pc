+// test: not equal to 0 under a one-bit mask) and a replacing stencil write
+// limited to that plane.
+void VulkanRenderer::Impl::copy_alpha_to_stencil(Target &target) {
+    const std::vector<StencilPlane> planes = stencil_planes(target.format);
