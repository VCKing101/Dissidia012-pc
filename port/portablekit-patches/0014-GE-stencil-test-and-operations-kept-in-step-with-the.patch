+// The stencil test and its operations (0x24, 0xDC, 0xDD). The PSP keeps the
+// stencil in the frame buffer's alpha bits: one in 5551, four in 4444, eight in
+// 8888, none in 5650. Field layout as the PSP SDK's sceGuStencilFunc and
+// sceGuStencilOp pack it, which the traced values bear out: 0xDC is the
+// function in bits 0..7, the reference in 8..15 and the mask in 16..23; 0xDD
+// the operations on a failed stencil test, a failed depth test and a pass, in
+// that order a byte each. Functions as the depth test's (0 never, 1 always,
+// 2 equal, 3 not equal, 4..7 less, less or equal, greater, greater or equal);
+// operations 0 keep, 1 zero, 2 replace, 3 invert, 4 increment, 5 decrement.
+struct StencilState {
+    bool test_enabled{};
+    std::uint32_t function{1u};
+    std::uint32_t reference{};
+    std::uint32_t mask{0xFFu};
+    std::uint32_t fail{};
+    std::uint32_t depth_fail{};
+    std::uint32_t pass{};
+};
+
 struct ViewportState {
     float x_scale{}, y_scale{}, z_scale{};
     float x_offset{}, y_offset{}, z_offset{};
@@ -167,6 +186,7 @@ struct DrawCall {
     BlendState blend;
     DepthState depth;
     AlphaTestState alpha_test;
+    StencilState stencil;
     ViewportState viewport;
     bool culling_enabled{};
     bool cull_clockwise{};
@@ -294,6 +314,7 @@ private:
     BlendState blend_{};
     DepthState depth_{};
     AlphaTestState alpha_test_{};
+    StencilState stencil_{};
     ViewportState viewport_{};
