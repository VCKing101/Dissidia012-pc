+// "N players on", or nothing while the port does not know.
+std::string public_players_text() {
+    const auto players = portablekit::game().public_server_players;
+    const int count = players != nullptr ? players() : -1;
+    if (count < 0) return {};
+    return count == 1 ? "1 player on" : std::to_string(count) + " players on";
+}
+
+// Play online, with a port's public server (GameProfile::public_server).
+void play_online() {
+    const settings::Settings &s = settings::current();
+    section("Play online");
+    std::string note;
+    const std::string address =
+        s.adhoc_online_server.empty() ? portablekit::game().public_server(note) : s.adhoc_online_server;
+    const std::string players = public_players_text();
+    if (adhoc_online()) {
+        info_row("Playing online", (players.empty() ? std::string() : players + ". ") +
+                                       "Go online in the game: everyone on the server is in its lobbies.");
+        if (button_row("Stop playing online###choice",
+                       {false, {},
+                        "Leaves the server at once, as a lost connection does. Nothing is chosen then: the game asks "
+                        "again how to play the next time it goes online."},
+                       colors::kDanger))
+            adhoc_choose_nothing();
+    } else {
+        const std::string label = "Play online" + (players.empty() ? std::string() : "   " + players) + "###online";
+        if (button_row(label.c_str(),
+                       {false, {},
+                        "Plays through the game's own server: everyone online is in the game's lobbies, with no "
+                        "hosting and no addresses to send. Stops hosting or a joined session. Remembered."}))
+            adhoc_play_online();
+    }
+    if (address.empty() && !note.empty()) info_row("Server", note);
+    else if (!s.adhoc_online_server.empty()) info_row("Server", s.adhoc_online_server + "   from Online server, below");
+}
