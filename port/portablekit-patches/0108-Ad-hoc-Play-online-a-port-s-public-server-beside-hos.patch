diff --git a/host/adhoc/host.cpp b/host/adhoc/host.cpp
index 561bc9a..56f582b 100644
--- a/host/adhoc/host.cpp
+++ b/host/adhoc/host.cpp
@@ -28,6 +28,7 @@ struct HostState {
     std::string error;
     std::uint16_t port{};
     std::vector<adhoc::ForwardedPort> also;  // the game's own ports to forward
+    std::string joined;  // with a public server: the session joined in this run
 };
 
 // Never destroyed: the discovery thread asks the server for its player count
@@ -81,13 +82,85 @@ std::string adhoc_server_address() {
         const std::uint16_t port = host().port;
         return port == adhoc::kAdhocctlPort ? std::string("127.0.0.1") : "127.0.0.1:" + std::to_string(port);
     }
-    return settings::current().adhoc_server;
+    const settings::Settings &s = settings::current();
+    if (!adhoc_has_public_server()) return s.adhoc_server;
+    if (std::string joined = adhoc_joined(); !joined.empty()) return joined;
+    if (!s.adhoc_server.empty() && !settings::overridden_by("network.server").empty()) return s.adhoc_server;
+    if (!s.adhoc_online) return {};
+    if (!s.adhoc_online_server.empty()) return s.adhoc_online_server;
+    std::string note;
+    return portablekit::game().public_server(note);
+}
+
+bool adhoc_has_public_server() { return portablekit::game().public_server != nullptr; }
+
+bool adhoc_online() { return adhoc_has_public_server() && settings::current().adhoc_online; }
+
+std::string adhoc_joined() {
+    HostState &state = host();
+    std::lock_guard lock(state.mutex);
+    return state.joined;
+}
+
+namespace {
+
+// Play online chosen or not, unless an environment variable decides it.
+void set_online(settings::Settings &s, bool online) {
+    if (settings::overridden_by("network.online").empty()) s.adhoc_online = online;
+}
+
+// Hosting ends: announcing, the server and the router's ports.
+void stop_hosting_locked(HostState &state) {
+    if (!state.server.running()) return;
+    adhoc::Discovery::get().stop_announcing();
+    state.server.stop();
+    state.port = 0u;
+    adhoc::PortMapper::get().stop();
+}
+
+} // namespace
+
+void adhoc_play_online() {
+    HostState &state = host();
+    {
+        std::lock_guard lock(state.mutex);
+        stop_hosting_locked(state);
+        state.joined.clear();
+    }
+    settings::Settings &s = settings::current();
+    set_online(s, true);
+    if (settings::overridden_by("network.adhoc").empty()) s.adhoc = true;
+    settings::save();
+    adhoc::Client::log("[adhoc] playing online", true);
+    adhoc_apply_settings(true);
+}
+
+void adhoc_choose_nothing() {
+    HostState &state = host();
+    {
+        std::lock_guard lock(state.mutex);
+        stop_hosting_locked(state);
+        state.joined.clear();
+    }
+    settings::Settings &s = settings::current();
+    set_online(s, false);
+    settings::save();
+    adhoc::Client::log("[adhoc] nothing chosen: not online", true);
+    adhoc_apply_settings(true);
 }
 
 bool adhoc_host_start() {
     HostState &state = host();
     std::vector<adhoc::ForwardedPort> also;
     std::uint16_t port = 0;
+    if (adhoc_has_public_server()) {
+        // Hosting is a choice of its own: not Play online, nor a joined session.
+        {
+            std::lock_guard lock(state.mutex);
+            state.joined.clear();
+        }
+        set_online(settings::current(), false);
+    }
     {
         std::lock_guard lock(state.mutex);
         if (state.server.running()) return true;
@@ -170,16 +243,16 @@ void adhoc_remember(const std::string &address) {
 
 void adhoc_join(const std::string &address) {
     if (address.empty()) return;
-    if (adhoc_hosting()) {
+    {
         HostState &state = host();
         std::lock_guard lock(state.mutex);
-        adhoc::Discovery::get().stop_announcing();
-        state.server.stop();
-        state.port = 0u;
-        adhoc::PortMapper::get().stop();
+        stop_hosting_locked(state);
+        // With a public server a joined session lasts for this run.
+        if (adhoc_has_public_server()) state.joined = address;
     }
     settings::Settings &s = settings::current();
-    if (settings::overridden_by("network.server").empty()) s.adhoc_server = address;
+    if (adhoc_has_public_server()) set_online(s, false);
+    else if (settings::overridden_by("network.server").empty()) s.adhoc_server = address;
     if (settings::overridden_by("network.adhoc").empty()) s.adhoc = true;
     remember(address);
     settings::save();
