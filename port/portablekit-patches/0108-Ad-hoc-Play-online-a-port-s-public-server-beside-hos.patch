+// or the public server's address is not known yet.
 [[nodiscard]] std::string adhoc_server_address();
 
+// Play online (GameProfile::public_server) ---------------------------------------
+// Three choices, one at a time: Play online (remembered), hosting and joining
+// (for the run). Choosing one ends the others.
+
+[[nodiscard]] bool adhoc_has_public_server();
+// Play online chosen, whether or not the server's address is known yet.
+[[nodiscard]] bool adhoc_online();
+// Chooses Play online: stops hosting, leaves a joined session, turns ad hoc
+// play on and remembers the choice. The game goes online through it the next
+// time it goes online.
+void adhoc_play_online();
+// Chooses nothing: stops playing online, hosting and a joined session, so the
+// game sees the wireless switch off until a choice is made.
+void adhoc_choose_nothing();
+// The session joined in this run with a public server; empty for none.
+[[nodiscard]] std::string adhoc_joined();
+
 // Hosting (adhoc/host.cpp) ------------------------------------------------------
 
 // <prefix>_ADHOC_LOOPBACK: hosting listens on 127.0.0.1 alone, asks no router
@@ -62,7 +84,9 @@ void adhoc_shutdown() noexcept;
 
 // Joining: makes `address` ("host" or "host:port") the server, remembers it
 // among the recent ones, turns ad hoc play on and uses it at once. Stops
-// hosting first if this instance hosts.
+// hosting first if this instance hosts. With a public server the session is
+// joined for this run only (the Server setting is left alone) and Play online
+// is no longer chosen.
 void adhoc_join(const std::string &address);
 
 // Puts `address` first among the recent ones, as joining does, for a server
