+IsoImage::~IsoImage() {
+    stop_ = true;
+    if (reader_.joinable()) reader_.join();
+}
+
+void IsoImage::read_through_in_background() {
+    if (reader_.joinable() || size_bytes_ == 0u) return;
+    const std::uint64_t memory = physical_memory();
+    if (memory != 0u && size_bytes_ > memory / 2u) {
+        std::cout << "[io] the disc image (" << (size_bytes_ >> 20u) << " MiB) is not read through: more than half "
+                  << "of this machine's memory\n";
+        return;
+    }
+    std::cout << "[io] reading the disc image through in the background (" << (size_bytes_ >> 20u)
+              << " MiB), so that later reads come from memory\n";
+    reader_ = std::thread([this] {
+#if defined(_WIN32)
+        // Background mode lowers the thread's I/O priority too, so the
+        // game's own reads go first.
+        SetThreadPriority(GetCurrentThread(), THREAD_MODE_BACKGROUND_BEGIN);
+#endif
+        const auto started = std::chrono::steady_clock::now();
+        std::ifstream in(path_, std::ios::binary);
+        std::vector<char> chunk(1u << 20u);
+        std::uint64_t done = 0u;
+        while (in && !stop_ && done < size_bytes_) {
+            in.read(chunk.data(), static_cast<std::streamsize>(chunk.size()));
+            if (in.gcount() <= 0) break;
+            done += static_cast<std::uint64_t>(in.gcount());
+        }
+        if (stop_) return;
+        const double seconds = std::chrono::duration<double>(std::chrono::steady_clock::now() - started).count();
+        std::cout << "[io] disc image read through: " << (done >> 20u) << " MiB in " << seconds << " s\n"
+                  << std::flush;
+    });
+}
