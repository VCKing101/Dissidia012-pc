+    const auto value = sfo_find(sfo, key);
+    if (!value || value->format == 0x0404u) return std::nullopt;
+    const auto *text = reinterpret_cast<const char *>(sfo.data() + value->at);
+    return std::string(text, strnlen(text, value->length));
