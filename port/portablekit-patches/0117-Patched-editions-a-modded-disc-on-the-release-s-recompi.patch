+                if (trace && taken != 0u)
+                    std::cout << "[patched] " << psprecomp::hex32(address) << ": " << psprecomp::hex32(le32(release + at))
+                              << " -> " << psprecomp::hex32(le32(memory + at)) << ", " << taken << " addresses interpreted"
+                              << std::endl;
+            }
+        }
+        offset += length;
+    }
+    // Words of the executable's data change as the game runs: only code is news.
+    if (units != 0u)
+        std::cout << "[patched] the executable: " << words << " changed word" << (words == 1u ? "" : "s") << ", "
+                  << units << " more recompiled unit" << (units == 1u ? "" : "s") << " interpreted" << std::endl;
+}
+
+void read_release_overlays() {
+    State &s = state();
+    if (s.overlays_read) return;
+    s.overlays_read = true;
+    if (s.release_disc.empty()) return;
+    IsoImage disc(s.release_disc);
+    // Every executable image the disc holds beside the main one.
+    std::vector<std::string> pending{"PSP_GAME/USRDIR"};
+    while (!pending.empty()) {
+        const std::string directory = pending.back();
+        pending.pop_back();
+        for (const std::string &name : disc.list(directory)) {
+            const std::string path = directory + "/" + name;
+            const auto entry = disc.find(path);
+            if (!entry) continue;
+            if (entry->directory) {
+                pending.push_back(path);
+                continue;
+            }
+            if (entry->size < 0x54u || entry->size > 32u * 1024u * 1024u) continue;
+            std::uint8_t magic[4]{};
+            if (disc.read(std::uint64_t(entry->lba) * IsoImage::kSectorSize, magic) != 4u ||
+                std::memcmp(magic, "\x7F" "ELF", 4u) != 0)
+                continue;
+            if (auto bytes = read_file(disc, path)) s.overlay_files.push_back(std::move(*bytes));
+        }
+    }
+}
+
+} // namespace
+
+std::filesystem::path requested_disc() {
+    if (portablekit::env("NO_PATCHED_DISC") != nullptr) return {};
+    if (const char *path = portablekit::env("PATCHED_DISC"); path != nullptr && *path != '\0') return path;
+    if (game().patched_disc != nullptr) return game().patched_disc();
+    return {};
+}
+
+namespace {
+std::filesystem::path &release_disc_path() {
+    static std::filesystem::path path;
+    return path;
+}
+} // namespace
+
+void set_release_disc(const std::filesystem::path &disc) { release_disc_path() = disc; }
+std::filesystem::path release_disc() { return release_disc_path(); }
+
+std::optional<Edition> open(const std::filesystem::path &path, std::string &why) {
+    std::error_code ec;
+    if (!std::filesystem::is_regular_file(path, ec)) {
+        why = "the file is not there";
+        return std::nullopt;
+    }
+    std::optional<IsoImage> opened;
+    try {
+        opened.emplace(path);
+    } catch (const std::exception &e) {
+        why = e.what();
+        return std::nullopt;
+    }
+    IsoImage &disc = *opened;
+    auto executable = read_file(disc, game().executable_path_on_disc);
+    if (!executable) {
+        why = "it has no executable";
+        return std::nullopt;
+    }
+    if (executable->size() < 4u || std::memcmp(executable->data(), "\x7F" "ELF", 4u) != 0) {
+        why = "its executable is encrypted, so no patch to it can be read";
+        return std::nullopt;
+    }
+    const auto sfo = read_file(disc, game().param_sfo_path_on_disc);
+    const std::optional<std::string> disc_id = sfo ? sfo_string(*sfo, "DISC_ID") : std::nullopt;
+    const bool ours = disc_id && (*disc_id == game().disc_id || find_region_release(*disc_id) != nullptr);
+    if (!ours) {
+        why = "it is not " + std::string(game().game_title) + " (disc " + disc_id.value_or("unknown") + ")";
+        return std::nullopt;
+    }
+    Edition edition;
+    edition.disc = path;
+    edition.executable = std::move(*executable);
+    edition.ram_bytes = game().guest_ram_bytes;
+    if (sfo_integer(*sfo, "MEMSIZE").value_or(0u) != 0u) edition.ram_bytes = std::max(edition.ram_bytes, kLargeMemory);
+    return edition;
+}
+
+void begin(psprecomp::Runtime &runtime, const Edition &edition, std::uint32_t load_base, std::uint32_t code_end,
+           const std::filesystem::path &release_disc) {
+    State &s = state();
+    s.active = true;
+    s.release_disc = release_disc;
+    s.code_start = load_base;
+    s.code.resize(code_end - load_base);
+    for (std::uint32_t i = 0; i < s.code.size(); ++i) s.code[i] = runtime.memory().load8(load_base + i);
+
+    const psprecomp::Elf32Image elf = psprecomp::Elf32Image::from_bytes(edition.executable, "patched executable");
+    (void)elf.load_and_relocate(runtime.memory(), load_base);
+    std::cout << "[patched] playing " << edition.disc.filename().string() << ", " << (edition.ram_bytes >> 20u)
+              << " MiB of memory" << std::endl;
+    compare_code(runtime, load_base, code_end);
+}
+
+bool active() noexcept { return state().active; }
+
+void code_flushed(psprecomp::Runtime &runtime) {
+    State &s = state();
+    if (s.active) compare_code(runtime, s.code_start, s.code_start + static_cast<std::uint32_t>(s.code.size()));
+}
+
+void data_flushed(psprecomp::Runtime &runtime, std::uint32_t address, std::uint32_t size) {
+    if (!state().active) return;
+    const std::uint32_t canonical = address & 0x1FFFFFFFu;
+    compare_code(runtime, canonical, canonical + size);
+}
+
+const std::vector<std::uint8_t> *overlay_baseline(std::uint32_t base, std::uint32_t code_size, std::uint64_t hash) {
+    State &s = state();
+    if (const auto found = s.baselines.find(hash); found != s.baselines.end()) return &found->second;
+    read_release_overlays();
+    const std::size_t window = kOverlayHeaderBytes + std::size_t{code_size};
+    for (const std::vector<std::uint8_t> &file : s.overlay_files) {
+        if (file.size() < 0x34u) continue;
+        const std::uint32_t table = le32(file.data() + 28u);
+        const std::uint32_t count = le16(file.data() + 44u), entry = le16(file.data() + 42u);
+        for (std::uint32_t i = 0; i < count && table + (i + 1u) * entry <= file.size(); ++i) {
+            const std::uint8_t *row = file.data() + table + i * entry;
+            if (le32(row) != 1u || le32(row + 8u) != base) continue;
+            const std::uint32_t offset = le32(row + 4u), size = le32(row + 16u);
+            if (offset + std::uint64_t{size} > file.size() || size < window) continue;
+            if (fnv1a64(file.data() + offset, window) != hash) continue;
+            auto &image = s.baselines[hash];
+            image.assign(file.begin() + offset, file.begin() + offset + size);
+            return &image;
+        }
+    }
+    return nullptr;
+}
+
+} // namespace portablekit::patched
