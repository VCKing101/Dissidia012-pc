+    std::uint64_t size_ = 0, base_size_ = 0, data_offset_ = 0;
+    std::vector<std::uint32_t> sectors_;  // sorted
+    std::vector<std::uint32_t> slots_;    // kZero, or the sector's index in the data
+    std::ifstream file_;
+};
