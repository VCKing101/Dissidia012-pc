+
+// A patched edition of the game: a disc made from the release by a mod, whose
+// executable is the release's with some of its code changed. Nothing is
+// recompiled for it. The release's recompiled code stays, and each generated
+// unit holding a word the patch changed is taken out of dispatch, so that the
+// interpreter runs that unit from guest memory. The comparison is made with
+// the release's own files, so a new version of a patch needs nothing here.
+//
+// <prefix>_PATCHED_DISC=<image> or GameProfile::patched_disc asks for one;
+// <prefix>_NO_PATCHED_DISC=1 ignores both and starts the release.
+namespace portablekit::patched {
+
+struct Edition {
+    std::filesystem::path disc;
+    // The disc's PSP_GAME/SYSDIR/EBOOT.BIN, a plain executable.
+    std::vector<std::uint8_t> executable;
+    // 64 MiB when the disc's PARAM.SFO asks for the larger memory (MEMSIZE).
+    std::uint32_t ram_bytes{};
+};
+
+// The patched disc this start was asked for; empty for the release.
+[[nodiscard]] std::filesystem::path requested_disc();
+
+// The release's disc image this start found, whichever disc it plays: what a
+// disc patch is applied to (disc_patch.hpp).
+void set_release_disc(const std::filesystem::path &disc);
+[[nodiscard]] std::filesystem::path release_disc();
+
+// Reads a patched disc. Empty, with `why` said, when it cannot be played as one.
+[[nodiscard]] std::optional<Edition> open(const std::filesystem::path &disc, std::string &why);
+
+// Puts the edition's executable over the release's, already loaded and
+// registered, and takes the units it changed out of dispatch. `code_end` is
+// where the release's own image stops being comparable (its first overlay
+// slot). `release_disc` is read for the release's overlays.
+void begin(psprecomp::Runtime &runtime, const Edition &edition, std::uint32_t load_base, std::uint32_t code_end,
+           const std::filesystem::path &release_disc);
+
+// True for the whole run once begin() was called.
+[[nodiscard]] bool active() noexcept;
+
+// The guest flushed a cache: code it wrote over the executable's stops running
+// recompiled from here on.
+void code_flushed(psprecomp::Runtime &runtime);
+void data_flushed(psprecomp::Runtime &runtime, std::uint32_t address, std::uint32_t size);
+
+// The release's image of the overlay a corpus was generated from: what is
+// loaded at `base`, found on the release's disc by the corpus's own hash over
+// its header and first `code_size` bytes. Null when the disc has none.
+[[nodiscard]] const std::vector<std::uint8_t> *overlay_baseline(std::uint32_t base, std::uint32_t code_size,
+                                                                std::uint64_t hash);
+
+} // namespace portablekit::patched
