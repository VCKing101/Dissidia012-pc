+// Disc patches (disc_patch.hpp).
+//
+// VCDIFF is RFC 3284. xdelta3 adds an Adler-32 of each target window (window
+// indicator bit 2) and secondary compression of the three sections of a
+// window (header indicator bit 0, then a compressor id; delta indicator bits
+// 0-2 say which sections are compressed). Its LZMA compressor (id 2) keeps
+// one xz stream per kind of section for the whole file: the first compressed
+// section of a kind starts with the stream and block headers, and every one
+// ends at a sync flush, so each holds whole LZMA2 chunks that continue the
+// stream before it. A compressed section is the size it decompresses to (a
+// VCDIFF integer), then those chunks.
+//
+// The LZMA and LZMA2 decoding below follows the public LZMA specification
+// (the range coder, the literal, length and distance coders, the state
+// machine) and the xz file format's description of its stream and block
+// headers; the code is this file's own.
+//
+// The layer file, little-endian:
+//   0  "PKDISC1\0"
+//   8  u32 version (1), 12 u32 sector size (2048)
+//   16 u64 size of the patched image, 24 u64 size of the release's image
+//   32 u64 changed sectors N, 40 u64 offset of the sector table, 48 u64 offset of the data
+//   56 u32 length of the release image's path, 60 u32 length of a note
+//   64 the path (UTF-8), the note
+//   the table: N times {u32 sector, u32 slot}, sorted by sector; slot 0xFFFFFFFF: zeros
+//   the data: one 2048-byte sector per slot
+#include "disc_patch.hpp"
+
+#include "install/user_data.hpp"
+#include "psprecomp/common.hpp"
+
+#include <algorithm>
+#include <array>
+#include <cstring>
+#include <list>
+#include <map>
+#include <optional>
+
+namespace portablekit::disc_patch {
+namespace {
+
+constexpr char kMagic[8] = {'P', 'K', 'D', 'I', 'S', 'C', '1', '\0'};
+constexpr std::uint32_t kSector = 2048u;
+constexpr std::uint32_t kZero = 0xFFFFFFFFu;
+
+std::uint32_t le32(const std::uint8_t *p) {
+    return static_cast<std::uint32_t>(p[0]) | static_cast<std::uint32_t>(p[1]) << 8u |
+           static_cast<std::uint32_t>(p[2]) << 16u | static_cast<std::uint32_t>(p[3]) << 24u;
+}
+std::uint64_t le64(const std::uint8_t *p) { return le32(p) | static_cast<std::uint64_t>(le32(p + 4)) << 32u; }
+void put32(std::vector<std::uint8_t> &out, std::uint32_t v) {
+    for (int i = 0; i < 4; ++i) out.push_back(static_cast<std::uint8_t>(v >> (8 * i)));
+}
+void put64(std::vector<std::uint8_t> &out, std::uint64_t v) {
+    put32(out, static_cast<std::uint32_t>(v));
+    put32(out, static_cast<std::uint32_t>(v >> 32u));
+}
+
+struct Failure {
+    std::string what;
+};
+
+// ---- LZMA2 in an xz stream ------------------------------------------------
+
+class RangeDecoder {
+public:
+    RangeDecoder(const std::uint8_t *data, std::size_t size) : p_(data), end_(data + size) {
+        if (size < 5u || p_[0] != 0u) throw Failure{"an LZMA chunk does not start as one"};
+        ++p_;
+        for (int i = 0; i < 4; ++i) code_ = (code_ << 8u) | *p_++;
+        if (code_ == range_) throw Failure{"an LZMA chunk is damaged"};
+    }
+    std::uint32_t bit(std::uint16_t &probability) {
+        const std::uint32_t bound = (range_ >> 11u) * probability;
+        std::uint32_t result;
+        if (code_ < bound) {
+            range_ = bound;
+            probability = static_cast<std::uint16_t>(probability + ((2048u - probability) >> 5u));
+            result = 0u;
+        } else {
+            range_ -= bound;
+            code_ -= bound;
+            probability = static_cast<std::uint16_t>(probability - (probability >> 5u));
+            result = 1u;
+        }
+        normalize();
+        return result;
+    }
+    std::uint32_t direct(unsigned count) {
+        std::uint32_t result = 0u;
+        while (count-- != 0u) {
+            range_ >>= 1u;
+            code_ -= range_;
+            const std::uint32_t t = 0u - (code_ >> 31u);
+            code_ += range_ & t;
+            normalize();
+            result = (result << 1u) + (t + 1u);
+        }
+        return result;
+    }
+
+private:
+    void normalize() {
+        if (range_ >= (1u << 24u)) return;
+        if (p_ >= end_) throw Failure{"an LZMA chunk ends early"};
+        range_ <<= 8u;
+        code_ = (code_ << 8u) | *p_++;
+    }
+    const std::uint8_t *p_;
+    const std::uint8_t *end_;
+    std::uint32_t range_ = 0xFFFFFFFFu;
+    std::uint32_t code_ = 0u;
+};
+
+std::uint32_t tree(RangeDecoder &rc, std::uint16_t *probs, unsigned bits) {
+    std::uint32_t m = 1u;
+    for (unsigned i = 0; i < bits; ++i) m = (m << 1u) | rc.bit(probs[m]);
+    return m - (1u << bits);
+}
+
+std::uint32_t reverse_tree(RangeDecoder &rc, std::uint16_t *probs, unsigned bits) {
+    std::uint32_t m = 1u, symbol = 0u;
+    for (unsigned i = 0; i < bits; ++i) {
+        const std::uint32_t b = rc.bit(probs[m]);
+        m = (m << 1u) | b;
+        symbol |= b << i;
+    }
+    return symbol;
+}
+
+struct LengthCoder {
+    std::uint16_t choice, choice2;
+    std::uint16_t low[16][8], mid[16][8], high[256];
+    void reset() {
+        choice = choice2 = 1024u;
+        std::fill(&low[0][0], &low[0][0] + 16 * 8, std::uint16_t{1024});
+        std::fill(&mid[0][0], &mid[0][0] + 16 * 8, std::uint16_t{1024});
+        std::fill(std::begin(high), std::end(high), std::uint16_t{1024});
+    }
+    std::uint32_t decode(RangeDecoder &rc, std::uint32_t pos_state) {
+        if (rc.bit(choice) == 0u) return tree(rc, low[pos_state], 3u);
+        if (rc.bit(choice2) == 0u) return 8u + tree(rc, mid[pos_state], 3u);
+        return 16u + tree(rc, high, 8u);
+    }
+};
+
+class XzLzma2 {
+public:
+    // Decodes one section: whole LZMA2 chunks continuing the stream, the
+    // first preceded by the stream and block headers. Appends to `out`.
+    void decode(const std::uint8_t *in, std::size_t size, std::vector<std::uint8_t> &out) {
+        std::size_t at = 0u;
+        if (!stream_started_) {
+            static constexpr std::uint8_t magic[6] = {0xFD, '7', 'z', 'X', 'Z', 0x00};
+            if (size < 12u || std::memcmp(in, magic, 6u) != 0) throw Failure{"a compressed section is not xz"};
+            at = 12u;
+            stream_started_ = true;
+        }
+        if (!block_started_) {
+            if (at >= size) throw Failure{"an xz stream has no block"};
+            const std::size_t length = (static_cast<std::size_t>(in[at]) + 1u) * 4u;
+            if (in[at] == 0u || at + length > size) throw Failure{"an xz block header is damaged"};
+            parse_block_header(in + at, length);
+            at += length;
+            block_started_ = true;
+        }
+        while (at < size && !finished_) {
+            const std::uint8_t control = in[at];
+            if (control == 0x00u) {
+                finished_ = true;  // the stream's end: its index and footer follow
+                break;
+            }
+            if (control == 0x01u || control == 0x02u) {
+                if (at + 3u > size) throw Failure{"an LZMA2 chunk is cut off"};
+                const std::size_t length = ((std::size_t{in[at + 1]} << 8u) | in[at + 2]) + 1u;
+                if (at + 3u + length > size) throw Failure{"an LZMA2 chunk is cut off"};
+                if (control == 0x01u) reset_dictionary();
+                for (std::size_t i = 0; i < length; ++i) put(in[at + 3u + i], out);
+                at += 3u + length;
+                continue;
+            }
+            if (control < 0x80u) throw Failure{"an LZMA2 chunk has an unknown kind"};
+            const unsigned reset = (control >> 5u) & 3u;
+            const std::size_t header = reset >= 2u ? 6u : 5u;
+            if (at + header > size) throw Failure{"an LZMA2 chunk is cut off"};
+            const std::size_t unpacked =
+                ((std::size_t{control & 0x1Fu} << 16u) | (std::size_t{in[at + 1]} << 8u) | in[at + 2]) + 1u;
+            const std::size_t packed = ((std::size_t{in[at + 3]} << 8u) | in[at + 4]) + 1u;
+            if (at + header + packed > size) throw Failure{"an LZMA2 chunk is cut off"};
+            if (reset == 3u) reset_dictionary();
+            if (reset >= 2u) set_properties(in[at + 5]);
+            if (!have_properties_) throw Failure{"an LZMA2 chunk comes before its properties"};
+            if (reset >= 1u) reset_state();
+            RangeDecoder rc(in + at + header, packed);
+            decode_chunk(rc, unpacked, out);
+            at += header + packed;
+        }
+    }
+
+private:
+    static std::uint64_t varint(const std::uint8_t *p, std::size_t size, std::size_t &at) {
+        std::uint64_t value = 0u;
+        for (unsigned shift = 0; shift < 63u; shift += 7u) {
+            if (at >= size) throw Failure{"an xz block header is damaged"};
+            const std::uint8_t b = p[at++];
+            value |= static_cast<std::uint64_t>(b & 0x7Fu) << shift;
+            if ((b & 0x80u) == 0u) return value;
+        }
+        throw Failure{"an xz block header is damaged"};
+    }
+
+    void parse_block_header(const std::uint8_t *p, std::size_t length) {
+        std::size_t at = 1u;
+        const std::uint8_t flags = p[at++];
+        const unsigned filters = (flags & 3u) + 1u;
+        if ((flags & 0x40u) != 0u) (void)varint(p, length - 4u, at);
+        if ((flags & 0x80u) != 0u) (void)varint(p, length - 4u, at);
+        for (unsigned i = 0; i < filters; ++i) {
+            const std::uint64_t id = varint(p, length - 4u, at);
+            const std::uint64_t properties = varint(p, length - 4u, at);
+            if (id != 0x21u || properties != 1u || filters != 1u)
+                throw Failure{"an xz stream uses a filter other than LZMA2"};
+            const std::uint8_t d = p[at++];
+            if (d > 40u) throw Failure{"an xz stream's dictionary size is invalid"};
+            const std::uint64_t bytes =
+                d == 40u ? 0xFFFFFFFFull : (static_cast<std::uint64_t>(2u | (d & 1u)) << (d / 2u + 11u));
+            // A patch's sections are small; a dictionary larger than this would
+            // only cost memory.
+            dictionary_.assign(static_cast<std::size_t>(std::min<std::uint64_t>(bytes, 256ull << 20u)), 0u);
+        }
+        reset_dictionary();
+    }
+
+    void reset_dictionary() {
+        position_ = 0u;
+        filled_ = 0u;
+        total_ = 0u;
+    }
+
+    void set_properties(std::uint8_t d) {
+        if (d >= 9u * 5u * 5u) throw Failure{"an LZMA2 chunk's properties are invalid"};
+        lc_ = d % 9u;
+        d = static_cast<std::uint8_t>(d / 9u);
+        lp_ = d % 5u;
+        pb_ = d / 5u;
+        if (lc_ + lp_ > 4u) throw Failure{"an LZMA2 chunk's properties are invalid"};
+        literals_.assign(std::size_t{0x300} << (lc_ + lp_), 1024u);
+        have_properties_ = true;
+    }
+
+    void reset_state() {
+        std::fill(literals_.begin(), literals_.end(), std::uint16_t{1024});
+        std::fill(std::begin(is_match_), std::end(is_match_), std::uint16_t{1024});
+        std::fill(std::begin(is_rep_), std::end(is_rep_), std::uint16_t{1024});
+        std::fill(std::begin(is_rep_g0_), std::end(is_rep_g0_), std::uint16_t{1024});
+        std::fill(std::begin(is_rep_g1_), std::end(is_rep_g1_), std::uint16_t{1024});
+        std::fill(std::begin(is_rep_g2_), std::end(is_rep_g2_), std::uint16_t{1024});
+        std::fill(std::begin(is_rep0_long_), std::end(is_rep0_long_), std::uint16_t{1024});
+        std::fill(&slot_[0][0], &slot_[0][0] + 4 * 64, std::uint16_t{1024});
+        std::fill(std::begin(special_), std::end(special_), std::uint16_t{1024});
+        std::fill(std::begin(align_), std::end(align_), std::uint16_t{1024});
+        length_.reset();
+        rep_length_.reset();
+        state_ = 0u;
+        rep_ = {0u, 0u, 0u, 0u};
+    }
+
+    void put(std::uint8_t b, std::vector<std::uint8_t> &out) {
+        if (dictionary_.empty()) throw Failure{"an LZMA2 stream has no dictionary"};
+        dictionary_[position_] = b;
+        if (++position_ == dictionary_.size()) position_ = 0u;
+        if (filled_ < dictionary_.size()) ++filled_;
+        ++total_;
+        out.push_back(b);
+    }
+
+    // The byte `distance` + 1 back.
+    [[nodiscard]] std::uint8_t back(std::uint32_t distance) const {
+        std::size_t at = position_ + dictionary_.size() - 1u - distance;
+        if (at >= dictionary_.size()) at -= dictionary_.size();
+        return dictionary_[at];
+    }
+
+    void decode_chunk(RangeDecoder &rc, std::size_t unpacked, std::vector<std::uint8_t> &out) {
+        const std::uint32_t pb_mask = (1u << pb_) - 1u;
+        const std::uint32_t lp_mask = (1u << lp_) - 1u;
+        std::size_t produced = 0u;
+        while (produced < unpacked) {
+            const std::uint32_t pos_state = static_cast<std::uint32_t>(total_) & pb_mask;
+            if (rc.bit(is_match_[(state_ << 4u) + pos_state]) == 0u) {
+                const std::uint32_t previous = filled_ != 0u ? back(0u) : 0u;
+                std::uint16_t *probs =
+                    literals_.data() +
+                    0x300u * (((static_cast<std::uint32_t>(total_) & lp_mask) << lc_) + (previous >> (8u - lc_)));
+                std::uint32_t symbol = 1u;
+                if (state_ >= 7u) {
+                    if (rep_[0] >= filled_) throw Failure{"an LZMA chunk is damaged"};
+                    std::uint32_t match = back(rep_[0]);
+                    do {
+                        const std::uint32_t match_bit = (match >> 7u) & 1u;
+                        match <<= 1u;
+                        const std::uint32_t b = rc.bit(probs[((1u + match_bit) << 8u) + symbol]);
+                        symbol = (symbol << 1u) | b;
+                        if (match_bit != b) break;
+                    } while (symbol < 0x100u);
+                }
+                while (symbol < 0x100u) symbol = (symbol << 1u) | rc.bit(probs[symbol]);
+                put(static_cast<std::uint8_t>(symbol), out);
+                ++produced;
+                state_ = state_ < 4u ? 0u : state_ < 10u ? state_ - 3u : state_ - 6u;
+                continue;
+            }
+            std::uint32_t length;
+            if (rc.bit(is_rep_[state_]) != 0u) {
+                if (filled_ == 0u) throw Failure{"an LZMA chunk is damaged"};
+                if (rc.bit(is_rep_g0_[state_]) == 0u) {
+                    if (rc.bit(is_rep0_long_[(state_ << 4u) + pos_state]) == 0u) {
+                        state_ = state_ < 7u ? 9u : 11u;
+                        put(back(rep_[0]), out);
+                        ++produced;
+                        continue;
+                    }
+                } else {
+                    std::uint32_t distance;
+                    if (rc.bit(is_rep_g1_[state_]) == 0u) {
+                        distance = rep_[1];
+                    } else {
+                        if (rc.bit(is_rep_g2_[state_]) == 0u) {
+                            distance = rep_[2];
+                        } else {
+                            distance = rep_[3];
+                            rep_[3] = rep_[2];
+                        }
+                        rep_[2] = rep_[1];
+                    }
+                    rep_[1] = rep_[0];
+                    rep_[0] = distance;
+                }
+                length = rep_length_.decode(rc, pos_state);
+                state_ = state_ < 7u ? 8u : 11u;
+            } else {
+                rep_[3] = rep_[2];
+                rep_[2] = rep_[1];
+                rep_[1] = rep_[0];
+                length = length_.decode(rc, pos_state);
+                state_ = state_ < 7u ? 7u : 10u;
+                const std::uint32_t slot = tree(rc, slot_[std::min<std::uint32_t>(length, 3u)], 6u);
+                std::uint32_t distance;
+                if (slot < 4u) {
+                    distance = slot;
+                } else {
+                    const unsigned direct_bits = (slot >> 1u) - 1u;
+                    distance = (2u | (slot & 1u)) << direct_bits;
+                    if (slot < 14u) {
+                        distance += reverse_tree(rc, special_ + distance - slot, direct_bits);
+                    } else {
+                        distance += rc.direct(direct_bits - 4u) << 4u;
+                        distance += reverse_tree(rc, align_, 4u);
+                    }
+                }
+                if (distance == 0xFFFFFFFFu) throw Failure{"an LZMA2 chunk has an end marker"};
+                rep_[0] = distance;
+            }
+            length += 2u;
+            if (rep_[0] >= filled_) throw Failure{"an LZMA chunk is damaged"};
+            if (produced + length > unpacked) throw Failure{"an LZMA chunk is damaged"};
+            for (std::uint32_t i = 0; i < length; ++i) put(back(rep_[0]), out);
+            produced += length;
+        }
+    }
+
+    bool stream_started_ = false, block_started_ = false, finished_ = false, have_properties_ = false;
+    std::vector<std::uint8_t> dictionary_;
+    std::size_t position_ = 0u, filled_ = 0u;
+    std::uint64_t total_ = 0u;
+    unsigned lc_ = 0u, lp_ = 0u, pb_ = 0u;
+    std::vector<std::uint16_t> literals_;
+    std::uint16_t is_match_[12 << 4], is_rep_[12], is_rep_g0_[12], is_rep_g1_[12], is_rep_g2_[12],
+        is_rep0_long_[12 << 4];
+    std::uint16_t slot_[4][64];
+    std::uint16_t special_[1 + 128 - 14];
+    std::uint16_t align_[16];
+    LengthCoder length_, rep_length_;
+    std::uint32_t state_ = 0u;
+    std::array<std::uint32_t, 4> rep_{};
+};
+
+// ---- VCDIFF ----------------------------------------------------------------
+
+enum Kind : std::uint8_t { kNoop = 0, kAdd = 1, kRun = 2, kCopy = 3 };
+struct Code {
+    std::uint8_t type1, size1, mode1, type2, size2, mode2;
+};
+
+std::array<Code, 256> default_code_table() {
+    std::array<Code, 256> t{};
+    std::size_t i = 0;
+    t[i++] = {kRun, 0, 0, kNoop, 0, 0};
+    for (std::uint8_t s = 0; s < 18; ++s) t[i++] = {kAdd, s, 0, kNoop, 0, 0};
+    for (std::uint8_t m = 0; m < 9; ++m) {
+        t[i++] = {kCopy, 0, m, kNoop, 0, 0};
+        for (std::uint8_t s = 4; s < 19; ++s) t[i++] = {kCopy, s, m, kNoop, 0, 0};
+    }
+    for (std::uint8_t m = 0; m < 6; ++m)
+        for (std::uint8_t a = 1; a < 5; ++a)
+            for (std::uint8_t c = 4; c < 7; ++c) t[i++] = {kAdd, a, 0, kCopy, c, m};
+    for (std::uint8_t m = 6; m < 9; ++m)
+        for (std::uint8_t a = 1; a < 5; ++a) t[i++] = {kAdd, a, 0, kCopy, 4, m};
+    for (std::uint8_t m = 0; m < 9; ++m) t[i++] = {kCopy, 4, m, kAdd, 1, 0};
+    return t;
+}
+
+std::uint64_t vint(const std::uint8_t *p, std::size_t size, std::size_t &at) {
+    std::uint64_t value = 0u;
+    for (int i = 0; i < 10; ++i) {
+        if (at >= size) throw Failure{"the patch ends early"};
+        const std::uint8_t b = p[at++];
+        value = (value << 7u) | (b & 0x7Fu);
+        if ((b & 0x80u) == 0u) return value;
+    }
+    throw Failure{"the patch is damaged"};
+}
+
+std::uint32_t adler32(const std::uint8_t *data, std::size_t size) {
+    std::uint32_t a = 1u, b = 0u;
+    while (size != 0u) {
+        const std::size_t n = std::min<std::size_t>(size, 5552u);
+        for (std::size_t i = 0; i < n; ++i) {
+            a += data[i];
+            b += a;
+        }
+        a %= 65521u;
+        b %= 65521u;
+        data += n;
+        size -= n;
+    }
+    return (b << 16u) | a;
+}
+
+// The release's image read in 4 MiB blocks, the last few kept: a patch's
+// copies mostly walk the image in order.
+class Source {
+public:
+    explicit Source(const std::filesystem::path &path) : file_(path, std::ios::binary) {
+        if (!file_) throw Failure{"the game's disc image cannot be read"};
+        size_ = std::filesystem::file_size(path);
+    }
+    [[nodiscard]] std::uint64_t size() const noexcept { return size_; }
+    void read(std::uint64_t offset, std::uint8_t *out, std::size_t length) {
+        while (length != 0u) {
+            const std::uint64_t index = offset / kBlock;
+            const std::size_t within = static_cast<std::size_t>(offset % kBlock);
+            const std::vector<std::uint8_t> &data = block(index);
+            const std::size_t n = std::min(length, kBlock - within);
+            for (std::size_t i = 0; i < n; ++i) out[i] = within + i < data.size() ? data[within + i] : 0u;
+            out += n;
+            offset += n;
+            length -= n;
+        }
+    }
+
+private:
+    static constexpr std::size_t kBlock = 4u << 20u;
+    static constexpr std::size_t kKept = 24u;
+    const std::vector<std::uint8_t> &block(std::uint64_t index) {
+        for (auto it = blocks_.begin(); it != blocks_.end(); ++it)
+            if (it->first == index) {
+                blocks_.splice(blocks_.begin(), blocks_, it);
+                return blocks_.front().second;
+            }
+        std::vector<std::uint8_t> data;
+        if (index * kBlock < size_) {
+            data.resize(static_cast<std::size_t>(std::min<std::uint64_t>(kBlock, size_ - index * kBlock)));
+            file_.clear();
+            file_.seekg(static_cast<std::streamoff>(index * kBlock));
+            file_.read(reinterpret_cast<char *>(data.data()), static_cast<std::streamsize>(data.size()));
+            if (static_cast<std::size_t>(file_.gcount()) != data.size()) throw Failure{"the game's disc image cannot be read"};
+        }
+        blocks_.emplace_front(index, std::move(data));
+        if (blocks_.size() > kKept) blocks_.pop_back();
+        return blocks_.front().second;
+    }
+    std::ifstream file_;
+    std::uint64_t size_ = 0u;
+    std::list<std::pair<std::uint64_t, std::vector<std::uint8_t>>> blocks_;
+};
+
+// Collects the sectors of the patched image that differ from the release's.
+class Sectors {
+public:
+    explicit Sectors(Source &source) : source_(source) {}
+    void add(const std::uint8_t *data, std::size_t size) {
+        while (size != 0u) {
+            const std::size_t n = std::min(size, kSector - pending_.size());
+            pending_.insert(pending_.end(), data, data + n);
+            data += n;
+            size -= n;
+            if (pending_.size() == kSector) flush();
+        }
+    }
+    void finish() {
+        if (!pending_.empty()) {
+            pending_.resize(kSector, 0u);
+            flush();
+        }
+    }
+    std::vector<std::uint32_t> sectors, slots;
+    std::vector<std::uint8_t> data;
+    std::uint64_t zeros = 0u;
+
+private:
+    void flush() {
+        std::array<std::uint8_t, kSector> release{};
+        const std::uint64_t offset = std::uint64_t{next_} * kSector;
+        if (offset < source_.size())
+            source_.read(offset, release.data(),
+                         static_cast<std::size_t>(std::min<std::uint64_t>(kSector, source_.size() - offset)));
+        if (offset >= source_.size() || std::memcmp(release.data(), pending_.data(), kSector) != 0) {
+            sectors.push_back(next_);
+            if (std::all_of(pending_.begin(), pending_.end(), [](std::uint8_t b) { return b == 0u; })) {
+                slots.push_back(kZero);
+                ++zeros;
+            } else {
+                slots.push_back(static_cast<std::uint32_t>(data.size() / kSector));
+                data.insert(data.end(), pending_.begin(), pending_.end());
+            }
+        }
+        ++next_;
+        pending_.clear();
+    }
+    Source &source_;
+    std::vector<std::uint8_t> pending_;
+    std::uint32_t next_ = 0u;
+};
+
+void apply(const std::vector<std::uint8_t> &patch, Source &source, Sectors &sectors, Progress &progress,
+           Result &result) {
+    static const std::array<Code, 256> table = default_code_table();
+    const std::uint8_t *p = patch.data();
+    const std::size_t size = patch.size();
+    if (size < 5u || p[0] != 0xD6u || p[1] != 0xC3u || p[2] != 0xC4u) throw Failure{"this is not a VCDIFF patch"};
+    if (p[3] != 0u) throw Failure{"the patch's VCDIFF version is not supported"};
+    const std::uint8_t indicator = p[4];
+    std::size_t at = 5u;
+    int secondary = -1;
+    if ((indicator & 1u) != 0u) secondary = p[at++];
+    if ((indicator & 2u) != 0u) throw Failure{"the patch uses a code table of its own, which is not supported"};
+    if ((indicator & 4u) != 0u) {
+        const std::uint64_t application_header = vint(p, size, at);
+        at += static_cast<std::size_t>(application_header);
+    }
+    if (secondary != -1 && secondary != 2)
+        throw Failure{"the patch uses secondary compression " + std::to_string(secondary) +
+                      ", which is not supported (xdelta3's LZMA, 2, is)"};
+
+    // The patched image's size: the sum of the windows' target lengths.
+    {
+        std::uint64_t total = 0u;
+        std::size_t scan = at;
+        while (scan < size) {
+            const std::uint8_t window = p[scan++];
+            if ((window & 3u) != 0u) {
+                (void)vint(p, size, scan);
+                (void)vint(p, size, scan);
+            }
+            const std::uint64_t length = vint(p, size, scan);
+            const std::size_t start = scan;
+            total += vint(p, size, scan);
+            scan = start + static_cast<std::size_t>(length);
+        }
+        progress.total = total;
+    }
+
+    XzLzma2 streams[3];
+    std::vector<std::uint8_t> sections[3];
+    std::vector<std::uint8_t> target;
+    std::uint64_t made = 0u;
+    while (at < size) {
+        if (progress.cancel) throw Failure{"Cancelled"};
+        const std::uint8_t window = p[at++];
+        if ((window & 2u) != 0u) throw Failure{"the patch copies from its own output, which is not supported"};
+        std::uint64_t segment_length = 0u, segment_position = 0u;
+        if ((window & 1u) != 0u) {
+            segment_length = vint(p, size, at);
+            segment_position = vint(p, size, at);
+            if (segment_position + segment_length > source.size())
+                throw Failure{"the patch reads past the end of the game's disc image: it was made for another disc"};
+        }
+        const std::uint64_t delta_length = vint(p, size, at);
+        const std::size_t delta_start = at;
+        const std::uint64_t target_length = vint(p, size, at);
+        if (at >= size) throw Failure{"the patch ends early"};
+        const std::uint8_t delta_indicator = p[at++];
+        const std::uint64_t lengths[3] = {vint(p, size, at), vint(p, size, at), vint(p, size, at)};
+        std::optional<std::uint32_t> checksum;
+        if ((window & 4u) != 0u) {
+            if (at + 4u > size) throw Failure{"the patch ends early"};
+            checksum = (std::uint32_t{p[at]} << 24u) | (std::uint32_t{p[at + 1]} << 16u) |
+                       (std::uint32_t{p[at + 2]} << 8u) | p[at + 3];
+            at += 4u;
+        }
+        for (int s = 0; s < 3; ++s) {
+            if (at + lengths[s] > size) throw Failure{"the patch ends early"};
+            const std::uint8_t *section = p + at;
+            const std::size_t length = static_cast<std::size_t>(lengths[s]);
+            sections[s].clear();
+            if ((delta_indicator & (1u << s)) != 0u) {
+                if (secondary != 2) throw Failure{"the patch is damaged"};
+                std::size_t read = 0u;
+                const std::uint64_t expected = vint(section, length, read);
+                streams[s].decode(section + read, length - read, sections[s]);
+                if (sections[s].size() != expected) throw Failure{"a compressed section of the patch is damaged"};
+            } else {
+                sections[s].assign(section, section + length);
+            }
+            at += length;
+        }
+        if (at != delta_start + delta_length) throw Failure{"the patch is damaged"};
+
+        target.assign(static_cast<std::size_t>(target_length), 0u);
+        const std::vector<std::uint8_t> &data = sections[0], &inst = sections[1], &addr = sections[2];
+        std::size_t dp = 0u, ip = 0u, ap = 0u, tp = 0u;
+        std::uint64_t near[4] = {0u, 0u, 0u, 0u};
+        std::size_t next_near = 0u;
+        std::vector<std::uint64_t> same(768u, 0u);
+        const auto execute = [&](std::uint8_t type, std::uint64_t n, std::uint8_t mode) {
+            if (type == kNoop) return;
+            if (tp + n > target.size()) throw Failure{"the patch is damaged"};
+            if (type == kAdd) {
+                if (dp + n > data.size()) throw Failure{"the patch is damaged"};
+                std::memcpy(target.data() + tp, data.data() + dp, static_cast<std::size_t>(n));
+                dp += static_cast<std::size_t>(n);
+                tp += static_cast<std::size_t>(n);
+                return;
+            }
+            if (type == kRun) {
+                if (dp >= data.size()) throw Failure{"the patch is damaged"};
+                std::memset(target.data() + tp, data[dp++], static_cast<std::size_t>(n));
+                tp += static_cast<std::size_t>(n);
+                return;
+            }
+            const std::uint64_t here = segment_length + tp;
+            std::uint64_t a;
+            if (mode == 0u) {
+                a = vint(addr.data(), addr.size(), ap);
+            } else if (mode == 1u) {
+                a = here - vint(addr.data(), addr.size(), ap);
+            } else if (mode < 6u) {
+                a = near[mode - 2u] + vint(addr.data(), addr.size(), ap);
+            } else {
+                if (ap >= addr.size()) throw Failure{"the patch is damaged"};
+                a = same[(mode - 6u) * 256u + addr[ap++]];
+            }
+            near[next_near] = a;
+            next_near = (next_near + 1u) % 4u;
+            same[a % 768u] = a;
+            if (a >= here) throw Failure{"the patch is damaged"};
+            std::uint64_t remaining = n;
+            if (a < segment_length) {
+                const std::uint64_t from_source = std::min(remaining, segment_length - a);
+                source.read(segment_position + a, target.data() + tp, static_cast<std::size_t>(from_source));
+                tp += static_cast<std::size_t>(from_source);
+                a += from_source;
+                remaining -= from_source;
+            }
+            // From this window's own output, byte by byte where it overlaps.
+            for (std::uint64_t i = 0; i < remaining; ++i) target[tp + i] = target[a - segment_length + i];
+            tp += static_cast<std::size_t>(remaining);
+        };
+        while (ip < inst.size()) {
+            const Code &code = table[inst[ip++]];
+            std::uint64_t size1 = code.size1, size2 = code.size2;
+            if (code.type1 != kNoop && size1 == 0u) size1 = vint(inst.data(), inst.size(), ip);
+            if (code.type2 != kNoop && size2 == 0u) size2 = vint(inst.data(), inst.size(), ip);
+            execute(code.type1, size1, code.mode1);
+            execute(code.type2, size2, code.mode2);
+        }
+        if (tp != target.size()) throw Failure{"the patch is damaged"};
+        if (checksum && adler32(target.data(), target.size()) != *checksum) ++result.mismatched;
+        ++result.windows;
+        sectors.add(target.data(), target.size());
+        made += target.size();
+        progress.done = made;
+    }
+    sectors.finish();
+}
+
+} // namespace
+
+bool is_patch_file(const std::filesystem::path &path) {
+    std::ifstream in(path, std::ios::binary);
+    std::uint8_t magic[4]{};
+    in.read(reinterpret_cast<char *>(magic), 4);
+    return in.gcount() == 4 && magic[0] == 0xD6u && magic[1] == 0xC3u && magic[2] == 0xC4u && magic[3] == 0u;
+}
+
+Result prepare(const std::filesystem::path &patch_path, const std::filesystem::path &base,
+               const std::filesystem::path &out, Progress &progress) {
+    Result result;
+    try {
+        std::ifstream in(patch_path, std::ios::binary);
+        if (!in) throw Failure{"the patch cannot be read"};
+        std::vector<std::uint8_t> patch(static_cast<std::size_t>(std::filesystem::file_size(patch_path)));
+        in.read(reinterpret_cast<char *>(patch.data()), static_cast<std::streamsize>(patch.size()));
+        if (static_cast<std::size_t>(in.gcount()) != patch.size()) throw Failure{"the patch cannot be read"};
+
+        Source source(base);
+        Sectors sectors(source);
+        apply(patch, source, sectors, progress, result);
+        result.changed_sectors = sectors.sectors.size();
+        result.zero_sectors = sectors.zeros;
+        if (result.mismatched != 0u)
+            result.message = std::to_string(result.mismatched) + " of the patch's " + std::to_string(result.windows) +
+                             " parts did not come out as it expected: it was made from a slightly different copy of "
+                             "the disc. They were applied anyway.";
+
+        // The file: header, path, note, table, data.
+        const std::string base_text = install::path_to_utf8(std::filesystem::absolute(base));
+        const std::string note = install::path_to_utf8(patch_path.filename());
+        std::vector<std::uint8_t> header(kMagic, kMagic + 8);
+        put32(header, 1u);
+        put32(header, kSector);
+        put64(header, progress.total.load());
+        put64(header, source.size());
+        put64(header, sectors.sectors.size());
+        const std::uint64_t table_offset = (64u + base_text.size() + note.size() + 15u) & ~std::uint64_t{15};
+        const std::uint64_t data_offset = (table_offset + sectors.sectors.size() * 8u + kSector - 1u) & ~std::uint64_t{kSector - 1u};
+        put64(header, table_offset);
+        put64(header, data_offset);
+        put32(header, static_cast<std::uint32_t>(base_text.size()));
+        put32(header, static_cast<std::uint32_t>(note.size()));
+        header.insert(header.end(), base_text.begin(), base_text.end());
+        header.insert(header.end(), note.begin(), note.end());
+        header.resize(static_cast<std::size_t>(table_offset), 0u);
+        for (std::size_t i = 0; i < sectors.sectors.size(); ++i) {
+            put32(header, sectors.sectors[i]);
+            put32(header, sectors.slots[i]);
+        }
+        header.resize(static_cast<std::size_t>(data_offset), 0u);
+
+        std::error_code ec;
+        std::filesystem::create_directories(out.parent_path(), ec);
+        std::filesystem::path partial = out;
+        partial += ".partial";
+        {
+            std::ofstream file(partial, std::ios::binary | std::ios::trunc);
+            file.write(reinterpret_cast<const char *>(header.data()), static_cast<std::streamsize>(header.size()));
+            file.write(reinterpret_cast<const char *>(sectors.data.data()),
+                       static_cast<std::streamsize>(sectors.data.size()));
+            if (!file) throw Failure{"the prepared disc cannot be written: is the disk full?"};
+        }
+        std::filesystem::rename(partial, out, ec);
+        if (ec) {
+            std::filesystem::remove(partial, ec);
+            throw Failure{"the prepared disc cannot be put in place"};
+        }
+        result.ok = true;
+    } catch (const Failure &failure) {
+        result.message = failure.what;
+    } catch (const std::exception &e) {
+        result.message = e.what();
+    }
+    return result;
+}
+
+std::unique_ptr<Layer> Layer::open(const std::filesystem::path &path) {
+    std::ifstream in(path, std::ios::binary);
+    std::array<std::uint8_t, 64> head{};
+    in.read(reinterpret_cast<char *>(head.data()), 64);
+    if (in.gcount() < 8 || std::memcmp(head.data(), kMagic, 8u) != 0) return nullptr;
+    if (in.gcount() != 64 || le32(head.data() + 8) != 1u || le32(head.data() + 12) != kSector)
+        throw psprecomp::Error("A prepared disc of another version: " + path.string());
+    std::unique_ptr<Layer> layer(new Layer());
+    layer->size_ = le64(head.data() + 16);
+    layer->base_size_ = le64(head.data() + 24);
+    const std::uint64_t count = le64(head.data() + 32);
+    const std::uint64_t table = le64(head.data() + 40);
+    layer->data_offset_ = le64(head.data() + 48);
+    std::string base(le32(head.data() + 56), '\0');
+    in.read(base.data(), static_cast<std::streamsize>(base.size()));
+    layer->base_ = install::path_from_utf8(base);
+    if (count > (1u << 26u)) throw psprecomp::Error("A damaged prepared disc: " + path.string());
+    std::vector<std::uint8_t> entries(static_cast<std::size_t>(count * 8u));
+    in.seekg(static_cast<std::streamoff>(table));
+    in.read(reinterpret_cast<char *>(entries.data()), static_cast<std::streamsize>(entries.size()));
+    if (static_cast<std::size_t>(in.gcount()) != entries.size())
+        throw psprecomp::Error("A damaged prepared disc: " + path.string());
+    layer->sectors_.resize(static_cast<std::size_t>(count));
+    layer->slots_.resize(static_cast<std::size_t>(count));
+    for (std::size_t i = 0; i < count; ++i) {
+        layer->sectors_[i] = le32(entries.data() + i * 8u);
+        layer->slots_[i] = le32(entries.data() + i * 8u + 4u);
+    }
+    layer->file_.open(path, std::ios::binary);
+    std::error_code ec;
+    if (!std::filesystem::is_regular_file(layer->base_, ec))
+        throw psprecomp::Error("The disc image this mod was prepared from is no longer at " + base +
+                               "; prepare the mod again");
+    if (std::filesystem::file_size(layer->base_, ec) != layer->base_size_)
+        throw psprecomp::Error("The disc image at " + base + " is not the one this mod was prepared from; prepare the "
+                               "mod again");
+    return layer;
+}
+
+Layer::~Layer() = default;
+
+std::size_t Layer::read(std::ifstream &base, std::uint64_t offset, std::span<std::uint8_t> output) {
+    if (offset >= size_) return 0u;
+    const std::size_t count = static_cast<std::size_t>(std::min<std::uint64_t>(output.size(), size_ - offset));
+    std::size_t done = 0u;
+    while (done < count) {
+        const std::uint64_t at = offset + done;
+        const std::uint32_t sector = static_cast<std::uint32_t>(at / kSector);
+        const std::size_t within = static_cast<std::size_t>(at % kSector);
+        const auto found = std::lower_bound(sectors_.begin(), sectors_.end(), sector);
+        if (found != sectors_.end() && *found == sector) {
+            const std::size_t n = std::min<std::size_t>(count - done, kSector - within);
+            const std::uint32_t slot = slots_[static_cast<std::size_t>(found - sectors_.begin())];
+            if (slot == kZero) {
+                std::memset(output.data() + done, 0, n);
+            } else {
+                file_.clear();
+                file_.seekg(static_cast<std::streamoff>(data_offset_ + std::uint64_t{slot} * kSector + within));
+                file_.read(reinterpret_cast<char *>(output.data() + done), static_cast<std::streamsize>(n));
+                if (static_cast<std::size_t>(file_.gcount()) != n) return done;
+            }
+            done += n;
+            continue;
+        }
+        // Up to the next changed sector, from the release's image.
+        const std::uint64_t stop =
+            found == sectors_.end() ? offset + count
+                                    : std::min<std::uint64_t>(offset + count, std::uint64_t{*found} * kSector);
+        const std::size_t n = static_cast<std::size_t>(stop - at);
+        const std::size_t from_base =
+            at < base_size_ ? static_cast<std::size_t>(std::min<std::uint64_t>(n, base_size_ - at)) : 0u;
+        if (from_base != 0u) {
+            base.clear();
+            base.seekg(static_cast<std::streamoff>(at));
+            base.read(reinterpret_cast<char *>(output.data() + done), static_cast<std::streamsize>(from_base));
+            if (static_cast<std::size_t>(base.gcount()) != from_base) return done;
+        }
+        std::memset(output.data() + done + from_base, 0, n - from_base);
+        done += n;
+    }
+    return done;
+}
