+std::optional<SfoValue> sfo_find(const std::vector<std::uint8_t> &sfo, std::string_view key) {
+    if (sfo.size() < 20u || std::memcmp(sfo.data(), "\0PSF", 4u) != 0) return std::nullopt;
+    const std::uint32_t keys = le32(sfo.data() + 8u), values = le32(sfo.data() + 12u), count = le32(sfo.data() + 16u);
+    for (std::uint32_t i = 0; i < count && 20u + (i + 1u) * 16u <= sfo.size(); ++i) {
+        const std::uint8_t *row = sfo.data() + 20u + i * 16u;
+        const std::uint32_t name = keys + le16(row);
+        if (name >= sfo.size()) continue;
+        const auto *text = reinterpret_cast<const char *>(sfo.data() + name);
+        if (std::string_view(text, strnlen(text, sfo.size() - name)) != key) continue;
+        const SfoValue value{values + le32(row + 12u), le32(row + 4u), le16(row + 2u)};
+        if (value.at + std::uint64_t{value.length} > sfo.size()) return std::nullopt;
+        return value;
