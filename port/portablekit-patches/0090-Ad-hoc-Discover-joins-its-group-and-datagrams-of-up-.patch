+    std::this_thread::sleep_for(std::chrono::milliseconds(100));
+    std::string card(kExchange, '\0');
+    for (std::size_t i = 0; i < card.size(); ++i) card[i] = static_cast<char>(i * 7u);
+    check(a.pdp_send(big, kMacB, 1000, card.data(), card.size()), "A sends a 27,416-byte datagram");
+    const auto big_header = b_big.read(relay::kPdpHeaderSize);
+    const auto big_body = big_header ? b_big.read(wire::get32(big_header->data() + 10)) : std::nullopt;
+    check(big_body && *big_body == card, "it reaches B whole");
+    std::reverse(card.begin(), card.end());
+    b_big.send(relay::pdp_header(kMacA, 1000, static_cast<std::uint32_t>(card.size())) + card);
+    check(wait_until([&] { return (got = a.pdp_receive(big)).has_value(); }) && got->data == card,
+          "B's 27,416-byte datagram reaches A whole");
+    a.pdp_close(big);
+    check(wait_until([&] { return a.diagnostics().relay_links_up == 1u; }), "the second datagram socket closes");
+
     // A stream from B to A's listening socket.
     const int listener = a.ptp_listen(20001, 8192, 1);
     check(wait_until([&] {
