+    // A pass-by exchange's datagrams are 27,416 bytes, whole both ways.
+    constexpr std::size_t kExchange = 0x6B18u;
+    const int big = a.pdp_open(1000, kExchange);
+    Raw b_big(relay_port);
+    b_big.send(relay::init(relay::kInitPdp, kMacB, 1000, Mac{}, 0));
