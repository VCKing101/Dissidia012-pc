diff --git a/host/ui/dialog_skin.hpp b/host/ui/dialog_skin.hpp
new file mode 100644
index 0000000..7f6d304
--- /dev/null
+++ b/host/ui/dialog_skin.hpp
@@ -0,0 +1,102 @@
+#pragma once
+
+#include "ui/save_list_dialog.hpp"
+
+#include <cstddef>
+#include <string>
+#include <vector>
+
+// A port's own look for the dialogs the game asks the PSP for: the message
+// dialog, the save-data list and the keyboard. PortableKit keeps what they do
+// (the answers, the saves, the typing, and the gamepad and keyboard controls
+// their headers describe); a skin only draws them, inside the interface frame
+// that draws them now, and says what the pointer is over. A dialog without a
+// skin is drawn by PortableKit, as before.
+//
+// Each view is everything the dialog shows this frame. The skin draws it
+// where it likes (usually over the game's picture, ui::game_picture()) and
+// fills the pointer: the choice the mouse is over and the one it clicked.
+namespace portablekit::ui {
+
+// What the pointer did this frame. Indexes are the view's: a message's
+// choices (0 OK or Yes, 1 No), a save list's slots, a keyboard's keys
+// (row * 100 + column). -1: none.
+struct SkinPointer {
+    int hovered{-1};
+    int clicked{-1};
+};
+
+struct MessageSkinView {
+    std::string text;      // UTF-8; '\n' breaks lines
+    bool question{};       // Yes and No; otherwise OK
+    bool no_selected{};    // a question: No is selected
+    bool allow_back{};     // back answers a question
+    bool confirm_south{};  // confirm is the south face button (the menu's "Confirm button")
+};
+
+struct SaveListSkinView {
+    SaveAction action{SaveAction::Load};
+    const std::vector<SaveSlot> *slots{};  // the request's slots
+    std::vector<std::size_t> shown;        // the slots listed, in order: loading and deleting list saves only
+    std::size_t selected{};                // the selected slot, an index into slots
+    bool confirm_south{};
+};
+
+struct KeyboardSkinKey {
+    std::string label;    // UTF-8: the character, or the action's name
+    bool character{};     // a character key rather than an action
+    bool enabled{true};   // it can be typed
+    bool lit{};           // Shift or the symbols page when on, and OK
+    bool selected{};
+    float left{};         // where the key starts and how wide it is, in tenths of the row
+    float width{};
+};
+
+struct KeyboardSkinView {
+    std::string title;           // what is being entered
+    std::string prompt;          // a line under it; may be empty
+    std::string text;            // UTF-8
+    std::size_t cursor_byte{};   // the text cursor, as a byte offset into text
+    std::size_t length{};        // characters in text
+    std::size_t max_length{};
+    bool full{};                 // no more characters fit
+    bool refused{};              // a key could not be typed a moment ago
+    bool caret_on{};             // the blinking cursor is showing this frame
+    bool gamepad{};              // the player is using a gamepad
+    bool confirm_south{};
+    std::vector<std::vector<KeyboardSkinKey>> rows;
+};
+
+// What a skinned dialog did this frame, for a skin that plays the game's own
+// sounds: the selection moved, something was chosen (an answer, a slot, a key
+// typed), the player backed out, or a key could not be typed.
+enum class DialogSound { Move, Confirm, Back, Refused };
+
+struct DialogSkin {
+    // Asked before a skin draws: false keeps PortableKit's look for that
+    // frame (the port's pictures could not be read, say). Null: always ready.
+    bool (*available)() = nullptr;
+    // Called from the interface frame when a dialog the skin draws does one
+    // of the things above. Null: silent, as before.
+    void (*sound)(DialogSound sound) = nullptr;
+    void (*message)(const MessageSkinView &view, SkinPointer &pointer) = nullptr;
+    void (*save_list)(const SaveListSkinView &view, SkinPointer &pointer) = nullptr;
+    // Only the game's keyboard requests (open_game_text_input), not keyboards
+    // opened inside PortableKit's own screens.
+    void (*keyboard)(const KeyboardSkinView &view, SkinPointer &pointer) = nullptr;
+};
+
+// Sets the skin; a member left null keeps PortableKit's look for that dialog.
+void set_dialog_skin(const DialogSkin &skin);
+[[nodiscard]] const DialogSkin &dialog_skin();
+// The skin's draw function for one dialog when the skin has one and is
+// available this frame; null otherwise.
+template <typename Draw> [[nodiscard]] Draw skin_ready(Draw draw) {
+    if (draw == nullptr) return nullptr;
+    const DialogSkin &skin = dialog_skin();
+    return skin.available == nullptr || skin.available() ? draw : nullptr;
+}
+// Tells the skin's sound function, when it has one.
+void skin_sound(DialogSound sound);
+
+} // namespace portablekit::ui
