+        view.allow_back = d.request.allow_back;
+        view.confirm_south = Layer::get().confirm_south();
+        SkinPointer pointer;
+        draw_skin(view, pointer);
+        const bool moved = io.MouseDelta.x * io.MouseDelta.x + io.MouseDelta.y * io.MouseDelta.y > 0.0f;
+        if (d.request.question && moved && pointer.hovered >= 0) d.no_selected = pointer.hovered == 1;
+        if (d.no_selected != was_no) skin_sound(DialogSound::Move);
+        if (pointer.clicked == 0) answer(MessageAnswer::Yes);
+        else if (pointer.clicked == 1 && d.request.question) answer(MessageAnswer::No);
+        return;
+    }
+
     ImGui::GetBackgroundDrawList()->AddRectFilled({0, 0}, io.DisplaySize, band::kDim);
     ImGui::SetNextWindowPos({0, 0}, ImGuiCond_Always);
     ImGui::SetNextWindowSize(io.DisplaySize, ImGuiCond_Always);
