+// A frame of the list as a skin draws it (dialog_skin.hpp); without
+// `controls`, only drawn (behind its question). Up and down move
+// over the listed slots (the arrow keys, the D-pad, the left stick, the mouse
+// wheel), confirm asks about the selected one, and the pointer selects and
+// clicks.
+void skinned_frame(void (*draw_skin)(const SaveListSkinView &, SkinPointer &), bool controls = true) {
+    Dialog &d = dialog();
+    Layer &layer = Layer::get();
+    SaveListSkinView view;
+    view.action = d.request.action;
+    view.slots = &d.request.slots;
+    for (std::size_t i = 0; i < d.request.slots.size(); ++i)
+        if (usable(d.request.slots[i], d.request.action)) view.shown.push_back(i);
+    auto at = std::find(view.shown.begin(), view.shown.end(), d.selected);
+    if (at == view.shown.end()) at = view.shown.begin();
+    auto position = static_cast<long>(at - view.shown.begin());
+
+    const auto pressed = [](std::initializer_list<ImGuiKey> keys) {
+        for (const ImGuiKey key : keys)
+            if (ImGui::IsKeyPressed(key, true)) return true;
+        return false;
+    };
+    long step = 0;
+    if (!controls) {
+        view.selected = d.selected;
+        view.confirm_south = layer.confirm_south();
+        SkinPointer ignored;
+        draw_skin(view, ignored);
+        return;
+    }
+    if (pressed({ImGuiKey_UpArrow})) step = -1;
+    if (pressed({ImGuiKey_DownArrow})) step = 1;
+    bool confirm = ImGui::IsKeyPressed(ImGuiKey_Enter, false) || ImGui::IsKeyPressed(ImGuiKey_KeypadEnter, false);
+    // A button held when the list opened, such as the one that led to it,
+    // does nothing until it is released.
+    if (layer.gamepad_armed()) {
+        if (pressed({ImGuiKey_GamepadDpadUp, ImGuiKey_GamepadLStickUp})) step = -1;
+        if (pressed({ImGuiKey_GamepadDpadDown, ImGuiKey_GamepadLStickDown})) step = 1;
+        const ImGuiKey key = layer.confirm_south() ? ImGuiKey_GamepadFaceDown : ImGuiKey_GamepadFaceRight;
+        confirm = confirm || ImGui::IsKeyPressed(key, false);
+    }
+    const ImGuiIO &io = ImGui::GetIO();
+    if (io.MouseWheel > 0.0f) step = -1;
+    if (io.MouseWheel < 0.0f) step = 1;
+    const std::size_t was = d.selected;
+    position = std::clamp(position + step, 0L, static_cast<long>(view.shown.size()) - 1);
+    d.selected = view.shown[static_cast<std::size_t>(position)];
+
+    view.selected = d.selected;
+    view.confirm_south = layer.confirm_south();
+    SkinPointer pointer;
+    draw_skin(view, pointer);
+    const auto listed = [&](int index) {
+        return index >= 0 && static_cast<std::size_t>(index) < d.request.slots.size() &&
+               usable(d.request.slots[static_cast<std::size_t>(index)], d.request.action);
+    };
+    const bool moved = io.MouseDelta.x * io.MouseDelta.x + io.MouseDelta.y * io.MouseDelta.y > 0.0f;
+    if (moved && listed(pointer.hovered)) d.selected = static_cast<std::size_t>(pointer.hovered);
+    if (d.selected != was) skin_sound(DialogSound::Move);
+    if (listed(pointer.clicked)) {
+        skin_sound(DialogSound::Confirm);
+        ask(static_cast<std::size_t>(pointer.clicked));
+        return;
+    }
+    if (confirm) {
+        skin_sound(DialogSound::Confirm);
+        ask(d.selected);
+    }
+}
+
