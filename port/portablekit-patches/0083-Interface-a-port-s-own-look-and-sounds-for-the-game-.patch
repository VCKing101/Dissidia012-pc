+// What a key shows: its label, whether it can be typed, whether it is lit
+// (Shift or the symbols page when on, Steam's keyboard when up, and OK).
+struct KeyLook {
+    std::string label;
+    bool enabled{true};
+    bool lit{};
+};
+
+KeyLook look_of(const Key &key) {
+    const Keyboard &k = keyboard();
+    KeyLook look;
+    if (key.kind == KeyKind::Char) {
+        const char32_t ch = key_char(key);
+        look.label = encode_utf8(std::u32string(1, ch));
+        look.enabled = allowed(ch);
+    } else {
+        look.label = action_label(key.kind);
+        if (key.kind == KeyKind::Space) look.enabled = allowed(U' ');
+    }
+    look.lit = (key.kind == KeyKind::Shift && k.shift != ShiftState::Off) || (key.kind == KeyKind::Symbols && k.symbols) ||
+               (key.kind == KeyKind::SteamKeyboard && k.steam_keyboard) || key.kind == KeyKind::Ok;
+    return look;
+}
