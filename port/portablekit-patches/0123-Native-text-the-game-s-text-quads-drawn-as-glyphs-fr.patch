+// The buffer a texture lies in, when it holds only the glyphs the host drew,
+// and where the texture's first texel is in it. The registry's lock is held.
+Buffer *checked_buffer(Registry &r, const psprecomp::GuestMemory &memory, const SharpTextQuery &query,
+                       std::uint32_t &base, std::uint32_t &column0, std::uint32_t &row0) {
+    if (query.bits != 4u && query.bits != 8u) return nullptr;
+    if (query.width == 0u || query.height == 0u) return nullptr;
     auto it = r.buffers.upper_bound(query.address);
-    if (it == r.buffers.begin()) return false;
+    if (it == r.buffers.begin()) return nullptr;
     --it;
-    const std::uint32_t base = it->first;
+    base = it->first;
     Buffer &b = it->second;
     const GlyphTarget &t = b.target;
     const std::size_t size = buffer_bytes(t);
-    if (static_cast<std::uint64_t>(query.address) >= static_cast<std::uint64_t>(base) + size) return false;
+    if (static_cast<std::uint64_t>(query.address) >= static_cast<std::uint64_t>(base) + size) return nullptr;
     const std::uint32_t bits = t.pixel_format == kFormat4 ? 4u : 8u;
     if (bits != query.bits || static_cast<std::uint64_t>(query.stride) * bits / 8u != t.bytes_per_line) {
         trace("%08X: texture %ux%u stride %u at %u bits is not laid out like glyph buffer %08X (%u bytes a line)",
               query.address, query.width, query.height, query.stride, query.bits, base, t.bytes_per_line);
-        return false;
+        return nullptr;
     }
     if (b.foreign || b.stamps.empty()) {
         trace("%08X: buffer %08X %s", query.address, base, b.foreign ? "holds more than glyphs" : "has no glyphs");
-        return false;
+        return nullptr;
     }
     if (b.generation != generation()) {
         trace("%08X: buffer %08X was drawn with another font", query.address, base);
-        return false;
+        return nullptr;
     }
     const std::uint8_t *bytes = memory.raw_pointer(base, size);
     if (bytes == nullptr || b.expected.size() != size || std::memcmp(bytes, b.expected.data(), size) != 0) {
         trace("%08X: buffer %08X was changed after its glyphs were drawn", query.address, base);
-        return false;
+        return nullptr;
     }
     const std::uint32_t offset = query.address - base;
-    const std::uint32_t row0 = offset / t.bytes_per_line;
-    const std::uint32_t column0 = (offset % t.bytes_per_line) * 8u / bits;
-    if (column0 >= t.width || row0 >= t.height) return false;
+    row0 = offset / t.bytes_per_line;
+    column0 = (offset % t.bytes_per_line) * 8u / bits;
+    if (column0 >= t.width || row0 >= t.height) return nullptr;
+    return &b;
+}
+
+} // namespace
+
+bool glyph_list(const psprecomp::GuestMemory &memory, const SharpTextQuery &query, GlyphList &out) {
+    if (!sharp_text_available()) return false;
+    Registry &r = registry();
+    const std::lock_guard lock(r.mutex);
+    std::uint32_t base = 0u, column0 = 0u, row0 = 0u;
+    Buffer *b = checked_buffer(r, memory, query, base, column0, row0);
+    if (b == nullptr) return false;
+    out.column = column0;
+    out.row = row0;
+    out.width = b->target.width;
+    out.height = b->target.height;
+    out.stamps.clear();
+    out.stamps.reserve(b->stamps.size());
+    for (const Stamp &stamp : b->stamps) out.stamps.push_back({stamp.code, stamp.x64, stamp.y64, stamp.clip});
+    b->last_used = ++r.clock;
+    return true;
+}
