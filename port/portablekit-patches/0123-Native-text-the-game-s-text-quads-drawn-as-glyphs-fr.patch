+                cut_y0 = std::max(cut_y0, std::lround(oy + ky * static_cast<float>(stamp.clip.y)));
+                cut_x1 = std::min(cut_x1, std::lround(ox + kx * static_cast<float>(std::min(right, 1.0e6))));
+                cut_y1 = std::min(cut_y1, std::lround(oy + ky * static_cast<float>(std::min(bottom, 1.0e6))));
+            }
+            if (cut_x0 >= cut_x1 || cut_y0 >= cut_y1) continue;
+            const float u0 = static_cast<float>(glyph->x + (cut_x0 - glyph_x0));
+            const float v0 = static_cast<float>(glyph->y + (cut_y0 - glyph_y0));
+            const float u1 = u0 + static_cast<float>(cut_x1 - cut_x0);
+            const float v1 = v0 + static_cast<float>(cut_y1 - cut_y0);
