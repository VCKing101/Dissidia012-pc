+// One glyph the host drew into a buffer, where sceFontGetCharGlyphImage put it.
+struct GlyphStamp {
+    std::uint32_t code{};
+    std::int32_t x64{};
+    std::int32_t y64{};
+    GlyphClip clip;
+};
+
+// The glyphs of the buffer a texture lies in, for drawing them straight from
+// the font instead of from the texture (the renderer's native text): where the
+// texture's first texel is in the buffer, the buffer's size, and every glyph
+// drawn into it since it was last clear.
+struct GlyphList {
+    std::uint32_t column{};
+    std::uint32_t row{};
+    std::uint32_t width{};
+    std::uint32_t height{};
+    std::vector<GlyphStamp> stamps;
+};
+
+// True and fills `out` under the same conditions as sharp_text(); the query's
+// factor is not used.
+bool glyph_list(const psprecomp::GuestMemory &memory, const SharpTextQuery &query, GlyphList &out);
+
 } // namespace portablekit::fonts
