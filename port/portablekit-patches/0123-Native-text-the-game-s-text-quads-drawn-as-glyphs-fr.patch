+        if ((!left && corner->position[0] != x1) || (!top && corner->position[1] != y1))
+            return decline(2u, "not an upright rectangle");
+        if (corner->color != first.color || corner->position[2] != first.position[2])
+            return decline(2u, "corners of different colours or depths");
+        float &u = left ? u_at_x0 : u_at_x1;
+        float &v = top ? v_at_y0 : v_at_y1;
