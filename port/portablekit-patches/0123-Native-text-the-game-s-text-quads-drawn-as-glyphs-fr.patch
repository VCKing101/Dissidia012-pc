+// Where the glyph the game asked to be drawn at (x64, y64) in its buffer has
+// its outline's origin, in buffer pixels, and a box in the buffer its 1x
+// bitmap lies within. False when nothing is drawn for the character.
+struct GlyphPlace {
+    float origin_x{};
+    float origin_y{};
+    float x0{}, y0{}, x1{}, y1{};
+};
+bool place(std::uint32_t code, std::int32_t x64, std::int32_t y64, GlyphPlace &out);
+// The same outline drawn scale_x by scale_y times as large as the game's
+// glyph, with its origin shift_x (0 to 1) of a pixel right of a whole pixel:
+// `x` and `y` are where its top-left pixel goes relative to that pixel.
+// Not cached: the renderer keeps what it draws.
+[[nodiscard]] GlyphBitmap render_at(std::uint32_t code, float scale_x, float scale_y, float shift_x);
+
 // Rereads the font settings and clears every cached glyph, so the next glyph
 // the game asks for comes from the new font, then runs the hook.
 void reload();
