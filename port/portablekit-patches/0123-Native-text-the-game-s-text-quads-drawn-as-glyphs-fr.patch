+    // The quad: an upright rectangle showing an upright rectangle of texels,
+    // u growing with x and v with y.
+    const Vertex &first = *corners[0];
+    float x0 = first.position[0], x1 = x0, y0 = first.position[1], y1 = y0;
+    for (const Vertex *corner : corners) {
