+VulkanRenderer::Impl::GlyphAdd VulkanRenderer::Impl::atlas_glyph(GlyphPage &page, std::uint64_t key,
+                                                                 std::uint32_t code, float scale_x, float scale_y,
+                                                                 float shift_x, const AtlasGlyph *&out) {
+    if (const auto found = page.glyphs.find(key); found != page.glyphs.end()) {
+        out = &found->second;
+        return GlyphAdd::Ready;
+    }
+    if (page.texture.descriptor == VK_NULL_HANDLE) {
+        page.side = wanted_glyph_page_side();
+        page.texture = create_texture_image(page.side, page.side);
+        if (page.texture.descriptor == VK_NULL_HANDLE) return GlyphAdd::Failed;
+        page.initialized = false;
+        page.clear_pending = true;
+    }
+    const fonts::GlyphBitmap bitmap = fonts::render_at(code, scale_x, scale_y, shift_x);
+    AtlasGlyph glyph{};
+    glyph.left = static_cast<std::int16_t>(std::clamp(bitmap.x, -32768, 32767));
+    glyph.top = static_cast<std::int16_t>(std::clamp(bitmap.y, -32768, 32767));
+    if (bitmap.width > 0 && bitmap.height > 0) {
+        const auto width = static_cast<std::uint32_t>(bitmap.width);
+        const auto height = static_cast<std::uint32_t>(bitmap.height);
+        if (width + 2u > page.side || height + 2u > page.side) return GlyphAdd::Failed;
+        // Shelves of glyphs side by side, a blank pixel between any two: the
+        // first shelf tall enough and not much taller, else a new one.
+        AtlasShelf *shelf = nullptr;
+        for (AtlasShelf &candidate : page.shelves) {
+            if (candidate.height >= height && candidate.height <= height + std::max(4u, height / 4u) &&
+                candidate.x + width + 1u <= page.side) {
+                shelf = &candidate;
+                break;
+            }
+        }
+        if (shelf == nullptr) {
+            const std::uint32_t shelf_height = (height + 3u) & ~3u;
+            if (page.next_y + shelf_height + 1u > page.side) return GlyphAdd::Full;
+            page.shelves.push_back({page.next_y, shelf_height, 1u});
+            page.next_y += shelf_height + 1u;
+            shelf = &page.shelves.back();
+        }
+        glyph.x = static_cast<std::uint16_t>(shelf->x);
+        glyph.y = static_cast<std::uint16_t>(shelf->y);
+        glyph.width = static_cast<std::uint16_t>(width);
+        glyph.height = static_cast<std::uint16_t>(height);
+        shelf->x += width + 1u;
+        // White, the coverage in alpha: the game's palette is white with an
+        // alpha ramp (native_text() checks), and the quad's colour tints it.
+        glyph_pixels.resize(std::size_t{width} * height);
+        for (std::size_t i = 0; i < glyph_pixels.size(); ++i)
+            glyph_pixels[i] = 0x00FFFFFFu | (static_cast<std::uint32_t>(bitmap.pixels[i]) << 24u);
+        VkBuffer buffer{};
+        VkDeviceSize offset = 0u;
+        if (!stage_upload(glyph_pixels.data(), static_cast<VkDeviceSize>(glyph_pixels.size()) * 4u, buffer, offset))
+            return GlyphAdd::Failed;
+        AtlasUpload upload{};
+        upload.buffer = buffer;
+        upload.copy.bufferOffset = offset;
+        upload.copy.imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0u, 0u, 1u};
+        upload.copy.imageOffset = {static_cast<std::int32_t>(glyph.x), static_cast<std::int32_t>(glyph.y), 0};
+        upload.copy.imageExtent = {width, height, 1u};
+        page.uploads.push_back(upload);
+        ++native_text_counts.added;
+    }
+    out = &page.glyphs.emplace(key, glyph).first->second;
+    return GlyphAdd::Ready;
+}
+
+void VulkanRenderer::Impl::record_glyph_uploads() {
+    if (frame_uploads == VK_NULL_HANDLE) return;
+    for (GlyphPage &page : glyph_pages) {
+        if (page.texture.image == VK_NULL_HANDLE || (!page.clear_pending && page.uploads.empty())) continue;
+        if (!frame_uploads_open) {
+            VkCommandBufferBeginInfo begin{VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO};
+            begin.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+            vkBeginCommandBuffer(frame_uploads, &begin);
+            frame_uploads_open = true;
+        }
+        // The barrier's first scope covers the frames before, which may have
+        // drawn from the page; its second, this frame's commands.
+        transition(frame_uploads, page.texture.image,
+                   page.initialized ? VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL : VK_IMAGE_LAYOUT_UNDEFINED,
+                   VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+        if (page.clear_pending) {
+            const VkClearColorValue transparent{};
+            const VkImageSubresourceRange range{VK_IMAGE_ASPECT_COLOR_BIT, 0u, 1u, 0u, 1u};
+            vkCmdClearColorImage(frame_uploads, page.texture.image, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+                                 &transparent, 1u, &range);
+            page.clear_pending = false;
+        }
+        for (const AtlasUpload &upload : page.uploads)
+            vkCmdCopyBufferToImage(frame_uploads, upload.buffer, page.texture.image,
+                                   VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1u, &upload.copy);
+        transition(frame_uploads, page.texture.image, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+                   VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+        page.initialized = true;
+        frame_upload_count += static_cast<std::uint32_t>(page.uploads.size());
+        page.uploads.clear();
+    }
+}
