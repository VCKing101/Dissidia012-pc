+                GpuVertex out{};
+                out.x = x;
+                out.y = y;
+                out.z = z;
+                out.u = u;
+                out.v = v;
+                out.color = tinted;
+                // Sampled between the centres of its edge texels only.
+                set_uv_rect(out, u0 + 0.5f, v0 + 0.5f, u1 - 0.5f, v1 - 0.5f);
+                return out;
+            };
+            const GpuVertex top_left = corner(left, top, u0, v0), top_right = corner(right, top, u1, v0);
+            const GpuVertex bottom_right = corner(right, bottom, u1, v1), bottom_left = corner(left, bottom, u0, v1);
+            text_vertices.insert(text_vertices.end(),
