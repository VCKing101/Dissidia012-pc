+VulkanRenderer::Impl::TextQuad VulkanRenderer::Impl::native_text(const GuestMemory &memory, const DrawCall &call,
+                                                                const std::array<const Vertex *, 4> &corners,
+                                                                float fit_x, float fit_y, VkDescriptorSet &descriptor,
+                                                                float &page_side) {
+    const TextureState &state = call.texture;
+    if (!sharp_text || native_text_off() || !fonts::sharp_text_available()) return TextQuad::NotText;
+    // New glyphs reach the GPU with the frame's uploads.
+    if (!recording || !async_uploads() || frame_uploads == VK_NULL_HANDLE) return TextQuad::NotText;
+    static const bool trace = portablekit::env("TRACE_NATIVE_TEXT") != nullptr;
+    const auto decline = [&](std::size_t reason, const char *why) {
+        ++native_text_counts.declined[reason];
+        static std::uint32_t told = 0u;
+        if (trace && told < 24u) {
+            ++told;
+            std::cout << "[native-text] 0x" << std::hex << state.address << std::dec << " " << state.width << "x"
+                      << state.height << " fmt " << static_cast<int>(state.format) << ": " << why << "\n";
+        }
+        return TextQuad::NotText;
+    };
+    // A 4- or 8-bit texture at an internal resolution of 2x or more, lying
+    // in a glyph buffer that holds only the glyphs the host drew.
+    if (sharp_text_factor(state) == 0u) return TextQuad::NotText;
+    const bool four_bit = state.format == TextureFormat::Clut4;
+    const fonts::SharpTextQuery query{state.address, state.buffer_width != 0u ? state.buffer_width : state.width,
+                                      state.width, state.height, four_bit ? 4u : 8u, 0};
+    if (!fonts::glyph_list(memory, query, text_glyphs)) return TextQuad::NotText;
+    // Modulated by the vertex colour, its blank texels dropped by the alpha
+    // test: then a glyph's pixels are all the quad draws. (Through-mode
+    // vertices are never lit, whatever the lighting switch says.)
+    if (state.function != 0u || !state.alpha_from_texture || !call.has_vertex_color)
+        return decline(0u, "not modulated by a vertex colour");
+    if (!call.alpha_test.enabled || call.alpha_test.function != 6u) return decline(0u, "no alpha test greater");
+    // The palette: one colour, its alpha rising with the index as a glyph's
+    // coverage does (entry 0, never seen, may have any colour).
+    const std::uint32_t entries = four_bit ? 16u : 256u;
+    const std::uint32_t tint = clut_color(memory, state, entries - 1u) & 0x00FFFFFFu;
+    for (std::uint32_t i = 0; i < entries; ++i) {
+        const std::uint32_t entry = clut_color(memory, state, i);
+        if ((entry >> 24u) != (four_bit ? i * 17u : i) || (i != 0u && (entry & 0x00FFFFFFu) != tint)) {
+            if (trace) {
+                static std::uint32_t told = 0u;
+                if (told++ < 4u) {
+                    std::cout << "[native-text] palette of 0x" << std::hex << state.address << ":";
+                    for (std::uint32_t k = 0; k < std::min(entries, 16u); ++k)
+                        std::cout << " " << clut_color(memory, state, k);
