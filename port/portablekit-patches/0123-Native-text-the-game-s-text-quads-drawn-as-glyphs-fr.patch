+        }
+        if (failure == GlyphAdd::Ready) {
+            // Only blank glyphs (spaces), or none inside the quad.
+            if (text_vertices.empty()) {
+                ++native_text_counts.skipped;
+                return TextQuad::Nothing;
+            }
+            page.used = true;
+            page.used_frame = glyph_frame;
+            descriptor = page.texture.descriptor;
+            page_side = static_cast<float>(page.side);
+            ++native_text_counts.quads;
+            native_text_counts.glyphs += drawn;
+            return TextQuad::Glyphs;
+        }
