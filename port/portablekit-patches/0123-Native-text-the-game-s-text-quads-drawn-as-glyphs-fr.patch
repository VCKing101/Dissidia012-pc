+std::uint32_t VulkanRenderer::Impl::wanted_glyph_page_side() const {
+    // A glyph of the game's menu text is about 40 x 45 pixels at 4x; past
+    // that, a page of 2048 would fill with a few screens of text.
+    const std::uint32_t lines = (target_extent.height + kPspHeight / 2u) / kPspHeight;
+    return lines <= 4u ? 2048u : 4096u;
+}
+
+void VulkanRenderer::Impl::reset_glyph_pages() {
+    for (GlyphPage &page : glyph_pages) {
+        page.glyphs.clear();
+        page.shelves.clear();
+        page.next_y = 1u;
+        page.uploads.clear();
+        page.clear_pending = page.texture.descriptor != VK_NULL_HANDLE;
+    }
+}
+
+void VulkanRenderer::Impl::destroy_glyph_pages() {
+    for (GlyphPage &page : glyph_pages) {
+        destroy_texture(page.texture);
+        page = GlyphPage{};
+    }
+    glyph_page = 0u;
+}
+
+bool VulkanRenderer::Impl::switch_glyph_page() {
+    GlyphPage &page = glyph_pages[glyph_page ^ 1u];
+    if (page.used && page.used_frame + kGlyphPageRest > glyph_frame) return false;
+    const std::uint32_t side = wanted_glyph_page_side();
+    if (page.texture.descriptor != VK_NULL_HANDLE && page.side != side) {
+        // No frame has drawn from it for kGlyphPageRest frames, so the GPU
+        // is done with it.
+        destroy_texture(page.texture);
+        page.initialized = false;
+    }
+    page.glyphs.clear();
+    page.shelves.clear();
+    page.next_y = 1u;
+    page.uploads.clear();
+    page.clear_pending = page.texture.descriptor != VK_NULL_HANDLE;
+    page.used = false;
+    glyph_page ^= 1u;
+    ++native_text_counts.switches;
+    return true;
+}
