+void VulkanRenderer::Impl::report_native_text() {
+    static const bool trace = portablekit::env("TRACE_NATIVE_TEXT") != nullptr;
+    // Every 300 frames recorded (`frames` counts presents).
+    ++glyph_frame;
+    if (!trace || glyph_frame % 300u != 0u) return;
+    NativeTextCounts &c = native_text_counts;
+    const std::uint64_t declined = c.declined[0] + c.declined[1] + c.declined[2];
+    if (c.quads + c.skipped + c.fallbacks + c.switches + declined != 0u) {
+        const GlyphPage &page = glyph_pages[glyph_page];
+        std::cout << "[native-text] frame " << frames << ": " << c.quads << " quads as " << c.glyphs << " glyphs, "
+                  << c.added << " glyphs added, " << c.skipped << " quads that draw nothing skipped, " << c.fallbacks
+                  << " drawn from textures, " << c.switches << " page switches; declined (state, palette, shape) "
+                  << c.declined[0] << "/" << c.declined[1] << "/" << c.declined[2] << "; page " << glyph_page << " "
+                  << page.side << "px, " << page.glyphs.size()
+                  << " glyphs, filled to row " << page.next_y << "\n";
+    }
+    c = NativeTextCounts{};
+}
