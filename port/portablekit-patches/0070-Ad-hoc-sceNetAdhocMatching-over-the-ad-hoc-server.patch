--- /dev/null
+++ b/host/adhoc/matching.cpp
@@ -0,0 +1,367 @@
+#include "adhoc/matching.hpp"
+
+#include <utility>
+
+namespace portablekit::adhoc {
+namespace {
+
+// Every packet: "PM", a type, the sender's mode, then the body.
+constexpr char kMagic0 = 'P';
+constexpr char kMagic1 = 'M';
+constexpr std::size_t kHeaderSize = 4u;
+
+constexpr char kHello = 'H';
+constexpr char kRequest = 'R';
+constexpr char kAccept = 'A';
+constexpr char kCancel = 'X';
+constexpr char kBye = 'B';
+constexpr char kKeepalive = 'K';
+constexpr char kData = 'D';     // u32 sequence, then the payload
+constexpr char kDataAck = 'd';  // u32 sequence
+
+std::string u32_bytes(std::uint32_t value) {
+    std::string bytes(4u, '\0');
+    for (std::size_t i = 0; i < 4u; ++i) bytes[i] = static_cast<char>((value >> (8u * i)) & 0xFFu);
+    return bytes;
+}
+
+std::uint32_t read_u32(const std::string &bytes, std::size_t offset) {
+    std::uint32_t value = 0u;
+    for (std::size_t i = 0; i < 4u; ++i)
+        value |= static_cast<std::uint32_t>(static_cast<std::uint8_t>(bytes[offset + i])) << (8u * i);
+    return value;
+}
+
+} // namespace
+
+const char *matching_event_name(MatchingEvent event) {
+    switch (event) {
+    case MatchingEvent::Hello: return "HELLO";
+    case MatchingEvent::Request: return "REQUEST";
+    case MatchingEvent::Leave: return "LEAVE";
+    case MatchingEvent::Deny: return "DENY";
+    case MatchingEvent::Cancel: return "CANCEL";
+    case MatchingEvent::Accept: return "ACCEPT";
+    case MatchingEvent::Established: return "ESTABLISHED";
+    case MatchingEvent::Timeout: return "TIMEOUT";
+    case MatchingEvent::Error: return "ERROR";
+    case MatchingEvent::Bye: return "BYE";
+    case MatchingEvent::Data: return "DATA";
+    case MatchingEvent::DataAck: return "DATA_ACK";
+    case MatchingEvent::DataTimeout: return "DATA_TIMEOUT";
+    }
+    return "?";
+}
+
+Matching::Matching(const Mac &self, const MatchingConfig &config, Send send)
+    : self_(self), config_(config), send_(std::move(send)) {}
+
+void Matching::start(std::string hello, std::uint64_t now_us) {
+    running_ = true;
+    hello_ = std::move(hello);
+    peers_.clear();
+    if (advertising()) send_hello(now_us);
+}
+
+void Matching::stop() {
+    if (running_) send(kBroadcastMac, kBye, {});
+    running_ = false;
+    peers_.clear();
+}
+
+void Matching::set_hello(std::string hello, std::uint64_t now_us) {
+    hello_ = std::move(hello);
+    if (advertising()) send_hello(now_us);
+}
+
+std::uint32_t Matching::select_target(const Mac &peer, std::string data, std::uint64_t now_us) {
+    if (!running_) return matching_error::kNotRunning;
+    if (peer == self_ || peer == kBroadcastMac) return matching_error::kInvalidArg;
+    const auto found = peers_.find(peer);
+    if (found != peers_.end() && found->second.link == Link::Asked) {
+        // Accepting a peer that asked.
+        if (config_.mode == MatchingMode::P2P && established_count() != 0u) return matching_error::kAlreadyEstablished;
+        if (config_.mode == MatchingMode::Parent && established_count() + 1u >= config_.max_peers)
+            return matching_error::kExceedMaxPeers;
+        Peer &entry = found->second;
+        entry.link = Link::Established;
+        entry.since_us = now_us;
+        entry.sent_us = now_us;
+        entry.attempts = 0u;
+        entry.request = std::move(data);
+        send(peer, kAccept, entry.request);
+        notice(MatchingEvent::Established, peer);
+        return 0u;
+    }
+    if (found != peers_.end()) {
+        switch (found->second.link) {
+        case Link::Asking: return matching_error::kRequestInProgress;
+        case Link::Established: return matching_error::kAlreadyEstablished;
+        default: break;
+        }
+    }
+    // Asking to join: a parent never asks, and a child or P2P peer joins one.
+    if (config_.mode == MatchingMode::Parent) return matching_error::kTargetNotReady;
+    if (found == peers_.end()) return matching_error::kUnknownTarget;
+    if (established_count() != 0u) return matching_error::kAlreadyEstablished;
+    for (const auto &[mac, other] : peers_)
+        if (other.link == Link::Asking) return matching_error::kRequestInProgress;
+    Peer &entry = found->second;
+    entry.link = Link::Asking;
+    entry.since_us = now_us;
+    entry.sent_us = now_us;
+    entry.attempts = 0u;
+    entry.request = std::move(data);
+    send(peer, kRequest, entry.request);
+    return 0u;
+}
+
+std::uint32_t Matching::cancel_target(const Mac &peer, std::string data) {
+    if (!running_) return matching_error::kNotRunning;
+    const auto found = peers_.find(peer);
+    if (found == peers_.end() || found->second.link == Link::Heard) return matching_error::kUnknownTarget;
+    send(peer, kCancel, data);
+    Peer &entry = found->second;
+    entry.link = Link::Heard;
+    entry.request.clear();
+    entry.sending.reset();
+    return 0u;
+}
+
+std::uint32_t Matching::send_data(const Mac &peer, std::string data, std::uint64_t now_us) {
+    if (!running_) return matching_error::kNotRunning;
+    if (data.empty()) return matching_error::kInvalidDataLen;
+    const auto found = peers_.find(peer);
+    if (found == peers_.end() || found->second.link != Link::Established) return matching_error::kNotEstablished;
+    Peer &entry = found->second;
+    if (entry.sending) return matching_error::kDataBusy;
+    entry.sending = entry.next_sequence++;
+    entry.send_buffer = u32_bytes(*entry.sending) + data;
+    entry.data_sent_us = now_us;
+    entry.data_attempts = 0u;
+    send(peer, kData, entry.send_buffer);
+    return 0u;
+}
+
+std::uint32_t Matching::abort_send(const Mac &peer) {
+    const auto found = peers_.find(peer);
+    if (found == peers_.end()) return matching_error::kUnknownTarget;
+    found->second.sending.reset();
+    return 0u;
+}
+
+void Matching::receive(const Mac &from, const std::string &packet, std::uint64_t now_us) {
+    if (!running_ || from == self_ || packet.size() < kHeaderSize || packet[0] != kMagic0 || packet[1] != kMagic1)
+        return;
+    const char type = packet[2];
+    const auto mode = static_cast<MatchingMode>(static_cast<std::uint8_t>(packet[3]));
+    std::string body = packet.substr(kHeaderSize);
+    auto found = peers_.find(from);
+    if (found != peers_.end()) found->second.heard_us = now_us;
+
+    switch (type) {
+    case kHello: {
+        if (found == peers_.end()) {
+            if (!hears_hellos_from(mode)) return;
+            Peer entry;
+            entry.mode = mode;
+            entry.heard_us = now_us;
+            entry.since_us = now_us;
+            found = peers_.emplace(from, entry).first;
+        }
+        found->second.mode = mode;
+        if (hears_hellos_from(mode)) notice(MatchingEvent::Hello, from, std::move(body));
+        return;
+    }
+    case kRequest: {
+        const bool fits = (config_.mode == MatchingMode::P2P && mode == MatchingMode::P2P) ||
+                          (config_.mode == MatchingMode::Parent && mode == MatchingMode::Child);
+        if (!fits) return;
+        if (found != peers_.end()) {
+            const Link link = found->second.link;
+            if (link == Link::Asked) return;  // a resend
+            if (link == Link::Established) {
+                send(from, kAccept, found->second.request);  // the accept was lost
+                return;
+            }
+        }
+        const bool full = config_.mode == MatchingMode::P2P ? established_count() != 0u
+                                                            : established_count() + 1u >= config_.max_peers;
+        if (full) {
+            send(from, kCancel, {});
+            return;
+        }
+        if (found == peers_.end()) {
+            Peer entry;
+            entry.mode = mode;
+            entry.heard_us = now_us;
+            found = peers_.emplace(from, entry).first;
+        }
+        found->second.link = Link::Asked;
+        found->second.since_us = now_us;
+        notice(MatchingEvent::Request, from, std::move(body));
+        return;
+    }
+    case kAccept: {
+        if (found == peers_.end()) return;
+        Peer &entry = found->second;
+        if (entry.link != Link::Asking) return;
+        entry.link = Link::Established;
+        entry.since_us = now_us;
+        entry.sent_us = now_us;
+        entry.request.clear();
+        notice(MatchingEvent::Accept, from, std::move(body));
+        notice(MatchingEvent::Established, from);
+        return;
+    }
+    case kCancel: {
+        if (found == peers_.end()) return;
+        Peer &entry = found->second;
+        MatchingEvent event{};
+        switch (entry.link) {
+        case Link::Asking: event = MatchingEvent::Deny; break;
+        case Link::Asked: event = MatchingEvent::Cancel; break;
+        case Link::Established: event = MatchingEvent::Leave; break;
+        case Link::Heard: return;
+        }
+        entry.link = Link::Heard;
+        entry.request.clear();
+        entry.sending.reset();
+        notice(event, from, std::move(body));
+        return;
+    }
+    case kBye: {
+        if (found == peers_.end()) return;
+        peers_.erase(found);
+        notice(MatchingEvent::Bye, from);
+        return;
+    }
+    case kKeepalive: return;
+    case kData: {
+        if (body.size() < 4u) return;
+        const std::uint32_t sequence = read_u32(body, 0u);
+        send(from, kDataAck, u32_bytes(sequence));
+        if (found == peers_.end() || found->second.link != Link::Established) return;
+        if (sequence == found->second.last_received) return;  // a resend whose ack was lost
+        found->second.last_received = sequence;
+        notice(MatchingEvent::Data, from, body.substr(4u));
+        return;
+    }
+    case kDataAck: {
+        if (body.size() < 4u || found == peers_.end()) return;
+        Peer &entry = found->second;
+        if (!entry.sending || *entry.sending != read_u32(body, 0u)) return;
+        entry.sending.reset();
+        entry.send_buffer.clear();
+        notice(MatchingEvent::DataAck, from);
+        return;
+    }
+    default: return;
+    }
+}
+
+void Matching::tick(std::uint64_t now_us) {
+    if (!running_) return;
+    if (advertising() && now_us - hello_sent_us_ >= config_.hello_us) send_hello(now_us);
+    const std::uint64_t quiet_limit = config_.keepalive_us * 3u;
+    std::vector<Mac> gone;
+    for (auto &[mac, entry] : peers_) {
+        switch (entry.link) {
+        case Link::Heard:
+            if (now_us - entry.heard_us > config_.hello_us * 3u) gone.push_back(mac);
+            break;
+        case Link::Asking:
+            if (now_us - entry.sent_us < config_.retransmit_us) break;
+            if (entry.attempts >= config_.retries) {
+                entry.link = Link::Heard;
+                entry.request.clear();
+                notice(MatchingEvent::Timeout, mac);
+                break;
+            }
+            ++entry.attempts;
+            entry.sent_us = now_us;
+            send(mac, kRequest, entry.request);
+            break;
+        case Link::Asked: break;
+        case Link::Established:
+            if (now_us - entry.heard_us > quiet_limit) {
+                entry.link = Link::Heard;
+                entry.sending.reset();
+                notice(MatchingEvent::Timeout, mac);
+                break;
+            }
+            if (now_us - entry.sent_us >= config_.keepalive_us) {
+                entry.sent_us = now_us;
+                send(mac, kKeepalive, {});
+            }
+            break;
+        }
+        if (entry.sending && now_us - entry.data_sent_us >= config_.retransmit_us) {
+            if (entry.data_attempts >= config_.retries) {
+                entry.sending.reset();
+                entry.send_buffer.clear();
+                notice(MatchingEvent::DataTimeout, mac);
+            } else {
+                ++entry.data_attempts;
+                entry.data_sent_us = now_us;
+                send(mac, kData, entry.send_buffer);
+            }
+        }
+    }
+    for (const Mac &mac : gone) peers_.erase(mac);
+}
+
+std::vector<MatchingNotice> Matching::take_notices() { return std::exchange(notices_, {}); }
+
+std::vector<Mac> Matching::members() const {
+    std::vector<Mac> list;
+    for (const auto &[mac, entry] : peers_)
+        if (entry.link == Link::Established) list.push_back(mac);
+    return list;
+}
+
+bool Matching::advertising() const {
+    if (!running_) return false;
+    switch (config_.mode) {
+    case MatchingMode::Parent: return established_count() + 1u < config_.max_peers;
+    case MatchingMode::Child: return false;
+    case MatchingMode::P2P: return established_count() == 0u;
+    }
+    return false;
+}
+
+std::size_t Matching::established_count() const {
+    std::size_t count = 0u;
+    for (const auto &[mac, entry] : peers_)
+        if (entry.link == Link::Established) ++count;
+    return count;
+}
+
+bool Matching::hears_hellos_from(MatchingMode mode) const {
+    if (!running_ || established_count() != 0u) return false;
+    if (config_.mode == MatchingMode::P2P) return mode == MatchingMode::P2P;
+    if (config_.mode == MatchingMode::Child) return mode == MatchingMode::Parent;
+    return false;
+}
+
+void Matching::notice(MatchingEvent event, const Mac &peer, std::string data) {
+    notices_.push_back(MatchingNotice{event, peer, std::move(data)});
+}
+
+void Matching::send(const Mac &to, char type, const std::string &body) {
+    std::string packet;
+    packet.reserve(kHeaderSize + body.size());
+    packet.push_back(kMagic0);
+    packet.push_back(kMagic1);
+    packet.push_back(type);
+    packet.push_back(static_cast<char>(static_cast<std::uint8_t>(config_.mode)));
+    packet += body;
+    send_(to, packet);
+}
+
+void Matching::send_hello(std::uint64_t now_us) {
+    hello_sent_us_ = now_us;
+    send(kBroadcastMac, kHello, hello_);
+}
+
+} // namespace portablekit::adhoc
diff --git a/host/adhoc/matching.hpp b/host/adhoc/matching.hpp
new file mode 100644
index 0000000..fefb3d2
--- /dev/null
+++ b/host/adhoc/matching.hpp
@@ -0,0 +1,172 @@
+#pragma once
+
+// sceNetAdhocMatching: the PSP library many games build their lobbies on,
+// as one protocol engine per matching object. It knows nothing of guest
+// memory or of the relay; the HLE layer feeds it the datagrams that arrive on
+// the object's port, gives it a way to send, and turns its notices into calls
+// of the game's event handler.
+//
+// What the game sees, as PSP games use it:
+// - A parent (mode 1) advertises itself with a hello carrying the game's data
+//   while it has room for children; a child (mode 2) hears parents' hellos
+//   and says nothing until it picks one; in P2P mode (3) both sides advertise
+//   until they are paired with one other.
+// - SelectTarget on a peer asks to join it (the peer gets REQUEST with the
+//   caller's data). SelectTarget on a peer that asked accepts it: the
+//   accepter gets ESTABLISHED at once, and the asker gets ACCEPT with the
+//   accepter's data, then ESTABLISHED. The accepter does not wait to hear
+//   back: a game may leave the group the moment it is matched (Dissidia 012
+//   does), and its last datagrams can be lost with it.
+// - CancelTarget withdraws a request (the peer gets CANCEL), refuses one (the
+//   asker gets DENY) or leaves an established peer (it gets LEAVE). Stopping
+//   says goodbye to every peer heard from (BYE).
+// - SendData goes to an established peer (DATA there), and is acknowledged
+//   (DATA_ACK here); one at a time per peer.
+// - A request with no answer and an established peer gone quiet end in
+//   TIMEOUT; unacknowledged data in DATA_TIMEOUT.
+//
+// The wire format is this engine's own: both ends of a session run it. The
+// timings are the game's own: the hello, keepalive and retransmission
+// intervals and the retry count it passes to Create.
+#include "adhoc/protocol.hpp"
+
+#include <cstdint>
+#include <functional>
+#include <map>
+#include <optional>
+#include <string>
+#include <vector>
+
+namespace portablekit::adhoc {
+
+enum class MatchingMode : std::uint32_t { Parent = 1u, Child = 2u, P2P = 3u };
+
+// The PSP's event numbers, as the game's handler receives them.
+enum class MatchingEvent : std::uint32_t {
+    Hello = 1u,
+    Request = 2u,
+    Leave = 3u,
+    Deny = 4u,
+    Cancel = 5u,
+    Accept = 6u,
+    Established = 7u,
+    Timeout = 8u,
+    Error = 9u,
+    Bye = 10u,
+    Data = 11u,
+    DataAck = 12u,
+    DataTimeout = 13u,
+};
+
+[[nodiscard]] const char *matching_event_name(MatchingEvent event);
+
+namespace matching_error {
+inline constexpr std::uint32_t kInvalidMode = 0x80410801u;
+inline constexpr std::uint32_t kInvalidMaxPeers = 0x80410803u;
+inline constexpr std::uint32_t kInvalidOptLen = 0x80410805u;
+inline constexpr std::uint32_t kInvalidArg = 0x80410806u;
+inline constexpr std::uint32_t kInvalidId = 0x80410807u;
+inline constexpr std::uint32_t kIsRunning = 0x8041080Au;
+inline constexpr std::uint32_t kNotRunning = 0x8041080Bu;
+inline constexpr std::uint32_t kUnknownTarget = 0x8041080Cu;
+inline constexpr std::uint32_t kTargetNotReady = 0x8041080Du;
+inline constexpr std::uint32_t kExceedMaxPeers = 0x8041080Eu;
+inline constexpr std::uint32_t kRequestInProgress = 0x8041080Fu;
+inline constexpr std::uint32_t kAlreadyEstablished = 0x80410810u;
+inline constexpr std::uint32_t kAlreadyInitialized = 0x80410812u;
+inline constexpr std::uint32_t kNotInitialized = 0x80410813u;
+inline constexpr std::uint32_t kPortInUse = 0x80410814u;
+inline constexpr std::uint32_t kInvalidDataLen = 0x80410816u;
+inline constexpr std::uint32_t kNotEstablished = 0x80410817u;
+inline constexpr std::uint32_t kDataBusy = 0x80410818u;
+} // namespace matching_error
+
+struct MatchingConfig {
+    MatchingMode mode{MatchingMode::P2P};
+    std::uint32_t max_peers{2u};  // this PSP included
+    std::uint64_t hello_us{5'000'000u};
+    std::uint64_t keepalive_us{10'000'000u};
+    std::uint32_t retries{30u};
+    std::uint64_t retransmit_us{2'000'000u};
+};
+
+struct MatchingNotice {
+    MatchingEvent event{};
+    Mac peer{};
+    std::string data;  // the peer's hello, request or accept data, or a DATA payload
+};
+
+class Matching {
+public:
+    // Sends one datagram to `to` on the object's port; kBroadcastMac means
+    // every member of the group.
+    using Send = std::function<void(const Mac &to, const std::string &packet)>;
+
+    Matching(const Mac &self, const MatchingConfig &config, Send send);
+
+    [[nodiscard]] const MatchingConfig &config() const noexcept { return config_; }
+    [[nodiscard]] bool running() const noexcept { return running_; }
+
+    void start(std::string hello, std::uint64_t now_us);
+    // Says goodbye to every peer and forgets them.
+    void stop();
+    void set_hello(std::string hello, std::uint64_t now_us);
+    [[nodiscard]] const std::string &hello() const noexcept { return hello_; }
+
+    // 0, or a matching_error code.
+    [[nodiscard]] std::uint32_t select_target(const Mac &peer, std::string data, std::uint64_t now_us);
+    [[nodiscard]] std::uint32_t cancel_target(const Mac &peer, std::string data);
+    [[nodiscard]] std::uint32_t send_data(const Mac &peer, std::string data, std::uint64_t now_us);
+    [[nodiscard]] std::uint32_t abort_send(const Mac &peer);
+
+    // One datagram from the object's port.
+    void receive(const Mac &from, const std::string &packet, std::uint64_t now_us);
+    // Hellos, keepalives, retransmissions and timeouts that are due.
+    void tick(std::uint64_t now_us);
+    [[nodiscard]] std::vector<MatchingNotice> take_notices();
+
+    // Established peers, for the parent its children, for a child its parent.
+    [[nodiscard]] std::vector<Mac> members() const;
+
+private:
+    enum class Link {
+        Heard,       // a hello came from it, nothing more
