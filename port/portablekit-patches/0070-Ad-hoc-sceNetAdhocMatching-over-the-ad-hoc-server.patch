+// sceNetAdhocMatching ------------------------------------------------------------
+
+MatchingObject *find_matching(std::uint32_t id) {
+    const auto found = state().matching.find(id);
+    return found != state().matching.end() ? &found->second : nullptr;
+}
+
+std::string read_bytes(const psprecomp::GuestMemory &memory, std::uint32_t address, std::uint32_t length) {
+    std::string bytes(address != 0u ? length : 0u, '\0');
+    for (std::size_t i = 0; i < bytes.size(); ++i)
+        bytes[i] = static_cast<char>(memory.load8(address + static_cast<std::uint32_t>(i)));
+    return bytes;
+}
+
+void stop_matching(MatchingObject &object) {
+    if (object.socket == 0) return;
+    object.engine->stop();
+    Client::get().pdp_close(object.socket);
+    object.socket = 0;
+}
+
+// The largest hello, request or data a datagram of the relay carries.
+constexpr std::uint32_t kMatchingDataMax = static_cast<std::uint32_t>(adhoc::relay::kPdpBlockMax) - 16u;
+
+void register_matching(HleRegistrar &hle) {
+    namespace merr = adhoc::matching_error;
+    // (pool size)
+    hle.add("sceNetAdhocMatching", "sceNetAdhocMatchingInit", [](Runtime &, AllegrexContext &ctx) {
+        if (state().matching_initialized) return done(ctx, "sceNetAdhocMatchingInit", 1, merr::kAlreadyInitialized);
+        state().matching_initialized = true;
+        ensure_hooked();
+        done(ctx, "sceNetAdhocMatchingInit", 1, 0u);
+    });
+    hle.add("sceNetAdhocMatching", "sceNetAdhocMatchingTerm", [](Runtime &, AllegrexContext &ctx) {
+        for (auto &[id, object] : state().matching) stop_matching(object);
+        state().matching.clear();
+        state().matching_initialized = false;
+        done(ctx, "sceNetAdhocMatchingTerm", 0, 0u);
+    });
+    // (mode, max peers, port, receive buffer, hello us, keepalive us, retry
+    // count, retransmit us, handler): the handler, the ninth argument, is on
+    // the stack.
+    hle.add("sceNetAdhocMatching", "sceNetAdhocMatchingCreate", [](Runtime &rt, AllegrexContext &ctx) {
+        const char *name = "sceNetAdhocMatchingCreate";
+        State &s = state();
+        if (!s.matching_initialized) return done(ctx, name, 8, merr::kNotInitialized);
+        const std::uint32_t mode = arg(ctx, 0);
+        if (mode < 1u || mode > 3u) return done(ctx, name, 8, merr::kInvalidMode);
+        if (arg(ctx, 1) < 2u || arg(ctx, 1) > 16u) return done(ctx, name, 8, merr::kInvalidMaxPeers);
+        const auto port = static_cast<std::uint16_t>(arg(ctx, 2));
+        for (const auto &[id, object] : s.matching)
+            if (object.port == port) return done(ctx, name, 8, merr::kPortInUse);
+        adhoc::MatchingConfig config;
+        config.mode = static_cast<adhoc::MatchingMode>(mode);
+        config.max_peers = arg(ctx, 1);
+        config.hello_us = arg(ctx, 4);
+        config.keepalive_us = arg(ctx, 5);
+        config.retries = arg(ctx, 6);
+        config.retransmit_us = arg(ctx, 7);
+        const std::uint32_t handler = rt.memory().load32(ctx.gpr[29]);
+        const std::uint32_t id = s.next_matching++;
