+// Calls a matching object's handler: (id, event, mac*, data length, data*).
+// The MAC and the data live in a block of guest memory freed when the handler
+// returns.
+void deliver_matching(std::uint32_t id, std::uint32_t handler, const adhoc::MatchingNotice &notice) {
+    const auto size = static_cast<std::uint32_t>((8u + notice.data.size() + 15u) & ~std::size_t{15u});
+    const std::int32_t block = kernel().allocate_block("matching event", 1u, size, 0u);
+    if (block < 0) {
+        Client::log("[adhoc] no guest memory for a matching event; " +
+                        std::string(adhoc::matching_event_name(notice.event)) + " dropped",
+                    true);
+        return;
+    }
+    const std::uint32_t address = kernel().find_block(block)->address;
+    auto &memory = kernel().runtime().memory();
+    write_mac(memory, address, notice.peer);
+    for (std::size_t i = 0; i < notice.data.size(); ++i)
+        memory.store8(address + 8u + static_cast<std::uint32_t>(i), static_cast<std::uint8_t>(notice.data[i]));
+    if (trace_adhoc())
+        trace_line("matching " + std::to_string(id) + " event " + adhoc::matching_event_name(notice.event) + " from " +
+                   adhoc::format_mac(notice.peer) + " length " + std::to_string(notice.data.size()));
+    InterruptCall call{};
+    call.function = handler;
+    call.arguments = {id, static_cast<std::uint32_t>(notice.event), address,
+                      static_cast<std::uint32_t>(notice.data.size()), notice.data.empty() ? 0u : address + 8u};
+    call.argument_count = 5u;
+    call.on_return = [block](std::uint32_t) { kernel().free_block(block); };
+    kernel().queue_interrupt(std::move(call));
+}
+
+// Feeds each started matching object what arrived on its port, runs its
+// timers and hands its events to the game.
+void pump_matching() {
+    const std::uint64_t now = kernel().now_us();
+    for (auto &[id, object] : state().matching) {
+        if (object.socket == 0) continue;
+        while (auto datagram = Client::get().pdp_receive(object.socket))
+            object.engine->receive(datagram->source, datagram->data, now);
+        object.engine->tick(now);
+        for (const adhoc::MatchingNotice &notice : object.engine->take_notices())
+            deliver_matching(id, object.handler, notice);
+    }
+}
+
 void ensure_hooked() {
     if (state().hooked) return;
     state().hooked = true;
     kernel().add_vblank_hook(pump_events);
+    kernel().add_vblank_hook(pump_matching);
 }
 
