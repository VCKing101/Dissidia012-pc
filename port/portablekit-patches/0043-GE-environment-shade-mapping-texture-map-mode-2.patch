+// Environment (shade) mapping, texture map mode 2: the GE takes U and V from
+// the vertex normal in world space and the vectors of the two lights 0xC1
+// names, (1 + N.L) / 2 each, whatever the lights' types and enables; the
+// vertex UVs are not read. The light vectors are the position registers, as
+// for a directional light; one never set (zero) is taken as (0, 0, 1). A
+// vertex without a normal has none in its data: it is taken as (0, 0, 1) in
+// world space, as the lighting above takes it. The texture scale applies to
+// the result, the offset does not (the host leaves it out of uv_transform).
+vec2 environment_map_uv() {
+    vec3 normal = mat3(object.world) * in_normal;
+    float length_squared = dot(normal, normal);
+    normal = length_squared > 0.0 ? normal * inversesqrt(length_squared) : vec3(0.0, 0.0, 1.0);
+    if (object.texgen.z > 0.5) normal = -normal;
+    vec3 u_light = lighting.light_position[int(object.texgen.x + 0.5) & 3].xyz;
+    vec3 v_light = lighting.light_position[int(object.texgen.y + 0.5) & 3].xyz;
+    u_light = dot(u_light, u_light) > 0.0 ? normalize(u_light) : vec3(0.0, 0.0, 1.0);
+    v_light = dot(v_light, v_light) > 0.0 ? normalize(v_light) : vec3(0.0, 0.0, 1.0);
+    return 0.5 * (vec2(1.0) + vec2(dot(normal, u_light), dot(normal, v_light)));
+}
+
