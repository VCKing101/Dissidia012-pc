+bool right_stick(gpu::VulkanRenderer &renderer, float width, bool zone_row) {
+    ImDrawList *draw = ImGui::GetWindowDrawList();
+    const ImVec2 start = ImGui::GetCursorScreenPos();
+    const settings::Settings &s = settings::current();
+    SDL_Gamepad *pad = renderer.gamepad();
+    const float x = axis(pad, SDL_GAMEPAD_AXIS_RIGHTX);
+    const float y = axis(pad, SDL_GAMEPAD_AXIS_RIGHTY);
+    const bool dpad = zone_row || s.right_stick == settings::RightStick::DPad;
+    if (!dpad && s.right_stick == settings::RightStick::Off) return false;
+    const float size = std::floor(std::min(width * 0.42f, font() * 12.0f));
+    const float radius = size * 0.42f;
+    const ImVec2 c{start.x + size * 0.5f, start.y + size * 0.5f};
+    const float line = std::max(1.0f, px(1.5f));
+    draw->AddRectFilled({start.x, start.y}, {start.x + size, start.y + size}, faded(colors::kPanel, 0.8f));
+    std::string state;
+    if (dpad) {
+        const float zone = s.right_stick_zone;
+        const bool left = x < -zone, right = x > zone, up = y < -zone, down = y > zone;
+        const ImU32 lit = faded(colors::kAccent, 0.35f);
+        if (left) draw->AddRectFilled({c.x - radius, c.y - radius}, {c.x - radius * zone, c.y + radius}, lit);
+        if (right) draw->AddRectFilled({c.x + radius * zone, c.y - radius}, {c.x + radius, c.y + radius}, lit);
+        if (up) draw->AddRectFilled({c.x - radius, c.y - radius}, {c.x + radius, c.y - radius * zone}, lit);
+        if (down) draw->AddRectFilled({c.x - radius, c.y + radius * zone}, {c.x + radius, c.y + radius}, lit);
+        for (const float k : {-zone, zone}) {
+            dashed_line(draw, {c.x + radius * k, c.y - radius}, {c.x + radius * k, c.y + radius}, colors::kText,
+                        px(4.0f), line);
+            dashed_line(draw, {c.x - radius, c.y + radius * k}, {c.x + radius, c.y + radius * k}, colors::kText,
+                        px(4.0f), line);
+        }
+        std::string pressed;
+        const auto add = [&](bool on, const char *name) {
+            if (on) pressed += (pressed.empty() ? "" : " and ") + std::string(name);
+        };
+        add(up, "Up");
+        add(down, "Down");
+        add(left, "Left");
+        add(right, "Right");
+        state = pressed.empty() ? "Presses nothing" : "Presses " + pressed;
+    } else {
+        const float length = std::hypot(x, y);
+        if (length <= s.dead_zone) {
+            state = "At rest";
+        } else {
+            const float amount = std::min((length - s.dead_zone) / (1.0f - s.dead_zone), 1.0f);
+            state = std::string("Pushed ") + direction(x, y) + ", " +
+                    std::to_string(static_cast<int>(std::lround(amount * 100.0f))) + "%";
+        }
+        draw->AddCircleFilled(c, radius * s.dead_zone, faded(colors::kDanger, 0.3f), 32);
+    }
+    draw->AddCircle(c, radius, faded(colors::kText, 0.45f), 64, line);
+    if (pad != nullptr) {
+        const ImVec2 dot{c.x + x * radius, c.y + y * radius};
+        draw->AddLine(c, dot, colors::kAccent, std::max(1.5f, px(2.0f)));
+        draw->AddCircleFilled(dot, px(8.0f), colors::kAccent);
+        draw->AddCircle(dot, px(8.0f), colors::kHeading, 0, std::max(1.5f, px(2.0f)));
+    }
+    const float column = start.x + size + px(28.0f);
+    float ly = start.y + px(6.0f);
+    label(draw, {column, ly}, dpad ? "D-pad" : "Camera", colors::kSection);
+    ly += std::round(font() * 1.2f);
+    const float heading_size = std::round(font() * 1.15f);
+    draw->AddText(heading_font(), heading_size, {column, ly}, colors::kHeading, state.c_str());
+    ly += heading_size + px(10.0f);
+    if (pad != nullptr)
+        readout(draw, {column, ly}, std::round(font() * 5.5f), "Right stick", printed("%.2f, %.2f", x, y));
+    float bottom = start.y + size + px(14.0f);
+    bottom += note(draw, {start.x, bottom}, width,
+                   pad != nullptr ? (dpad ? std::string("Past a dashed line the stick presses that way; in a corner, "
+                                                        "two ways. Live from ")
+                                          : std::string("Live from ")) +
+                                        pad_name(pad) + "."
+                                  : "Connect a gamepad to try it here.");
+    ImGui::Dummy({width, bottom - start.y});
+    return true;
+}
+
+bool mouse(float width) {
+    ImDrawList *draw = ImGui::GetWindowDrawList();
+    const ImVec2 start = ImGui::GetCursorScreenPos();
+    const float sensitivity = settings::current().mouse_sensitivity;
+    constexpr float kCounts = 100.0f;
+    const float degrees = kCounts * sensitivity;
+    // An arrow for the mouse's 100 counts, and the camera's turn as a wedge.
+    const float arrow_w = std::round(font() * 6.0f);
+    float y = start.y + px(6.0f);
+    text(draw, {start.x, y}, colors::kTextDim, "Mouse moves", 0.8f);
+    const float ay = y + std::round(font() * 1.6f);
+    draw->AddLine({start.x, ay}, {start.x + arrow_w - px(10.0f), ay}, colors::kHeading, std::max(1.5f, px(2.0f)));
+    draw->AddTriangleFilled({start.x + arrow_w, ay}, {start.x + arrow_w - px(12.0f), ay - px(6.0f)},
+                            {start.x + arrow_w - px(12.0f), ay + px(6.0f)}, colors::kHeading);
+    text(draw, {start.x, ay + px(10.0f)}, colors::kHeading, "100 counts", 0.9f);
+    const float r = std::round(font() * 4.2f);
+    const ImVec2 c{start.x + arrow_w + px(40.0f), start.y + r + px(8.0f)};
+    const float sweep = std::min(degrees, 180.0f) * 3.14159265f / 180.0f;
+    const float a0 = -3.14159265f * 0.5f;
+    draw->PathLineTo(c);
+    draw->PathArcTo(c, r, a0, a0 + sweep, 32);
+    draw->PathFillConvex(faded(colors::kAccent, 0.35f));
+    draw->PathArcTo(c, r, a0, a0 + sweep, 32);
+    draw->PathStroke(colors::kAccent, 0, std::max(1.5f, px(2.0f)));
+    draw->AddLine(c, {c.x, c.y - r}, faded(colors::kText, 0.35f), std::max(1.0f, px(1.5f)));
+    draw->AddCircleFilled(c, px(5.0f), colors::kHeading);
+    const float column = c.x + r + px(26.0f);
+    text(draw, {column, y}, colors::kTextDim, "Camera turns", 0.8f);
+    const std::string turned = printed("%.0f°", degrees);
+    const float big = std::round(font() * 1.6f);
+    draw->AddText(heading_font(), big, {column, y + std::round(font() * 1.1f)}, colors::kHeading, turned.c_str());
+    const std::string full = std::to_string(static_cast<int>(std::lround(360.0f / std::max(sensitivity, 0.01f)))) +
+                             " counts for a full turn";
+    text(draw, {column, y + std::round(font() * 1.2f) + big}, colors::kTextDim, full, 0.8f);
+    float bottom = std::max(c.y + r, ay + font() * 1.6f) + px(14.0f);
+    bottom += note(draw, {start.x, bottom}, width,
+                   printed("At %.2f", sensitivity) + "° a count of the mouse's own motion.");
+    ImGui::Dummy({width, bottom - start.y});
+    return true;
+}
+
+bool font_sample(float width) {
+    font_preview();
+    if (const char *about = portablekit::game().font_note; about != nullptr) {
+        ImDrawList *draw = ImGui::GetWindowDrawList();
+        const ImVec2 at = ImGui::GetCursorScreenPos();
+        const float h = note(draw, {at.x + px(16.0f), at.y + px(4.0f)}, width - px(32.0f), about, colors::kTextDim);
+        ImGui::Dummy({width, h + px(8.0f)});
+    }
+    return true;
+}
+
+bool prompts(gpu::VulkanRenderer &renderer, float width) {
+    ImDrawList *draw = ImGui::GetWindowDrawList();
+    const ImVec2 start = ImGui::GetCursorScreenPos();
+    const settings::Settings &s = settings::current();
+    const input::PadKind kind = pad_kind(renderer.gamepad());
+    const bool cross_confirms = portablekit::game().confirm_button == 1u;
+    const float gap = px(12.0f);
+    const float cell_w = std::floor((width - gap * 2.0f) / 3.0f);
+    const float cell_h = std::round(font() * 3.6f);
+    const float r = std::round(font() * 0.62f);
+    for (int i = 0; i < input::kPromptSettings; ++i) {
+        const auto setting = static_cast<input::PromptSetting>(i);
+        const input::ButtonPrompts p = input::button_prompts(setting, kind, s.confirm_south, cross_confirms, false);
+        const ImVec2 min{start.x + static_cast<float>(i % 3) * (cell_w + gap),
+                         start.y + static_cast<float>(i / 3) * (cell_h + gap)};
+        const ImVec2 max{min.x + cell_w, min.y + cell_h};
+        const bool on = setting == s.button_prompts;
+        draw->AddRectFilled(min, max, on ? faded(colors::kRowFocus, 0.35f) : faded(colors::kText, 0.05f));
+        if (on) draw->AddRect(min, max, colors::kAccent, 0.0f, 0, std::max(1.0f, px(2.0f)));
+        float gx = min.x + px(12.0f) + r;
+        const float gy = min.y + px(10.0f) + r;
+        // Confirm, back and the top face button, as the game's prompts show them.
+        const struct {
+            input::FaceButton face;
+            input::PromptKey key;
+            Shape psp;
+            ImU32 psp_colour;
+        } kShown[] = {{p.cross, input::PromptKey::Cross, Shape::Cross, IM_COL32(127, 167, 255, 255)},
+                      {p.circle, input::PromptKey::Circle, Shape::Circle, IM_COL32(255, 122, 122, 255)},
+                      {p.triangle, input::PromptKey::Triangle, Shape::Triangle, IM_COL32(111, 214, 160, 255)}};
+        for (const auto &shown : kShown) {
+            const ImVec2 c{gx, gy};
+            switch (p.style) {
+            case input::PromptStyle::Psp:
+                draw->AddCircleFilled(c, r, IM_COL32(58, 61, 72, 255));
+                shape(draw, c, r, shown.psp, shown.psp_colour);
+                gx += r * 2.0f + px(6.0f);
+                break;
+            case input::PromptStyle::PlayStation:
+                draw->AddCircleFilled(c, r, IM_COL32(26, 29, 41, 255));
+                shape(draw, c, r, shape_at(shown.face), IM_COL32(238, 241, 248, 255));
+                gx += r * 2.0f + px(6.0f);
+                break;
+            case input::PromptStyle::Xbox:
+                draw->AddCircleFilled(c, r, xbox_colour(shown.face));
+                letter(draw, c, r, xbox_letter(shown.face), IM_COL32(255, 255, 255, 255));
+                gx += r * 2.0f + px(6.0f);
+                break;
+            case input::PromptStyle::Nintendo:
+                draw->AddCircleFilled(c, r, IM_COL32(74, 77, 88, 255));
+                letter(draw, c, r, nintendo_letter(shown.face), IM_COL32(255, 255, 255, 255));
+                gx += r * 2.0f + px(6.0f);
+                break;
+            case input::PromptStyle::Keyboard: {
+                const input::Binding binding =
+                    s.bindings[static_cast<std::size_t>(input::prompt_key_action(static_cast<std::size_t>(shown.key)))][0];
+                const std::string name = binding == input::kNone ? "—" : input::name(binding);
+                gx += cap(draw, {gx - r, gy - r * 0.95f}, name.c_str()) + px(6.0f);
+                break;
+            }
+            }
+        }
+        text(draw, {min.x + px(12.0f), max.y - std::round(font() * 1.35f)}, on ? colors::kHeading : colors::kTextDim,
+             input::prompt_setting_label(setting), 0.8f);
+        if (setting == input::PromptSetting::Automatic) {
+            static const char *const kStyles[] = {"PSP", "Xbox", "PlayStation", "Nintendo", "keys"};
+            const std::string now = std::string("now ") + kStyles[static_cast<int>(p.style)];
+            text(draw, {max.x - px(10.0f) - text_width(now, 0.7f), max.y - std::round(font() * 1.3f)},
+                 colors::kTextFaint, now, 0.7f);
+        }
+    }
+    float y = start.y + 2.0f * (cell_h + gap) + px(4.0f);
+    y += note(draw, {start.x, y}, width,
+              "Confirm, back and the top button, as the game's own prompts show them. PSP is the game's own symbols.");
+    ImGui::Dummy({width, y - start.y});
+    return true;
+}
+
+bool confirm(gpu::VulkanRenderer &renderer, float width) {
+    ImDrawList *draw = ImGui::GetWindowDrawList();
+    const ImVec2 start = ImGui::GetCursorScreenPos();
+    const settings::Settings &s = settings::current();
+    input::PadKind kind = pad_kind(renderer.gamepad());
+    if (kind == input::PadKind::Keyboard) kind = input::PadKind::None;
+    const float gap = px(22.0f);
+    const float cell_w = std::floor((width - gap) * 0.5f);
+    const float r = std::round(font() * 0.85f);
+    const float cell_h = r * 7.0f;
+    for (int i = 0; i < 2; ++i) {
+        const bool south = i == 0;
+        const ImVec2 min{start.x + static_cast<float>(i) * (cell_w + gap), start.y};
+        const ImVec2 max{min.x + cell_w, min.y + cell_h};
+        const bool on = south == s.confirm_south;
+        draw->AddRectFilled(min, max, on ? faded(colors::kRowFocus, 0.25f) : faded(colors::kText, 0.04f));
+        if (on) draw->AddRect(min, max, colors::kAccent, 0.0f, 0, std::max(1.0f, px(2.0f)));
+        const ImVec2 c{(min.x + max.x) * 0.5f, min.y + cell_h * 0.47f};
+        const float d = r * 2.2f;
+        const input::FaceButton yes = south ? input::FaceButton::South : input::FaceButton::East;
+        const input::FaceButton no = south ? input::FaceButton::East : input::FaceButton::South;
+        const struct {
+            input::FaceButton face;
+            ImVec2 at;
+        } kButtons[] = {{input::FaceButton::North, {c.x, c.y - d}},
+                        {input::FaceButton::West, {c.x - d, c.y}},
+                        {input::FaceButton::East, {c.x + d, c.y}},
+                        {input::FaceButton::South, {c.x, c.y + d}}};
+        for (const auto &b : kButtons) face_button(draw, b.at, r, kind, b.face, b.face == yes);
+        const auto tag = [&](input::FaceButton face, const char *value, bool strong) {
+            // Left of the bottom button, right of the right one.
+            const ImVec2 at = face == input::FaceButton::South
+                                  ? ImVec2{c.x - r - px(10.0f) - text_width(value, 0.75f), c.y + d - font() * 0.4f}
+                                  : ImVec2{c.x + d + r + px(10.0f), c.y - font() * 0.4f};
+            text(draw, at, strong ? colors::kHeading : colors::kTextDim, value, 0.75f);
+        };
+        tag(yes, "Confirm", true);
+        tag(no, "Back", false);
+        const std::string name = south ? "Bottom (Western)" : "Right (Japanese)";
+        text(draw, {min.x + px(10.0f), max.y + px(8.0f)}, on ? colors::kHeading : colors::kTextDim, name, 0.8f);
+    }
+    float y = start.y + cell_h + std::round(font() * 1.9f);
+    const bool cross = portablekit::game().confirm_button == 1u;
+    y += note(draw, {start.x, y}, width,
+              std::string("The game itself confirms with ") + (cross ? "×" : "○") +
+                  "; this chooses which button sends it. The game's prompts follow, except in the PSP style.");
+    ImGui::Dummy({width, y - start.y});
+    return true;
+}
+
+} // namespace
+
+float px(float value) { return std::round(value * Layer::get().scale()); }
+
+ImU32 faded(ImU32 colour, float factor) {
+    const auto alpha = static_cast<float>((colour >> IM_COL32_A_SHIFT) & 0xFFu) * std::clamp(factor, 0.0f, 1.0f);
+    return (colour & ~IM_COL32_A_MASK) | (static_cast<ImU32>(alpha + 0.5f) << IM_COL32_A_SHIFT);
+}
+
+float label(ImDrawList *draw, ImVec2 at, const char *value, ImU32 colour, float size) {
+    std::string upper(value);
+    for (char &c : upper)
+        if (c >= 'a' && c <= 'z') c = static_cast<char>(c - 'a' + 'A');
+    const float pixels = std::round(font() * size);
+    return spaced_text(draw, caps_font(), pixels, at, colour, upper.c_str(), pixels * 0.18f);
+}
+
+void hairline(ImDrawList *draw, ImVec2 from, float width) {
+    const float line = std::max(1.0f, px(1.0f));
+    const ImU32 strong = faded(colors::kHeading, 0.55f);
+    const ImU32 none = faded(colors::kHeading, 0.0f);
+    draw->AddRectFilledMultiColor(from, {from.x + width, from.y + line}, strong, none, none, strong);
+}
+
+float cap(ImDrawList *draw, ImVec2 at, const char *value) {
+    const float size = std::round(font() * 0.72f);
+    ImFont *face = caps_font() != nullptr ? caps_font() : ImGui::GetFont();
+    const ImVec2 measured = face->CalcTextSizeA(size, FLT_MAX, 0.0f, value);
+    const float h = std::round(font() * 1.1f);
+    const float w = std::max(h, measured.x + px(14.0f));
+    if (draw != nullptr) {
+        draw->AddRect(at, {at.x + w, at.y + h}, colors::kTextFaint, px(4.0f), 0, std::max(1.0f, px(1.0f)));
+        draw->AddText(face, size, {std::round(at.x + (w - measured.x) * 0.5f), std::round(at.y + (h - measured.y) * 0.5f)},
+                      colors::kHeading, value);
+    }
+    return w;
+}
+
+void diamond(ImDrawList *draw, ImVec2 c, float r, ImU32 colour) {
+    draw->AddQuadFilled({c.x, c.y - r}, {c.x + r, c.y}, {c.x, c.y + r}, {c.x - r, c.y}, colour);
+}
+
+bool preview(const std::string &key, gpu::VulkanRenderer &renderer, float width) {
+    if (key == "input.dead_zone") return stick(renderer, width);
+    if (key == "input.stick_square") return diagonals(renderer, width);
+    if (key == "input.trigger") return triggers(renderer, width);
+    if (key == "input.right_stick") return right_stick(renderer, width, false);
+    if (key == "input.right_stick_zone") return right_stick(renderer, width, true);
+    if (key == "input.mouse_sensitivity") return mouse(width);
+    if (key == "video.sharp_screen") return scaling(renderer, width);
+    if (key == "video.aspect") return aspect(renderer, width);
+    if (key == "text.font" || key == "text.weight") return font_sample(width);
+    if (key == "input.button_prompts") return prompts(renderer, width);
+    if (key == "input.confirm") return confirm(renderer, width);
+    return false;
+}
+
+void forget_paused_frame() {
+    paused() = Frame{};
+    atlas().thumbnail_key.clear();
+    atlas().crops_key.clear();
+}
+
+} // namespace portablekit::ui::look
