+bool aspect(gpu::VulkanRenderer &renderer, float width) {
+    ImDrawList *draw = ImGui::GetWindowDrawList();
+    const ImVec2 start = ImGui::GetCursorScreenPos();
+    const Frame &f = paused_frame(renderer);
+    if (!f.ok) return false;
+    const ImVec2 thumb = thumbnail(f);
+    const ImGuiIO &io = ImGui::GetIO();
+    const float window_w = io.DisplaySize.x;
+    const float window_h = io.DisplaySize.y;
+    const bool fill = gpu::VulkanRenderer::supports_fill();
+    const int count = fill ? 3 : 2;
+    const float gap = px(22.0f);
+    float box_w = (width - gap * static_cast<float>(count - 1)) / static_cast<float>(count);
+    float box_h = box_w * window_h / window_w;
+    if (box_h > font() * 7.0f) {
+        box_h = font() * 7.0f;
+        box_w = box_h * window_w / window_h;
+    }
+    box_w = std::floor(box_w);
+    box_h = std::floor(box_h);
+    const settings::Aspect chosen = gpu::VulkanRenderer::usable_aspect(settings::current().aspect);
+    const float picture_aspect = static_cast<float>(f.width) / static_cast<float>(f.height);
+    const ImTextureRef texture = atlas().texture->GetTexRef();
+    const ImVec2 whole = uv(thumb.x, thumb.y);
+    for (int i = 0; i < count; ++i) {
+        const auto which = static_cast<settings::Aspect>(i);
+        const ImVec2 min{std::round(start.x + static_cast<float>(i) * (box_w + gap)), std::round(start.y)};
+        const ImVec2 max{min.x + box_w, min.y + box_h};
+        draw->AddRectFilled(min, max, IM_COL32(0, 0, 0, 255));
+        std::string size;
+        if (which == settings::Aspect::Original) {
+            const float fit = std::min(box_w / picture_aspect, box_h);
+            const float w = fit * picture_aspect;
+            const ImVec2 a{min.x + (box_w - w) * 0.5f, min.y + (box_h - fit) * 0.5f};
+            draw->AddImage(texture, a, {a.x + w, a.y + fit}, {0.0f, 0.0f}, whole);
+            const float shown_h = std::min(window_w / picture_aspect, window_h);
+            size = size_text(shown_h * picture_aspect, shown_h);
+        } else if (which == settings::Aspect::Stretch) {
+            draw->AddImage(texture, min, max, {0.0f, 0.0f}, whole);
+            size = size_text(window_w, window_h);
+        } else {
+            // Fill widens or narrows the view itself; from a paused frame the
+            // nearest likeness is its middle at the window's shape.
+            const float box_aspect = box_w / box_h;
+            ImVec2 a{0.0f, 0.0f};
+            ImVec2 b = whole;
+            if (box_aspect < picture_aspect) {
+                const float keep = box_aspect / picture_aspect;
+                a.x = whole.x * (1.0f - keep) * 0.5f;
+                b.x = whole.x - a.x;
+            } else {
+                const float keep = picture_aspect / box_aspect;
+                a.y = whole.y * (1.0f - keep) * 0.5f;
+                b.y = whole.y - a.y;
+            }
+            draw->AddImage(texture, min, max, a, b);
+            size = size_text(window_w, window_h);
+        }
+        const bool on = which == chosen;
+        draw->AddRect({min.x - px(3.0f), min.y - px(3.0f)}, {max.x + px(3.0f), max.y + px(3.0f)},
+                      on ? colors::kAccent : colors::kPanelEdge, 0.0f, 0, std::max(1.0f, px(on ? 2.0f : 1.0f)));
+        static const char *const kNames[] = {"Original", "Stretch", "Fill"};
+        const float y = max.y + px(10.0f);
+        text(draw, {min.x, y}, on ? colors::kHeading : colors::kTextDim, kNames[i], 0.8f);
+        text(draw, {max.x - text_width(size, 0.75f), y + px(1.0f)}, colors::kTextFaint, size, 0.75f);
+    }
+    float y = start.y + box_h + std::round(font() * 1.8f);
+    y += note(draw, {start.x, y}, width,
+              "In your window's shape, " + size_text(window_w, window_h) + ". From the paused game.");
+    ImGui::Dummy({width, y - start.y});
+    return true;
+}
+
+// The stick's last places, for its trail.
+struct Trail {
+    std::array<ImVec2, 6> points{};
+    int count{};
+    std::chrono::steady_clock::time_point last{};
+};
+
+void stick_gate(ImDrawList *draw, ImVec2 c, float radius, float dead_zone, bool square, bool live, float x, float y,
+                Trail *trail) {
+    const float line = std::max(1.0f, px(1.5f));
+    draw->AddRectFilled({c.x - radius * 1.19f, c.y - radius * 1.19f}, {c.x + radius * 1.19f, c.y + radius * 1.19f},
+                        faded(colors::kPanel, 0.8f));
+    if (square)
+        dashed_rect(draw, {c.x - radius, c.y - radius}, {c.x + radius, c.y + radius}, faded(colors::kSection, 0.75f),
+                    px(5.0f), line);
+    draw->AddCircle(c, radius, faded(colors::kText, 0.45f), 64, line);
+    draw->AddLine({c.x - radius, c.y}, {c.x + radius, c.y}, faded(colors::kText, 0.12f), 1.0f);
+    draw->AddLine({c.x, c.y - radius}, {c.x, c.y + radius}, faded(colors::kText, 0.12f), 1.0f);
+    if (dead_zone > 0.0f) {
+        draw->AddCircleFilled(c, radius * dead_zone, faded(colors::kDanger, 0.35f), 32);
+        draw->AddCircle(c, radius * dead_zone, colors::kDanger, 32, line);
+    }
+    if (!live) return;
+    const ImVec2 dot{c.x + x * radius, c.y + y * radius};
+    if (trail != nullptr) {
+        const auto now = std::chrono::steady_clock::now();
+        if (now - trail->last > std::chrono::milliseconds(45)) {
+            for (int i = static_cast<int>(trail->points.size()) - 1; i > 0; --i)
+                trail->points[static_cast<std::size_t>(i)] = trail->points[static_cast<std::size_t>(i - 1)];
+            trail->points[0] = {x, y};
+            trail->count = std::min(trail->count + 1, static_cast<int>(trail->points.size()));
+            trail->last = now;
+        }
+        for (int i = trail->count - 1; i >= 1; --i) {
+            const ImVec2 p = trail->points[static_cast<std::size_t>(i)];
+            draw->AddCircleFilled({c.x + p.x * radius, c.y + p.y * radius}, px(4.5f),
+                                  faded(colors::kSection, 0.5f - 0.07f * static_cast<float>(i)));
+        }
+    }
+    draw->AddLine(c, dot, colors::kAccent, std::max(1.5f, px(2.0f)));
+    draw->AddCircleFilled(dot, px(9.0f), colors::kAccent);
+    draw->AddCircle(dot, px(9.0f), colors::kHeading, 0, std::max(1.5f, px(2.0f)));
+}
+
+std::string nub_text(const input::stick::Nub &nub) {
+    return std::to_string(static_cast<int>(nub.x)) + ", " + std::to_string(static_cast<int>(nub.y));
+}
