+bool Menu::tab_strip(ImVec2 at) {
+    static const char *const kTabs[] = {"Video", "Audio", "Controls", "Network", "Cheats", "System"};
+    constexpr int kCount = 6;
+    const int before = tab_;
+    const bool typing = ImGui::GetIO().WantTextInput;
+    if (ImGui::IsKeyPressed(ImGuiKey_GamepadL1, false) || (!typing && ImGui::IsKeyPressed(ImGuiKey_Q, false)))
+        tab_ = (tab_ + kCount - 1) % kCount;
+    if (ImGui::IsKeyPressed(ImGuiKey_GamepadR1, false) || (!typing && ImGui::IsKeyPressed(ImGuiKey_W, false)))
+        tab_ = (tab_ + 1) % kCount;
+
+    const float font = Layer::get().font_size();
+    ImDrawList *draw = ImGui::GetWindowDrawList();
+    const float cap_height = std::round(font * 1.1f);
+    float x = at.x;
+    x += look::cap(draw, {x, at.y + std::round(font * 0.15f)}, shoulder(false)) + std::round(font * 0.7f);
+    const float size = std::round(font * 0.9f);
+    const float spacing = size * 0.12f;
+    ImGui::PushItemFlag(ImGuiItemFlags_NoNav, true);
+    for (int i = 0; i < kCount; ++i) {
+        std::string name(kTabs[i]);
+        for (char &c : name)
+            if (c >= 'a' && c <= 'z') c = static_cast<char>(c - 'a' + 'A');
+        const float text_width = spaced_text(nullptr, caps_font(), size, {}, 0, name.c_str(), spacing);
+        const float pad = std::round(font * 0.75f);
+        const ImVec2 min{x, at.y - look::px(4.0f)};
+        const ImVec2 max{x + text_width + pad * 2.0f, at.y + cap_height + look::px(8.0f)};
+        ImGui::SetCursorScreenPos(min);
+        ImGui::PushID(i);
+        if (ImGui::InvisibleButton("tab", {max.x - min.x, max.y - min.y})) tab_ = i;
+        const bool hovered = ImGui::IsItemHovered();
+        ImGui::PopID();
+        const bool active = i == tab_;
+        const ImU32 ink = active ? colors::kHeading : hovered ? colors::kText : colors::kTextFaint;
+        spaced_text(draw, caps_font(), size, {x + pad, at.y + (cap_height - size) * 0.5f}, ink, name.c_str(), spacing);
+        if (active)
+            draw->AddRectFilled({x + pad, max.y - look::px(3.0f)}, {x + pad + text_width, max.y}, colors::kHighlight);
+        x = max.x;
+    }
+    ImGui::PopItemFlag();
+    look::cap(draw, {x + std::round(font * 0.7f) - std::round(font * 0.75f), at.y + std::round(font * 0.15f)},
+              shoulder(true));
+    return tab_ != before;
+}
