+                    const std::uint32_t pixel = impl.overlay_pixels[(y / scale) * perf::kOverlayWidth + x / scale];
+                    std::memcpy(row + (inset + x) * 4u, &pixel, 4u);
+                }
+            }
+        }
+    }
+    return write_bmp(path, pixels.data(), width, height, false);
+}
