+
+// --- The paused frame ------------------------------------------------------------
+
+struct Frame {
+    bool tried{};
+    bool ok{};
+    std::vector<std::uint8_t> pixels;  // R, G, B, A
+    std::uint32_t width{};
+    std::uint32_t height{};
+};
+
+Frame &paused() {
+    static Frame frame;
+    return frame;
+}
+
+const Frame &paused_frame(gpu::VulkanRenderer &renderer) {
+    Frame &frame = paused();
+    if (!frame.tried) {
+        frame.tried = true;
+        frame.ok = renderer.read_frame(frame.pixels, frame.width, frame.height) && frame.width > 0u &&
+                   frame.height > 0u && frame.pixels.size() >= std::size_t{frame.width} * frame.height * 4u;
+    }
+    return frame;
+}
+
+// The frame halved or more, box-filtered, as a lower Resolution would draw
+// it (near enough for a preview).
+Frame scaled_down(const Frame &source, std::uint32_t lines) {
+    Frame out;
+    out.tried = out.ok = true;
+    out.height = lines;
+    out.width = static_cast<std::uint32_t>(std::lround(static_cast<double>(source.width) * lines / source.height));
+    out.pixels.resize(std::size_t{out.width} * out.height * 4u);
+    const double sx = static_cast<double>(source.width) / out.width;
+    const double sy = static_cast<double>(source.height) / out.height;
+    for (std::uint32_t y = 0; y < out.height; ++y)
+        for (std::uint32_t x = 0; x < out.width; ++x) {
+            const auto x0 = static_cast<std::uint32_t>(x * sx);
+            const auto y0 = static_cast<std::uint32_t>(y * sy);
+            const auto x1 = std::max(x0 + 1u, std::min(source.width, static_cast<std::uint32_t>((x + 1) * sx)));
+            const auto y1 = std::max(y0 + 1u, std::min(source.height, static_cast<std::uint32_t>((y + 1) * sy)));
+            std::array<std::uint32_t, 3> sum{};
+            std::uint32_t count = 0;
+            for (std::uint32_t yy = y0; yy < y1; ++yy)
+                for (std::uint32_t xx = x0; xx < x1; ++xx) {
+                    const std::uint8_t *p = source.pixels.data() + (std::size_t{yy} * source.width + xx) * 4u;
+                    for (int c = 0; c < 3; ++c) sum[static_cast<std::size_t>(c)] += p[c];
+                    ++count;
+                }
+            std::uint8_t *q = out.pixels.data() + (std::size_t{y} * out.width + x) * 4u;
+            for (int c = 0; c < 3; ++c) q[c] = static_cast<std::uint8_t>(sum[static_cast<std::size_t>(c)] / count);
+            q[3] = 255u;
+        }
+    return out;
+}
+
+std::uint32_t texel(const Frame &f, int x, int y) {
+    x = std::clamp(x, 0, static_cast<int>(f.width) - 1);
+    y = std::clamp(y, 0, static_cast<int>(f.height) - 1);
+    std::uint32_t value = 0;
+    std::memcpy(&value, f.pixels.data() + (static_cast<std::size_t>(y) * f.width + x) * 4u, 4u);
+    return value | 0xFF000000u;  // opaque, whatever the target's alpha
+}
+
+std::uint32_t bilinear(const Frame &f, float u, float v) {
+    u -= 0.5f;
+    v -= 0.5f;
+    const int x0 = static_cast<int>(std::floor(u));
+    const int y0 = static_cast<int>(std::floor(v));
+    const float fx = u - static_cast<float>(x0);
+    const float fy = v - static_cast<float>(y0);
+    const std::uint32_t a = texel(f, x0, y0), b = texel(f, x0 + 1, y0), c = texel(f, x0, y0 + 1),
+                        d = texel(f, x0 + 1, y0 + 1);
+    std::uint32_t out = 0xFF000000u;
+    for (int shift = 0; shift < 24; shift += 8) {
+        const auto ch = [&](std::uint32_t p) { return static_cast<float>((p >> shift) & 0xFFu); };
+        const float value = (ch(a) * (1.0f - fx) + ch(b) * fx) * (1.0f - fy) + (ch(c) * (1.0f - fx) + ch(d) * fx) * fy;
+        out |= static_cast<std::uint32_t>(std::clamp(value + 0.5f, 0.0f, 255.0f)) << shift;
+    }
+    return out;
+}
+
+// One texture the previews draw from, in parts: the frame's thumbnail at the
+// top, close-ups below.
+constexpr int kAtlasSize = 1024;
+constexpr int kSlotWidth = 512;
+constexpr int kSlotHeight = 256;
+
+struct Atlas {
+    ImTextureData *texture{};
+    std::string thumbnail_key;
+    std::string crops_key;
+};
+
+Atlas &atlas() {
+    static Atlas value;
+    if (value.texture == nullptr) {
+        value.texture = new ImTextureData();
+        value.texture->Create(ImTextureFormat_RGBA32, kAtlasSize, kAtlasSize);
+        std::memset(value.texture->GetPixels(), 0, std::size_t{kAtlasSize} * kAtlasSize * 4u);
+        ImGui::RegisterUserTexture(value.texture);
+    }
+    return value;
+}
+
+std::uint32_t *atlas_row(int y) {
+    return static_cast<std::uint32_t *>(atlas().texture->GetPixels()) + static_cast<std::size_t>(y) * kAtlasSize;
+}
+
+void upload(int x, int y, int w, int h) {
+    ImTextureData *t = atlas().texture;
+    if (t->Status == ImTextureStatus_OK || t->Status == ImTextureStatus_WantUpdates)
+        ImTextureDataQueueUpload(t, x, y, w, h);
+}
+
+ImVec2 uv(float x, float y) { return {x / kAtlasSize, y / kAtlasSize}; }
+
+// Slot `slot` (0-3) of the close-ups: its top left in the atlas.
+ImVec2 slot_origin(int slot) {
+    return {static_cast<float>((slot % 2) * kSlotWidth), static_cast<float>(kSlotWidth + (slot / 2) * kSlotHeight)};
+}
+
+// What the window shows around the frame's centre, `zoom` times larger:
+// `source` scaled `ratio` times to the window by the nearest pixel or
+// bilinearly, as the renderer's last blit does.
+void render_crop(int slot, int w, int h, const Frame &source, float ratio, bool nearest, int zoom) {
+    const ImVec2 origin = slot_origin(slot);
+    const float cx = static_cast<float>(source.width) * 0.5f;
+    const float cy = static_cast<float>(source.height) * 0.42f;
+    for (int oy = 0; oy < h; ++oy) {
+        std::uint32_t *row = atlas_row(static_cast<int>(origin.y) + oy) + static_cast<int>(origin.x);
+        const float dy = static_cast<float>(oy / zoom) - static_cast<float>(h / zoom) * 0.5f;
+        const float v = cy + (dy + 0.5f) / ratio;
+        for (int ox = 0; ox < w; ++ox) {
+            const float dx = static_cast<float>(ox / zoom) - static_cast<float>(w / zoom) * 0.5f;
+            const float u = cx + (dx + 0.5f) / ratio;
+            row[ox] = nearest ? texel(source, static_cast<int>(std::floor(u)), static_cast<int>(std::floor(v)))
+                              : bilinear(source, u, v);
+        }
+    }
+    upload(static_cast<int>(origin.x), static_cast<int>(origin.y), w, h);
+}
+
+void draw_slot(ImDrawList *draw, int slot, ImVec2 at, float w, float h) {
+    const ImVec2 o = slot_origin(slot);
+    const ImVec2 min{std::round(at.x), std::round(at.y)};
+    draw->AddImage(atlas().texture->GetTexRef(), min, {min.x + w, min.y + h}, uv(o.x, o.y), uv(o.x + w, o.y + h));
+}
+
+// The whole frame, small, at the atlas's top left; returns its size.
+ImVec2 thumbnail(const Frame &f) {
+    const int width = std::min(kSlotWidth, 480);
+    const int height = std::min(kSlotWidth, static_cast<int>(std::lround(480.0 * f.height / f.width)));
+    const std::string key = std::to_string(f.width) + "x" + std::to_string(f.height) + "@" +
+                            std::to_string(reinterpret_cast<std::uintptr_t>(f.pixels.data()));
+    if (atlas().thumbnail_key != key) {
+        const Frame small = scaled_down(f, static_cast<std::uint32_t>(height));
+        for (int y = 0; y < height; ++y)
+            for (int x = 0; x < width; ++x) atlas_row(y)[x] = texel(small, x, y);
+        upload(0, 0, width, height);
+        atlas().thumbnail_key = key;
+    }
+    return {static_cast<float>(width), static_cast<float>(height)};
+}
+
+// A close-up with its caption: the choice's name, and "Chosen" by the one
+// in use.
+void close_up(ImDrawList *draw, int slot, ImVec2 at, float w, float h, const char *name, bool chosen) {
+    draw_slot(draw, slot, at, w, h);
+    const float edge = std::max(1.0f, px(chosen ? 2.0f : 1.0f));
+    draw->AddRect({at.x - px(3.0f), at.y - px(3.0f)}, {at.x + w + px(3.0f), at.y + h + px(3.0f)},
+                  chosen ? colors::kAccent : colors::kPanelEdge, 0.0f, 0, edge);
+    const float y = at.y + h + px(10.0f);
+    text(draw, {at.x, y}, chosen ? colors::kHeading : colors::kTextDim, name, 0.8f);
+    if (chosen) {
+        const std::string mark = "Chosen";
+        text(draw, {at.x + w - text_width(mark, 0.8f), y}, colors::kSection, mark, 0.8f);
+    }
+}
