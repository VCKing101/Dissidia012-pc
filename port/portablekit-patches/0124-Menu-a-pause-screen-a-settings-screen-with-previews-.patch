+    dashed_line(draw, min, {max.x, min.y}, colour, dash, thickness);
+    dashed_line(draw, {max.x, min.y}, max, colour, dash, thickness);
+    dashed_line(draw, max, {min.x, max.y}, colour, dash, thickness);
+    dashed_line(draw, {min.x, max.y}, min, colour, dash, thickness);
