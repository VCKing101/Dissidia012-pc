+
+void apply_theme_colours(const InterfaceTheme *theme) {
+    if (theme == nullptr) return;
+    // 0xRRGGBBAA as ImGui packs it.
+    const auto c = [](std::uint32_t rgba) {
+        return IM_COL32((rgba >> 24u) & 0xFFu, (rgba >> 16u) & 0xFFu, (rgba >> 8u) & 0xFFu, rgba & 0xFFu);
+    };
+    colors::kBackdrop = c(theme->backdrop);
+    colors::kPanel = c(theme->panel);
+    colors::kPanelEdge = c(theme->edge);
+    colors::kRow = IM_COL32(0, 0, 0, 0);
+    colors::kRowHover = c(theme->row_hover);
+    colors::kRowFocus = c(theme->focus);
+    colors::kFocusEnd = c(theme->focus_end);
+    colors::kAccent = c(theme->accent);
+    colors::kAccentBright = c(theme->heading);
+    colors::kHighlight = c(theme->highlight);
+    colors::kHeading = c(theme->heading);
+    colors::kSection = c(theme->section);
+    colors::kText = c(theme->text);
+    colors::kTextDim = c(theme->text_dim);
+    colors::kTextFaint = c(theme->text_faint);
+    colors::kTextDisabled = c(theme->text_disabled);
+    colors::kValue = c(theme->value);
+    colors::kDanger = c(theme->danger);
+    colors::kGood = c(theme->good);
+    colors::kTrack = c(theme->track);
+}
+
+float spaced_text(ImDrawList *draw, ImFont *font, float size, ImVec2 at, ImU32 colour, const char *text,
+                  float spacing) {
+    if (font == nullptr) font = ImGui::GetFont();
+    float x = at.x;
+    const char *end = text + std::strlen(text);
+    for (const char *s = text; s < end;) {
+        unsigned int c = 0;
