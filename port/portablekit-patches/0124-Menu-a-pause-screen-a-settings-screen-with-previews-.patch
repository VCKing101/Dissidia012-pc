+    std::uint32_t text_disabled;
+    std::uint32_t value;         // a setting's value
+    std::uint32_t danger;        // Quit, Disconnect
+    std::uint32_t good;          // connected, at rest
+    std::uint32_t track;         // an empty switch or slider
