+namespace {
+
+// The name the pause screen and the settings screen give the game: the
+// theme's title and its accent, or the project's name.
+struct Title {
+    std::string main;
+    std::string accent;
+};
+
+Title game_title_parts() {
+    const InterfaceTheme *theme = portablekit::game().theme;
+    if (theme != nullptr && theme->title != nullptr)
+        return {theme->title, theme->title_accent != nullptr ? theme->title_accent : ""};
+    return {portablekit::game().project_name, ""};
+}
+
+// What the pause screen says by Cheats: how many are on.
+std::string cheats_summary() {
+    const cheats::Overview o = cheats::overview();
+    if (!o.available || !settings::current().cheats) return "Off";
+    std::size_t on = 0u;
+    for (const cheats::BuiltinRow &row : o.builtin) on += row.choice != 0u ? 1u : 0u;
+    for (const cheats::CheatRow &row : o.cheats) on += row.enabled ? 1u : 0u;
+    return on == 0u ? std::string("None on") : std::to_string(on) + " on";
+}
+
+const char *shoulder(bool right) {
+    if (Layer::get().input_device() != InputDevice::Gamepad) return right ? "W" : "Q";
+    SDL_Gamepad *pad = Layer::get().renderer().gamepad();
+    const SDL_GamepadType type = pad != nullptr ? SDL_GetGamepadType(pad) : SDL_GAMEPAD_TYPE_UNKNOWN;
+    const char *name = pad != nullptr ? SDL_GetGamepadName(pad) : nullptr;
+    if (type == SDL_GAMEPAD_TYPE_PS3 || type == SDL_GAMEPAD_TYPE_PS4 || type == SDL_GAMEPAD_TYPE_PS5 ||
+        (name != nullptr && std::strstr(name, "Steam Deck") != nullptr))
+        return right ? "R1" : "L1";
+    if (type == SDL_GAMEPAD_TYPE_NINTENDO_SWITCH_PRO || type == SDL_GAMEPAD_TYPE_NINTENDO_SWITCH_JOYCON_PAIR)
+        return right ? "R" : "L";
+    return right ? "RB" : "LB";
+}
+
+// A card behind what `draw_contents` draws: drawn after it, under it.
+template <typename F> void card(float width, F &&draw_contents) {
+    ImDrawList *draw = ImGui::GetWindowDrawList();
+    const float pad = look::px(18.0f);
+    const ImVec2 min = ImGui::GetCursorScreenPos();
+    draw->ChannelsSplit(2);
+    draw->ChannelsSetCurrent(1);
+    ImGui::SetCursorScreenPos({min.x + pad, min.y + pad});
+    ImGui::BeginGroup();
+    ImGui::PushItemWidth(width - 2.0f * pad);
+    ImGui::Dummy({width - 2.0f * pad, 0.0f});
+    begin_card();
+    draw_contents(width - 2.0f * pad);
+    end_card();
+    ImGui::PopItemWidth();
+    ImGui::EndGroup();
+    const float bottom = ImGui::GetItemRectMax().y + pad * 0.6f;
+    draw->ChannelsSetCurrent(0);
+    draw->AddRectFilled(min, {min.x + width, bottom}, colors::kPanel);
+    draw->AddRect(min, {min.x + width, bottom}, colors::kPanelEdge, 0.0f, 0, std::max(1.0f, look::px(1.0f)));
+    draw->ChannelsMerge();
+    ImGui::SetCursorScreenPos({min.x, bottom + look::px(14.0f)});
+    ImGui::Dummy({width, 0.0f});
+}
