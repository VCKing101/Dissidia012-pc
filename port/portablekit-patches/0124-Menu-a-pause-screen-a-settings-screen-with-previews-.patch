+void dashed_line(ImDrawList *draw, ImVec2 a, ImVec2 b, ImU32 colour, float dash, float thickness) {
+    const float length = std::hypot(b.x - a.x, b.y - a.y);
+    if (length <= 0.0f) return;
+    const ImVec2 step{(b.x - a.x) / length, (b.y - a.y) / length};
+    for (float t = 0.0f; t < length; t += dash * 2.0f) {
+        const float end = std::min(length, t + dash);
+        draw->AddLine({a.x + step.x * t, a.y + step.y * t}, {a.x + step.x * end, a.y + step.y * end}, colour,
+                      thickness);
+    }
+}
