+#pragma once
+
+#include "imgui.h"
+
+#include <string>
+
+namespace portablekit::gpu {
+class VulkanRenderer;
+}
+
+// The parts of the menu's look that are not rows (menu.cpp lays the screens
+// out with them) and the previews in its side panel: what the focused
+// setting does, drawn from the player's own pad, mouse and paused game.
+// Everything is sized from the menu's text size and coloured from the
+// theme (widgets.hpp).
+namespace portablekit::ui::look {
+
+// Pixels for a length given in units of 20 px text.
+[[nodiscard]] float px(float value);
+// A colour with its alpha multiplied by `factor`.
+[[nodiscard]] ImU32 faded(ImU32 colour, float factor);
+
+// Small capitals with space between the letters, as the menu's labels are
+// set; `size` is a share of the text size. Returns the width drawn.
+float label(ImDrawList *draw, ImVec2 at, const char *text, ImU32 colour, float size = 0.7f);
+// A hairline from `from`, `width` long, fading out to the right.
+void hairline(ImDrawList *draw, ImVec2 from, float width);
+// A key cap, such as L1 or Esc, with its top left at `at`; returns its width.
+float cap(ImDrawList *draw, ImVec2 at, const char *text);
+// A diamond centred on `centre`.
+void diamond(ImDrawList *draw, ImVec2 centre, float radius, ImU32 colour);
+
+// The preview for the setting under `key` (RowOptions::key), drawn at the
+// cursor across `width`. False when that setting has none.
+bool preview(const std::string &key, gpu::VulkanRenderer &renderer, float width);
+
+// Forgets the paused frame the previews read, as the menu closes: the next
+// menu reads the frame it opens over.
+void forget_paused_frame();
+
+} // namespace portablekit::ui::look
