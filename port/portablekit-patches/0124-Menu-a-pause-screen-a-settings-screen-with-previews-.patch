+bool triggers(gpu::VulkanRenderer &renderer, float width) {
+    ImDrawList *draw = ImGui::GetWindowDrawList();
+    const ImVec2 start = ImGui::GetCursorScreenPos();
+    const settings::Settings &s = settings::current();
+    SDL_Gamepad *pad = renderer.gamepad();
+    const input::PadKind kind = pad_kind(pad);
+    const char *names[2] = {"LT", "RT"};
+    if (kind == input::PadKind::PlayStation || kind == input::PadKind::SteamDeck) names[0] = "L2", names[1] = "R2";
+    if (kind == input::PadKind::Nintendo) names[0] = "ZL", names[1] = "ZR";
+    const bool extras = (portablekit::active_extra_buttons() & input::kExtraL2) != 0u;
+    const char *presses[2] = {"L", "R"};
+    if (!s.swap_triggers && extras) presses[0] = "L2", presses[1] = "R2";
+    const SDL_GamepadAxis axes[2] = {SDL_GAMEPAD_AXIS_LEFT_TRIGGER, SDL_GAMEPAD_AXIS_RIGHT_TRIGGER};
+    const float name_w = std::round(font() * 2.2f);
+    const float status_w = std::round(font() * 6.0f);
+    const float bar_w = width - name_w - status_w - px(24.0f);
+    float y = start.y + std::round(font() * 1.1f);
+    const float bar_h = std::round(font() * 0.6f);
+    for (int i = 0; i < 2; ++i) {
+        const float value = std::max(0.0f, axis(pad, axes[i]));
+        const bool pressed = pad != nullptr && value > s.trigger;
+        text(draw, {start.x, y - font() * 0.25f}, colors::kHeading, names[i], 0.85f);
+        const ImVec2 min{start.x + name_w, y};
+        const ImVec2 max{min.x + bar_w, y + bar_h};
+        draw->AddRectFilled(min, max, colors::kTrack);
+        draw->AddRectFilled(min, {min.x + bar_w * value, max.y}, pressed ? colors::kAccent : colors::kTextFaint);
+        const float mark = min.x + bar_w * s.trigger;
+        draw->AddLine({mark, min.y - px(7.0f)}, {mark, max.y + px(7.0f)}, colors::kHeading, std::max(1.5f, px(2.0f)));
+        if (i == 0) {
+            const std::string point = std::to_string(static_cast<int>(std::lround(s.trigger * 100.0f))) + "%";
+            text(draw, {mark - text_width(point, 0.7f) * 0.5f, min.y - font() * 1.15f}, colors::kTextDim, point, 0.7f);
+        }
+        const std::string status = pressed ? std::string("Presses ") + presses[i] : "Not pressed";
+        const ImVec2 at{max.x + px(24.0f), y - font() * 0.25f};
+        if (pressed) {
+            const float w = text_width(status, 0.75f) + px(16.0f);
+            draw->AddRectFilled({at.x, at.y - px(2.0f)}, {at.x + w, at.y + font() * 0.95f}, colors::kRowFocus);
+            text(draw, {at.x + px(8.0f), at.y}, colors::kHeading, status, 0.75f);
+        } else {
+            text(draw, at, colors::kTextFaint, status, 0.75f);
+        }
+        y += std::round(font() * 1.9f);
+    }
+    std::string about = pad != nullptr ? "Live from " + pad_name(pad) + ". The line is where a trigger starts to press."
+                                       : "Connect a gamepad to try it here.";
+    if (!s.swap_triggers && extras && portablekit::game().extra_triggers != nullptr)
+        about += std::string(" ") + portablekit::game().extra_triggers;
+    if (s.swap_triggers) about += " With Swap shoulders and triggers on, they press L and R.";
+    y += note(draw, {start.x, y}, width, about);
+    ImGui::Dummy({width, y - start.y});
+    return true;
+}
