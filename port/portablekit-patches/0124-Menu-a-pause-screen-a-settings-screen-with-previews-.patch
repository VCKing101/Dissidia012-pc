+    case Shape::Circle: draw->AddCircle(c, k * 1.1f, ink, 0, t); break;
+    case Shape::Square: draw->AddRect({c.x - k, c.y - k}, {c.x + k, c.y + k}, ink, 0.0f, 0, t); break;
+    case Shape::Triangle:
+        draw->AddTriangle({c.x, c.y - k * 1.15f}, {c.x + k * 1.15f, c.y + k * 0.8f}, {c.x - k * 1.15f, c.y + k * 0.8f},
