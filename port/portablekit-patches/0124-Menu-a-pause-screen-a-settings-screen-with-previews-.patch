+bool Menu::pause_item(const char *label, const std::string &hint, const std::string &description, int index,
+                      bool danger) {
+    Layer &layer = Layer::get();
+    const float font = layer.font_size();
+    const float height = std::round(font * pause_item_lines_);
+    const ImVec2 min = ImGui::GetCursorScreenPos();
+    const float width = ImGui::GetContentRegionAvail().x;
+    const ImVec2 max{min.x + width, min.y + height};
+    const bool pressed = ImGui::InvisibleButton(label, {width, height}, ImGuiButtonFlags_EnableNav);
+    if ((first_frame_ && index == 0) || (refocus_pause_ && index == pause_focus_)) {
+        ImGui::FocusItem();
+        refocus_pause_ = false;
+    }
+    const bool focused = ImGui::IsItemFocused();
+    const bool hovered = ImGui::IsItemHovered();
+    ImDrawList *draw = ImGui::GetWindowDrawList();
+    if (focused) draw_focus_bar(draw, min, max);
+    else if (hovered) draw->AddRectFilled(min, max, colors::kRowHover);
+    ImFont *face = heading_font();
+    const float size = std::round(font * (face != nullptr ? 1.43f : 1.3f));
+    const float x = min.x + std::round(font * 2.4f);
+    const float y = std::round(min.y + (height - size) * 0.5f);
+    const ImU32 ink = focused ? colors::kHeading : danger ? colors::kDanger : colors::kText;
+    draw->AddText(face, size, {x, y}, ink, label);
+    if (!hint.empty() && !focused) {
+        const float label_width = (face != nullptr ? face : ImGui::GetFont())->CalcTextSizeA(size, FLT_MAX, 0.0f, label).x;
+        const float small = std::round(font * 0.72f);
+        draw->AddText(nullptr, small, {x + label_width + std::round(font * 1.0f), std::round(min.y + (height - small) * 0.5f)},
+                      colors::kTextDim, hint.c_str());
+    }
+    if (focused || (hovered && layer.description().empty())) {
+        layer.set_description(description);
+        layer.set_focused_row(label, nullptr);
+    }
+    return pressed;
+}
