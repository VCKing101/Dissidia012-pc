+bool scaling(gpu::VulkanRenderer &renderer, float width) {
+    ImDrawList *draw = ImGui::GetWindowDrawList();
+    const ImVec2 start = ImGui::GetCursorScreenPos();
+    const Frame &f = paused_frame(renderer);
+    if (!f.ok) return false;
+    const GamePicture picture = game_picture();
+    const float ratio = picture.height / static_cast<float>(f.height);
+    const bool same = std::fabs(ratio - 1.0f) < 0.03f;
+    const bool sharp = settings::current().sharp_screen;
+    const float gap = px(20.0f);
+    const float pair_w = std::floor(std::min<float>(kSlotWidth, (width - gap) * 0.5f));
+    const float single_w = std::floor(std::min<float>(kSlotWidth, width));
+    const float h = std::floor(std::min<float>(kSlotHeight, std::round(font() * 7.5f)));
+    constexpr int kZoom = 2;
+    const bool lower = f.height >= 800u;  // a frame drawn at ×3 or more: ×2 can be shown
+    const std::string key = std::to_string(f.width) + "x" + std::to_string(f.height) + "/" + std::to_string(ratio) +
+                            "/" + std::to_string(pair_w) + "/" + std::to_string(h) + "@" +
+                            std::to_string(reinterpret_cast<std::uintptr_t>(f.pixels.data()));
+    const float ratio2 = picture.height / 544.0f;
+    if (atlas().crops_key != key) {
+        if (same) {
+            render_crop(0, static_cast<int>(single_w), static_cast<int>(h), f, ratio, true, kZoom);
+        } else {
+            render_crop(0, static_cast<int>(pair_w), static_cast<int>(h), f, ratio, true, kZoom);
+            render_crop(1, static_cast<int>(pair_w), static_cast<int>(h), f, ratio, false, kZoom);
+        }
+        if (same && lower) {
+            const Frame half = scaled_down(f, 544u);
+            render_crop(2, static_cast<int>(pair_w), static_cast<int>(h), half, ratio2, true, kZoom);
+            render_crop(3, static_cast<int>(pair_w), static_cast<int>(h), half, ratio2, false, kZoom);
+        }
+        atlas().crops_key = key;
+    }
+
+    float y = start.y;
+    label(draw, {start.x, y}, "On your screen now", colors::kSection);
+    y += std::round(font() * 1.3f);
+    const std::string drawn = size_text(f.width, f.height);
+    const std::string shown = size_text(picture.width, picture.height);
+    if (same) {
+        close_up(draw, 0, {start.x, y}, single_w, h, sharp ? "Sharp" : "Smooth", false);
+        y += h + std::round(font() * 1.7f);
+        y += note(draw, {start.x, y}, width,
+                  "Sharp and Smooth look the same here: the game is drawn at " + drawn + " and shown at " + shown +
+                      ", almost one to one.",
+                  colors::kTextDim) +
+             px(16.0f);
+        if (lower) {
+            label(draw, {start.x, y}, ("At Resolution ×2, enlarged " + printed("%.1f", ratio2) + "×").c_str(),
+                  colors::kSection);
+            y += std::round(font() * 1.3f);
+            close_up(draw, 2, {start.x, y}, pair_w, h, "Sharp", sharp);
+            close_up(draw, 3, {start.x + pair_w + gap, y}, pair_w, h, "Smooth", !sharp);
+            y += h + std::round(font() * 1.7f);
+        }
+    } else {
+        close_up(draw, 0, {start.x, y}, pair_w, h, "Sharp", sharp);
+        close_up(draw, 1, {start.x + pair_w + gap, y}, pair_w, h, "Smooth", !sharp);
+        y += h + std::round(font() * 1.7f);
+        const std::string how =
+            ratio > 1.0f ? "enlarged " + printed("%.2f", ratio) + "×" : "shrunk to " + printed("%.0f", ratio * 100.0) + "%";
+        y += note(draw, {start.x, y}, width, "Drawn at " + drawn + ", shown at " + shown + ": " + how + ".",
+                  colors::kTextDim) +
+             px(16.0f);
+    }
+    y += note(draw, {start.x, y}, width, "Close-ups of the paused game, 2× zoom.");
+    ImGui::Dummy({width, y - start.y});
+    return true;
+}
