+bool stick(gpu::VulkanRenderer &renderer, float width) {
+    ImDrawList *draw = ImGui::GetWindowDrawList();
+    const ImVec2 start = ImGui::GetCursorScreenPos();
+    const settings::Settings &s = settings::current();
+    SDL_Gamepad *pad = renderer.gamepad();
+    const float x = axis(pad, SDL_GAMEPAD_AXIS_LEFTX);
+    const float y = axis(pad, SDL_GAMEPAD_AXIS_LEFTY);
+    const float size = std::floor(std::min(width * 0.45f, font() * 14.0f));
+    const float radius = size * 0.42f;
+    const ImVec2 c{start.x + size * 0.5f, start.y + size * 0.5f};
+    static Trail trail;
+    stick_gate(draw, c, radius, s.dead_zone, s.stick_square, pad != nullptr, x, y, &trail);
+
+    const float column = start.x + size + px(30.0f);
+    const float label_w = std::round(font() * 6.0f);
+    float ly = start.y + px(6.0f);
+    const input::stick::Nub nub = input::stick::to_nub(x, y, {s.dead_zone, input::stick::kFullDeflection, s.stick_square});
+    const float length = std::hypot(x, y);
+    if (pad != nullptr) {
+        ly += readout(draw, {column, ly}, label_w, "Left stick", printed("%.2f, %.2f", x, y));
+        ly += readout(draw, {column, ly}, label_w, "Game reads", nub_text(nub));
+    }
+    ly += readout(draw, {column, ly}, label_w, "Dead zone",
+                  std::to_string(static_cast<int>(std::lround(s.dead_zone * 100.0f))) + "%", colors::kDanger);
+    if (pad != nullptr)
+        ly += readout(draw, {column, ly}, label_w, "Now", length <= s.dead_zone ? "inside the dead zone" : "past it",
+                      length <= s.dead_zone ? colors::kGood : colors::kText);
+    // The legend.
+    ly += px(8.0f);
+    const float swatch = std::round(font() * 0.55f);
+    draw->AddCircleFilled({column + swatch * 0.5f, ly + swatch * 0.6f}, swatch * 0.5f, faded(colors::kDanger, 0.6f));
+    text(draw, {column + swatch + px(8.0f), ly}, colors::kTextDim, "Ignored", 0.75f);
+    ly += std::round(font() * 1.2f);
+    if (s.stick_square) {
+        dashed_line(draw, {column, ly + swatch * 0.6f}, {column + swatch * 1.6f, ly + swatch * 0.6f},
+                    colors::kSection, px(3.0f), std::max(1.0f, px(1.5f)));
+        text(draw, {column + swatch * 1.6f + px(8.0f), ly}, colors::kTextDim, "The PSP's range, Full diagonals", 0.75f);
+    }
+    float bottom = start.y + size + px(14.0f);
+    bottom += note(draw, {start.x, bottom}, width,
+                   pad != nullptr ? "Live from " + pad_name(pad) + ". Move the left stick to try it; the D-pad leaves "
+                                                                   "this row. The game reads 0 to 255 on each axis, 128 at rest."
+                                  : "Connect a gamepad to try it here.");
+    ImGui::Dummy({width, bottom - start.y});
+    return true;
+}
+
+bool diagonals(gpu::VulkanRenderer &renderer, float width) {
+    ImDrawList *draw = ImGui::GetWindowDrawList();
+    const ImVec2 start = ImGui::GetCursorScreenPos();
+    const settings::Settings &s = settings::current();
+    SDL_Gamepad *pad = renderer.gamepad();
+    // The direction the stick points, or up and right while it rests: a
+    // full push that way, with the setting off and on.
+    float x = axis(pad, SDL_GAMEPAD_AXIS_LEFTX);
+    float y = axis(pad, SDL_GAMEPAD_AXIS_LEFTY);
+    float length = std::hypot(x, y);
+    if (length <= s.dead_zone || pad == nullptr) {
+        x = 0.70710678f;
+        y = -0.70710678f;
+        length = 1.0f;
+    }
+    x /= length;
+    y /= length;
+    const float size = std::floor(std::min((width - px(24.0f)) * 0.5f, font() * 11.0f));
+    const float radius = size * 0.4f;
+    for (int i = 0; i < 2; ++i) {
+        const bool square = i == 1;
+        const ImVec2 origin{start.x + static_cast<float>(i) * (size + px(24.0f)), start.y};
+        const ImVec2 c{origin.x + size * 0.5f, origin.y + size * 0.5f};
+        const input::stick::Nub nub = input::stick::to_nub(x, y, {0.0f, input::stick::kFullDeflection, square});
+        const float gx = (static_cast<float>(nub.x) - 128.0f) / (nub.x >= 128 ? 127.0f : 128.0f);
+        const float gy = (static_cast<float>(nub.y) - 128.0f) / (nub.y >= 128 ? 127.0f : 128.0f);
+        stick_gate(draw, c, radius, 0.0f, true, true, gx, gy, nullptr);
+        const bool on = square == s.stick_square;
+        const std::string caption = std::string(square ? "On" : "Off") + " · reads " + nub_text(nub);
+        text(draw, {origin.x, origin.y + size + px(8.0f)}, on ? colors::kHeading : colors::kTextDim, caption, 0.8f);
+    }
+    float bottom = start.y + size + std::round(font() * 1.9f);
+    bottom += note(draw, {start.x, bottom}, width,
+                   pad != nullptr ? "A full push the way " + pad_name(pad) +
+                                        "'s left stick points (up and right while it rests). The D-pad leaves this row."
+                                  : "A full push up and right.");
+    ImGui::Dummy({width, bottom - start.y});
+    return true;
+}
