-        const GlyphBitmap glyph = render_scaled(stamp.code, stamp.x64, stamp.y64, query.factor);
+        const GlyphBitmap glyph = render_scaled(stamp.code, stamp.x64, stamp.y64, factor);
         if (glyph.pixels.empty()) continue;
         // Inside the buffer, the clip rectangle and the covered part.
         const std::int64_t clip_x0 = std::max<std::int64_t>({0, static_cast<std::int64_t>(stamp.clip.x) * f, left});
@@ -276,14 +271,85 @@ bool sharp_text(const psprecomp::GuestMemory &memory, const SharpTextQuery &quer
         const std::int64_t count = x_end - x_begin;
         for (std::int64_t y = y_begin; y < y_end; ++y) {
