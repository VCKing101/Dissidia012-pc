+// Returns how many glyphs reached it.
+std::size_t draw_glyphs(const Buffer &b, std::uint32_t column0, std::uint32_t row0, std::uint32_t width,
+                        std::uint32_t height, int factor, std::vector<std::uint8_t> &coverage) {
     const GlyphTarget &t = b.target;
-    const std::uint32_t covered_width = std::min(query.width, t.width - column0);
-    const std::uint32_t covered_height = std::min(query.height, t.height - row0);
