+
+bool sharp_text_preview(gpu::VulkanRenderer &renderer, float width) {
+    ImDrawList *draw = ImGui::GetWindowDrawList();
+    const ImVec2 start = ImGui::GetCursorScreenPos();
+    const settings::Settings &s = settings::current();
+    const std::array<std::uint32_t, 2> target = renderer.target_size();
+    if (target[1] == 0u) return false;
+    // As the renderer draws it: the internal resolution's lines per PSP line.
+    const int factor = static_cast<int>(std::min((target[1] + 136u) / 272u, 8u));
+    float y = start.y;
+    if (factor < 2) {
+        y += note(draw, {start.x, y}, width,
+                  "At this resolution the game's text is drawn at the PSP's size either way.", colors::kTextDim);
+        ImGui::Dummy({width, y - start.y});
+        return true;
+    }
+    TextPreview &preview = text_preview();
+    const fonts::TextSample &sample = preview.sample;
+    const std::string wanted = std::to_string(factor) + "/" + std::to_string(fonts::generation());
+    if (preview.key != wanted) {
+        preview.found = fonts::text_sample(factor, preview.sample);
+        preview.key = wanted;
+        atlas().crops_key.clear();
+    }
+    if (!preview.found) {
+        y += note(draw, {start.x, y}, width, "The game has drawn no text to show yet.", colors::kTextDim);
+        ImGui::Dummy({width, y - start.y});
+        return true;
+    }
+    // On screen: the internal resolution shown at the window's scale.
+    const GamePicture picture = game_picture();
+    const float ratio = picture.height > 0.0f ? picture.height / static_cast<float>(target[1]) : 1.0f;
+    const int pad = static_cast<int>(px(12.0f));
+    const int big_w = static_cast<int>(sample.width) * factor;
+    const int big_h = static_cast<int>(sample.height) * factor;
+    const int text_w = static_cast<int>(std::lround(static_cast<float>(big_w) * ratio));
+    const int text_h = static_cast<int>(std::lround(static_cast<float>(big_h) * ratio));
+    const int strip_w = std::min({kAtlasSize, static_cast<int>(width), text_w + pad * 2});
+    const int strip_h = std::min({kSlotHeight, static_cast<int>(std::round(font() * 5.0f)), text_h + pad * 2});
+    const std::string key = "text/" + wanted + "/" + std::to_string(s.sharp_textures) + "/" +
+                            std::to_string(s.sharp_screen) + "/" + std::to_string(ratio) + "/" +
+                            std::to_string(strip_w) + "x" + std::to_string(strip_h);
+    const ImVec2 off_origin{0.0f, static_cast<float>(kSlotWidth)};
+    const ImVec2 on_origin{0.0f, static_cast<float>(kSlotWidth + kSlotHeight)};
+    if (atlas().crops_key != key) {
+        const ImU32 backdrop = colors::kPanel | 0xFF000000u;
+        const ImU32 ink = colors::kHeading | 0xFF000000u;
+        // Off: the PSP-sized letters enlarged to the internal resolution by
+        // the Texture filter, then to the screen.
+        const std::vector<std::uint8_t> off_big =
+            enlarged(sample.game, static_cast<int>(sample.width), static_cast<int>(sample.height), big_w, big_h,
+                     static_cast<float>(factor), s.sharp_textures);
+        const int cov_w = std::min(text_w, strip_w - pad), cov_h = std::min(text_h, strip_h - pad);
+        put_text(0, kSlotWidth, strip_w, strip_h, pad,
+                 enlarged(off_big, big_w, big_h, cov_w, cov_h, ratio, s.sharp_screen), cov_w, cov_h, ink, backdrop);
+        // On: drawn at the internal resolution, then to the screen.
+        put_text(0, kSlotWidth + kSlotHeight, strip_w, strip_h, pad,
+                 enlarged(sample.sharp, big_w, big_h, cov_w, cov_h, ratio, s.sharp_screen), cov_w, cov_h, ink,
+                 backdrop);
+        atlas().crops_key = key;
+    }
+    label(draw, {start.x, y}, ("The game's text at ×" + std::to_string(factor)).c_str(), colors::kSection);
+    y += std::round(font() * 1.3f);
+    const float w = static_cast<float>(strip_w), h = static_cast<float>(strip_h);
+    framed(draw, off_origin, {start.x, y}, w, h, "Off: the PSP's letters, enlarged " + std::to_string(factor) + "×",
+           !s.sharp_text);
+    y += h + std::round(font() * 1.9f);
+    framed(draw, on_origin, {start.x, y}, w, h, "On: drawn again at " + std::to_string(factor) + "×", s.sharp_text);
+    y += h + std::round(font() * 1.9f);
+    y += note(draw, {start.x, y}, width,
+              "Text the game drew last, as large as your screen shows it. Off enlarges the PSP's letters with the "
+              "Texture filter; On draws them again from the font.");
+    ImGui::Dummy({width, y - start.y});
+    return true;
+}
