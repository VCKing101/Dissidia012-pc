+// The frame as a Resolution of `lines` would draw it, near enough: each pixel
+// an average of the frame's pixels it covers, weighted to its centre (a tent).
+// Against Dissidia drawn at ×1 and at ×4 on the same screen, that came within
+// about 1 % of the real ×1 on both its text, which a plain average matches
+// better, and its pictures, where the centre alone does.
+Frame drawn_at(const Frame &source, std::uint32_t lines) {
+    Frame out;
+    out.tried = out.ok = true;
+    out.height = lines;
+    out.width = static_cast<std::uint32_t>(std::lround(static_cast<double>(source.width) * lines / source.height));
+    out.pixels.resize(std::size_t{out.width} * out.height * 4u);
+    const float sx = static_cast<float>(source.width) / static_cast<float>(out.width);
+    const float sy = static_cast<float>(source.height) / static_cast<float>(out.height);
+    // The weights along one axis, for each pixel of the smaller frame.
+    struct Span {
+        int first{};
+        std::vector<float> weights;
+    };
+    const auto spans = [](std::uint32_t count, float scale, std::uint32_t limit) {
+        std::vector<Span> result(count);
+        const float half = std::max(0.5f, scale * 0.5f);
+        for (std::uint32_t i = 0; i < count; ++i) {
+            const float centre = (static_cast<float>(i) + 0.5f) * scale;
+            Span &span = result[i];
+            span.first = std::max(0, static_cast<int>(std::floor(centre - half)));
+            const int last = std::min(static_cast<int>(limit) - 1, static_cast<int>(std::ceil(centre + half)));
+            float total = 0.0f;
+            for (int p = span.first; p <= last; ++p) {
+                const float w = std::max(0.0f, 1.0f - std::fabs(static_cast<float>(p) + 0.5f - centre) / half);
+                span.weights.push_back(w);
+                total += w;
+            }
+            if (total > 0.0f)
+                for (float &w : span.weights) w /= total;
+        }
