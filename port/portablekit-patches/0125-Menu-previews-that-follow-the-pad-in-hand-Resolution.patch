+        const bool now = i == steps.size();
+        const ImVec2 at{start.x + static_cast<float>(i % 2u) * (cell_w + gap),
+                        y + static_cast<float>(i / 2u) * row_h};
+        std::string name;
+        bool chosen = false;
+        if (now) {
+            const std::string setting =
+                s.internal_scale == 0u ? std::string("Auto") : "×" + std::to_string(s.internal_scale);
+            name = changed ? "Paused at " + size_text(f.width, f.height)
+                           : setting + ", " + size_text(f.width, f.height);
+            chosen = !changed;
+        } else {
+            const int k = steps[i];
+            name = "×" + std::to_string(k) + ", " +
+                   size_text(static_cast<double>(f.width) * 272.0 * k / f.height, 272.0 * k);
+            chosen = changed && s.internal_scale == static_cast<std::uint32_t>(k);
+        }
+        close_up(draw, static_cast<int>(i), at, cell_w, cell_h, name, chosen);
+    }
+    y += static_cast<float>((cells + 1u) / 2u) * row_h;
+    if (changed)
+        y += note(draw, {start.x, y}, width,
+                  "Now " + size_text(target[0], target[1]) + ": the game shows it when it draws again.",
+                  colors::kTextDim) +
+             px(10.0f);
+    if (resolution_strength() < kLittleToShow)
+        y += note(draw, {start.x, y}, width,
+                  "Little on this screen changes with the resolution: it sharpens the edges of models and scenery, "
+                  "not menus. Pause on the world map or in a battle to compare.",
+                  colors::kTextDim) +
+             px(10.0f);
+    y += note(draw, {start.x, y}, width,
+              "Close-ups of the paused game as your screen shows it, 2× zoom, where the resolution changes it "
+              "most, the game's own menus and text left aside. The lower resolutions are worked out from it, so "
+              "they are close to what the game draws, not exact; a higher one cannot be.");
+    ImGui::Dummy({width, y - start.y});
+    return true;
+}
