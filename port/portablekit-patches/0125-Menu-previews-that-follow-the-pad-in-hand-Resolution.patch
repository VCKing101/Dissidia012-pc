+// --- Sharp text ---------------------------------------------------------------
+
+// Coverage `w` by `h` enlarged `scale` times to `out_w` by `out_h`, by the
+// nearest pixel or bilinearly; nothing outside it.
+std::vector<std::uint8_t> enlarged(const std::vector<std::uint8_t> &coverage, int w, int h, int out_w, int out_h,
+                                   float scale, bool nearest) {
+    std::vector<std::uint8_t> out(static_cast<std::size_t>(out_w) * static_cast<std::size_t>(out_h), 0u);
+    const auto at = [&](int x, int y) -> float {
+        if (x < 0 || y < 0 || x >= w || y >= h) return 0.0f;
+        return coverage[static_cast<std::size_t>(y) * static_cast<std::size_t>(w) + static_cast<std::size_t>(x)];
+    };
+    for (int oy = 0; oy < out_h; ++oy)
+        for (int ox = 0; ox < out_w; ++ox) {
+            const float u = (static_cast<float>(ox) + 0.5f) / scale;
+            const float v = (static_cast<float>(oy) + 0.5f) / scale;
+            float value = 0.0f;
+            if (nearest) {
+                value = at(static_cast<int>(std::floor(u)), static_cast<int>(std::floor(v)));
+            } else {
+                const float fu = u - 0.5f, fv = v - 0.5f;
+                const int x0 = static_cast<int>(std::floor(fu)), y0 = static_cast<int>(std::floor(fv));
+                const float ax = fu - static_cast<float>(x0), ay = fv - static_cast<float>(y0);
+                value = (at(x0, y0) * (1.0f - ax) + at(x0 + 1, y0) * ax) * (1.0f - ay) +
+                        (at(x0, y0 + 1) * (1.0f - ax) + at(x0 + 1, y0 + 1) * ax) * ay;
+            }
+            out[static_cast<std::size_t>(oy) * static_cast<std::size_t>(out_w) + static_cast<std::size_t>(ox)] =
+                static_cast<std::uint8_t>(std::clamp(value + 0.5f, 0.0f, 255.0f));
+        }
+    return out;
+}
+
+// Coverage put in the atlas at (x, y) as `ink` over `backdrop`, `pad` pixels
+// of backdrop around it, the whole `w` by `h`.
+void put_text(int x, int y, int w, int h, int pad, const std::vector<std::uint8_t> &coverage, int cov_w, int cov_h,
+              ImU32 ink, ImU32 backdrop) {
+    for (int oy = 0; oy < h; ++oy) {
+        std::uint32_t *row = atlas_row(y + oy) + x;
+        for (int ox = 0; ox < w; ++ox) {
+            const int cx = ox - pad, cy = oy - pad;
+            const std::uint32_t c =
+                cx >= 0 && cy >= 0 && cx < cov_w && cy < cov_h
+                    ? coverage[static_cast<std::size_t>(cy) * static_cast<std::size_t>(cov_w) + static_cast<std::size_t>(cx)]
+                    : 0u;
+            std::uint32_t pixel = 0xFF000000u;
+            for (int shift = 0; shift < 24; shift += 8) {
+                const std::uint32_t a = (backdrop >> shift) & 0xFFu, b = (ink >> shift) & 0xFFu;
+                pixel |= ((a * (255u - c) + b * c + 127u) / 255u) << shift;
+            }
+            row[ox] = pixel;
+        }
+    }
+    upload(x, y, w, h);
+}
+
+// The block of text the Sharp text preview shows, taken once a menu.
