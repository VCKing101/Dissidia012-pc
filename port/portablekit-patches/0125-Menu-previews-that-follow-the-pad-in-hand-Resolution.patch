+bool sharp_text(const psprecomp::GuestMemory &memory, const SharpTextQuery &query, SharpText &out) {
+    if (!sharp_text_available() || query.factor < 2 || query.factor > 16) return false;
+    Registry &r = registry();
+    const std::lock_guard lock(r.mutex);
+    std::uint32_t base = 0u, column0 = 0u, row0 = 0u;
+    Buffer *found = checked_buffer(r, memory, query, base, column0, row0);
+    if (found == nullptr) return false;
+    Buffer &b = *found;
+    const GlyphTarget &t = b.target;
+    const std::uint32_t covered_width = std::min(query.width, t.width - column0);
+    const std::uint32_t covered_height = std::min(query.height, t.height - row0);
+    out.covered_width = covered_width;
+    out.covered_height = covered_height;
+    const std::size_t drawn = draw_glyphs(b, column0, row0, covered_width, covered_height, query.factor, out.coverage);
     b.last_used = ++r.clock;
     trace("%08X: %ux%u of buffer %08X (%ux%u) at %dx, %zu of %zu glyphs", query.address, covered_width,
           covered_height, base, t.width, t.height, query.factor, drawn, b.stamps.size());
     return true;
 }
 
+bool text_sample(int factor, TextSample &out) {
+    if (!sharp_text_available() || factor < 1 || factor > 16) return false;
+    Registry &r = registry();
+    const std::lock_guard lock(r.mutex);
+    const std::uint64_t font = generation();
+    std::vector<const Buffer *> usable;
+    for (const auto &[address, b] : r.buffers)
+        if (!b.foreign && !b.stamps.empty() && b.generation == font && b.expected.size() == buffer_bytes(b.target))
+            usable.push_back(&b);
+    if (usable.empty()) return false;
+    std::sort(usable.begin(), usable.end(),
+              [](const Buffer *a, const Buffer *b) { return a->last_used > b->last_used; });
+    if (usable.size() > 16u) usable.resize(16u);
+    const Buffer &b = **std::max_element(usable.begin(), usable.end(), [](const Buffer *a, const Buffer *c) {
+        return a->stamps.size() < c->stamps.size();
+    });
+    // The buffer as its glyphs left it: coverage, 4-bit low nibble first.
+    const GlyphTarget &t = b.target;
+    const bool four_bit = t.pixel_format == kFormat4;
+    const auto coverage_at = [&](std::uint32_t x, std::uint32_t y) -> std::uint8_t {
+        const std::uint8_t byte = b.expected[std::size_t{y} * t.bytes_per_line + (four_bit ? x / 2u : x)];
+        if (!four_bit) return byte;
+        return static_cast<std::uint8_t>(((x & 1u) != 0u ? byte >> 4u : byte & 0x0Fu) * 17u);
+    };
+    std::uint32_t x0 = t.width, y0 = t.height, x1 = 0u, y1 = 0u;
+    for (std::uint32_t y = 0; y < t.height; ++y)
+        for (std::uint32_t x = 0; x < t.width; ++x)
+            if (coverage_at(x, y) != 0u) {
+                x0 = std::min(x0, x);
+                y0 = std::min(y0, y);
+                x1 = std::max(x1, x + 1u);
+                y1 = std::max(y1, y + 1u);
+            }
+    if (x1 <= x0 || y1 <= y0) return false;
+    // A pixel of the buffer's own around the glyphs.
+    x0 = x0 > 0u ? x0 - 1u : 0u;
+    y0 = y0 > 0u ? y0 - 1u : 0u;
+    x1 = std::min(t.width, x1 + 1u);
+    y1 = std::min(t.height, y1 + 1u);
+    out.width = x1 - x0;
+    out.height = y1 - y0;
+    out.factor = factor;
+    out.glyphs = static_cast<std::uint32_t>(b.stamps.size());
+    out.game.resize(std::size_t{out.width} * out.height);
+    for (std::uint32_t y = 0; y < out.height; ++y)
+        for (std::uint32_t x = 0; x < out.width; ++x)
+            out.game[std::size_t{y} * out.width + x] = coverage_at(x0 + x, y0 + y);
+    if (factor >= 2) (void)draw_glyphs(b, x0, y0, out.width, out.height, factor, out.sharp);
+    else out.sharp = out.game;
+    return true;
+}
+
 } // namespace portablekit::fonts
