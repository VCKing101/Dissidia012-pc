+        for (const GpuVertex &vertex : impl.scratch) {
+            rect[0] = std::min(rect[0], vertex.x);
+            rect[1] = std::min(rect[1], vertex.y);
+            rect[2] = std::max(rect[2], vertex.x);
+            rect[3] = std::max(rect[3], vertex.y);
+        }
+        if (rect[2] - rect[0] < kScreenWideDraw && rect[2] > rect[0] && rect[3] > rect[1])
+            impl.interface_rects_building.push_back(rect);
+    }
 
