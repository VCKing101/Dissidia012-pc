+        for (std::uint32_t x = 0; x < out.width; ++x) {
+            const Span &row = rows[y], &column = columns[x];
+            std::array<float, 3> sum{};
+            for (std::size_t j = 0; j < row.weights.size(); ++j) {
+                const std::uint8_t *line =
+                    source.pixels.data() + std::size_t{static_cast<std::uint32_t>(row.first) + j} * source.width * 4u;
+                for (std::size_t i = 0; i < column.weights.size(); ++i) {
+                    const std::uint8_t *p = line + (static_cast<std::size_t>(column.first) + i) * 4u;
