+// A block of the game's text for the menu's preview of Sharp text: of the 16
+// glyph buffers used last that hold only glyphs drawn with the font in use,
+// the one with the most glyphs, cut to the part they cover. `game` is that
+// part as the buffer holds it, the PSP's size (coverage 0 to 255, `width` by
+// `height`); `sharp` is the same part drawn `factor` times as large, as Sharp
+// text draws it. Not checked against guest memory: the text may have left
+// the screen since.
+struct TextSample {
+    std::uint32_t width{};
+    std::uint32_t height{};
+    int factor{};
+    std::uint32_t glyphs{};
+    std::vector<std::uint8_t> game;
+    std::vector<std::uint8_t> sharp;
+};
+bool text_sample(int factor, TextSample &out);
+
 } // namespace portablekit::fonts
