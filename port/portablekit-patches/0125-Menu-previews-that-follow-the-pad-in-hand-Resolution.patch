+SDL_Gamepad *Layer::menu_gamepad() const {
+    if (renderer_ == nullptr) return nullptr;
+    // SDL_GetGamepadFromID finds a gamepad only while something has it open:
+    // the renderer has the players', ImGui's backend every connected one.
+    if (last_pad_ != 0u)
+        if (SDL_Gamepad *pad = SDL_GetGamepadFromID(last_pad_)) return pad;
+    if (SDL_Gamepad *pad = renderer_->gamepad()) return pad;
+    int count = 0;
+    SDL_JoystickID *ids = SDL_GetGamepads(&count);
+    SDL_Gamepad *found = nullptr;
+    for (int i = 0; ids != nullptr && i < count && found == nullptr; ++i) found = SDL_GetGamepadFromID(ids[i]);
+    SDL_free(ids);
+    return found;
+}
