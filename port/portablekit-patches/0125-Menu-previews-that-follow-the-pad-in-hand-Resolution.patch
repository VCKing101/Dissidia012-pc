-            std::uint8_t *row = out.coverage.data() + (y - top) * out_width + (x_begin - left);
+            std::uint8_t *row = coverage.data() + (y - top) * out_width + (x_begin - left);
             for (std::int64_t i = 0; i < count; ++i) row[i] = std::max(row[i], in[i]);
         }
     }
+    return drawn;
