+// --- Pictures of the game's (GameProfile::setting_pictures) -----------------------
+
+struct Picture {
+    ImTextureData *texture{};
+    int width{};
+    int height{};
+};
+
+// A PNG of the profile's as a texture, decoded once and kept.
+const Picture *picture(const EmbeddedImage &image) {
+    static std::vector<std::pair<const unsigned char *, Picture>> decoded;
+    if (image.data == nullptr || image.size == 0u) return nullptr;
+    for (const auto &[data, found] : decoded)
+        if (data == image.data) return found.texture != nullptr ? &found : nullptr;
+    Picture made;
+    int channels = 0;
+    stbi_uc *pixels = stbi_load_from_memory(image.data, static_cast<int>(image.size), &made.width, &made.height,
+                                            &channels, 4);
+    if (pixels != nullptr && made.width > 0 && made.height > 0) {
+        made.texture = new ImTextureData();
+        made.texture->Create(ImTextureFormat_RGBA32, made.width, made.height);
+        std::memcpy(made.texture->GetPixels(), pixels, static_cast<std::size_t>(made.width) * made.height * 4u);
+        ImGui::RegisterUserTexture(made.texture);
+    }
+    if (pixels != nullptr) stbi_image_free(pixels);
+    decoded.emplace_back(image.data, made);
+    return made.texture != nullptr ? &decoded.back().second : nullptr;
+}
+
+bool setting_pictures(const SettingPictures &p, float width) {
+    const Picture *off = picture(p.off);
+    const Picture *on = picture(p.on);
+    if (off == nullptr || on == nullptr) return false;
+    ImDrawList *draw = ImGui::GetWindowDrawList();
+    const ImVec2 start = ImGui::GetCursorScreenPos();
+    const float gap = px(20.0f);
+    // Side by side, at the size the game drew them or smaller.
+    const float w = std::floor(std::min((width - gap) * 0.5f, static_cast<float>(off->width)));
+    const float h = std::floor(std::min(w * static_cast<float>(off->height) / static_cast<float>(off->width),
+                                        std::round(font() * 16.0f)));
+    const float shown_w = std::floor(h * static_cast<float>(off->width) / static_cast<float>(off->height));
+    const bool now_on = p.is_on != nullptr && p.is_on();
+    float y = start.y;
+    for (int i = 0; i < 2; ++i) {
+        const Picture &pic = i == 0 ? *off : *on;
+        const bool chosen = p.is_on != nullptr && (i == 1) == now_on;
+        const ImVec2 at{std::round(start.x + static_cast<float>(i) * (shown_w + gap)), std::round(y)};
+        draw->AddImage(pic.texture->GetTexRef(), at, {at.x + shown_w, at.y + h});
+        const float edge = std::max(1.0f, px(chosen ? 2.0f : 1.0f));
+        draw->AddRect({at.x - px(3.0f), at.y - px(3.0f)}, {at.x + shown_w + px(3.0f), at.y + h + px(3.0f)},
+                      chosen ? colors::kAccent : colors::kPanelEdge, 0.0f, 0, edge);
+        const float caption_y = at.y + h + px(10.0f);
+        text(draw, {at.x, caption_y}, chosen ? colors::kHeading : colors::kTextDim, i == 0 ? "Off" : "On", 0.8f);
+        if (chosen) {
+            const std::string mark = "Chosen";
+            text(draw, {at.x + shown_w - text_width(mark, 0.8f), caption_y}, colors::kSection, mark, 0.8f);
+        }
+    }
+    y += h + std::round(font() * 1.9f);
+    if (p.note != nullptr) y += note(draw, {start.x, y}, width, p.note);
+    ImGui::Dummy({width, y - start.y});
+    return true;
+}
