@@ -175,6 +226,74 @@ const Matching &Matcher::match(const std::vector<DrawSummary> &older, const std:
         out.camera_distance = std::max(out.camera_distance, camera.distance);
     }
 
+    // Instances of one mesh again, now that the camera is known. Drawing
+    // order pairs a copy with its neighbour once copies enter or leave the
+    // view, and a neighbour a short way off passes the own-motion guard below
+    // and is blended halfway towards. A copy whose drawing-order partner is
+    // where the camera's motion carries it keeps it; the others of each mesh
+    // pair up nearest first (the copy that needs the least motion of its
+    // own), so that a copy that left the view does not take its neighbour's
+    // place. In a stream of sparks the nearest to where one was is the one
+    // behind it only when the stream moves more than half its spacing a
+    // frame, where neither pairing reads as motion.
+    const auto predicted_of = [&](const DrawSummary &from) {
+        const Matrix &c = out.views[std::min<std::size_t>(from.split_view, kViews - 1u)].camera;
+        const std::array<float, 3> before = from.prepared ? from.eye_translation : eye_translation_of(from);
+        std::array<float, 3> predicted{};
+        for (std::size_t row = 0; row < 3u; ++row)
+            predicted[row] = c[row] * before[0] + c[4u + row] * before[1] + c[8u + row] * before[2] + c[12u + row];
+        return predicted;
+    };
+    const auto squared_distance = [&](const std::array<float, 3> &at, std::int32_t to) {
+        const DrawSummary &other = newer[static_cast<std::size_t>(to)];
+        const std::array<float, 3> b = other.prepared ? other.eye_translation : eye_translation_of(other);
+        const float x = at[0] - b[0], y = at[1] - b[1], z = at[2] - b[2];
+        return x * x + y * y + z * z;
+    };
+    if (out.camera_found && thresholds.nearest_instances && thresholds.max_own_motion > 0.0f) {
+        const float close = 0.05f * thresholds.max_own_motion;
+        taken_.assign(newer.size(), 0u);
+        for (std::size_t i = 0; i < older.size(); ++i)
+            if (out.newer_of[i] >= 0 && shared_[i] == 0u) taken_[static_cast<std::size_t>(out.newer_of[i])] = 1u;
+        const auto repairable = [&](std::size_t i) {
+            return older[i].eligible && shared_[i] != 0u &&
+                   out.views[std::min<std::size_t>(older[i].split_view, kViews - 1u)].found;
+        };
+        // The copies left to pair, each with its drawing-order partner.
+        unsettled_.clear();
+        for (std::size_t i = 0; i < older.size(); ++i) {
+            if (!repairable(i)) continue;
+            const std::int32_t in_order = out.newer_of[i];
+            if (in_order >= 0 && squared_distance(predicted_of(older[i]), in_order) <= close * close) {
+                taken_[static_cast<std::size_t>(in_order)] = 1u;
+                continue;
+            }
+            unsettled_.push_back({static_cast<std::int32_t>(i), in_order});
+            if (in_order >= 0) --out.matched;
+            out.newer_of[i] = Matching::kNoPartner;
+        }
+        candidates_.clear();
+        for (const auto &[i, in_order] : unsettled_) {
+            const DrawSummary &from = older[static_cast<std::size_t>(i)];
+            const std::array<float, 3> predicted = predicted_of(from);
+            for (std::int32_t at = slot_for(key_of(from), from).first; at >= 0; at = next_[static_cast<std::size_t>(at)])
+                if (taken_[static_cast<std::size_t>(at)] == 0u)
+                    candidates_.push_back({squared_distance(predicted, at), i, at});
+        }
+        std::sort(candidates_.begin(), candidates_.end(), [](const Candidate &a, const Candidate &b) {
+            return a.distance < b.distance || (a.distance == b.distance && a.older < b.older);
+        });
+        for (const Candidate &candidate : candidates_) {
+            std::int32_t &partner = out.newer_of[static_cast<std::size_t>(candidate.older)];
+            if (partner >= 0 || taken_[static_cast<std::size_t>(candidate.newer)] != 0u) continue;
+            partner = candidate.newer;
+            taken_[static_cast<std::size_t>(candidate.newer)] = 1u;
+            ++out.matched;
+        }
+        for (const auto &[i, in_order] : unsettled_)
+            if (out.newer_of[static_cast<std::size_t>(i)] != in_order) ++out.reordered;
+    }
+
     // Each pair's own motion: where its view's camera motion would have
     // taken the older draw against where the newer one is, in eye space.
     if (out.camera_found && thresholds.max_own_motion > 0.0f) {
