+    // Everything that stands still moved by the very same matrix, while a
+    // pair of two different instances of one mesh turned with the camera but
+    // slid by the distance between the two: the turn alone cannot tell them
+    // apart, and a row of copies paired with their neighbours slides as one.
+    // With nearest_instances the camera is the motion the most pairs of
+    // meshes drawn once agree on (rounding aside), then the most of any
+    // pairs, and the median turn only when no motion is shared by a few.
+    const auto agree = [](const Matrix &a, const Matrix &b) {
+        for (std::size_t column = 0; column < 3u; ++column)
+            for (std::size_t row = 0; row < 3u; ++row)
+                if (std::fabs(a[column * 4u + row] - b[column * 4u + row]) > 1e-3f) return false;
+        for (std::size_t row = 0; row < 3u; ++row) {
+            const float size = std::max(std::fabs(a[12u + row]), std::fabs(b[12u + row]));
+            if (std::fabs(a[12u + row] - b[12u + row]) > 0.01f + 1e-3f * size) return false;
+        }
+        return true;
+    };
     for (std::size_t view = 0; view < kViews; ++view) {
         std::vector<Sample> &taken = samples[view];
         if (taken.empty()) continue;
         const auto middle = taken.begin() + static_cast<std::ptrdiff_t>(taken.size() / 2u);
         std::nth_element(taken.begin(), middle, taken.end(),
                          [](const Sample &a, const Sample &b) { return a.turn < b.turn; });
+        const Sample *chosen = &*middle;
+        const auto consensus = [&](const std::vector<Sample> &among) -> const Sample * {
+            const Sample *best = nullptr;
+            std::size_t most = 0u;
+            for (const Sample &candidate : among) {
+                std::size_t agreeing = 0u;
+                for (const Sample &other : among) agreeing += agree(candidate.motion, other.motion) ? 1u : 0u;
+                if (agreeing > most) {
+                    most = agreeing;
+                    best = &candidate;
+                }
+                if (most * 2u > among.size()) break;  // no other motion can be shared by more
+            }
+            return most >= 3u ? best : nullptr;
+        };
+        if (thresholds.nearest_instances) {
+            if (const Sample *found = consensus(unique_samples[view])) chosen = found;
+            else if (const Sample *any = consensus(taken)) chosen = any;
+        }
