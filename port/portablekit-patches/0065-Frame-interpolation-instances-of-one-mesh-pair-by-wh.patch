+    const std::size_t stride = std::max<std::size_t>(1u, out.matched / 256u);
+    const std::size_t unique_stride = std::max<std::size_t>(1u, unique_matched / 256u);
+    std::size_t seen = 0u;
+    std::size_t unique_seen = 0u;
+    for (std::size_t i = 0; i < older.size(); ++i) {
