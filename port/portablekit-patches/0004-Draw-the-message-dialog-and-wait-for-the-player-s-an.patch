diff --git a/host/ui/message_dialog.cpp b/host/ui/message_dialog.cpp
new file mode 100644
index 0000000..2a22131
--- /dev/null
+++ b/host/ui/message_dialog.cpp
@@ -0,0 +1,250 @@
+#include "ui/message_dialog.hpp"
+
+#include "ui/layer.hpp"
+#include "ui/widgets.hpp"
+
+#include "gpu/vulkan_renderer.hpp"
+
+#include "imgui.h"
+
+#include <algorithm>
+#include <cmath>
+#include <initializer_list>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace portablekit::ui {
+namespace {
+
+struct Dialog {
+    bool open{};
+    MessageRequest request;
+    MessageDone on_done;
+    bool no_selected{};  // a question: which button is selected
+};
+
+Dialog &dialog() {
+    static Dialog value;
+    return value;
+}
+
+float font() { return Layer::get().font_size(); }
+float px(float value) { return std::round(value * Layer::get().scale()); }
+
+void release_game() {
+    Layer &layer = Layer::get();
+    layer.set_interactive(false);
+    layer.renderer().set_game_input(true);
+}
+
+void answer(MessageAnswer value) {
+    Dialog &d = dialog();
+    if (!d.open) return;
+    d.open = false;
+    release_game();
+    MessageDone done = std::move(d.on_done);
+    d.on_done = nullptr;
+    if (done) done(value);
+}
+
+void choose() {
+    const Dialog &d = dialog();
+    answer(d.request.question && d.no_selected ? MessageAnswer::No : MessageAnswer::Yes);
+}
+
+// The message broken into lines no wider than `width`: at the game's own
+// line breaks, and between words where a line is too long.
+std::vector<std::string> wrap(const std::string &text, float width) {
+    std::vector<std::string> lines;
+    std::size_t start = 0u;
+    for (;;) {
+        const std::size_t end = text.find('\n', start);
+        const std::string paragraph = text.substr(start, end == std::string::npos ? std::string::npos : end - start);
+        std::string line;
+        std::size_t at = 0u;
+        while (at <= paragraph.size()) {
+            const std::size_t space = paragraph.find(' ', at);
+            const std::string word = paragraph.substr(at, space == std::string::npos ? std::string::npos : space - at);
+            const std::string candidate = line.empty() ? word : line + " " + word;
+            if (!line.empty() && ImGui::CalcTextSize(candidate.c_str()).x > width) {
+                lines.push_back(line);
+                line = word;
+            } else {
+                line = candidate;
+            }
+            if (space == std::string::npos) break;
+            at = space + 1u;
+        }
+        lines.push_back(line);
+        if (end == std::string::npos) break;
+        start = end + 1u;
+    }
+    // A trailing line break draws nothing.
+    while (lines.size() > 1u && lines.back().empty()) lines.pop_back();
+    return lines;
+}
+
+void handle_input() {
+    Dialog &d = dialog();
+    Layer &layer = Layer::get();
+    // The menu does not open over the dialog.
+    (void)layer.take_menu_toggle();
+    const bool back_pressed = layer.take_back();
+
+    if (d.request.question) {
+        if (ImGui::IsKeyPressed(ImGuiKey_LeftArrow, true) || ImGui::IsKeyPressed(ImGuiKey_UpArrow, true))
+            d.no_selected = false;
+        if (ImGui::IsKeyPressed(ImGuiKey_RightArrow, true) || ImGui::IsKeyPressed(ImGuiKey_DownArrow, true))
+            d.no_selected = true;
+        if (back_pressed && d.request.allow_back) {
+            answer(MessageAnswer::Back);
+            return;
+        }
+    }
+    if (ImGui::IsKeyPressed(ImGuiKey_Enter, false) || ImGui::IsKeyPressed(ImGuiKey_KeypadEnter, false)) {
+        choose();
+        return;
+    }
+
+    // A button held when the dialog opened, such as the one that led to it,
+    // does nothing until it is released.
+    if (!layer.gamepad_armed()) return;
+    const bool south = layer.confirm_south();
+    const ImGuiKey confirm = south ? ImGuiKey_GamepadFaceDown : ImGuiKey_GamepadFaceRight;
+    const ImGuiKey back = south ? ImGuiKey_GamepadFaceRight : ImGuiKey_GamepadFaceDown;
+    const auto pressed = [](std::initializer_list<ImGuiKey> keys) {
+        for (const ImGuiKey key : keys)
+            if (ImGui::IsKeyPressed(key, true)) return true;
+        return false;
+    };
+    if (d.request.question) {
+        if (pressed({ImGuiKey_GamepadDpadLeft, ImGuiKey_GamepadLStickLeft, ImGuiKey_GamepadDpadUp,
+                     ImGuiKey_GamepadLStickUp}))
+            d.no_selected = false;
+        if (pressed({ImGuiKey_GamepadDpadRight, ImGuiKey_GamepadLStickRight, ImGuiKey_GamepadDpadDown,
+                     ImGuiKey_GamepadLStickDown}))
+            d.no_selected = true;
+        if (ImGui::IsKeyPressed(back, false) && d.request.allow_back) {
+            answer(MessageAnswer::Back);
+            return;
+        }
+    }
+    if (ImGui::IsKeyPressed(confirm, false)) choose();
+}
+
+// One button; true when clicked. Hovering a question's button selects it.
+bool button(const char *label, ImVec2 min, ImVec2 size, bool selected, bool &hovered) {
+    ImGui::SetCursorScreenPos(min);
+    ImGui::PushID(label);
+    const bool clicked = ImGui::InvisibleButton("##button", size);
+    hovered = ImGui::IsItemHovered();
+    ImGui::PopID();
+    ImDrawList *draw = ImGui::GetWindowDrawList();
+    const ImVec2 max{min.x + size.x, min.y + size.y};
+    const float rounding = px(6.0f);
+    draw->AddRectFilled(min, max, selected ? colors::kAccent : colors::kTrack, rounding);
+    if (selected)
+        draw->AddRect({min.x - px(2.0f), min.y - px(2.0f)}, {max.x + px(2.0f), max.y + px(2.0f)},
+                      colors::kAccentBright, rounding + px(2.0f), 0, px(2.0f));
+    const ImVec2 text = ImGui::CalcTextSize(label);
+    draw->AddText({min.x + (size.x - text.x) * 0.5f, min.y + (size.y - text.y) * 0.5f},
+                  selected ? colors::kPanel : colors::kText, label);
+    return clicked;
+}
+
+} // namespace
+
+bool open_game_message(MessageRequest request, MessageDone on_done) {
+    Layer &layer = Layer::get();
+    if (!layer.attached()) return false;
+    if (dialog().open) close_game_message();
+    Dialog &d = dialog();
+    d = Dialog{};
+    d.open = true;
+    d.no_selected = request.question && request.default_no;
+    d.request = std::move(request);
+    d.on_done = std::move(on_done);
+    layer.renderer().set_game_input(false);
+    layer.set_interactive(true);
+    return true;
+}
+
+bool game_message_open() { return dialog().open; }
+
+void close_game_message() {
+    Dialog &d = dialog();
+    if (!d.open) return;
+    d.open = false;
+    d.on_done = nullptr;
+    release_game();
+}
+
+void game_message_frame() {
+    Dialog &d = dialog();
+    if (!d.open) return;
+    handle_input();
+    if (!d.open) return;
+
+    const ImGuiIO &io = ImGui::GetIO();
+    ImGui::GetBackgroundDrawList()->AddRectFilled({0, 0}, io.DisplaySize, IM_COL32(0, 0, 0, 120));
+    ImGui::SetNextWindowPos({0, 0}, ImGuiCond_Always);
+    ImGui::SetNextWindowSize(io.DisplaySize, ImGuiCond_Always);
+    ImGui::Begin("##message", nullptr,
+                 ImGuiWindowFlags_NoDecoration | ImGuiWindowFlags_NoMove | ImGuiWindowFlags_NoSavedSettings |
+                     ImGuiWindowFlags_NoNav | ImGuiWindowFlags_NoScrollWithMouse | ImGuiWindowFlags_NoBackground);
+    ImDrawList *draw = ImGui::GetWindowDrawList();
+
+    ImGui::PushFont(nullptr, ImGui::GetStyle().FontSizeBase * 1.1f);
+    const float width = std::min(io.DisplaySize.x * 0.8f, font() * 36.0f);
+    const std::vector<std::string> lines = wrap(d.request.text, width);
+    const float line_height = ImGui::GetTextLineHeightWithSpacing();
+    const float text_height = line_height * static_cast<float>(lines.size());
+    const ImVec2 button_size{std::round(font() * 6.0f), std::round(font() * 1.9f)};
+    const float gap = std::round(font() * 1.2f);
+    const float block = text_height + gap + button_size.y;
+    const float top = std::round((io.DisplaySize.y - block) * 0.5f);
+
+    // The band: two rules across the whole screen, a little outside the
+    // text and the buttons, and a darker strip between them.
+    const float margin = std::round(font() * 1.1f);
+    const float rule_top = top - margin;
+    const float rule_bottom = top + block + margin;
+    draw->AddRectFilled({0, rule_top}, {io.DisplaySize.x, rule_bottom}, IM_COL32(0, 0, 0, 110));
+    draw->AddLine({0, rule_top}, {io.DisplaySize.x, rule_top}, IM_COL32(255, 255, 255, 200), px(1.5f));
+    draw->AddLine({0, rule_bottom}, {io.DisplaySize.x, rule_bottom}, IM_COL32(255, 255, 255, 200), px(1.5f));
+
+    float y = top;
+    for (const std::string &line : lines) {
+        const ImVec2 size = ImGui::CalcTextSize(line.c_str());
+        draw->AddText({std::round((io.DisplaySize.x - size.x) * 0.5f), y}, IM_COL32(255, 255, 255, 255), line.c_str());
+        y += line_height;
+    }
+    ImGui::PopFont();
+
+    const float buttons_y = top + text_height + gap;
+    bool hovered = false;
+    if (d.request.question) {
+        const float spacing = std::round(font() * 1.5f);
+        const float left = std::round((io.DisplaySize.x - button_size.x * 2.0f - spacing) * 0.5f);
+        const bool yes = button("Yes", {left, buttons_y}, button_size, !d.no_selected, hovered);
+        if (hovered && io.MouseDelta.x * io.MouseDelta.x + io.MouseDelta.y * io.MouseDelta.y > 0.0f) d.no_selected = false;
+        const bool no = button("No", {left + button_size.x + spacing, buttons_y}, button_size, d.no_selected, hovered);
+        if (hovered && io.MouseDelta.x * io.MouseDelta.x + io.MouseDelta.y * io.MouseDelta.y > 0.0f) d.no_selected = true;
+        if (yes) {
+            answer(MessageAnswer::Yes);
+        } else if (no) {
+            answer(MessageAnswer::No);
+        }
+    } else {
+        const float left = std::round((io.DisplaySize.x - button_size.x) * 0.5f);
+        if (button("OK", {left, buttons_y}, button_size, true, hovered)) answer(MessageAnswer::Yes);
+    }
+
+    ImGui::SetCursorScreenPos({std::round((io.DisplaySize.x - width) * 0.5f), rule_bottom + px(10.0f)});
+    if (d.request.question && d.request.allow_back) hints({{Control::Confirm, "Enter"}, {Control::Back, "Back"}});
+    else hints({{Control::Confirm, d.request.question ? "Enter" : "OK"}});
+    ImGui::End();
+}
+
+} // namespace portablekit::ui
