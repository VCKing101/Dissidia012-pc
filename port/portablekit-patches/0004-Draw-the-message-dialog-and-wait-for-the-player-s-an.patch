+#pragma once
+
+#include <functional>
+#include <string>
+
+// The game's message dialog (sceUtilityMsgDialog), drawn by the interface
+// layer over the running game: the message, centred between two rules across
+// the screen, and an OK button for a notice or Yes and No for a question, with
+// the button hints underneath.
+//
+// Gamepad: left/right (D-pad or left stick) moves between Yes and No, confirm
+// chooses, back answers a question with Back unless the game turned that off.
+// Keyboard: the arrow keys, Enter, Esc. The mouse clicks the buttons. Confirm
+// is the face button the menu's "Confirm button" setting names. A notice
+// closes only with confirm.
+//
+// The game keeps running behind it, as it does behind the PSP's dialog, but
+// reads a neutral pad until the dialog closes.
+namespace portablekit::ui {
+
+struct MessageRequest {
+    std::string text;      // UTF-8; '\n' breaks lines
+    bool question{};       // Yes and No; otherwise a notice with OK
+    bool default_no{};     // a question opens with No selected
+    bool allow_back{true}; // back answers a question with Back
+};
+
+enum class MessageAnswer { Yes, No, Back };
+
+// Called once when the player answers. A notice answers Yes.
+using MessageDone = std::function<void(MessageAnswer)>;
+
+// Opens the dialog over the running game. False when there is no interface
+// to draw it in.
+bool open_game_message(MessageRequest request, MessageDone on_done);
+[[nodiscard]] bool game_message_open();
+// Closes an open dialog without an answer (the game shut it down itself).
+void close_game_message();
+// Builds this frame of the dialog and handles its input. Called inside an
+// interface frame by draw_over_game().
+void game_message_frame();
+
+} // namespace portablekit::ui
