-// logged so the conversation can be followed.
+// SceUtilityMsgDialogParams, after the common dialog header.
+namespace msg {
+constexpr std::uint32_t kMode = 0x34u;         // 0: error code, 1: text
+constexpr std::uint32_t kErrorValue = 0x38u;
+constexpr std::uint32_t kMessage = 0x3Cu;      // char[512], UTF-8
+constexpr std::uint32_t kOptions = 0x23Cu;
+constexpr std::uint32_t kButtonPressed = 0x240u;
+constexpr std::uint32_t kMinimumSize = 0x244u;
+
+constexpr std::uint32_t kModeError = 0u;
+// Option bits. A game's notice reads 0xA3: text, no sound, an OK button and
+// no cancelling.
+constexpr std::uint32_t kOptionYesNo = 0x10u;
+constexpr std::uint32_t kOptionNoCancel = 0x80u;
+constexpr std::uint32_t kOptionDefaultNo = 0x100u;
+constexpr std::uint32_t kPressedYes = 1u;  // also what a notice's OK reports
+constexpr std::uint32_t kPressedNo = 2u;
+constexpr std::uint32_t kPressedBack = 3u;
+} // namespace msg
+
+// The message dialog. It is drawn by the port's interface over the running
+// game (host/ui/message_dialog.hpp) and stays VISIBLE until the player
+// answers; the answer, OK, Yes, No or Back, is what the game reads.
+//
+//   <prefix>_MSGDIALOG_ANSWERS=ok,no,yes,back
+//       answers the next dialogs in order, without drawing them: for tests,
+//       and for runs without a window. Each dialog takes the next answer.
+//   <prefix>_MSGDIALOG_INSTANT=1
+//       close to the old behaviour: nothing drawn and every dialog answered
+//       at once, OK to a notice but No to a question, so that nothing such
+//       as a save or an overwrite is ever confirmed without a person.
+//
+// With no window and no scripted answer left the dialog waits, as the PSP's
+// would with nobody at the controls, and says so once.
+struct MsgDialogState {
+    std::uint32_t params{};
+    std::uint32_t status{dialog_status::kNone};
+    std::optional<std::uint32_t> answer;  // the button code to deliver
+    bool question{};
+    unsigned serial{};
+};
+
+MsgDialogState &msg_state() {
+    static MsgDialogState state;
+    return state;
+}
+
+const char *pressed_name(std::uint32_t pressed, bool question) {
+    switch (pressed) {
+    case msg::kPressedYes: return question ? "yes" : "ok";
+    case msg::kPressedNo: return "no";
+    case msg::kPressedBack: return "back";
+    default: return "?";
+    }
+}
+
+bool msgdialog_instant() {
+    static const bool instant = [] {
+        const char *text = portablekit::env("MSGDIALOG_INSTANT");
+        return text != nullptr && *text != '\0' && *text != '0';
+    }();
+    return instant;
+}
+
+// The answers <prefix>_MSGDIALOG_ANSWERS still holds, the next one last.
+std::vector<std::uint32_t> &scripted_answers() {
+    static std::vector<std::uint32_t> answers = [] {
+        std::vector<std::uint32_t> list;
+        const char *text = portablekit::env("MSGDIALOG_ANSWERS");
+        if (text == nullptr) return list;
+        std::string item;
+        const std::string all = std::string(text) + ",";
+        for (const char c : all) {
+            if (c != ',' && c != ';' && c != ' ') {
+                item.push_back(static_cast<char>(std::tolower(static_cast<unsigned char>(c))));
+                continue;
+            }
+            if (item.empty()) continue;
+            if (item == "ok" || item == "yes") list.push_back(msg::kPressedYes);
+            else if (item == "no") list.push_back(msg::kPressedNo);
+            else if (item == "back") list.push_back(msg::kPressedBack);
+            else std::cerr << "[msgdialog] MSGDIALOG_ANSWERS: \"" << item << "\" is not ok, yes, no or back\n";
+            item.clear();
+        }
+        std::reverse(list.begin(), list.end());
+        return list;
+    }();
+    return answers;
+}
+
+void msg_set_answer(std::uint32_t pressed, const char *by) {
+    MsgDialogState &state = msg_state();
+    state.answer = pressed;
+    std::cerr << "[msgdialog] #" << state.serial << " -> " << pressed_name(pressed, state.question) << " (" << by
+              << ")" << std::endl;
+}
+
+// Hands the answer to the game and reports QUIT.
+void msg_deliver(psprecomp::GuestMemory &memory) {
+    MsgDialogState &state = msg_state();
+    const std::uint32_t pressed = *state.answer;
+    state.answer.reset();
+    if (state.params != 0u) {
+        if (memory.load32(state.params + dialog_common::kSizeOffset) >= msg::kMinimumSize)
+            memory.store32(state.params + msg::kButtonPressed, pressed);
+        memory.store32(state.params + dialog_common::kResultOffset, 0u);
+    }
+    state.status = dialog_status::kQuit;
+}
+
+// One poll (GetStatus or Update): the status to report, then the next step.
+std::uint32_t msg_poll(psprecomp::GuestMemory &memory) {
+    MsgDialogState &state = msg_state();
+    const std::uint32_t reported = state.status;
+    switch (state.status) {
+    case dialog_status::kInit: state.status = dialog_status::kVisible; break;
+    case dialog_status::kVisible:
+        if (state.answer) msg_deliver(memory);
+        break;
+    case dialog_status::kFinished:
+        state.status = dialog_status::kNone;
+        state.params = 0u;
+        break;
+    default: break;
+    }
+    return reported;
+}
+
+void msg_close_ui() {
+#if defined(PORTABLEKIT_HAS_RENDERER)
+    if (ui::game_message_open()) ui::close_game_message();
+#endif
+}
+
+// Where the answer comes from: the instant answer, the script, the player,
+// or nobody yet.
+void msg_ask(const std::string &text, bool question, bool default_no, bool allow_back) {
+    MsgDialogState &state = msg_state();
+    if (msgdialog_instant()) {
+        msg_set_answer(question ? msg::kPressedNo : msg::kPressedYes, "MSGDIALOG_INSTANT");
+        return;
+    }
+    if (std::vector<std::uint32_t> &script = scripted_answers(); !script.empty()) {
+        const std::uint32_t pressed = script.back();
+        script.pop_back();
+        msg_set_answer(pressed, "MSGDIALOG_ANSWERS");
+        return;
+    }
+#if defined(PORTABLEKIT_HAS_RENDERER)
+    ui::MessageRequest request;
+    request.text = text;
+    request.question = question;
+    request.default_no = default_no;
+    request.allow_back = allow_back;
+    const unsigned serial = state.serial;
+    const bool opened = ui::open_game_message(std::move(request), [serial](ui::MessageAnswer answer) {
+        if (msg_state().serial != serial || msg_state().status == dialog_status::kNone) return;
+        msg_set_answer(answer == ui::MessageAnswer::Yes  ? msg::kPressedYes
+                       : answer == ui::MessageAnswer::No ? msg::kPressedNo
+                                                         : msg::kPressedBack,
+                       "player");
+    });
+    if (opened) return;
+#else
+    (void)text;
+    (void)question;
+    (void)default_no;
+    (void)allow_back;
+    (void)state;
+#endif
+    log_once("msgdialog-waiting",
+             "[msgdialog] no window to draw the dialog in and no answer scripted; the game waits for an answer "
+             "(<prefix>_MSGDIALOG_ANSWERS answers dialogs in order)");
+}
+
 void register_msg_dialog(HleRegistrar &hle) {
     hle.add("sceUtility", "sceUtilityMsgDialogInitStart", [](Runtime &rt, AllegrexContext &ctx) {
         auto &memory = rt.memory();
+        MsgDialogState &state = msg_state();
         const std::uint32_t params = arg(ctx, 0);
+        if (state.status != dialog_status::kNone || params == 0u) {
+            std::cerr << "[msgdialog] InitStart while a dialog is active (status " << state.status << ")\n";
+            kernel().finish(ctx, kErrorUtilityInvalidStatus);
+            return;
+        }
         const std::uint32_t size = memory.load32(params + dialog_common::kSizeOffset);
         const std::uint32_t mode = memory.load32(params + msg::kMode);
         const std::uint32_t options = size >= msg::kMinimumSize ? memory.load32(params + msg::kOptions) : 0u;
+        const bool question = (options & msg::kOptionYesNo) != 0u;
+        const bool default_no = (options & msg::kOptionDefaultNo) != 0u;
+        std::string text;
         if (mode == msg::kModeError) {
-            std::cerr << "[msgdialog] error " << psprecomp::hex32(memory.load32(params + msg::kErrorValue)) << "\n";
+            const std::uint32_t code = memory.load32(params + msg::kErrorValue);
+            text = "An error has occurred.\n(" + psprecomp::hex32(code) + ")";
         } else {
-            std::cerr << "[msgdialog] \"" << read_cstring(memory, params + msg::kMessage, 512u) << "\""
-                      << ((options & msg::kOptionYesNo) != 0u ? " [yes/no]" : "")
-                      << ((options & msg::kOptionDefaultNo) != 0u ? " [default no]" : "") << " -> "
-                      << ((options & msg::kOptionYesNo) != 0u ? "yes" : "ok") << "\n";
+            text = read_cstring(memory, params + msg::kMessage, 512u);
         }
-        if (size >= msg::kMinimumSize) memory.store32(params + msg::kButtonPressed, msg::kPressedYes);
+        const unsigned serial = state.serial + 1u;
+        state = MsgDialogState{};
+        state.params = params;
+        state.status = dialog_status::kInit;
+        state.question = question;
+        state.serial = serial;
+        std::cerr << "[msgdialog] #" << serial << " \"" << text << "\"" << (mode == msg::kModeError ? " [error]" : "")
+                  << (question ? " [yes/no]" : "") << (default_no ? " [default no]" : "")
+                  << ((options & msg::kOptionNoCancel) != 0u ? " [no cancel]" : "")
+                  << " options=" << psprecomp::hex32(options) << "\n";
         memory.store32(params + dialog_common::kResultOffset, 0u);
-        msg_dialog().start();
+        msg_ask(text, question, default_no, (options & msg::kOptionNoCancel) == 0u);
         kernel().finish(ctx, 0u);
     });
 
-    hle.add("sceUtility", "sceUtilityMsgDialogUpdate", [](Runtime &, AllegrexContext &ctx) {
-        (void)msg_dialog().poll();
+    hle.add("sceUtility", "sceUtilityMsgDialogUpdate", [](Runtime &rt, AllegrexContext &ctx) {
+        (void)msg_poll(rt.memory());
         kernel().finish(ctx, 0u);
     });
 
-    hle.add("sceUtility", "sceUtilityMsgDialogGetStatus", [](Runtime &, AllegrexContext &ctx) {
-        kernel().finish(ctx, msg_dialog().poll());
+    hle.add("sceUtility", "sceUtilityMsgDialogGetStatus", [](Runtime &rt, AllegrexContext &ctx) {
+        kernel().finish(ctx, msg_poll(rt.memory()));
     });
 
     hle.add("sceUtility", "sceUtilityMsgDialogShutdownStart", [](Runtime &, AllegrexContext &ctx) {
-        if (!msg_dialog().active()) {
+        MsgDialogState &state = msg_state();
+        if (state.status == dialog_status::kNone) {
             kernel().finish(ctx, kErrorUtilityInvalidStatus);
             return;
         }
-        if (!msg_dialog().shutdown()) std::cerr << "[msgdialog] ShutdownStart before the dialog finished\n";
+        if (state.status != dialog_status::kQuit)
+            std::cerr << "[msgdialog] #" << state.serial << " shut down before it was answered\n";
+        msg_close_ui();
+        state.answer.reset();
+        state.status = dialog_status::kFinished;
+        kernel().finish(ctx, 0u);
+    });
+
+    // The game takes the dialog down itself: it quits with no answer.
+    hle.add("sceUtility", "sceUtilityMsgDialogAbort", [](Runtime &, AllegrexContext &ctx) {
+        MsgDialogState &state = msg_state();
+        if (state.status != dialog_status::kVisible && state.status != dialog_status::kInit) {
+            kernel().finish(ctx, kErrorUtilityInvalidStatus);
+            return;
+        }
+        std::cerr << "[msgdialog] #" << state.serial << " aborted by the game\n";
+        msg_close_ui();
+        state.answer.reset();
+        state.status = dialog_status::kQuit;
         kernel().finish(ctx, 0u);
     });
 }
