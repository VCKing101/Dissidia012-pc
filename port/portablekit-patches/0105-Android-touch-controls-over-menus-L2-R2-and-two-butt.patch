+// The app's internal files directory, the one SDL_GetPrefPath() returns
+// (Context.getFilesDir(), with a slash), worked out without Java: SDL can only
+// ask Java once SDLActivity has set it up, and a port's static constructors
+// that read settings run before that, while libmain.so is loaded. Internal
+// storage is /data/user/<user>/<package>, the user being the uid's hundred
+// thousands and the package the process name. Empty when that directory is
+// not there (an app moved to adoptable storage keeps it elsewhere): SDL is
+// asked then.
+std::filesystem::path android_files_directory() {
+    std::ifstream cmdline("/proc/self/cmdline", std::ios::binary);
+    std::string name;
+    std::getline(cmdline, name, '\0');
+    name = name.substr(0, name.find(':'));  // a service process: <package>:<name>
+    if (name.empty() || name.find('/') != std::string::npos) return {};
+    const std::filesystem::path package =
+        std::filesystem::path("/data/user") / std::to_string(getuid() / 100000u) / name;
+    std::error_code ec;
+    if (!std::filesystem::is_directory(package, ec)) return {};
+    return package / "files" / "";
+}
+#endif
