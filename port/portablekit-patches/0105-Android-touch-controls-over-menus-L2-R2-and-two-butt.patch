+
+// Text centred in a circle of radius r: on one line, or on two at the
+// space nearest the middle when one would be too small to read.
+void draw_fitted(ImDrawList *list, const std::string &text, ImVec2 c, float r, ImU32 ink) {
+    ImFont *font = ImGui::GetFont();
+    const float width = r * 1.6f;
+    const float largest = r * 0.5f;
+    const auto fit = [&](const std::string &line) {
+        const ImVec2 at_one = font->CalcTextSizeA(1.0f, 1e9f, 0.0f, line.c_str());
+        return at_one.x > 0.0f ? std::min(largest, width / at_one.x) : largest;
+    };
+    const float one_line = fit(text);
+    const std::size_t space = text.find(' ');
+    if (one_line >= largest * 0.75f || space == std::string::npos) {
+        const ImVec2 extent = font->CalcTextSizeA(one_line, 1e9f, 0.0f, text.c_str());
+        list->AddText(font, one_line, {c.x - extent.x * 0.5f, c.y - extent.y * 0.5f}, ink, text.c_str());
+        return;
+    }
+    const std::string top = text.substr(0, space), bottom = text.substr(space + 1);
+    const float size = std::min({fit(top), fit(bottom), largest * 0.85f});
+    const ImVec2 a = font->CalcTextSizeA(size, 1e9f, 0.0f, top.c_str());
+    const ImVec2 b = font->CalcTextSizeA(size, 1e9f, 0.0f, bottom.c_str());
+    list->AddText(font, size, {c.x - a.x * 0.5f, c.y - a.y}, ink, top.c_str());
+    list->AddText(font, size, {c.x - b.x * 0.5f, c.y}, ink, bottom.c_str());
+}
+
