From 1463e18bad7248fd7095e7a7bb1e2534540e2990 Mon Sep 17 00:00:00 2001
From: VCKing101 <59761021+VCKing101@users.noreply.github.com>
Date: Mon, 2 Nov 2026 15:03:24 +1030
Subject: [PATCH] Network page: no ImGui ID warning for players, who counts as
 on line, typed servers remembered

- ImGui's "conflicting ID" box is a message for developers; it showed
  to a player on the Steam Deck. <PREFIX>_UI_ID_CHECK=1 now turns it on,
  and it is off otherwise. The status rows whose labels can repeat (hosts
  heard, peers, sockets) get an ID each.
- Hosting says "N players on line" and that a player counts from when
  their game goes on line: joining on this page only chooses the session,
  so the host saw no new player until the joiner's game went on line. A
  joining player gets a "Joined" row saying the same.
- A server typed into the Server field is kept with the recent sessions
  under Join, as one typed under Address is: a LAN address, an internet
  address or a server's name alike (adhoc_remember()).

Tested with Dissidia 012 on Windows: two copies on one PC into a battle,
each stepping through the whole Network page with <PREFIX>_UI_ID_CHECK=1:
no warning, "2 players on line" on the host, the Joined row on the
joiner. Not seen: the duplicate rows the Deck had (a lingering host or
peer), nor the warning itself with the check on.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 host/adhoc/host.cpp    |  4 ++++
 host/adhoc/session.hpp |  4 ++++
 host/ui/layer.cpp      |  4 ++++
 host/ui/menu.cpp       | 33 ++++++++++++++++++++++++++++-----
 4 files changed, 40 insertions(+), 5 deletions(-)

diff --git a/host/adhoc/host.cpp b/host/adhoc/host.cpp
index d6449f7..af56c66 100644
--- a/host/adhoc/host.cpp
+++ b/host/adhoc/host.cpp
@@ -152,6 +152,10 @@ void adhoc_shutdown() noexcept {
     adhoc::Client::get().shutdown();
 }
 
+void adhoc_remember(const std::string &address) {
+    if (!address.empty()) remember(address);
+}
+
 void adhoc_join(const std::string &address) {
     if (address.empty()) return;
     if (adhoc_hosting()) {
diff --git a/host/adhoc/session.hpp b/host/adhoc/session.hpp
index 0998c47..b072370 100644
--- a/host/adhoc/session.hpp
+++ b/host/adhoc/session.hpp
@@ -59,4 +59,8 @@ void adhoc_shutdown() noexcept;
 // hosting first if this instance hosts.
 void adhoc_join(const std::string &address);
 
+// Puts `address` first among the recent ones, as joining does, for a server
+// typed in by hand; the caller saves the settings.
+void adhoc_remember(const std::string &address);
+
 } // namespace portablekit
diff --git a/host/ui/layer.cpp b/host/ui/layer.cpp
index 5d041de..e59c220 100644
--- a/host/ui/layer.cpp
+++ b/host/ui/layer.cpp
@@ -160,6 +160,10 @@ bool Layer::attach(gpu::VulkanRenderer &renderer) {
     // Keep the focused row highlighted: on a gamepad there is no pointer.
     io.ConfigNavCursorVisibleAlways = true;
     io.ConfigNavEscapeClearFocusItem = false;
+    // ImGui's box for two items with one ID is a message for developers:
+    // <PREFIX>_UI_ID_CHECK=1 shows it, and players never see it.
+    const char *id_check = portablekit::env("UI_ID_CHECK");
+    io.ConfigDebugHighlightIdConflicts = id_check != nullptr && *id_check != '\0' && std::string(id_check) != "0";
     if (!ImGui_ImplSDL3_InitForVulkan(renderer.window())) {
         std::cout << "[ui] ImGui_ImplSDL3_InitForVulkan failed; no menu\n";
         ImGui::DestroyContext();
diff --git a/host/ui/menu.cpp b/host/ui/menu.cpp
index 9c973c3..d9d91c2 100644
--- a/host/ui/menu.cpp
+++ b/host/ui/menu.cpp
@@ -1188,7 +1188,8 @@ void play_together() {
         const std::string suffix =
             status.adhocctl_port == adhoc::kAdhocctlPort ? std::string() : ":" + std::to_string(status.adhocctl_port);
         info_row("Hosting", players_text(status.players.size()) +
-                                " connected. Everyone now goes on line in the game and picks the same room.");
+                                " on line. A player counts from when their game goes on line; everyone picks the "
+                                "same room there.");
         const std::vector<adhoc::LocalAddress> addresses = adhoc::local_addresses();
         if (addresses.empty()) info_row("Your addresses", "No network is connected");
         for (std::size_t i = 0; i < addresses.size(); ++i) {
@@ -1254,6 +1255,9 @@ void play_together() {
             adhoc_join(address);
     }
     if (hosts.empty()) info_row("On this network", "Looking for hosted sessions…");
+    if (!hosting && s.adhoc && !s.adhoc_server.empty())
+        info_row("Joined", s.adhoc_server + ". Your game connects to it whenever it is on line, and the host counts "
+                                            "you from then.");
     if (text_row("join_address", "Address", typed_address, 100u, true, address_character,
                  {false, {},
                   "The host's address: their internet address, or their VPN address for a VPN without broadcast "
@@ -1289,7 +1293,9 @@ void Menu::network() {
                  options_for("network.server", "The session or PSP ad hoc server the game goes on line with: host "
                                                "name or address, host:port if it is not on 27312. Joining fills "
                                                "it in; for a public server, type its name. Applies the next time "
-                                               "the game goes on line."))) {
+                                               "the game goes on line, and is kept with the recent sessions under "
+                                               "Join."))) {
+        adhoc_remember(s.adhoc_server);
         settings::save();
         adhoc_apply_settings();
     }
@@ -1329,25 +1335,42 @@ void Menu::network() {
             text += "; announcing " + ds.announce_note + ", " + std::to_string(ds.announcements_sent) + " sent, " +
                     std::to_string(ds.queries_answered) + " queries answered";
         info_row("Discovery", text);
-        for (const adhoc::FoundHost &host : adhoc::Discovery::get().hosts())
+        // One ID each: two hosts, players or sockets can have the same label.
+        int row = 0;
+        for (const adhoc::FoundHost &host : adhoc::Discovery::get().hosts()) {
+            ImGui::PushID(row++);
             info_row(("Host " + host.info.name).c_str(),
                      host.join_address() + ", " + players_text(host.info.players) + ", " + host.info.product +
                          ", heard " + format_duration(host.heard_ms) + " ago");
+            ImGui::PopID();
+        }
     }
     if (!d.server_address.empty()) info_row("Server address", d.server_address);
     info_row("You", (s.adhoc_mac.empty() ? std::string("address made up on first use") : s.adhoc_mac) +
                         (d.nickname.empty() ? "" : "   " + d.nickname));
     info_row("Group", group_text(d));
-    for (const adhoc::PeerSummary &peer : d.peers)
+    ImGui::PushID("peers");
+    for (std::size_t i = 0; i < d.peers.size(); ++i) {
+        const adhoc::PeerSummary &peer = d.peers[i];
+        ImGui::PushID(static_cast<int>(i));
         info_row(peer.nickname.empty() ? "Player" : peer.nickname.c_str(),
                  adhoc::format_mac(peer.mac) + "   " +
                      (peer.last_heard_ms ? "heard " + format_duration(*peer.last_heard_ms) + " ago" : "not heard yet"));
-    for (const adhoc::SocketSummary &socket : d.sockets) {
+        ImGui::PopID();
+    }
+    ImGui::PopID();
+    // A listening socket and the streams it accepted share a port, so a label.
+    ImGui::PushID("sockets");
+    for (std::size_t i = 0; i < d.sockets.size(); ++i) {
+        const adhoc::SocketSummary &socket = d.sockets[i];
         const std::string label = socket.kind + " " + std::to_string(socket.port);
+        ImGui::PushID(static_cast<int>(i));
         info_row(label.c_str(), socket.state + (socket.peer ? "   " + adhoc::format_mac(*socket.peer) + " port " +
                                                                   std::to_string(socket.peer_port)
                                                             : std::string{}));
+        ImGui::PopID();
     }
+    ImGui::PopID();
     if (d.relay_links_wanted != 0u)
         info_row("Relay links", std::to_string(d.relay_links_up) + " of " + std::to_string(d.relay_links_wanted) +
                                     " up");
-- 
